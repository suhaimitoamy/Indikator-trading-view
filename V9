    float pExtreme = high
    float pMinRange = atr * projectionSeedAtr
    if math.abs(pExtreme - pOrigin) < pMinRange
        pExtreme := pOrigin + pMinRange

    [zLow, zHigh, f382, f500, f618, f705, f786] = f_zone_bounds(1, ctxState > 0 ? ctxState : 2, fibRetMode, pOrigin, pExtreme)

