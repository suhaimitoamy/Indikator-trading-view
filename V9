bearObScore += bearObActive and bearMssEvent ? 1 : 0
bearObScore += bearObActive and sessionOk ? 1 : 0
bearObScore += bearObActive and bearPdPreOk ? 1 : 0
bearObScore += bearObActive and htfBearEntryOk ? 1 : 0
bearObScore += bearObActive and not bearObMitigated ? 1 : 0

