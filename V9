//@version=6
indicator("XAUUSD Context Narrator v9.1", overlay = true, max_labels_count = 150, max_lines_count = 300)

//==================== INPUTS ====================//
groupSess = "Sessions"
tzInput = input.string("Asia/Makassar", "Timezone", group = groupSess)
asiaSession = input.session("0600-1400", "Asia Session", group = groupSess)
londonSession = input.session("1500-2000", "London Session", group = groupSess)
newYorkSession = input.session("2030-0000", "New York Session", group = groupSess)

groupTf = "Timeframes"
biasTf = input.timeframe("15", "HTF Validation TF", group = groupTf)
levelTf = input.timeframe("5", "Entry Structure TF", group = groupTf)

groupLogic = "Logic"
setupMode = input.string("Conservative", "Setup Mode", options = ["Conservative", "Balanced", "Aggressive"], group = groupLogic)
fibRetMode = input.string("Adaptive", "Fib Retracement Mode", options = ["Adaptive", "Shallow", "Normal", "Deep"], group = groupLogic)
fibInvalidation = input.string("0.786", "SL / Invalidation", options = ["0.705", "0.786", "Origin"], group = groupLogic)
fibUsePoiRefinement = input.bool(true, "Refine zone with OB/FVG POI", group = groupLogic)
projectionSeedAtr = input.float(0.80, "Minimum projected leg (ATR)", minval = 0.2, step = 0.05, group = groupLogic)
nearZoneAtr = input.float(0.35, "Near zone distance (ATR)", minval = 0.1, step = 0.05, group = groupLogic)
poiMinScore = input.int(4, "Min POI score", minval = 1, maxval = 8, group = groupLogic)
minFvgAtr = input.float(0.10, "Min FVG size (ATR)", minval = 0.0, step = 0.05, group = groupLogic)
equalToleranceAtr = input.float(0.10, "Equal highs/lows tolerance (ATR)", minval = 0.01, step = 0.01, group = groupLogic)
judasBars = input.int(6, "Judas window bars", minval = 1, maxval = 20, group = groupLogic)
sweepTimeoutBars = input.int(20, "Sweep timeout bars", minval = 3, maxval = 60, group = groupLogic)
projectionMaxBars = input.int(60, "Projection max bars", minval = 10, maxval = 300, group = groupLogic)

groupTarget = "Targets"
fibExt1 = input.float(1.0, "TP1 Extension", minval = 0.5, step = 0.05, group = groupTarget)
fibExt2 = input.float(1.272, "TP2 Extension", minval = 0.8, step = 0.05, group = groupTarget)
fibExt3 = input.float(1.618, "TP3 Extension", minval = 1.0, step = 0.05, group = groupTarget)

groupVis = "Visuals"
showLevels = input.bool(true, "Show active support/resistance", group = groupVis)
showAsia = input.bool(true, "Show Asia range", group = groupVis)
showLiquidityMap = input.bool(true, "Show liquidity map", group = groupVis)
showSessionBg = input.bool(false, "Highlight active session", group = groupVis)
showProjectedZone = input.bool(true, "Show projected zone", group = groupVis)
showConfirmedZone = input.bool(true, "Show confirmed zone", group = groupVis)
showPoiZones = input.bool(true, "Show OB / FVG", group = groupVis)
showSignals = input.bool(true, "Show grab / MSS / trigger markers", group = groupVis)
showProjectedPath = input.bool(true, "Show projected path", group = groupVis)
pathBarsToZone = input.int(8, "Path bars to zone", minval = 2, maxval = 80, group = groupVis)
pathBarsToTP = input.int(20, "Path bars to TP1", minval = 4, maxval = 120, group = groupVis)
showDashboard = input.bool(true, "Show dashboard", group = groupVis)
dashboardStyle = input.string("Mobile", "Dashboard Style", options = ["Mobile", "Desktop"], group = groupVis)
dashboardPos = input.string("Bottom Left", "Dashboard Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = groupVis)

//==================== EFFECTIVE PRESETS ====================//
swingLen = setupMode == "Conservative" ? 4 : setupMode == "Balanced" ? 3 : 2
atrLen = setupMode == "Conservative" ? 14 : setupMode == "Balanced" ? 14 : 10
bodyRatioMin = setupMode == "Conservative" ? 0.60 : setupMode == "Balanced" ? 0.50 : 0.40
displacementAtr = setupMode == "Conservative" ? 0.40 : setupMode == "Balanced" ? 0.30 : 0.20
breakBufferAtr = setupMode == "Conservative" ? 0.18 : setupMode == "Balanced" ? 0.14 : 0.10
falseBreakWickRatio = setupMode == "Conservative" ? 1.45 : setupMode == "Balanced" ? 1.30 : 1.15
impulseBodyAtr = setupMode == "Conservative" ? 0.55 : setupMode == "Balanced" ? 0.45 : 0.35
holdBufferAtr = setupMode == "Conservative" ? 0.14 : setupMode == "Balanced" ? 0.10 : 0.08
shallowRetestAtr = setupMode == "Conservative" ? 0.32 : setupMode == "Balanced" ? 0.40 : 0.52
continuationBars = setupMode == "Conservative" ? 3 : setupMode == "Balanced" ? 2 : 1
continuationLiftAtr = setupMode == "Conservative" ? 0.45 : setupMode == "Balanced" ? 0.35 : 0.25
regimeLookback = setupMode == "Conservative" ? 28 : setupMode == "Balanced" ? 24 : 20
rangeRegimeAtr = setupMode == "Conservative" ? 3.0 : setupMode == "Balanced" ? 3.2 : 3.6
trendSpreadAtr = setupMode == "Conservative" ? 0.20 : setupMode == "Balanced" ? 0.18 : 0.14
expansionBarAtr = setupMode == "Conservative" ? 1.50 : setupMode == "Balanced" ? 1.40 : 1.25
newsBarAtr = setupMode == "Conservative" ? 2.10 : setupMode == "Balanced" ? 2.20 : 2.40
chaseAtr = setupMode == "Conservative" ? 0.85 : setupMode == "Balanced" ? 1.05 : 1.30
setupThreshold = setupMode == "Conservative" ? 72 : setupMode == "Balanced" ? 60 : 52

//==================== HELPERS ====================//
f_inSession(_sess) =>
    not na(time(timeframe.period, _sess, tzInput))

f_dashPos(_pos) =>
    _pos == "Top Left" ? position.top_left :
     _pos == "Bottom Right" ? position.bottom_right :
     _pos == "Bottom Left" ? position.bottom_left :
     position.top_right

f_price(_x) =>
    na(_x) ? "-" : str.tostring(_x, format.mintick)

f_min_na(_a, _b) =>
    na(_a) ? _b : na(_b) ? _a : math.min(_a, _b)

f_max_na(_a, _b) =>
    na(_a) ? _b : na(_b) ? _a : math.max(_a, _b)

f_clamp(_x, _lo, _hi) =>
    math.max(_lo, math.min(_hi, _x))

f_grade(_score) =>
    _score >= 85 ? "A+" :
     _score >= 75 ? "A" :
     _score >= 65 ? "B" :
     _score >= 50 ? "C" :
     "Avoid"

f_overlap(_aLow, _aHigh, _bLow, _bHigh) =>
    not na(_aLow) and not na(_aHigh) and not na(_bLow) and not na(_bHigh) and math.max(_aLow, _bLow) <= math.min(_aHigh, _bHigh)

f_interLow(_aLow, _aHigh, _bLow, _bHigh) =>
    f_overlap(_aLow, _aHigh, _bLow, _bHigh) ? math.max(_aLow, _bLow) : na

f_interHigh(_aLow, _aHigh, _bLow, _bHigh) =>
    f_overlap(_aLow, _aHigh, _bLow, _bHigh) ? math.min(_aHigh, _bHigh) : na

f_zoneText(_lo, _hi) =>
    na(_lo) or na(_hi) ? "-" : f_price(_lo) + " - " + f_price(_hi)

f_zone_bounds(_dir, _state, _mode, _origin, _extreme) =>
    float _range = math.abs(_extreme - _origin)
    float _fib382 = na
    float _fib500 = na
    float _fib618 = na
    float _fib705 = na
    float _fib786 = na
    float _low = na
    float _high = na

    if _range > 0
        _fib382 := _dir == 1 ? _extreme - _range * 0.382 : _extreme + _range * 0.382
        _fib500 := _dir == 1 ? _extreme - _range * 0.500 : _extreme + _range * 0.500
        _fib618 := _dir == 1 ? _extreme - _range * 0.618 : _extreme + _range * 0.618
        _fib705 := _dir == 1 ? _extreme - _range * 0.705 : _extreme + _range * 0.705
        _fib786 := _dir == 1 ? _extreme - _range * 0.786 : _extreme + _range * 0.786

        if _dir == 1
            if _mode == "Shallow" or (_mode == "Adaptive" and _state >= 4)
                _low := _fib500
                _high := _fib382
            else if _mode == "Deep" or (_mode == "Adaptive" and _state == 3)
                _low := _fib705
                _high := _fib500
            else if _mode == "Adaptive" and _state == 2
                _low := _fib618
                _high := _fib500
            else
                _low := _fib618
                _high := _fib382
        else
            if _mode == "Shallow" or (_mode == "Adaptive" and _state >= 4)
                _low := _fib382
                _high := _fib500
            else if _mode == "Deep" or (_mode == "Adaptive" and _state == 3)
                _low := _fib500
                _high := _fib705
            else if _mode == "Adaptive" and _state == 2
                _low := _fib500
                _high := _fib618
            else
                _low := _fib382
                _high := _fib618

    [_low, _high, _fib382, _fib500, _fib618, _fib705, _fib786]

//==================== SESSIONS ====================//
inAsia = f_inSession(asiaSession)
inLondon = f_inSession(londonSession)
inNewYork = f_inSession(newYorkSession)

sessionShort = inAsia ? "Asia" : inLondon ? "London" : inNewYork ? "NY" : "Off"
bgcolor(showSessionBg and (inAsia or inLondon or inNewYork) ? color.new(color.teal, 92) : na)

//==================== ASIA RANGE ====================//
var float asiaHigh = na
var float asiaLow = na
var bool asiaLocked = false

prevInAsia = bar_index > 0 ? inAsia[1] : false
asiaStart = inAsia and not prevInAsia
asiaEnd = not inAsia and prevInAsia

if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaLocked := false
else if inAsia
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)

if asiaEnd and not na(asiaHigh) and not na(asiaLow)
    asiaLocked := true

//==================== BASE DATA ====================//
atr = ta.atr(atrLen)
body = math.abs(close - open)
bodySafe = math.max(body, syminfo.mintick)
barRange = math.max(high - low, syminfo.mintick)
bodyRatio = body / barRange
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
breakBuffer = atr * breakBufferAtr
holdBuffer = atr * holdBufferAtr
shallowRetestBuffer = atr * shallowRetestAtr
closePos = (close - low) / barRange
displacementOk = body >= atr * displacementAtr and bodyRatio >= bodyRatioMin
impulseBodyOk = body >= atr * impulseBodyAtr and bodyRatio >= math.max(bodyRatioMin - 0.10, 0.35)
bullCloseStrength = closePos >= 0.65
bearCloseStrength = closePos <= 0.35

chartTfSec = timeframe.in_seconds()
biasTfSec = timeframe.in_seconds(biasTf)
levelTfSec = timeframe.in_seconds(levelTf)
biasTfIsHigher = biasTfSec > chartTfSec
levelTfIsHigher = levelTfSec > chartTfSec

//==================== HTF VALIDATION ====================//
htfClose = biasTfIsHigher ? request.security(syminfo.tickerid, biasTf, close[1], lookahead = barmerge.lookahead_on) : close
htfEma20 = biasTfIsHigher ? request.security(syminfo.tickerid, biasTf, ta.ema(close, 20)[1], lookahead = barmerge.lookahead_on) : ta.ema(close, 20)
htfEma50 = biasTfIsHigher ? request.security(syminfo.tickerid, biasTf, ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on) : ta.ema(close, 50)
htfAtr = biasTfIsHigher ? request.security(syminfo.tickerid, biasTf, ta.atr(14)[1], lookahead = barmerge.lookahead_on) : atr
htfRangeHigh = biasTfIsHigher ? request.security(syminfo.tickerid, biasTf, ta.highest(high, 20)[1], lookahead = barmerge.lookahead_on) : ta.highest(high, 20)
htfRangeLow = biasTfIsHigher ? request.security(syminfo.tickerid, biasTf, ta.lowest(low, 20)[1], lookahead = barmerge.lookahead_on) : ta.lowest(low, 20)
htfRangeReady = not na(htfRangeHigh) and not na(htfRangeLow) and htfRangeHigh > htfRangeLow
htfRangeMid = htfRangeReady ? (htfRangeHigh + htfRangeLow) * 0.5 : na

bullBias = htfClose > htfEma20 and htfEma20 > htfEma50
bearBias = htfClose < htfEma20 and htfEma20 < htfEma50
biasText = bullBias ? "Bullish" : bearBias ? "Bearish" : "Netral"

htfBullEntryOk = bullBias and htfRangeReady and htfClose <= htfRangeMid + htfAtr * 0.20
htfBearEntryOk = bearBias and htfRangeReady and htfClose >= htfRangeMid - htfAtr * 0.20
htfPdText = not htfRangeReady ? "-" : htfClose < htfRangeMid ? "Discount" : htfClose > htfRangeMid ? "Premium" : "Equilibrium"

//==================== STRUCTURE LEVELS ====================//
levelPh = levelTfIsHigher ? request.security(syminfo.tickerid, levelTf, ta.pivothigh(high, swingLen, swingLen), lookahead = barmerge.lookahead_off) : ta.pivothigh(high, swingLen, swingLen)
levelPl = levelTfIsHigher ? request.security(syminfo.tickerid, levelTf, ta.pivotlow(low, swingLen, swingLen), lookahead = barmerge.lookahead_off) : ta.pivotlow(low, swingLen, swingLen)

var float activeResistance = na
var float activeSupport = na
var float prevResistance = na
var float prevSupport = na

if not na(levelPh)
    prevResistance := activeResistance
    activeResistance := levelPh

if not na(levelPl)
    prevSupport := activeSupport
    activeSupport := levelPl

bullStructure = not na(activeResistance) and not na(prevResistance) and not na(activeSupport) and not na(prevSupport) and activeResistance > prevResistance and activeSupport > prevSupport
bearStructure = not na(activeResistance) and not na(prevResistance) and not na(activeSupport) and not na(prevSupport) and activeResistance < prevResistance and activeSupport < prevSupport
structureText = bullStructure ? "HH / HL" : bearStructure ? "LH / LL" : bullBias ? "Konteks Bull" : bearBias ? "Konteks Bear" : "Range / Mixed"

//==================== DEALING RANGE ====================//
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow = na

if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

rangeReady = not na(lastSwingHigh) and not na(lastSwingLow) and lastSwingHigh > lastSwingLow
dealingHigh = lastSwingHigh
dealingLow = lastSwingLow
drMid = rangeReady ? (dealingHigh + dealingLow) * 0.5 : na
drCE = drMid
pdText = not rangeReady ? "-" : close < drMid ? "Discount" : close > drMid ? "Premium" : "Equilibrium"

//==================== LIQUIDITY MAP ====================//
extBSL = lastSwingHigh
extSSL = lastSwingLow

eqHigh = not na(activeResistance) and not na(prevResistance) and math.abs(activeResistance - prevResistance) <= atr * equalToleranceAtr ? math.max(activeResistance, prevResistance) : na
eqLow = not na(activeSupport) and not na(prevSupport) and math.abs(activeSupport - prevSupport) <= atr * equalToleranceAtr ? math.min(activeSupport, prevSupport) : na

intBSL = eqHigh
intSSL = eqLow

drawDir = htfBullEntryOk ? 1 : htfBearEntryOk ? -1 : 0
drawTarget = drawDir == 1 ? extBSL : drawDir == -1 ? extSSL : na
drawText = drawDir == 1 ? "Buy-side Liquidity" : drawDir == -1 ? "Sell-side Liquidity" : "Mixed"

//==================== REGIME ====================//
emaFast = ta.ema(close, 10)
emaSlow = ta.ema(close, 20)
recentRange = ta.highest(high, regimeLookback) - ta.lowest(low, regimeLookback)
spreadAbs = math.abs(emaFast - emaSlow)

trendUpRegime = bullBias and bullStructure and emaFast > emaSlow and spreadAbs > atr * trendSpreadAtr
trendDownRegime = bearBias and bearStructure and emaFast < emaSlow and spreadAbs > atr * trendSpreadAtr
rangeRegime = recentRange <= atr * rangeRegimeAtr and spreadAbs <= atr * trendSpreadAtr * 1.2
newsRegime = barRange >= atr * newsBarAtr
expansionRegime = not newsRegime and barRange >= atr * expansionBarAtr

regimeText = newsRegime ? "Abnormal Volatility" :
     trendUpRegime ? "Trend Day Bull" :
     trendDownRegime ? "Trend Day Bear" :
     expansionRegime ? "Expansion Day" :
     rangeRegime ? "Range Day" :
     "Mixed Day"

//==================== SWEEP ENGINE ====================//
bullAsiaSweep = asiaLocked and not na(asiaLow) and low < asiaLow and close > asiaLow
bearAsiaSweep = asiaLocked and not na(asiaHigh) and high > asiaHigh and close < asiaHigh

closeBreakUp = not na(activeResistance) and close > activeResistance + breakBuffer and close > open and displacementOk
closeBreakDown = not na(activeSupport) and close < activeSupport - breakBuffer and close < open and displacementOk

impulseBreakUp = not na(activeResistance) and high > activeResistance + breakBuffer and close > activeResistance and close > open and impulseBodyOk and bullCloseStrength
impulseBreakDown = not na(activeSupport) and low < activeSupport - breakBuffer and close < activeSupport and close < open and impulseBodyOk and bearCloseStrength

weakBreakUp = not na(activeResistance) and high > activeResistance + breakBuffer and close > activeResistance and not closeBreakUp and not impulseBreakUp
weakBreakDown = not na(activeSupport) and low < activeSupport - breakBuffer and close < activeSupport and not closeBreakDown and not impulseBreakDown

buySideSweep = not na(extBSL) and high > extBSL + breakBuffer and close < extBSL
sellSideSweep = not na(extSSL) and low < extSSL - breakBuffer and close > extSSL

sweepReclaimBull = ((not na(activeSupport) and low < activeSupport - breakBuffer and close > activeSupport) or bullAsiaSweep or sellSideSweep) and close > open and lowerWick > bodySafe * falseBreakWickRatio
sweepReclaimBear = ((not na(activeResistance) and high > activeResistance + breakBuffer and close < activeResistance) or bearAsiaSweep or buySideSweep) and close < open and upperWick > bodySafe * falseBreakWickRatio

bullLiquidityGrab = sellSideSweep or bullAsiaSweep or sweepReclaimBull
bearLiquidityGrab = buySideSweep or bearAsiaSweep or sweepReclaimBear

//==================== SESSION DELIVERY ENGINE ====================//
londonOpen = inLondon and not inLondon[1]
nyOpen = inNewYork and not inNewYork[1]
londonBars = ta.barssince(londonOpen)

judasBull = inLondon and asiaLocked and bullLiquidityGrab and not na(londonBars) and londonBars <= judasBars
judasBear = inLondon and asiaLocked and bearLiquidityGrab and not na(londonBars) and londonBars <= judasBars

sessionOk = inLondon or inNewYork
sessionModelText = inAsia ? "Asia Build" :
     judasBull ? "London Judas Bull" :
     judasBear ? "London Judas Bear" :
     inLondon and bullBias ? "London Delivery Bull" :
     inLondon and bearBias ? "London Delivery Bear" :
     inNewYork and bullBias ? "NY Continuation Bull" :
     inNewYork and bearBias ? "NY Continuation Bear" :
     "Off Session"

//==================== STRICT MSS ENGINE ====================//
var bool bullSweepPending = false
var bool bearSweepPending = false
var int bullSweepBar = na
var int bearSweepBar = na
var float bullSweepExtreme = na
var float bearSweepExtreme = na
var float bullBreakLevel = na
var float bearBreakLevel = na

var int ctxDir = 0
var int ctxState = 0
var int ctxBreakType = 0
var float ctxLevel = na
var int ctxBreakBar = na
var float ctxSweepExtreme = na
var int ctxSweepClass = 0

bullGrabEvent = bullLiquidityGrab and not bullLiquidityGrab[1]
bearGrabEvent = bearLiquidityGrab and not bearLiquidityGrab[1]

if bullGrabEvent
    bullSweepPending := true
    bearSweepPending := false
    bullSweepBar := bar_index
    bullSweepExtreme := low
    bullBreakLevel := activeResistance
    ctxDir := 1
    ctxState := 1
    ctxBreakType := 3
    ctxLevel := activeSupport
    ctxBreakBar := bar_index
    ctxSweepExtreme := low
    ctxSweepClass := 1

if bearGrabEvent
    bearSweepPending := true
    bullSweepPending := false
    bearSweepBar := bar_index
    bearSweepExtreme := high
    bearBreakLevel := activeSupport
    ctxDir := -1
    ctxState := 1
    ctxBreakType := 3
    ctxLevel := activeResistance
    ctxBreakBar := bar_index
    ctxSweepExtreme := high
    ctxSweepClass := 1

if bullSweepPending and not na(bullSweepBar) and bar_index - bullSweepBar > sweepTimeoutBars
    bullSweepPending := false
if bearSweepPending and not na(bearSweepBar) and bar_index - bearSweepBar > sweepTimeoutBars
    bearSweepPending := false

bullMssEvent = bullSweepPending and not na(bullBreakLevel) and bar_index > bullSweepBar and close > bullBreakLevel + breakBuffer and displacementOk and bullCloseStrength and (htfBullEntryOk or setupMode == "Aggressive")
bearMssEvent = bearSweepPending and not na(bearBreakLevel) and bar_index > bearSweepBar and close < bearBreakLevel - breakBuffer and displacementOk and bearCloseStrength and (htfBearEntryOk or setupMode == "Aggressive")

bullBms = bullMssEvent and bullStructure
bearBms = bearMssEvent and bearStructure

if bullMssEvent
    bullSweepPending := false
    ctxDir := 1
    ctxState := 2
    ctxBreakType := bullBms ? 2 : 1
    ctxLevel := bullBreakLevel
    ctxBreakBar := bar_index
    ctxSweepExtreme := f_min_na(ctxSweepExtreme, bullSweepExtreme)
    ctxSweepClass := 2

if bearMssEvent
    bearSweepPending := false
    ctxDir := -1
    ctxState := 2
    ctxBreakType := bearBms ? 2 : 1
    ctxLevel := bearBreakLevel
    ctxBreakBar := bar_index
    ctxSweepExtreme := f_max_na(ctxSweepExtreme, bearSweepExtreme)
    ctxSweepClass := 2

longRetest = ctxDir == 1 and ctxState >= 2 and not na(ctxLevel) and low <= ctxLevel + shallowRetestBuffer and close >= ctxLevel
shortRetest = ctxDir == -1 and ctxState >= 2 and not na(ctxLevel) and high >= ctxLevel - shallowRetestBuffer and close <= ctxLevel

if longRetest and ctxState < 3
    ctxState := 3
if shortRetest and ctxState < 3
    ctxState := 3

longRun = ctxDir == 1 and ctxState >= 2 and not na(ctxLevel) and close > ctxLevel + atr * continuationLiftAtr and ta.lowest(close, continuationBars) > ctxLevel
shortRun = ctxDir == -1 and ctxState >= 2 and not na(ctxLevel) and close < ctxLevel - atr * continuationLiftAtr and ta.highest(close, continuationBars) < ctxLevel

if longRun
    ctxState := ctxState >= 3 ? 5 : 4
    ctxSweepClass := 2
if shortRun
    ctxState := ctxState >= 3 ? 5 : 4
    ctxSweepClass := 2

if ctxDir == 1 and ctxState >= 2 and not na(ctxLevel) and close < ctxLevel - holdBuffer
    ctxState := 6
if ctxDir == -1 and ctxState >= 2 and not na(ctxLevel) and close > ctxLevel + holdBuffer
    ctxState := 6

stateText = ctxState == 1 ? "Liquidity Grab" :
     ctxState == 2 ? "MSS / BMS Confirmed" :
     ctxState == 3 ? "Retested" :
     ctxState == 4 ? "Liquidity Run" :
     ctxState == 5 ? "Delivering" :
     ctxState == 6 ? "Failed" :
     "Idle"

breakClassText = ctxBreakType == 1 ? "MSS" :
     ctxBreakType == 2 ? "BMS" :
     ctxBreakType == 3 ? "Grab / Reclaim" :
     weakBreakUp or weakBreakDown ? "Weak Break" :
     "None"

mssText = bullMssEvent ? (bullBms ? "Bullish BMS" : "Bullish MSS") :
     bearMssEvent ? (bearBms ? "Bearish BMS" : "Bearish MSS") :
     "No MSS"

sweepText = ctxSweepClass == 1 ? "Liquidity Grab" : ctxSweepClass == 2 ? "Liquidity Run" : "None"

//==================== POI ENGINE ====================//
var float bullObLow = na
var float bullObHigh = na
var bool bullObActive = false
var bool bullObMitigated = false
var int bullObBar = na

var float bearObLow = na
var float bearObHigh = na
var bool bearObActive = false
var bool bearObMitigated = false
var int bearObBar = na

var float bullFvgLow = na
var float bullFvgHigh = na
var bool bullFvgActive = false
var bool bullFvgMitigated = false
var int bullFvgBar = na

var float bearFvgLow = na
var float bearFvgHigh = na
var bool bearFvgActive = false
var bool bearFvgMitigated = false
var int bearFvgBar = na

if bullMssEvent and close[1] < open[1]
    bullObLow := low[1]
    bullObHigh := high[1]
    bullObActive := true
    bullObMitigated := false
    bullObBar := bar_index

if bearMssEvent and close[1] > open[1]
    bearObLow := low[1]
    bearObHigh := high[1]
    bearObActive := true
    bearObMitigated := false
    bearObBar := bar_index

bullFvgNew = bar_index > 2 and low > high[2] and (low - high[2]) >= atr * minFvgAtr
bearFvgNew = bar_index > 2 and high < low[2] and (low[2] - high) >= atr * minFvgAtr

if bullFvgNew
    bullFvgLow := high[2]
    bullFvgHigh := low
    bullFvgActive := true
    bullFvgMitigated := false
