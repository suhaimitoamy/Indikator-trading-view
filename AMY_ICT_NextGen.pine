//@version=5
indicator("AMY ICT NextGen Market Mapping", overlay=true, max_boxes_count=250, max_lines_count=300, max_labels_count=250, max_bars_back=3000)

// ============================================================================
// TYPES
// ============================================================================
type amyFvg
    float top
    float bot
    int dir
    box bx
    bool active

type amyOb
    float top
    float bot
    int dir
    box bx
    bool active

// ============================================================================
// INPUTS
// ============================================================================
grpCore = "1. Core"
tz = input.string("Asia/Makassar", "Timezone", group=grpCore)
asiaSess = input.session("0600-1400", "Asia Session", group=grpCore)
londonSess = input.session("1400-1800", "London Session", group=grpCore)
nySess = input.session("1930-0400", "New York Session", group=grpCore)
showAsia = input.bool(true, "Show Asia High / Low", group=grpCore)
showLiquidity = input.bool(true, "Show Liquidity", group=grpCore)
showStructure = input.bool(true, "Show BOS / MSS", group=grpCore)
structureHistory = input.int(3, "Visible BOS / MSS", minval=1, maxval=10, group=grpCore)
showDashboard = input.bool(true, "Show Unified Dashboard", group=grpCore)

grpCtx = "2. Context"
htf = input.timeframe("240", "HTF Bias", group=grpCtx)
htfEmaLen = input.int(20, "HTF EMA Length", minval=1, group=grpCtx)
pdLookback = input.int(80, "Premium / Discount Lookback", minval=20, maxval=300, group=grpCtx)
atrLen = input.int(14, "ATR Length", minval=1, group=grpCtx)

grpEma = "3. EMA"
showEma = input.bool(true, "Show EMA", group=grpEma)
ema1Len = input.int(21, "EMA 1 Length", minval=1, group=grpEma)
ema2Len = input.int(34, "EMA 2 Length", minval=1, group=grpEma)
ema3Len = input.int(90, "EMA 3 Length", minval=1, group=grpEma)

grpStruct = "4. Structure"
swingLen = input.int(4, "Swing Length", minval=1, maxval=20, group=grpStruct)

grpSR = "5. Support Resistance"
showSRBoxes = input.bool(true, "Show Support / Resistance", group=grpSR)
srBoxAtrPad = input.float(0.20, "Zone Thickness ATR", minval=0.05, maxval=2.0, step=0.05, group=grpSR)
srBoxExtend = input.int(55, "Zone Extend Bars", minval=10, maxval=200, group=grpSR)
showSRLabels = input.bool(true, "Show Zone Text", group=grpSR)

grpPoi = "6. ICT Base OB / FVG"
showFvg = input.bool(true, "Show FVG", group=grpPoi)
fvgVisible = input.int(3, "Visible FVG Each Direction", minval=1, maxval=10, group=grpPoi)
fvgExtend = input.int(12, "FVG Extend Bars", minval=2, maxval=100, group=grpPoi)
showOb = input.bool(true, "Show Order Blocks", group=grpPoi)
obSwingLen = input.int(10, "OB Swing Lookback", minval=3, maxval=50, group=grpPoi)
obVisible = input.int(2, "Visible OB Each Direction", minval=1, maxval=10, group=grpPoi)
obExtend = input.int(16, "OB Extend Bars", minval=2, maxval=100, group=grpPoi)
obUseBody = input.bool(true, "Use Candle Body", group=grpPoi)
poiNearAtr = input.float(0.35, "Near POI ATR", minval=0.05, maxval=2.0, step=0.05, group=grpPoi)

grpEntry = "7. Entry Map"
showEntryMap = input.bool(true, "Show Entry Map", group=grpEntry)
entryProfile = input.string("Auto", "Profile", options=["Auto", "M5", "M15", "H1"], group=grpEntry)
slAtrPad = input.float(0.50, "SL ATR Buffer", minval=0.0, maxval=2.0, step=0.05, group=grpEntry)

// Tuned with walk-forward synthetic XAUUSD January-June 2026.
entrySweepMemoryBars = 48
mappingMargin = 2
mappingReleaseBars = 3

// ============================================================================
// HELPERS
// ============================================================================
f_inSession(sess) =>
    not na(time(timeframe.period, sess, tz))

f_price(x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

f_meter(percent) =>
    safePercent = int(math.max(0, math.min(100, percent)))
    filled = int(math.round(safePercent / 10.0))
    string meter = ""
    for i = 1 to 10
        meter += i <= filled ? "█" : "░"
    meter

// ============================================================================
// SESSION ENGINE
// ============================================================================
inAsia = f_inSession(asiaSess)
inLondon = f_inSession(londonSess)
inNY = f_inSession(nySess)
validSession = inLondon or inNY
sessionText = inAsia ? "ASIA" : inLondon ? "LONDON" : inNY ? "NEW YORK" : "OFF SESSION"

prevAsia = bar_index > 0 ? inAsia[1] : false
asiaStart = inAsia and not prevAsia

var float asiaHigh = na
var float asiaLow = na
var int asiaStartBar = na
var line asiaHighLine = na
var line asiaLowLine = na
var label asiaHighLabel = na
var label asiaLowLabel = na
var bool asiaHighConsumed = false
var bool asiaLowConsumed = false

if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaStartBar := bar_index
    asiaHighConsumed := false
    asiaLowConsumed := false
    if not na(asiaHighLine)
        line.delete(asiaHighLine)
        asiaHighLine := na
    if not na(asiaLowLine)
        line.delete(asiaLowLine)
        asiaLowLine := na
    if not na(asiaHighLabel)
        label.delete(asiaHighLabel)
        asiaHighLabel := na
    if not na(asiaLowLabel)
        label.delete(asiaLowLabel)
        asiaLowLabel := na
else if inAsia
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)

if showAsia and not na(asiaHigh) and not na(asiaLow)
    asiaLeft = na(asiaStartBar) ? bar_index : asiaStartBar
    if na(asiaHighLine)
        asiaHighLine := line.new(asiaLeft, asiaHigh, bar_index + 1, asiaHigh, extend=extend.right, color=color.new(color.purple, 10), width=1)
    if na(asiaLowLine)
        asiaLowLine := line.new(asiaLeft, asiaLow, bar_index + 1, asiaLow, extend=extend.right, color=color.new(color.purple, 10), width=1)
    line.set_xy1(asiaHighLine, asiaLeft, asiaHigh)
    line.set_xy2(asiaHighLine, bar_index + 1, asiaHigh)
    line.set_xy1(asiaLowLine, asiaLeft, asiaLow)
    line.set_xy2(asiaLowLine, bar_index + 1, asiaLow)
    if na(asiaHighLabel)
        asiaHighLabel := label.new(bar_index + 3, asiaHigh, "ASIA HIGH", style=label.style_label_left, color=color.rgb(96, 74, 128), textcolor=color.white, size=size.tiny)
    if na(asiaLowLabel)
        asiaLowLabel := label.new(bar_index + 3, asiaLow, "ASIA LOW", style=label.style_label_left, color=color.rgb(96, 74, 128), textcolor=color.white, size=size.tiny)
    label.set_xy(asiaHighLabel, bar_index + 3, asiaHigh)
    label.set_xy(asiaLowLabel, bar_index + 3, asiaLow)
else if not showAsia
    if not na(asiaHighLine)
        line.delete(asiaHighLine)
        asiaHighLine := na
    if not na(asiaLowLine)
        line.delete(asiaLowLine)
        asiaLowLine := na
    if not na(asiaHighLabel)
        label.delete(asiaHighLabel)
        asiaHighLabel := na
    if not na(asiaLowLabel)
        label.delete(asiaLowLabel)
        asiaLowLabel := na

// ============================================================================
// CONTEXT + EMA
// ============================================================================
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead=barmerge.lookahead_on)
htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_on)

biasBull = not na(htfClose) and not na(htfEma) and htfClose > htfEma
biasBear = not na(htfClose) and not na(htfEma) and htfClose < htfEma
biasText = biasBull ? "BULL" : biasBear ? "BEAR" : "NEUTRAL"

ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
ema3 = ta.ema(close, ema3Len)
emaBull = ema1 > ema2 and ema2 > ema3
emaBear = ema1 < ema2 and ema2 < ema3

plot(showEma ? ema1 : na, "EMA 1", color=color.new(color.aqua, 0), linewidth=1)
plot(showEma ? ema2 : na, "EMA 2", color=color.new(color.orange, 0), linewidth=1)
plot(showEma ? ema3 : na, "EMA 3", color=color.new(color.purple, 0), linewidth=2)

atr = ta.atr(atrLen)
body = math.abs(close - open)
barRange = math.max(high - low, syminfo.mintick)
bodyRatio = body / barRange
meanBody = ta.sma(body, math.max(3, swingLen))
compactBody = high - math.max(close, open) < body * 0.36 and math.min(close, open) - low < body * 0.36
displacementBull = close > open and body > meanBody and compactBody and bodyRatio >= 0.45
displacementBear = close < open and body > meanBody and compactBody and bodyRatio >= 0.45

pdHigh = ta.highest(high, pdLookback)
pdLow = ta.lowest(low, pdLookback)
pdEq = math.avg(pdHigh, pdLow)
inDiscount = close < pdEq
inPremium = close > pdEq
rangeText = inDiscount ? "DISCOUNT" : inPremium ? "PREMIUM" : "EQUILIBRIUM"
plot(pdEq, "PD EQ", color=color.new(color.gray, 82), linewidth=1)

// ============================================================================
// STRUCTURE + LIQUIDITY ENGINE
// ============================================================================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na
var line bslLine = na
var line sslLine = na
var label bslLabel = na
var label sslLabel = na
var bool bslConsumed = false
var bool sslConsumed = false
var bool bslBroken = false
var bool sslBroken = false
var string trend = "NEUTRAL"
var array<line> structureLines = array.new<line>()
var array<label> structureLabels = array.new<label>()
var array<label> sweepLabels = array.new<label>()

if not na(ph)
    lastHigh := ph
    lastHighBar := bar_index - swingLen
    bslConsumed := false
    bslBroken := false
    if not na(bslLine)
        line.delete(bslLine)
        bslLine := na
    if not na(bslLabel)
        label.delete(bslLabel)
        bslLabel := na
    if showLiquidity
        bslLine := line.new(lastHighBar, lastHigh, bar_index + 80, lastHigh, color=color.new(color.red, 25), style=line.style_dashed, width=1)
        bslLabel := label.new(lastHighBar, lastHigh, "BSL", style=label.style_label_down, color=color.new(color.red, 68), textcolor=color.white, size=size.tiny)

if not na(pl)
    lastLow := pl
    lastLowBar := bar_index - swingLen
    sslConsumed := false
    sslBroken := false
    if not na(sslLine)
        line.delete(sslLine)
        sslLine := na
    if not na(sslLabel)
        label.delete(sslLabel)
        sslLabel := na
    if showLiquidity
        sslLine := line.new(lastLowBar, lastLow, bar_index + 80, lastLow, color=color.new(color.green, 25), style=line.style_dashed, width=1)
        sslLabel := label.new(lastLowBar, lastLow, "SSL", style=label.style_label_up, color=color.new(color.green, 68), textcolor=color.white, size=size.tiny)

if showLiquidity
    if not na(bslLine)
        line.set_x2(bslLine, bar_index + 80)
    if not na(sslLine)
        line.set_x2(sslLine, bar_index + 80)
else
    if not na(bslLine)
        line.delete(bslLine)
        bslLine := na
    if not na(sslLine)
        line.delete(sslLine)
        sslLine := na
    if not na(bslLabel)
        label.delete(bslLabel)
        bslLabel := na
    if not na(sslLabel)
        label.delete(sslLabel)
        sslLabel := na

newBslSweep = not bslConsumed and not na(lastHigh) and high > lastHigh and close < lastHigh and barstate.isconfirmed
newSslSweep = not sslConsumed and not na(lastLow) and low < lastLow and close > lastLow and barstate.isconfirmed
newAsiaHighSweep = validSession and not inAsia and not asiaHighConsumed and not na(asiaHigh) and high > asiaHigh and close < asiaHigh and barstate.isconfirmed
newAsiaLowSweep = validSession and not inAsia and not asiaLowConsumed and not na(asiaLow) and low < asiaLow and close > asiaLow and barstate.isconfirmed

var int lastBuySweepBar = na
var int lastSellSweepBar = na
if newBslSweep
    bslConsumed := true
    lastBuySweepBar := bar_index
if newSslSweep
    sslConsumed := true
    lastSellSweepBar := bar_index
if newAsiaHighSweep
    asiaHighConsumed := true
    lastBuySweepBar := bar_index
if newAsiaLowSweep
    asiaLowConsumed := true
    lastSellSweepBar := bar_index

recentBuySweep = not na(lastBuySweepBar) and bar_index - lastBuySweepBar <= entrySweepMemoryBars
recentSellSweep = not na(lastSellSweepBar) and bar_index - lastSellSweepBar <= entrySweepMemoryBars
liqText = recentSellSweep ? "SELLSIDE SWEPT" : recentBuySweep ? "BUYSIDE SWEPT" : "WAITING"

label newSweepLabel = na
if showLiquidity
    if newBslSweep
        newSweepLabel := label.new(bar_index, high, "×", style=label.style_none, textcolor=color.red, size=size.small)
    else if newSslSweep
        newSweepLabel := label.new(bar_index, low, "×", style=label.style_none, textcolor=color.lime, size=size.small)
    else if newAsiaHighSweep
        newSweepLabel := label.new(bar_index, high, "◆", style=label.style_none, textcolor=color.purple, size=size.tiny)
    else if newAsiaLowSweep
        newSweepLabel := label.new(bar_index, low, "◆", style=label.style_none, textcolor=color.purple, size=size.tiny)

if not na(newSweepLabel)
    sweepLabels.unshift(newSweepLabel)
    if sweepLabels.size() > 3
        oldSweepLabel = sweepLabels.pop()
        label.delete(oldSweepLabel)

rawBreakBull = not bslBroken and not na(lastHigh) and close > lastHigh and close[1] <= lastHigh and barstate.isconfirmed
rawBreakBear = not sslBroken and not na(lastLow) and close < lastLow and close[1] >= lastLow and barstate.isconfirmed
mssBull = rawBreakBull and trend != "BULL"
mssBear = rawBreakBear and trend != "BEAR"
bosBull = rawBreakBull and trend == "BULL"
bosBear = rawBreakBear and trend == "BEAR"

if rawBreakBull
    trend := "BULL"
    bslBroken := true
if rawBreakBear
    trend := "BEAR"
    sslBroken := true

structureEvent = mssBull or mssBear or bosBull or bosBear
if showStructure and structureEvent
    bullishStructure = mssBull or bosBull
    structurePrice = bullishStructure ? lastHigh : lastLow
    structureStart = bullishStructure ? lastHighBar : lastLowBar
    structureText = mssBull or mssBear ? "MSS" : "BOS"
    structureColor = bullishStructure ? color.lime : color.red
    newStructureLine = line.new(structureStart, structurePrice, bar_index, structurePrice, color=structureColor, width=1)
    structureMid = int(math.round(math.avg(structureStart, bar_index)))
    newStructureLabel = label.new(structureMid, structurePrice, structureText, style=label.style_none, textcolor=structureColor, size=size.tiny)
    structureLines.unshift(newStructureLine)
    structureLabels.unshift(newStructureLabel)
    if structureLines.size() > structureHistory
        oldStructureLine = structureLines.pop()
        line.delete(oldStructureLine)
    if structureLabels.size() > structureHistory
        oldStructureLabel = structureLabels.pop()
        label.delete(oldStructureLabel)

if not showStructure
    if structureLines.size() > 0
        for i = structureLines.size() - 1 to 0
            line.delete(structureLines.pop())
    if structureLabels.size() > 0
        for i = structureLabels.size() - 1 to 0
            label.delete(structureLabels.pop())

// ============================================================================
// SUPPORT / RESISTANCE
// ============================================================================
var box resistanceBox = na
var box supportBox = na
resTop = not na(lastHigh) ? lastHigh + atr * srBoxAtrPad : na
resBot = not na(lastHigh) ? lastHigh - atr * srBoxAtrPad : na
supTop = not na(lastLow) ? lastLow + atr * srBoxAtrPad : na
supBot = not na(lastLow) ? lastLow - atr * srBoxAtrPad : na
resText = showSRLabels and not na(lastHigh) ? "Resistance\n" + f_price(lastHigh) : ""
supText = showSRLabels and not na(lastLow) ? "Support\n" + f_price(lastLow) : ""

if showSRBoxes and not na(lastHigh) and not na(lastHighBar)
    if na(resistanceBox)
        resistanceBox := box.new(lastHighBar, resTop, bar_index + srBoxExtend, resBot, bgcolor=color.new(color.purple, 82), border_color=color.new(color.purple, 55), text=resText, text_color=color.purple, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)
    else
        box.set_lefttop(resistanceBox, lastHighBar, resTop)
        box.set_rightbottom(resistanceBox, bar_index + srBoxExtend, resBot)
        box.set_text(resistanceBox, resText)
else if not na(resistanceBox)
    box.delete(resistanceBox)
    resistanceBox := na

if showSRBoxes and not na(lastLow) and not na(lastLowBar)
    if na(supportBox)
        supportBox := box.new(lastLowBar, supTop, bar_index + srBoxExtend, supBot, bgcolor=color.new(color.blue, 84), border_color=color.new(color.blue, 58), text=supText, text_color=color.blue, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)
    else
        box.set_lefttop(supportBox, lastLowBar, supTop)
        box.set_rightbottom(supportBox, bar_index + srBoxExtend, supBot)
        box.set_text(supportBox, supText)
else if not na(supportBox)
    box.delete(supportBox)
    supportBox := na

// ============================================================================
// ICT BASE FVG
// ============================================================================
var array<amyFvg> bullFvgs = array.new<amyFvg>()
var array<amyFvg> bearFvgs = array.new<amyFvg>()

fvgBull = displacementBull[1] and low > high[2]
fvgBear = displacementBear[1] and high < low[2]

if showFvg and fvgBull
    fvgTop = low
    fvgBot = high[2]
    if fvgBull[1] and bullFvgs.size() > 0
        latestBullFvg = bullFvgs.get(0)
        latestBullFvg.top := fvgTop
        latestBullFvg.bot := fvgBot
        latestBullFvg.active := true
        box.set_lefttop(latestBullFvg.bx, bar_index - 2, fvgTop)
        box.set_rightbottom(latestBullFvg.bx, bar_index + fvgExtend, fvgBot)
        bullFvgs.set(0, latestBullFvg)
    else
        newBullFvgBox = box.new(bar_index - 2, fvgTop, bar_index + fvgExtend, fvgBot, bgcolor=color.new(color.lime, 90), border_color=color.new(color.lime, 65), text="FVG", text_color=color.new(color.lime, 35), text_size=size.tiny, text_halign=text.align_right)
        bullFvgs.unshift(amyFvg.new(fvgTop, fvgBot, 1, newBullFvgBox, true))
        if bullFvgs.size() > fvgVisible
            oldBullFvg = bullFvgs.pop()
            box.delete(oldBullFvg.bx)

if showFvg and fvgBear
    fvgTop = low[2]
    fvgBot = high
    if fvgBear[1] and bearFvgs.size() > 0
        latestBearFvg = bearFvgs.get(0)
        latestBearFvg.top := fvgTop
        latestBearFvg.bot := fvgBot
        latestBearFvg.active := true
        box.set_lefttop(latestBearFvg.bx, bar_index - 2, fvgTop)
        box.set_rightbottom(latestBearFvg.bx, bar_index + fvgExtend, fvgBot)
        bearFvgs.set(0, latestBearFvg)
    else
        newBearFvgBox = box.new(bar_index - 2, fvgTop, bar_index + fvgExtend, fvgBot, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 65), text="FVG", text_color=color.new(color.red, 35), text_size=size.tiny, text_halign=text.align_right)
        bearFvgs.unshift(amyFvg.new(fvgTop, fvgBot, -1, newBearFvgBox, true))
        if bearFvgs.size() > fvgVisible
            oldBearFvg = bearFvgs.pop()
            box.delete(oldBearFvg.bx)

if bullFvgs.size() > 0
    for i = bullFvgs.size() - 1 to 0
        bullFvgItem = bullFvgs.get(i)
        if bullFvgItem.active
            box.set_right(bullFvgItem.bx, bar_index + fvgExtend)
            if low < bullFvgItem.top
                box.set_border_style(bullFvgItem.bx, line.style_dashed)
            if low < bullFvgItem.bot
                box.delete(bullFvgItem.bx)
                bullFvgs.remove(i)

if bearFvgs.size() > 0
    for i = bearFvgs.size() - 1 to 0
        bearFvgItem = bearFvgs.get(i)
        if bearFvgItem.active
            box.set_right(bearFvgItem.bx, bar_index + fvgExtend)
            if high > bearFvgItem.bot
                box.set_border_style(bearFvgItem.bx, line.style_dashed)
            if high > bearFvgItem.top
                box.delete(bearFvgItem.bx)
                bearFvgs.remove(i)

if not showFvg
    if bullFvgs.size() > 0
        for i = bullFvgs.size() - 1 to 0
            hiddenBullFvg = bullFvgs.pop()
            box.delete(hiddenBullFvg.bx)
    if bearFvgs.size() > 0
        for i = bearFvgs.size() - 1 to 0
            hiddenBearFvg = bearFvgs.pop()
            box.delete(hiddenBearFvg.bx)

// ============================================================================
// ICT BASE ORDER BLOCK
// ============================================================================
var array<amyOb> bullObs = array.new<amyOb>()
var array<amyOb> bearObs = array.new<amyOb>()
var int obOs = 0
var float obSwingHigh = na
var float obSwingLow = na
var int obSwingHighBar = na
var int obSwingLowBar = na
var bool obSwingHighCrossed = false
var bool obSwingLowCrossed = false

obUpper = ta.highest(high, obSwingLen)
obLower = ta.lowest(low, obSwingLen)
if bar_index >= obSwingLen
    obOs := high[obSwingLen] > obUpper ? 0 : low[obSwingLen] < obLower ? 1 : obOs

if obOs == 0 and obOs[1] != 0
    obSwingHigh := high[obSwingLen]
    obSwingHighBar := bar_index - obSwingLen
    obSwingHighCrossed := false

if obOs == 1 and obOs[1] != 1
    obSwingLow := low[obSwingLen]
    obSwingLowBar := bar_index - obSwingLen
    obSwingLowCrossed := false

newBullOb = showOb and not na(obSwingHigh) and close > obSwingHigh and not obSwingHighCrossed
newBearOb = showOb and not na(obSwingLow) and close < obSwingLow and not obSwingLowCrossed

if newBullOb
    obSwingHighCrossed := true
    scanBars = math.min(bar_index - obSwingHighBar - 1, 3000)
    float bullObTop = na
    float bullObBot = na
    int bullObOffset = na
    if scanBars > 0
        for i = 1 to scanBars
            candidateBot = obUseBody ? math.min(open[i], close[i]) : low[i]
            candidateTop = obUseBody ? math.max(open[i], close[i]) : high[i]
            if na(bullObBot) or candidateBot < bullObBot
                bullObBot := candidateBot
                bullObTop := candidateTop
                bullObOffset := i
    if not na(bullObTop) and not na(bullObBot) and not na(bullObOffset)
        newBullObBox = box.new(bar_index - bullObOffset, bullObTop, bar_index + obExtend, bullObBot, bgcolor=color.new(color.blue, 90), border_color=color.new(color.blue, 40), text="+OB", text_color=color.new(color.blue, 5), text_size=size.tiny, text_halign=text.align_right)
        bullObs.unshift(amyOb.new(bullObTop, bullObBot, 1, newBullObBox, true))
        if bullObs.size() > obVisible
            oldBullOb = bullObs.pop()
            box.delete(oldBullOb.bx)

if newBearOb
    obSwingLowCrossed := true
    scanBars = math.min(bar_index - obSwingLowBar - 1, 3000)
    float bearObTop = na
    float bearObBot = na
    int bearObOffset = na
    if scanBars > 0
        for i = 1 to scanBars
            candidateTop = obUseBody ? math.max(open[i], close[i]) : high[i]
            candidateBot = obUseBody ? math.min(open[i], close[i]) : low[i]
            if na(bearObTop) or candidateTop > bearObTop
                bearObTop := candidateTop
                bearObBot := candidateBot
                bearObOffset := i
    if not na(bearObTop) and not na(bearObBot) and not na(bearObOffset)
        newBearObBox = box.new(bar_index - bearObOffset, bearObTop, bar_index + obExtend, bearObBot, bgcolor=color.new(color.red, 91), border_color=color.new(color.red, 40), text="-OB", text_color=color.new(color.red, 5), text_size=size.tiny, text_halign=text.align_right)
        bearObs.unshift(amyOb.new(bearObTop, bearObBot, -1, newBearObBox, true))
        if bearObs.size() > obVisible
            oldBearOb = bearObs.pop()
            box.delete(oldBearOb.bx)

if bullObs.size() > 0
    for i = bullObs.size() - 1 to 0
        bullObItem = bullObs.get(i)
        box.set_right(bullObItem.bx, bar_index + obExtend)
        if close < bullObItem.bot
            box.delete(bullObItem.bx)
            bullObs.remove(i)

if bearObs.size() > 0
    for i = bearObs.size() - 1 to 0
        bearObItem = bearObs.get(i)
        box.set_right(bearObItem.bx, bar_index + obExtend)
        if close > bearObItem.top
            box.delete(bearObItem.bx)
            bearObs.remove(i)

if not showOb
    if bullObs.size() > 0
        for i = bullObs.size() - 1 to 0
            hiddenBullOb = bullObs.pop()
            box.delete(hiddenBullOb.bx)
    if bearObs.size() > 0
        for i = bearObs.size() - 1 to 0
            hiddenBearOb = bearObs.pop()
            box.delete(hiddenBearOb.bx)

// ============================================================================
// POI PROXIMITY
// ============================================================================
nearBullFvg = false
nearBearFvg = false
nearBullOb = false
nearBearOb = false

if bullFvgs.size() > 0
    for i = 0 to bullFvgs.size() - 1
        item = bullFvgs.get(i)
        if low <= item.top + atr * poiNearAtr and high >= item.bot - atr * 0.10
            nearBullFvg := true

if bearFvgs.size() > 0
    for i = 0 to bearFvgs.size() - 1
        item = bearFvgs.get(i)
        if high >= item.bot - atr * poiNearAtr and low <= item.top + atr * 0.10
            nearBearFvg := true

if bullObs.size() > 0
    for i = 0 to bullObs.size() - 1
        item = bullObs.get(i)
        if low <= item.top + atr * poiNearAtr and high >= item.bot - atr * 0.10
            nearBullOb := true

if bearObs.size() > 0
    for i = 0 to bearObs.size() - 1
        item = bearObs.get(i)
        if high >= item.bot - atr * poiNearAtr and low <= item.top + atr * 0.10
            nearBearOb := true

nearBullPoi = nearBullFvg or nearBullOb
nearBearPoi = nearBearFvg or nearBearOb
bullPoiActive = bullFvgs.size() > 0 or bullObs.size() > 0
bearPoiActive = bearFvgs.size() > 0 or bearObs.size() > 0
poiText = nearBullPoi and nearBearPoi ? "BOTH POI NEAR" : nearBullPoi ? "NEAR BULL POI" : nearBearPoi ? "NEAR BEAR POI" : bullPoiActive and bearPoiActive ? "BULL + BEAR ACTIVE" : bullPoiActive ? "BULL POI ACTIVE" : bearPoiActive ? "BEAR POI ACTIVE" : "NONE"

// ============================================================================
// STABLE MARKET MAPPING
// ============================================================================
mappingIsM5 = timeframe.isminutes and timeframe.multiplier <= 5
mappingIsM15 = timeframe.isminutes and timeframe.multiplier > 5 and timeframe.multiplier <= 30
mappingSweepBars = mappingIsM5 or mappingIsM15 ? 48 : 12
mappingThreshold = mappingIsM5 ? 4 : 5
mappingConfirmBars = mappingIsM15 ? 1 : 4
mappingHoldFloor = mappingIsM15 ? 4 : 3
mappingRecentBuySweep = not na(lastBuySweepBar) and bar_index - lastBuySweepBar <= mappingSweepBars
mappingRecentSellSweep = not na(lastSellSweepBar) and bar_index - lastSellSweepBar <= mappingSweepBars

scoreBull = 0
if biasBull
    scoreBull += 1
if validSession
    scoreBull += 1
if inDiscount
    scoreBull += 1
if mappingRecentSellSweep
    scoreBull += 1
if trend == "BULL"
    scoreBull += 1
if nearBullPoi
    scoreBull += 1
if emaBull
    scoreBull += 1

scoreBear = 0
if biasBear
    scoreBear += 1
if validSession
    scoreBear += 1
if inPremium
    scoreBear += 1
if mappingRecentBuySweep
    scoreBear += 1
if trend == "BEAR"
    scoreBear += 1
if nearBearPoi
    scoreBear += 1
if emaBear
    scoreBear += 1

rawBullContext = scoreBull >= mappingThreshold and scoreBull >= scoreBear + mappingMargin
rawBearContext = scoreBear >= mappingThreshold and scoreBear >= scoreBull + mappingMargin

var int mappingDir = 0
var int mappingWeakBars = 0
var int bullContextConfirm = 0
var int bearContextConfirm = 0

bullContextConfirm := rawBullContext ? bullContextConfirm + 1 : 0
bearContextConfirm := rawBearContext ? bearContextConfirm + 1 : 0
bullContextReady = bullContextConfirm >= mappingConfirmBars
bearContextReady = bearContextConfirm >= mappingConfirmBars

if mappingDir == 0
    if bullContextReady
        mappingDir := 1
        mappingWeakBars := 0
    else if bearContextReady
        mappingDir := -1
        mappingWeakBars := 0
else if mappingDir == 1
    if bearContextReady
        mappingDir := -1
        mappingWeakBars := 0
    else if scoreBull < mappingHoldFloor
        mappingWeakBars += 1
        if mappingWeakBars >= mappingReleaseBars
            mappingDir := 0
            mappingWeakBars := 0
    else
        mappingWeakBars := 0
else
    if bullContextReady
        mappingDir := 1
        mappingWeakBars := 0
    else if scoreBear < mappingHoldFloor
        mappingWeakBars += 1
        if mappingWeakBars >= mappingReleaseBars
            mappingDir := 0
            mappingWeakBars := 0
    else
        mappingWeakBars := 0

bullContextPercent = int(math.round(scoreBull * 100.0 / 7.0))
bearContextPercent = int(math.round(scoreBear * 100.0 / 7.0))
mappingStatus = mappingDir == 1 ? "BULLISH CONTEXT" : mappingDir == -1 ? "BEARISH CONTEXT" : "NEUTRAL"
mappingColor = mappingDir == 1 ? color.lime : mappingDir == -1 ? color.red : color.yellow

// ============================================================================
// COMPACT ENTRY MAP — ONE LIVE SETUP ONLY
// ============================================================================
isM5Auto = timeframe.isminutes and timeframe.multiplier <= 5
isM15Auto = timeframe.isminutes and timeframe.multiplier > 5 and timeframe.multiplier <= 30
profileM5 = entryProfile == "M5" or entryProfile == "Auto" and isM5Auto
profileM15 = entryProfile == "M15" or entryProfile == "Auto" and isM15Auto
profileH1 = entryProfile == "H1" or entryProfile == "Auto" and not isM5Auto and not isM15Auto

profileText = profileM5 ? "M5" : profileM15 ? "M15" : "H1"
profileExpiryBars = profileM5 ? 96 : profileM15 ? 72 : 36
profileTp2R = profileM15 ? 1.75 : 2.0
effectiveSlAtrPad = entryProfile == "Auto" and profileH1 ? 0.30 : slAtrPad
profileNeedsPoi = profileM5 or profileH1
profileBullTrigger = profileM5 ? mssBull : mssBull or bosBull
profileBearTrigger = profileM5 ? mssBear : mssBear or bosBear

var bool setupLive = false
var bool setupTp1Hit = false
var int setupDir = 0
var int setupStartBar = na
var string setupState = "WAITING"
var float setupEntry = na
var float setupSl = na
var float setupTp1 = na
var float setupTp2 = na
var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var label entryLabel = na
var label slLabel = na
var label tp1Label = na
var label tp2Label = na

if setupLive and bar_index > setupStartBar
    slHit = setupDir == 1 ? low <= setupSl : high >= setupSl
    tp1HitNow = setupDir == 1 ? high >= setupTp1 : low <= setupTp1
    tp2HitNow = setupDir == 1 ? high >= setupTp2 : low <= setupTp2
    beHit = setupDir == 1 ? low <= setupEntry : high >= setupEntry

    if not setupTp1Hit
        if slHit
            setupLive := false
            setupState := "SL HIT"
        else if tp2HitNow
            setupTp1Hit := true
            setupLive := false
            setupState := "TP2 HIT"
        else if tp1HitNow
            setupTp1Hit := true
            setupState := "TP1 HIT / BE"
            setupSl := setupEntry
            if not na(slLine)
                line.set_y1(slLine, setupSl)
                line.set_y2(slLine, setupSl)
            if not na(slLabel)
                label.set_text(slLabel, "BE " + f_price(setupSl))
                label.set_y(slLabel, setupSl)
    else
        if tp2HitNow
            setupLive := false
            setupState := "TP2 HIT"
        else if beHit
            setupLive := false
            setupState := "TP1 / BE"

    if setupLive and bar_index - setupStartBar >= profileExpiryBars
        setupLive := false
        setupState := "EXPIRED"

if setupLive
    visualRight = bar_index + 10
    if not na(entryLine)
        line.set_x2(entryLine, visualRight)
    if not na(slLine)
        line.set_x2(slLine, visualRight)
    if not na(tp1Line)
        line.set_x2(tp1Line, visualRight)
    if not na(tp2Line)
        line.set_x2(tp2Line, visualRight)
    if not na(entryLabel)
        label.set_x(entryLabel, visualRight)
    if not na(slLabel)
        label.set_x(slLabel, visualRight)
    if not na(tp1Label)
        label.set_x(tp1Label, visualRight)
    if not na(tp2Label)
        label.set_x(tp2Label, visualRight)

longFilter = validSession and biasBull and emaBull and recentSellSweep and mappingDir == 1 and (not profileNeedsPoi or nearBullPoi)
shortFilter = validSession and biasBear and emaBear and recentBuySweep and mappingDir == -1 and (not profileNeedsPoi or nearBearPoi)
newLongSetup = showEntryMap and not setupLive and profileBullTrigger and longFilter and not na(lastLow)
newShortSetup = showEntryMap and not setupLive and profileBearTrigger and shortFilter and not na(lastHigh)

if newLongSetup or newShortSetup
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tp1Label)
        label.delete(tp1Label)
    if not na(tp2Label)
        label.delete(tp2Label)

    setupDir := newLongSetup ? 1 : -1
    setupEntry := close
    rawSetupSl = setupDir == 1 ? math.min(low, lastLow) - atr * effectiveSlAtrPad : math.max(high, lastHigh) + atr * effectiveSlAtrPad
    setupRisk = setupDir == 1 ? setupEntry - rawSetupSl : rawSetupSl - setupEntry

    if setupRisk > 0 and setupRisk <= atr * 8.0
        setupSl := rawSetupSl
        setupTp1 := setupEntry + setupDir * setupRisk
        setupTp2 := setupEntry + setupDir * setupRisk * profileTp2R
        setupStartBar := bar_index
        setupTp1Hit := false
        setupLive := true
        setupState := setupDir == 1 ? "LONG ACTIVE" : "SHORT ACTIVE"

        setupRight = bar_index + 10
        entryLine := line.new(bar_index, setupEntry, setupRight, setupEntry, color=color.yellow, width=1)
        slLine := line.new(bar_index, setupSl, setupRight, setupSl, color=color.red, width=1)
        tp1Line := line.new(bar_index, setupTp1, setupRight, setupTp1, color=color.new(color.lime, 20), width=1, style=line.style_dashed)
        tp2Line := line.new(bar_index, setupTp2, setupRight, setupTp2, color=color.lime, width=1)
        entryLabel := label.new(setupRight, setupEntry, "ENTRY " + f_price(setupEntry), style=label.style_label_left, color=color.new(color.yellow, 72), textcolor=color.white, size=size.tiny)
        slLabel := label.new(setupRight, setupSl, "SL " + f_price(setupSl), style=label.style_label_left, color=color.new(color.red, 72), textcolor=color.white, size=size.tiny)
        tp1Label := label.new(setupRight, setupTp1, "TP1 " + f_price(setupTp1), style=label.style_label_left, color=color.new(color.green, 78), textcolor=color.white, size=size.tiny)
        tp2Label := label.new(setupRight, setupTp2, "TP2 " + f_price(setupTp2), style=label.style_label_left, color=color.new(color.green, 68), textcolor=color.white, size=size.tiny)
    else
        setupDir := 0
        setupState := "SKIPPED"

if not showEntryMap
    setupLive := false
    setupState := "HIDDEN"
    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na
    if not na(slLine)
        line.delete(slLine)
        slLine := na
    if not na(tp1Line)
        line.delete(tp1Line)
        tp1Line := na
    if not na(tp2Line)
        line.delete(tp2Line)
        tp2Line := na
    if not na(entryLabel)
        label.delete(entryLabel)
        entryLabel := na
    if not na(slLabel)
        label.delete(slLabel)
        slLabel := na
    if not na(tp1Label)
        label.delete(tp1Label)
        tp1Label := na
    if not na(tp2Label)
        label.delete(tp2Label)
        tp2Label := na

// ============================================================================
// EVENT HISTORY
// ============================================================================
var array<string> eventLog = array.new_string()
string eventName = ""
float eventPrice = na

if mssBull
    eventName := "MSS BULL"
    eventPrice := lastHigh
else if mssBear
    eventName := "MSS BEAR"
    eventPrice := lastLow
else if bosBull
    eventName := "BOS BULL"
    eventPrice := lastHigh
else if bosBear
    eventName := "BOS BEAR"
    eventPrice := lastLow
else if newBslSweep
    eventName := "BSL SWEEP"
    eventPrice := lastHigh
else if newSslSweep
    eventName := "SSL SWEEP"
    eventPrice := lastLow
else if newAsiaHighSweep
    eventName := "ASIA HIGH SWEEP"
    eventPrice := asiaHigh
else if newAsiaLowSweep
    eventName := "ASIA LOW SWEEP"
    eventPrice := asiaLow

if barstate.isconfirmed and str.length(eventName) > 0
    eventLine = str.format_time(time, "HH:mm", tz) + "  " + eventName + " @ " + f_price(eventPrice)
    bool isNewEvent = true
    if eventLog.size() > 0
        isNewEvent := eventLog.get(0) != eventLine
    if isNewEvent
        eventLog.unshift(eventLine)
        if eventLog.size() > 3
            eventLog.pop()

event0 = eventLog.size() > 0 ? eventLog.get(0) : "No confirmed event"
event1 = eventLog.size() > 1 ? eventLog.get(1) : "-"
event2 = eventLog.size() > 2 ? eventLog.get(2) : "-"

// ============================================================================
// UNIFIED DASHBOARD
// ============================================================================
dashHeader = color.rgb(58, 58, 58)
dashBg = color.rgb(86, 86, 86)
dashAlt = color.rgb(74, 74, 74)
dashBorder = color.rgb(120, 120, 120)

var table dashboard = table.new(position.bottom_right, 3, 16, bgcolor=dashBg, border_width=1, border_color=dashBorder)

if barstate.isfirst
    table.merge_cells(dashboard, 0, 0, 2, 0)
    table.merge_cells(dashboard, 0, 1, 2, 1)
    table.merge_cells(dashboard, 1, 2, 2, 2)
    table.merge_cells(dashboard, 1, 3, 2, 3)
    table.merge_cells(dashboard, 1, 4, 2, 4)
    table.merge_cells(dashboard, 1, 5, 2, 5)
    table.merge_cells(dashboard, 1, 6, 2, 6)
    table.merge_cells(dashboard, 1, 7, 2, 7)
    table.merge_cells(dashboard, 1, 8, 2, 8)
    table.merge_cells(dashboard, 0, 12, 2, 12)
    table.merge_cells(dashboard, 0, 13, 2, 13)
    table.merge_cells(dashboard, 0, 14, 2, 14)
    table.merge_cells(dashboard, 0, 15, 2, 15)

if showDashboard and barstate.islast
    table.cell(dashboard, 0, 0, "AMY ICT NEXTGEN — " + timeframe.period + " MARKET MAPPING", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashHeader)
    table.cell(dashboard, 0, 1, "STATUS: " + mappingStatus, text_color=mappingColor, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    table.cell(dashboard, 0, 2, "HTF Bias", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 2, biasText, text_color=biasBull ? color.lime : biasBear ? color.red : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 3, "Session", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 3, sessionText, text_color=validSession ? color.lime : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    table.cell(dashboard, 0, 4, "Structure", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 4, trend, text_color=trend == "BULL" ? color.lime : trend == "BEAR" ? color.red : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 5, "Liquidity", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 5, liqText, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    table.cell(dashboard, 0, 6, "Range", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 6, rangeText, text_color=inDiscount ? color.lime : inPremium ? color.orange : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 7, "OB / FVG", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 7, poiText, text_color=nearBullPoi ? color.lime : nearBearPoi ? color.red : color.silver, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    entrySummary = profileText + " | " + setupState + " | E " + f_price(setupEntry) + " | SL " + f_price(setupSl) + " | T1 " + f_price(setupTp1) + " | T2 " + f_price(setupTp2)
    table.cell(dashboard, 0, 8, "Entry Map", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 8, entrySummary, text_color=setupDir == 1 ? color.lime : setupDir == -1 ? color.red : color.silver, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 9, "Bull", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 9, f_meter(bullContextPercent), text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 2, 9, str.tostring(bullContextPercent) + "%", text_color=color.white, text_size=size.small, bgcolor=dashAlt)

    table.cell(dashboard, 0, 10, "Bear", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 10, f_meter(bearContextPercent), text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 2, 10, str.tostring(bearContextPercent) + "%", text_color=color.white, text_size=size.small, bgcolor=dashBg)

    table.cell(dashboard, 0, 11, "EMA", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 11, str.tostring(ema1Len) + " / " + str.tostring(ema2Len), text_color=color.white, text_size=size.tiny, bgcolor=dashAlt)
    table.cell(dashboard, 2, 11, str.tostring(ema3Len), text_color=color.white, text_size=size.tiny, bgcolor=dashAlt)

    table.cell(dashboard, 0, 12, "EVENT HISTORY", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashHeader)
    table.cell(dashboard, 0, 13, event0, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashBg)
    table.cell(dashboard, 0, 14, event1, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashAlt)
    table.cell(dashboard, 0, 15, event2, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashBg)
else if barstate.islast
    table.clear(dashboard, 0, 0, 2, 15)
