//@version=5
indicator("AMY ICT NextGen Core", overlay=true, max_boxes_count=200, max_lines_count=120, max_labels_count=120)

// ============================================================================
// TYPES
// ============================================================================
type amyOrderBlock
    float top
    float bot
    int leftTime
    int bias
    box bx

type amyFairValueGap
    float top
    float bot
    int leftTime
    int bias
    box topBx
    box botBx

// ============================================================================
// INPUTS
// ============================================================================
grpCore = "1. Core"
tz = input.string("Asia/Makassar", "Timezone", group=grpCore)
asiaSess = input.session("0600-1400", "Asia Session", group=grpCore)
londonSess = input.session("1400-1800", "London Session", group=grpCore)
nySess = input.session("1930-0400", "New York Session", group=grpCore)
showAsia = input.bool(true, "Show Asia High / Low", group=grpCore)
showLiquidity = input.bool(true, "Show Liquidity", group=grpCore)
showStructure = input.bool(true, "Show BOS / MSS", group=grpCore)
showPoi = input.bool(true, "Show Active POI", group=grpCore)
showPanel = input.bool(true, "Show Mini Panel", group=grpCore)
showMappingPanel = input.bool(true, "Show Market Explanation", group=grpCore)

grpCtx = "2. Context"
htf = input.timeframe("240", "HTF Bias", group=grpCtx)
emaLen = input.int(20, "HTF EMA Length", minval=1, group=grpCtx)

grpStruct = "3. Structure"
swingLen = input.int(4, "Swing Length", minval=1, maxval=20, group=grpStruct)
pdLookback = input.int(80, "Premium / Discount Lookback", minval=20, maxval=300, group=grpStruct)
atrLen = input.int(14, "ATR Length", minval=1, group=grpStruct)

grpSR = "4. Support Resistance Boxes"
showSRBoxes = input.bool(true, "Show Support / Resistance Boxes", group=grpSR)
srBoxAtrPad = input.float(0.20, "Box Thickness ATR", minval=0.05, maxval=2.0, step=0.05, group=grpSR)
srBoxExtend = input.int(55, "Box Extend Bars", minval=10, maxval=200, group=grpSR)
showSRLabels = input.bool(true, "Show Support / Resistance Text", group=grpSR)

grpPoi = "5. SMC POI Boxes"
poiMaxBoxes = input.int(3, "Visible OB / FVG Count", minval=1, maxval=10, group=grpPoi)
poiExtendBars = input.int(80, "POI Extend Bars", minval=10, maxval=300, group=grpPoi)
poiNearAtr = input.float(0.80, "POI Near ATR", minval=0.10, maxval=3.0, step=0.05, group=grpPoi)
showObText = input.bool(true, "Show OB Text", group=grpPoi)
showFvgText = input.bool(true, "Show FVG Text", group=grpPoi)

// ============================================================================
// HELPERS
// ============================================================================
f_inSession(sess) =>
    not na(time(timeframe.period, sess, tz))

f_price(x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

f_rightTime(bars) =>
    time + (time - time[1]) * bars

f_meter(percent) =>
    safePercent = int(math.max(0, math.min(100, percent)))
    filled = int(math.round(safePercent / 10.0))
    string meter = ""
    for i = 1 to 10
        meter += i <= filled ? "█" : "░"
    meter

f_lastBearish(lookback) =>
    float zTop = na
    float zBot = na
    int zTime = na
    for i = 1 to lookback
        if na(zTop) and close[i] < open[i]
            zTop := open[i]
            zBot := low[i]
            zTime := time[i]
    [zTop, zBot, zTime]

f_lastBullish(lookback) =>
    float zTop = na
    float zBot = na
    int zTime = na
    for i = 1 to lookback
        if na(zTop) and close[i] > open[i]
            zTop := high[i]
            zBot := open[i]
            zTime := time[i]
    [zTop, zBot, zTime]

// ============================================================================
// CORE ENGINE
// ============================================================================
inAsia = f_inSession(asiaSess)
inLondon = f_inSession(londonSess)
inNY = f_inSession(nySess)
validSession = inLondon or inNY
sessionText = inAsia ? "ASIA" : inLondon ? "LONDON" : inNY ? "NY" : "OFF"

prevAsia = bar_index > 0 ? inAsia[1] : false
asiaStart = inAsia and not prevAsia

var float asiaHigh = na
var float asiaLow = na
var int asiaStartBar = na
var line asiaHighLine = na
var line asiaLowLine = na
var label asiaHighLabel = na
var label asiaLowLabel = na
var bool asiaHighConsumed = false
var bool asiaLowConsumed = false

if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaStartBar := bar_index
    asiaHighConsumed := false
    asiaLowConsumed := false
    if not na(asiaHighLine)
        line.delete(asiaHighLine)
        asiaHighLine := na
    if not na(asiaLowLine)
        line.delete(asiaLowLine)
        asiaLowLine := na
    if not na(asiaHighLabel)
        label.delete(asiaHighLabel)
        asiaHighLabel := na
    if not na(asiaLowLabel)
        label.delete(asiaLowLabel)
        asiaLowLabel := na
else if inAsia
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)

if showAsia and not na(asiaHigh) and not na(asiaLow)
    if na(asiaHighLine)
        asiaHighLine := line.new(na(asiaStartBar) ? bar_index : asiaStartBar, asiaHigh, bar_index + 1, asiaHigh, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.purple, 15), style=line.style_solid, width=1)
    if na(asiaLowLine)
        asiaLowLine := line.new(na(asiaStartBar) ? bar_index : asiaStartBar, asiaLow, bar_index + 1, asiaLow, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.purple, 15), style=line.style_solid, width=1)
    line.set_xy1(asiaHighLine, na(asiaStartBar) ? bar_index : asiaStartBar, asiaHigh)
    line.set_xy2(asiaHighLine, bar_index + 1, asiaHigh)
    line.set_xy1(asiaLowLine, na(asiaStartBar) ? bar_index : asiaStartBar, asiaLow)
    line.set_xy2(asiaLowLine, bar_index + 1, asiaLow)
    if na(asiaHighLabel)
        asiaHighLabel := label.new(bar_index + 3, asiaHigh, "ASIA HIGH", style=label.style_label_left, color=color.new(color.purple, 70), textcolor=color.white, size=size.tiny)
    if na(asiaLowLabel)
        asiaLowLabel := label.new(bar_index + 3, asiaLow, "ASIA LOW", style=label.style_label_left, color=color.new(color.purple, 70), textcolor=color.white, size=size.tiny)
    label.set_xy(asiaHighLabel, bar_index + 3, asiaHigh)
    label.set_xy(asiaLowLabel, bar_index + 3, asiaLow)
else if not showAsia
    if not na(asiaHighLine)
        line.delete(asiaHighLine)
        asiaHighLine := na
    if not na(asiaLowLine)
        line.delete(asiaLowLine)
        asiaLowLine := na
    if not na(asiaHighLabel)
        label.delete(asiaHighLabel)
        asiaHighLabel := na
    if not na(asiaLowLabel)
        label.delete(asiaLowLabel)
        asiaLowLabel := na

// ============================================================================
// CONTEXT ENGINE
// ============================================================================
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead=barmerge.lookahead_off)
htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, emaLen)[1], lookahead=barmerge.lookahead_off)

biasBull = not na(htfClose) and not na(htfEma) and htfClose > htfEma
biasBear = not na(htfClose) and not na(htfEma) and htfClose < htfEma
biasText = biasBull ? "BULL" : biasBear ? "BEAR" : "NEUTRAL"

// ============================================================================
// STRUCTURE ENGINE
// ============================================================================
atr = ta.atr(atrLen)
body = math.abs(close - open)
barRange = math.max(high - low, syminfo.mintick)
bodyRatio = body / barRange
displacementBull = close > open and body >= atr * 0.25 and bodyRatio >= 0.45
displacementBear = close < open and body >= atr * 0.25 and bodyRatio >= 0.45

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na
var line bslLine = na
var line sslLine = na
var label bslLabel = na
var label sslLabel = na
var bool bslConsumed = false
var bool sslConsumed = false
var bool bslBroken = false
var bool sslBroken = false
var array<label> structureLabels = array.new<label>()

if not na(ph)
    lastHigh := ph
    lastHighBar := bar_index - swingLen
    bslConsumed := false
    bslBroken := false
    if not na(bslLine)
        line.delete(bslLine)
        bslLine := na
    if not na(bslLabel)
        label.delete(bslLabel)
        bslLabel := na
    if showLiquidity
        bslLine := line.new(lastHighBar, lastHigh, bar_index + 80, lastHigh, color=color.new(color.red, 25), style=line.style_dashed, width=1)
        bslLabel := label.new(lastHighBar, lastHigh, "BSL", style=label.style_label_down, color=color.new(color.red, 72), textcolor=color.white, size=size.tiny)

if not na(pl)
    lastLow := pl
    lastLowBar := bar_index - swingLen
    sslConsumed := false
    sslBroken := false
    if not na(sslLine)
        line.delete(sslLine)
        sslLine := na
    if not na(sslLabel)
        label.delete(sslLabel)
        sslLabel := na
    if showLiquidity
        sslLine := line.new(lastLowBar, lastLow, bar_index + 80, lastLow, color=color.new(color.green, 25), style=line.style_dashed, width=1)
        sslLabel := label.new(lastLowBar, lastLow, "SSL", style=label.style_label_up, color=color.new(color.green, 72), textcolor=color.white, size=size.tiny)

if showLiquidity
    if not na(bslLine)
        line.set_x2(bslLine, bar_index + 80)
    if not na(sslLine)
        line.set_x2(sslLine, bar_index + 80)
else
    if not na(bslLine)
        line.delete(bslLine)
        bslLine := na
    if not na(sslLine)
        line.delete(sslLine)
        sslLine := na
    if not na(bslLabel)
        label.delete(bslLabel)
        bslLabel := na
    if not na(sslLabel)
        label.delete(sslLabel)
        sslLabel := na

var string trend = "NEUTRAL"
rawBreakBull = not bslBroken and not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
rawBreakBear = not sslBroken and not na(lastLow) and close < lastLow and close[1] >= lastLow
mssBull = rawBreakBull and trend != "BULL" and displacementBull and barstate.isconfirmed
mssBear = rawBreakBear and trend != "BEAR" and displacementBear and barstate.isconfirmed
bosBull = rawBreakBull and trend == "BULL" and displacementBull and barstate.isconfirmed
bosBear = rawBreakBear and trend == "BEAR" and displacementBear and barstate.isconfirmed

if mssBull or bosBull
    trend := "BULL"
    bslBroken := true
if mssBear or bosBear
    trend := "BEAR"
    sslBroken := true

label newStructureLabel = na
if showStructure
    if mssBull
        newStructureLabel := label.new(bar_index, low, "MSS", style=label.style_label_up, color=color.new(color.lime, 10), textcolor=color.black, size=size.tiny)
    else if mssBear
        newStructureLabel := label.new(bar_index, high, "MSS", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny)
    else if bosBull
        newStructureLabel := label.new(bar_index, low, "BOS", style=label.style_label_up, color=color.new(color.green, 35), textcolor=color.white, size=size.tiny)
    else if bosBear
        newStructureLabel := label.new(bar_index, high, "BOS", style=label.style_label_down, color=color.new(color.maroon, 35), textcolor=color.white, size=size.tiny)

if not na(newStructureLabel)
    structureLabels.unshift(newStructureLabel)
    if structureLabels.size() > 3
        oldStructureLabel = structureLabels.pop()
        label.delete(oldStructureLabel)

pdHigh = ta.highest(high, pdLookback)
pdLow = ta.lowest(low, pdLookback)
pdEq = (pdHigh + pdLow) / 2.0
inDiscount = close < pdEq
inPremium = close > pdEq
plot(pdEq, "PD EQ", color=color.new(color.gray, 85), linewidth=1)

// ============================================================================
// LIQUIDITY ENGINE
// ============================================================================
prevLondon = bar_index > 0 ? inLondon[1] : false
prevNY = bar_index > 0 ? inNY[1] : false
sessionStart = (inLondon and not prevLondon) or (inNY and not prevNY)

var bool bslSwept = false
var bool sslSwept = false
var bool asiaHighSwept = false
var bool asiaLowSwept = false
var array<label> sweepLabels = array.new<label>()

if sessionStart
    bslSwept := false
    sslSwept := false
    asiaHighSwept := false
    asiaLowSwept := false

newBslSweep = not bslConsumed and not na(lastHigh) and high > lastHigh and close < lastHigh and barstate.isconfirmed
newSslSweep = not sslConsumed and not na(lastLow) and low < lastLow and close > lastLow and barstate.isconfirmed
newAsiaHighSweep = validSession and not inAsia and not asiaHighConsumed and not na(asiaHigh) and high > asiaHigh and close < asiaHigh and barstate.isconfirmed
newAsiaLowSweep = validSession and not inAsia and not asiaLowConsumed and not na(asiaLow) and low < asiaLow and close > asiaLow and barstate.isconfirmed

if newBslSweep
    bslSwept := true
    bslConsumed := true
if newSslSweep
    sslSwept := true
    sslConsumed := true
if newAsiaHighSweep
    asiaHighSwept := true
    asiaHighConsumed := true
if newAsiaLowSweep
    asiaLowSwept := true
    asiaLowConsumed := true

label newSweepLabel = na
if showLiquidity
    if newBslSweep
        newSweepLabel := label.new(bar_index, high, "×", style=label.style_none, textcolor=color.red, size=size.small)
    else if newSslSweep
        newSweepLabel := label.new(bar_index, low, "×", style=label.style_none, textcolor=color.lime, size=size.small)
    else if newAsiaHighSweep
        newSweepLabel := label.new(bar_index, high, "◆", style=label.style_none, textcolor=color.purple, size=size.tiny)
    else if newAsiaLowSweep
        newSweepLabel := label.new(bar_index, low, "◆", style=label.style_none, textcolor=color.purple, size=size.tiny)

if not na(newSweepLabel)
    sweepLabels.unshift(newSweepLabel)
    if sweepLabels.size() > 3
        oldSweepLabel = sweepLabels.pop()
        label.delete(oldSweepLabel)

// ============================================================================
// SUPPORT RESISTANCE BOX ENGINE
// ============================================================================
var box resistanceBox = na
var box supportBox = na
resTop = not na(lastHigh) ? lastHigh + atr * srBoxAtrPad : na
resBot = not na(lastHigh) ? lastHigh - atr * srBoxAtrPad : na
supTop = not na(lastLow) ? lastLow + atr * srBoxAtrPad : na
supBot = not na(lastLow) ? lastLow - atr * srBoxAtrPad : na
resText = showSRLabels and not na(lastHigh) ? "Resistance\n" + f_price(lastHigh) : ""
supText = showSRLabels and not na(lastLow) ? "Support\n" + f_price(lastLow) : ""

if showSRBoxes and not na(lastHigh) and not na(lastHighBar)
    if na(resistanceBox)
        resistanceBox := box.new(lastHighBar, resTop, bar_index + srBoxExtend, resBot, bgcolor=color.new(color.purple, 82), border_color=color.new(color.purple, 55), text=resText, text_color=color.purple, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)
    else
        box.set_lefttop(resistanceBox, lastHighBar, resTop)
        box.set_rightbottom(resistanceBox, bar_index + srBoxExtend, resBot)
        box.set_text(resistanceBox, resText)
else
    if not na(resistanceBox)
        box.delete(resistanceBox)
        resistanceBox := na

if showSRBoxes and not na(lastLow) and not na(lastLowBar)
    if na(supportBox)
        supportBox := box.new(lastLowBar, supTop, bar_index + srBoxExtend, supBot, bgcolor=color.new(color.blue, 84), border_color=color.new(color.blue, 58), text=supText, text_color=color.blue, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)
    else
        box.set_lefttop(supportBox, lastLowBar, supTop)
        box.set_rightbottom(supportBox, bar_index + srBoxExtend, supBot)
        box.set_text(supportBox, supText)
else
    if not na(supportBox)
        box.delete(supportBox)
        supportBox := na

// ============================================================================
// SMC POI ENGINE: ARRAY ORDER BLOCK + SPLIT FVG
// ============================================================================
var array<amyOrderBlock> bullObs = array.new<amyOrderBlock>()
var array<amyOrderBlock> bearObs = array.new<amyOrderBlock>()
var array<amyFairValueGap> bullFvgs = array.new<amyFairValueGap>()
var array<amyFairValueGap> bearFvgs = array.new<amyFairValueGap>()

rightTime = f_rightTime(poiExtendBars)

[bullObTopTmp, bullObBotTmp, bullObTimeTmp] = f_lastBearish(10)
[bearObTopTmp, bearObBotTmp, bearObTimeTmp] = f_lastBullish(10)

if showPoi and (mssBull or bosBull) and not na(bullObTopTmp) and inDiscount
    newBox = box.new(chart.point.new(bullObTimeTmp, na, bullObTopTmp), chart.point.new(rightTime, na, bullObBotTmp), xloc=xloc.bar_time, extend=extend.none, bgcolor=color.new(color.teal, 82), border_color=color.new(color.teal, 35), text=showObText ? "+OB" : "", text_color=color.teal, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
    bullObs.unshift(amyOrderBlock.new(bullObTopTmp, bullObBotTmp, bullObTimeTmp, 1, newBox))
    if bullObs.size() > poiMaxBoxes
        oldOb = bullObs.pop()
        box.delete(oldOb.bx)

if showPoi and (mssBear or bosBear) and not na(bearObTopTmp) and inPremium
    newBox = box.new(chart.point.new(bearObTimeTmp, na, bearObTopTmp), chart.point.new(rightTime, na, bearObBotTmp), xloc=xloc.bar_time, extend=extend.none, bgcolor=color.new(color.orange, 82), border_color=color.new(color.orange, 35), text=showObText ? "-OB" : "", text_color=color.orange, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
    bearObs.unshift(amyOrderBlock.new(bearObTopTmp, bearObBotTmp, bearObTimeTmp, -1, newBox))
    if bearObs.size() > poiMaxBoxes
        oldOb = bearObs.pop()
        box.delete(oldOb.bx)

if bullObs.size() > 0
    for i = bullObs.size() - 1 to 0
        ob = bullObs.get(i)
        if close < ob.bot
            box.delete(ob.bx)
            bullObs.remove(i)
        else
            box.set_bottom_right_point(ob.bx, chart.point.new(rightTime, na, ob.bot))
            box.set_bgcolor(ob.bx, color.new(color.teal, low <= ob.top and high >= ob.bot ? 72 : 88))

if bearObs.size() > 0
    for i = bearObs.size() - 1 to 0
        ob = bearObs.get(i)
        if close > ob.top
            box.delete(ob.bx)
            bearObs.remove(i)
        else
            box.set_bottom_right_point(ob.bx, chart.point.new(rightTime, na, ob.bot))
            box.set_bgcolor(ob.bx, color.new(color.orange, high >= ob.bot and low <= ob.top ? 72 : 88))

fvgBull = low > high[2] and (low - high[2]) >= atr * 0.10 and displacementBull[1]
fvgBear = high < low[2] and (low[2] - high) >= atr * 0.10 and displacementBear[1]

if showPoi and fvgBull and biasBull and inDiscount
    fvgTop = low
    fvgBot = high[2]
    fvgMid = math.avg(fvgTop, fvgBot)
    topBox = box.new(chart.point.new(time[1], na, fvgTop), chart.point.new(rightTime, na, fvgMid), xloc=xloc.bar_time, bgcolor=color.new(color.green, 78), border_color=color.new(color.green, 60), text=showFvgText ? "FVG" : "", text_color=color.green, text_size=size.tiny, text_halign=text.align_right)
    botBox = box.new(chart.point.new(time[1], na, fvgMid), chart.point.new(rightTime, na, fvgBot), xloc=xloc.bar_time, bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 75))
    bullFvgs.unshift(amyFairValueGap.new(fvgTop, fvgBot, time[1], 1, topBox, botBox))
    if bullFvgs.size() > poiMaxBoxes
        oldFvg = bullFvgs.pop()
        box.delete(oldFvg.topBx)
        box.delete(oldFvg.botBx)

if showPoi and fvgBear and biasBear and inPremium
    fvgTop = low[2]
    fvgBot = high
    fvgMid = math.avg(fvgTop, fvgBot)
    topBox = box.new(chart.point.new(time[1], na, fvgTop), chart.point.new(rightTime, na, fvgMid), xloc=xloc.bar_time, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 75), text=showFvgText ? "FVG" : "", text_color=color.red, text_size=size.tiny, text_halign=text.align_right)
    botBox = box.new(chart.point.new(time[1], na, fvgMid), chart.point.new(rightTime, na, fvgBot), xloc=xloc.bar_time, bgcolor=color.new(color.red, 78), border_color=color.new(color.red, 60))
    bearFvgs.unshift(amyFairValueGap.new(fvgTop, fvgBot, time[1], -1, topBox, botBox))
    if bearFvgs.size() > poiMaxBoxes
        oldFvg = bearFvgs.pop()
        box.delete(oldFvg.topBx)
        box.delete(oldFvg.botBx)

if bullFvgs.size() > 0
    for i = bullFvgs.size() - 1 to 0
        fvg = bullFvgs.get(i)
        if low < fvg.bot
            box.delete(fvg.topBx)
            box.delete(fvg.botBx)
            bullFvgs.remove(i)
        else
            mid = math.avg(fvg.top, fvg.bot)
            box.set_bottom_right_point(fvg.topBx, chart.point.new(rightTime, na, mid))
            box.set_bottom_right_point(fvg.botBx, chart.point.new(rightTime, na, fvg.bot))
            box.set_bgcolor(fvg.topBx, color.new(color.green, low <= fvg.top and high >= fvg.bot ? 72 : 88))

if bearFvgs.size() > 0
    for i = bearFvgs.size() - 1 to 0
        fvg = bearFvgs.get(i)
        if high > fvg.top
            box.delete(fvg.topBx)
            box.delete(fvg.botBx)
            bearFvgs.remove(i)
        else
            mid = math.avg(fvg.top, fvg.bot)
            box.set_bottom_right_point(fvg.topBx, chart.point.new(rightTime, na, mid))
            box.set_bottom_right_point(fvg.botBx, chart.point.new(rightTime, na, fvg.bot))
            box.set_bgcolor(fvg.botBx, color.new(color.red, high >= fvg.bot and low <= fvg.top ? 72 : 88))

nearBullFvg = false
nearBearFvg = false
nearBullOb = false
nearBearOb = false

if bullFvgs.size() > 0
    for i = 0 to bullFvgs.size() - 1
        fvg = bullFvgs.get(i)
        if low <= fvg.top + atr * poiNearAtr and high >= fvg.bot - atr * 0.2
            nearBullFvg := true

if bearFvgs.size() > 0
    for i = 0 to bearFvgs.size() - 1
        fvg = bearFvgs.get(i)
        if high >= fvg.bot - atr * poiNearAtr and low <= fvg.top + atr * 0.2
            nearBearFvg := true

if bullObs.size() > 0
    for i = 0 to bullObs.size() - 1
        ob = bullObs.get(i)
        if low <= ob.top + atr * poiNearAtr and high >= ob.bot - atr * 0.2
            nearBullOb := true

if bearObs.size() > 0
    for i = 0 to bearObs.size() - 1
        ob = bearObs.get(i)
        if high >= ob.bot - atr * poiNearAtr and low <= ob.top + atr * 0.2
            nearBearOb := true

nearBullPoi = nearBullFvg or nearBullOb
nearBearPoi = nearBearFvg or nearBearOb
bullPoiActive = bullFvgs.size() > 0 or bullObs.size() > 0
bearPoiActive = bearFvgs.size() > 0 or bearObs.size() > 0

// ============================================================================
// MARKET MAPPING ENGINE
// ============================================================================
scoreBull = 0
if biasBull
    scoreBull += 1
if validSession
    scoreBull += 1
if inDiscount
    scoreBull += 1
if sslSwept or asiaLowSwept
    scoreBull += 1
if trend == "BULL"
    scoreBull += 1
if nearBullPoi
    scoreBull += 1
if displacementBull
    scoreBull += 1

scoreBear = 0
if biasBear
    scoreBear += 1
if validSession
    scoreBear += 1
if inPremium
    scoreBear += 1
if bslSwept or asiaHighSwept
    scoreBear += 1
if trend == "BEAR"
    scoreBear += 1
if nearBearPoi
    scoreBear += 1
if displacementBear
    scoreBear += 1

bullContextPercent = int(math.round(scoreBull * 100.0 / 7.0))
bearContextPercent = int(math.round(scoreBear * 100.0 / 7.0))

bullishReady = biasBull and trend == "BULL" and (sslSwept or asiaLowSwept) and nearBullPoi
bearishReady = biasBear and trend == "BEAR" and (bslSwept or asiaHighSwept) and nearBearPoi
mappingStatus = bullishReady ? "BULLISH READY" : bearishReady ? "BEARISH READY" : scoreBull >= 4 and scoreBull > scoreBear ? "BULLISH CONTEXT" : scoreBear >= 4 and scoreBear > scoreBull ? "BEARISH CONTEXT" : "NEUTRAL"
mappingColor = bullishReady or mappingStatus == "BULLISH CONTEXT" ? color.lime : bearishReady or mappingStatus == "BEARISH CONTEXT" ? color.red : color.yellow

// ============================================================================
// EVENT HISTORY
// ============================================================================
var array<string> eventLog = array.new_string()
string eventName = ""
float eventPrice = na
bool eventHasSweep = false

if mssBull
    eventName := "MSS BULL"
    eventPrice := lastHigh
else if mssBear
    eventName := "MSS BEAR"
    eventPrice := lastLow
else if bosBull
    eventName := "BOS BULL"
    eventPrice := lastHigh
else if bosBear
    eventName := "BOS BEAR"
    eventPrice := lastLow
else if newBslSweep
    eventName := "BSL SWEEP"
    eventPrice := lastHigh
    eventHasSweep := true
else if newSslSweep
    eventName := "SSL SWEEP"
    eventPrice := lastLow
    eventHasSweep := true
else if newAsiaHighSweep
    eventName := "ASIA HIGH SWEEP"
    eventPrice := asiaHigh
    eventHasSweep := true
else if newAsiaLowSweep
    eventName := "ASIA LOW SWEEP"
    eventPrice := asiaLow
    eventHasSweep := true

if barstate.isconfirmed and str.length(eventName) > 0
    eventSuffix = eventHasSweep ? "" : "  ✓"
    eventLine = str.format_time(time, "HH:mm", tz) + "  " + eventName + " @ " + f_price(eventPrice) + eventSuffix
    isNewEvent = true
    if eventLog.size() > 0
        isNewEvent := eventLog.get(0) != eventLine
    if isNewEvent
        eventLog.unshift(eventLine)
        if eventLog.size() > 3
            eventLog.pop()

event0 = eventLog.size() > 0 ? eventLog.get(0) : "No confirmed event"
event1 = eventLog.size() > 1 ? eventLog.get(1) : "—"
event2 = eventLog.size() > 2 ? eventLog.get(2) : "—"

// ============================================================================
// MARKET EXPLANATION PANEL — MIDDLE LEFT
// ============================================================================
var table mappingPanel = table.new(position.middle_left, 3, 8, bgcolor=color.new(color.black, 12), border_width=1, border_color=color.new(color.gray, 35))

if barstate.isfirst
    table.merge_cells(mappingPanel, 0, 0, 2, 0)
    table.merge_cells(mappingPanel, 0, 1, 2, 1)
    table.merge_cells(mappingPanel, 0, 4, 2, 4)
    table.merge_cells(mappingPanel, 0, 5, 2, 5)
    table.merge_cells(mappingPanel, 0, 6, 2, 6)
    table.merge_cells(mappingPanel, 0, 7, 2, 7)

if showMappingPanel and barstate.islast
    table.cell(mappingPanel, 0, 0, "◎ " + timeframe.period + " — MARKET MAPPING", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.black, 5))
    table.cell(mappingPanel, 0, 1, "● " + mappingStatus, text_color=mappingColor, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.black, 8))
    table.cell(mappingPanel, 0, 2, "↑ Bull", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 1, 2, f_meter(bullContextPercent), text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 2, 2, str.tostring(bullContextPercent) + "%", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 0, 3, "↓ Bear", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 1, 3, f_meter(bearContextPercent), text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 2, 3, str.tostring(bearContextPercent) + "%", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 0, 4, "⚡ Event:", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.black, 8))
    table.cell(mappingPanel, 0, 5, event0, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 0, 6, event1, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(color.black, 12))
    table.cell(mappingPanel, 0, 7, event2, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(color.black, 12))
else if barstate.islast
    table.clear(mappingPanel, 0, 0, 2, 7)

// ============================================================================
// MINI PANEL — BOTTOM RIGHT
// ============================================================================
liqText = sslSwept or asiaLowSwept ? "SSL SWEPT" : bslSwept or asiaHighSwept ? "BSL SWEPT" : "WAIT"
poiText = nearBullPoi and nearBearPoi ? "BOTH POI NEAR" : nearBullPoi ? "NEAR BULL POI" : nearBearPoi ? "NEAR BEAR POI" : bullPoiActive and bearPoiActive ? "BULL + BEAR POI ACTIVE" : bullPoiActive ? "BULL POI ACTIVE" : bearPoiActive ? "BEAR POI ACTIVE" : "NONE"
mapText = "BULL " + str.tostring(scoreBull) + "/7 | BEAR " + str.tostring(scoreBear) + "/7"

var table panel = table.new(position.bottom_right, 2, 7, bgcolor=color.new(color.black, 12), border_width=1, border_color=color.new(color.gray, 35))
if showPanel and barstate.islast
    table.cell(panel, 0, 0, "AMY ICT", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 5))
    table.cell(panel, 1, 0, "NEXTGEN", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 5))
    table.cell(panel, 0, 1, "Bias", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 1, 1, biasText, text_color=biasBull ? color.lime : biasBear ? color.red : color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 0, 2, "Session", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 1, 2, sessionText, text_color=validSession ? color.lime : color.gray, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 0, 3, "Structure", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 1, 3, trend, text_color=trend == "BULL" ? color.lime : trend == "BEAR" ? color.red : color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 0, 4, "Liquidity", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 1, 4, liqText, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 0, 5, "POI / Map", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 1, 5, poiText + " | " + mapText, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 0, 6, "Status", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 12))
    table.cell(panel, 1, 6, mappingStatus, text_color=mappingColor, text_size=size.small, bgcolor=color.new(color.black, 12))
else if barstate.islast
    table.clear(panel, 0, 0, 1, 6)
