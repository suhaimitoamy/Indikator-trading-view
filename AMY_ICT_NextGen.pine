//@version=5
indicator("AMY ICT NextGen Market Mapping", overlay=true, max_boxes_count=200, max_lines_count=250, max_labels_count=200, max_bars_back=3000)

// ============================================================================
// TYPES
// ============================================================================
type amyFvg
    float top
    float bot
    int dir
    box bx
    bool active

type amyOb
    float top
    float bot
    int dir
    box bx
    bool active

// ============================================================================
// INPUTS
// ============================================================================
grpCore = "1. Core"
tz = input.string("Asia/Makassar", "Timezone", group=grpCore)
asiaSess = input.session("0600-1400", "Asia Session", group=grpCore)
londonSess = input.session("1400-1800", "London Session", group=grpCore)
nySess = input.session("1930-0400", "New York Session", group=grpCore)
showAsia = input.bool(true, "Show Asia High / Low", group=grpCore)
showLiquidity = input.bool(true, "Show Liquidity", group=grpCore)
showStructure = input.bool(true, "Show BOS / MSS", group=grpCore)
structureHistory = input.int(3, "Visible BOS / MSS", minval=1, maxval=10, group=grpCore)
showDashboard = input.bool(true, "Show Unified Dashboard", group=grpCore)

grpCtx = "2. Context"
htf = input.timeframe("240", "HTF Bias", group=grpCtx)
emaLen = input.int(20, "HTF EMA Length", minval=1, group=grpCtx)

grpEma = "3. EMA"
showEma = input.bool(true, "Show EMA", group=grpEma)
ema1Len = input.int(21, "EMA 1 Length", minval=1, group=grpEma)
ema2Len = input.int(34, "EMA 2 Length", minval=1, group=grpEma)
ema3Len = input.int(90, "EMA 3 Length", minval=1, group=grpEma)

grpStruct = "4. Structure"
swingLen = input.int(4, "Swing Length", minval=1, maxval=20, group=grpStruct)
pdLookback = input.int(80, "Premium / Discount Lookback", minval=20, maxval=300, group=grpStruct)
atrLen = input.int(14, "ATR Length", minval=1, group=grpStruct)

grpSR = "5. Support Resistance Boxes"
showSRBoxes = input.bool(true, "Show Support / Resistance Boxes", group=grpSR)
srBoxAtrPad = input.float(0.20, "Box Thickness ATR", minval=0.05, maxval=2.0, step=0.05, group=grpSR)
srBoxExtend = input.int(55, "Box Extend Bars", minval=10, maxval=200, group=grpSR)
showSRLabels = input.bool(true, "Show Support / Resistance Text", group=grpSR)

grpPoi = "6. ICT Base OB / FVG"
showFvg = input.bool(true, "Show FVG Boxes", group=grpPoi)
fvgVisible = input.int(2, "Visible FVG Each Direction", minval=1, maxval=10, group=grpPoi)
fvgExtend = input.int(12, "FVG Extend Bars", minval=2, maxval=100, group=grpPoi)
showOb = input.bool(true, "Show Order Block Boxes", group=grpPoi)
obVisible = input.int(2, "Visible OB Each Direction", minval=1, maxval=10, group=grpPoi)
obLookback = input.int(10, "OB Search Lookback", minval=3, maxval=100, group=grpPoi)
obExtend = input.int(16, "OB Extend Bars", minval=2, maxval=100, group=grpPoi)
obUseBody = input.bool(true, "Use Candle Body for OB", group=grpPoi)
poiNearAtr = input.float(0.35, "Near POI ATR", minval=0.05, maxval=2.0, step=0.05, group=grpPoi)

grpEntry = "7. Entry Map"
showEntryMap = input.bool(true, "Show Entry Map", group=grpEntry)
entryExtendBars = input.int(30, "Line Extend Bars", minval=10, maxval=100, group=grpEntry)
slAtrPad = input.float(0.30, "SL ATR Buffer", minval=0.0, maxval=2.0, step=0.05, group=grpEntry)
tp1R = input.float(1.0, "TP1 R", minval=0.5, maxval=10.0, step=0.5, group=grpEntry)
tp2R = input.float(2.0, "TP2 R", minval=1.0, maxval=20.0, step=0.5, group=grpEntry)

// ============================================================================
// HELPERS
// ============================================================================
f_inSession(sess) =>
    not na(time(timeframe.period, sess, tz))

f_price(x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

f_meter(percent) =>
    safePercent = int(math.max(0, math.min(100, percent)))
    filled = int(math.round(safePercent / 10.0))
    string meter = ""
    for i = 1 to 10
        meter += i <= filled ? "█" : "░"
    meter

// ============================================================================
// SESSION ENGINE
// ============================================================================
inAsia = f_inSession(asiaSess)
inLondon = f_inSession(londonSess)
inNY = f_inSession(nySess)
validSession = inLondon or inNY
sessionText = inAsia ? "ASIA" : inLondon ? "LONDON" : inNY ? "NEW YORK" : "OFF SESSION"

prevAsia = bar_index > 0 ? inAsia[1] : false
asiaStart = inAsia and not prevAsia

var float asiaHigh = na
var float asiaLow = na
var int asiaStartBar = na
var line asiaHighLine = na
var line asiaLowLine = na
var label asiaHighLabel = na
var label asiaLowLabel = na
var bool asiaHighConsumed = false
var bool asiaLowConsumed = false

if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaStartBar := bar_index
    asiaHighConsumed := false
    asiaLowConsumed := false
    if not na(asiaHighLine)
        line.delete(asiaHighLine)
        asiaHighLine := na
    if not na(asiaLowLine)
        line.delete(asiaLowLine)
        asiaLowLine := na
    if not na(asiaHighLabel)
        label.delete(asiaHighLabel)
        asiaHighLabel := na
    if not na(asiaLowLabel)
        label.delete(asiaLowLabel)
        asiaLowLabel := na
else if inAsia
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)

if showAsia and not na(asiaHigh) and not na(asiaLow)
    startBar = na(asiaStartBar) ? bar_index : asiaStartBar
    if na(asiaHighLine)
        asiaHighLine := line.new(startBar, asiaHigh, bar_index + 1, asiaHigh, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.purple, 10), width=1)
    if na(asiaLowLine)
        asiaLowLine := line.new(startBar, asiaLow, bar_index + 1, asiaLow, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.purple, 10), width=1)
    line.set_xy1(asiaHighLine, startBar, asiaHigh)
    line.set_xy2(asiaHighLine, bar_index + 1, asiaHigh)
    line.set_xy1(asiaLowLine, startBar, asiaLow)
    line.set_xy2(asiaLowLine, bar_index + 1, asiaLow)
    if na(asiaHighLabel)
        asiaHighLabel := label.new(bar_index + 3, asiaHigh, "ASIA HIGH", style=label.style_label_left, color=color.rgb(96, 74, 128), textcolor=color.white, size=size.tiny)
    if na(asiaLowLabel)
        asiaLowLabel := label.new(bar_index + 3, asiaLow, "ASIA LOW", style=label.style_label_left, color=color.rgb(96, 74, 128), textcolor=color.white, size=size.tiny)
    label.set_xy(asiaHighLabel, bar_index + 3, asiaHigh)
    label.set_xy(asiaLowLabel, bar_index + 3, asiaLow)
else if not showAsia
    if not na(asiaHighLine)
        line.delete(asiaHighLine)
        asiaHighLine := na
    if not na(asiaLowLine)
        line.delete(asiaLowLine)
        asiaLowLine := na
    if not na(asiaHighLabel)
        label.delete(asiaHighLabel)
        asiaHighLabel := na
    if not na(asiaLowLabel)
        label.delete(asiaLowLabel)
        asiaLowLabel := na

// ============================================================================
// CONTEXT + EMA
// ============================================================================
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead=barmerge.lookahead_on)
htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, emaLen)[1], lookahead=barmerge.lookahead_on)

biasBull = not na(htfClose) and not na(htfEma) and htfClose > htfEma
biasBear = not na(htfClose) and not na(htfEma) and htfClose < htfEma
biasText = biasBull ? "BULL" : biasBear ? "BEAR" : "NEUTRAL"

ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
ema3 = ta.ema(close, ema3Len)

plot(showEma ? ema1 : na, "EMA 1", color=color.new(color.aqua, 0), linewidth=1)
plot(showEma ? ema2 : na, "EMA 2", color=color.new(color.orange, 0), linewidth=1)
plot(showEma ? ema3 : na, "EMA 3", color=color.new(color.purple, 0), linewidth=2)

// ============================================================================
// STRUCTURE ENGINE
// ============================================================================
atr = ta.atr(atrLen)
body = math.abs(close - open)
barRange = math.max(high - low, syminfo.mintick)
bodyRatio = body / barRange
meanBody = ta.sma(body, math.max(3, swingLen))
compactBody = high - math.max(close, open) < body * 0.36 and math.min(close, open) - low < body * 0.36
displacementBull = close > open and body > meanBody and compactBody and bodyRatio >= 0.45
displacementBear = close < open and body > meanBody and compactBody and bodyRatio >= 0.45

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na
var line bslLine = na
var line sslLine = na
var label bslLabel = na
var label sslLabel = na
var bool bslConsumed = false
var bool sslConsumed = false
var bool bslBroken = false
var bool sslBroken = false
var string trend = "NEUTRAL"
var array<line> structureLines = array.new<line>()
var array<label> structureLabels = array.new<label>()

if not na(ph)
    lastHigh := ph
    lastHighBar := bar_index - swingLen
    bslConsumed := false
    bslBroken := false
    if not na(bslLine)
        line.delete(bslLine)
        bslLine := na
    if not na(bslLabel)
        label.delete(bslLabel)
        bslLabel := na
    if showLiquidity
        bslLine := line.new(lastHighBar, lastHigh, bar_index + 80, lastHigh, color=color.new(color.red, 25), style=line.style_dashed, width=1)
        bslLabel := label.new(lastHighBar, lastHigh, "BSL", style=label.style_label_down, color=color.new(color.red, 68), textcolor=color.white, size=size.tiny)

if not na(pl)
    lastLow := pl
    lastLowBar := bar_index - swingLen
    sslConsumed := false
    sslBroken := false
    if not na(sslLine)
        line.delete(sslLine)
        sslLine := na
    if not na(sslLabel)
        label.delete(sslLabel)
        sslLabel := na
    if showLiquidity
        sslLine := line.new(lastLowBar, lastLow, bar_index + 80, lastLow, color=color.new(color.green, 25), style=line.style_dashed, width=1)
        sslLabel := label.new(lastLowBar, lastLow, "SSL", style=label.style_label_up, color=color.new(color.green, 68), textcolor=color.white, size=size.tiny)

if showLiquidity
    if not na(bslLine)
        line.set_x2(bslLine, bar_index + 80)
    if not na(sslLine)
        line.set_x2(sslLine, bar_index + 80)
else
    if not na(bslLine)
        line.delete(bslLine)
        bslLine := na
    if not na(sslLine)
        line.delete(sslLine)
        sslLine := na
    if not na(bslLabel)
        label.delete(bslLabel)
        bslLabel := na
    if not na(sslLabel)
        label.delete(sslLabel)
        sslLabel := na

rawBreakBull = not bslBroken and not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
rawBreakBear = not sslBroken and not na(lastLow) and close < lastLow and close[1] >= lastLow
mssBull = rawBreakBull and trend != "BULL" and barstate.isconfirmed
mssBear = rawBreakBear and trend != "BEAR" and barstate.isconfirmed
bosBull = rawBreakBull and trend == "BULL" and barstate.isconfirmed
bosBear = rawBreakBear and trend == "BEAR" and barstate.isconfirmed

if mssBull or bosBull
    trend := "BULL"
    bslBroken := true
if mssBear or bosBear
    trend := "BEAR"
    sslBroken := true

structureEvent = mssBull or mssBear or bosBull or bosBear
if showStructure and structureEvent
    bullishEvent = mssBull or bosBull
    structurePrice = bullishEvent ? lastHigh : lastLow
    structureStart = bullishEvent ? lastHighBar : lastLowBar
    structureText = mssBull or mssBear ? "MSS" : "BOS"
    structureColor = bullishEvent ? color.lime : color.red
    newLine = line.new(structureStart, structurePrice, bar_index, structurePrice, color=structureColor, width=1)
    midBar = int(math.round(math.avg(structureStart, bar_index)))
    newLabel = label.new(midBar, structurePrice, structureText, style=label.style_none, textcolor=structureColor, size=size.tiny)
    structureLines.unshift(newLine)
    structureLabels.unshift(newLabel)
    if structureLines.size() > structureHistory
        oldLine = structureLines.pop()
        line.delete(oldLine)
    if structureLabels.size() > structureHistory
        oldLabel = structureLabels.pop()
        label.delete(oldLabel)

if not showStructure
    if structureLines.size() > 0
        for i = structureLines.size() - 1 to 0
            oldLine = structureLines.pop()
            line.delete(oldLine)
    if structureLabels.size() > 0
        for i = structureLabels.size() - 1 to 0
            oldLabel = structureLabels.pop()
            label.delete(oldLabel)

pdHigh = ta.highest(high, pdLookback)
pdLow = ta.lowest(low, pdLookback)
pdEq = (pdHigh + pdLow) / 2.0
inDiscount = close < pdEq
inPremium = close > pdEq
rangeText = inDiscount ? "DISCOUNT" : inPremium ? "PREMIUM" : "EQUILIBRIUM"
plot(pdEq, "PD EQ", color=color.new(color.gray, 82), linewidth=1)

// ============================================================================
// LIQUIDITY ENGINE
// ============================================================================
prevLondon = bar_index > 0 ? inLondon[1] : false
prevNY = bar_index > 0 ? inNY[1] : false
sessionStart = (inLondon and not prevLondon) or (inNY and not prevNY)

var bool bslSwept = false
var bool sslSwept = false
var bool asiaHighSwept = false
var bool asiaLowSwept = false
var array<label> sweepLabels = array.new<label>()

if sessionStart
    bslSwept := false
    sslSwept := false
    asiaHighSwept := false
    asiaLowSwept := false

newBslSweep = not bslConsumed and not na(lastHigh) and high > lastHigh and close < lastHigh and barstate.isconfirmed
newSslSweep = not sslConsumed and not na(lastLow) and low < lastLow and close > lastLow and barstate.isconfirmed
newAsiaHighSweep = validSession and not inAsia and not asiaHighConsumed and not na(asiaHigh) and high > asiaHigh and close < asiaHigh and barstate.isconfirmed
newAsiaLowSweep = validSession and not inAsia and not asiaLowConsumed and not na(asiaLow) and low < asiaLow and close > asiaLow and barstate.isconfirmed

if newBslSweep
    bslSwept := true
    bslConsumed := true
if newSslSweep
    sslSwept := true
    sslConsumed := true
if newAsiaHighSweep
    asiaHighSwept := true
    asiaHighConsumed := true
if newAsiaLowSweep
    asiaLowSwept := true
    asiaLowConsumed := true

label newSweepLabel = na
if showLiquidity
    if newBslSweep
        newSweepLabel := label.new(bar_index, high, "×", style=label.style_none, textcolor=color.red, size=size.small)
    else if newSslSweep
        newSweepLabel := label.new(bar_index, low, "×", style=label.style_none, textcolor=color.lime, size=size.small)
    else if newAsiaHighSweep
        newSweepLabel := label.new(bar_index, high, "◆", style=label.style_none, textcolor=color.purple, size=size.tiny)
    else if newAsiaLowSweep
        newSweepLabel := label.new(bar_index, low, "◆", style=label.style_none, textcolor=color.purple, size=size.tiny)

if not na(newSweepLabel)
    sweepLabels.unshift(newSweepLabel)
    if sweepLabels.size() > 3
        oldSweepLabel = sweepLabels.pop()
        label.delete(oldSweepLabel)

liqText = sslSwept or asiaLowSwept ? "SELLSIDE SWEPT" : bslSwept or asiaHighSwept ? "BUYSIDE SWEPT" : "WAITING"

// ============================================================================
// SUPPORT / RESISTANCE ENGINE
// ============================================================================
var box resistanceBox = na
var box supportBox = na
resTop = not na(lastHigh) ? lastHigh + atr * srBoxAtrPad : na
resBot = not na(lastHigh) ? lastHigh - atr * srBoxAtrPad : na
supTop = not na(lastLow) ? lastLow + atr * srBoxAtrPad : na
supBot = not na(lastLow) ? lastLow - atr * srBoxAtrPad : na
resText = showSRLabels and not na(lastHigh) ? "Resistance\n" + f_price(lastHigh) : ""
supText = showSRLabels and not na(lastLow) ? "Support\n" + f_price(lastLow) : ""

if showSRBoxes and not na(lastHigh) and not na(lastHighBar)
    if na(resistanceBox)
        resistanceBox := box.new(lastHighBar, resTop, bar_index + srBoxExtend, resBot, bgcolor=color.new(color.purple, 82), border_color=color.new(color.purple, 55), text=resText, text_color=color.purple, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)
    else
        box.set_lefttop(resistanceBox, lastHighBar, resTop)
        box.set_rightbottom(resistanceBox, bar_index + srBoxExtend, resBot)
        box.set_text(resistanceBox, resText)
else
    if not na(resistanceBox)
        box.delete(resistanceBox)
        resistanceBox := na

if showSRBoxes and not na(lastLow) and not na(lastLowBar)
    if na(supportBox)
        supportBox := box.new(lastLowBar, supTop, bar_index + srBoxExtend, supBot, bgcolor=color.new(color.blue, 84), border_color=color.new(color.blue, 58), text=supText, text_color=color.blue, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)
    else
        box.set_lefttop(supportBox, lastLowBar, supTop)
        box.set_rightbottom(supportBox, bar_index + srBoxExtend, supBot)
        box.set_text(supportBox, supText)
else
    if not na(supportBox)
        box.delete(supportBox)
        supportBox := na

// ============================================================================
// ICT BASE FVG ENGINE
// ============================================================================
var array<amyFvg> bullFvgs = array.new<amyFvg>()
var array<amyFvg> bearFvgs = array.new<amyFvg>()

fvgBull = displacementBull[1] and low > high[2]
fvgBear = displacementBear[1] and high < low[2]

if showFvg and fvgBull
    fvgTop = low
    fvgBot = high[2]
    if fvgBull[1] and bullFvgs.size() > 0
        latestFvg = bullFvgs.get(0)
        latestFvg.top := fvgTop
        latestFvg.bot := fvgBot
        latestFvg.active := true
        box.set_lefttop(latestFvg.bx, bar_index - 2, fvgTop)
        box.set_rightbottom(latestFvg.bx, bar_index + fvgExtend, fvgBot)
        bullFvgs.set(0, latestFvg)
    else
        fvgBox = box.new(bar_index - 2, fvgTop, bar_index + fvgExtend, fvgBot, bgcolor=color.new(color.lime, 90), border_color=color.new(color.lime, 65), text="FVG", text_color=color.new(color.lime, 45), text_size=size.tiny, text_halign=text.align_right)
        bullFvgs.unshift(amyFvg.new(fvgTop, fvgBot, 1, fvgBox, true))
        if bullFvgs.size() > fvgVisible
            oldFvg = bullFvgs.pop()
            box.delete(oldFvg.bx)

if showFvg and fvgBear
    fvgTop = low[2]
    fvgBot = high
    if fvgBear[1] and bearFvgs.size() > 0
        latestFvg = bearFvgs.get(0)
        latestFvg.top := fvgTop
        latestFvg.bot := fvgBot
        latestFvg.active := true
        box.set_lefttop(latestFvg.bx, bar_index - 2, fvgTop)
        box.set_rightbottom(latestFvg.bx, bar_index + fvgExtend, fvgBot)
        bearFvgs.set(0, latestFvg)
    else
        fvgBox = box.new(bar_index - 2, fvgTop, bar_index + fvgExtend, fvgBot, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 65), text="FVG", text_color=color.new(color.red, 45), text_size=size.tiny, text_halign=text.align_right)
        bearFvgs.unshift(amyFvg.new(fvgTop, fvgBot, -1, fvgBox, true))
        if bearFvgs.size() > fvgVisible
            oldFvg = bearFvgs.pop()
            box.delete(oldFvg.bx)

if bullFvgs.size() > 0
    for i = bullFvgs.size() - 1 to 0
        fvg = bullFvgs.get(i)
        if fvg.active
            box.set_right(fvg.bx, bar_index + fvgExtend)
            if low < fvg.top
                box.set_border_style(fvg.bx, line.style_dashed)
            if low < fvg.bot
                box.set_right(fvg.bx, bar_index)
                box.set_bgcolor(fvg.bx, color.new(color.lime, 96))
                box.set_border_style(fvg.bx, line.style_dotted)
                fvg.active := false
                bullFvgs.set(i, fvg)

if bearFvgs.size() > 0
    for i = bearFvgs.size() - 1 to 0
        fvg = bearFvgs.get(i)
        if fvg.active
            box.set_right(fvg.bx, bar_index + fvgExtend)
            if high > fvg.bot
                box.set_border_style(fvg.bx, line.style_dashed)
            if high > fvg.top
                box.set_right(fvg.bx, bar_index)
                box.set_bgcolor(fvg.bx, color.new(color.red, 96))
                box.set_border_style(fvg.bx, line.style_dotted)
                fvg.active := false
                bearFvgs.set(i, fvg)

if not showFvg
    if bullFvgs.size() > 0
        for i = bullFvgs.size() - 1 to 0
            oldFvg = bullFvgs.pop()
            box.delete(oldFvg.bx)
    if bearFvgs.size() > 0
        for i = bearFvgs.size() - 1 to 0
            oldFvg = bearFvgs.pop()
            box.delete(oldFvg.bx)

// ============================================================================
// ICT BASE ORDER BLOCK ENGINE
// ============================================================================
var array<amyOb> bullObs = array.new<amyOb>()
var array<amyOb> bearObs = array.new<amyOb>()

if showOb and (mssBull or bosBull) and not na(lastHighBar)
    barsFromSwing = math.min(obLookback, math.max(1, bar_index - lastHighBar))
    float obTop = na
    float obBot = na
    int obOffset = na
    for i = 1 to barsFromSwing
        candleTop = obUseBody ? math.max(open[i], close[i]) : high[i]
        candleBot = obUseBody ? math.min(open[i], close[i]) : low[i]
        if na(obBot) or candleBot < obBot
            obBot := candleBot
            obTop := candleTop
            obOffset := i
    if not na(obTop) and not na(obBot) and not na(obOffset)
        obBox = box.new(bar_index - obOffset, obTop, bar_index + obExtend, obBot, bgcolor=color.new(color.blue, 90), border_color=color.new(color.blue, 45), text="+OB", text_color=color.new(color.blue, 10), text_size=size.tiny, text_halign=text.align_right)
        bullObs.unshift(amyOb.new(obTop, obBot, 1, obBox, true))
        if bullObs.size() > obVisible
            oldOb = bullObs.pop()
            box.delete(oldOb.bx)

if showOb and (mssBear or bosBear) and not na(lastLowBar)
    barsFromSwing = math.min(obLookback, math.max(1, bar_index - lastLowBar))
    float obTop = na
    float obBot = na
    int obOffset = na
    for i = 1 to barsFromSwing
        candleTop = obUseBody ? math.max(open[i], close[i]) : high[i]
        candleBot = obUseBody ? math.min(open[i], close[i]) : low[i]
        if na(obTop) or candleTop > obTop
            obTop := candleTop
            obBot := candleBot
            obOffset := i
    if not na(obTop) and not na(obBot) and not na(obOffset)
        obBox = box.new(bar_index - obOffset, obTop, bar_index + obExtend, obBot, bgcolor=color.new(color.red, 91), border_color=color.new(color.red, 45), text="-OB", text_color=color.new(color.red, 10), text_size=size.tiny, text_halign=text.align_right)
        bearObs.unshift(amyOb.new(obTop, obBot, -1, obBox, true))
        if bearObs.size() > obVisible
            oldOb = bearObs.pop()
            box.delete(oldOb.bx)

if bullObs.size() > 0
    for i = bullObs.size() - 1 to 0
        ob = bullObs.get(i)
        if ob.active
            box.set_right(ob.bx, bar_index + obExtend)
            if close < ob.bot
                box.set_right(ob.bx, bar_index)
                box.set_bgcolor(ob.bx, color.new(color.yellow, 94))
                box.set_border_style(ob.bx, line.style_dotted)
                ob.active := false
                bullObs.set(i, ob)

if bearObs.size() > 0
    for i = bearObs.size() - 1 to 0
        ob = bearObs.get(i)
        if ob.active
            box.set_right(ob.bx, bar_index + obExtend)
            if close > ob.top
                box.set_right(ob.bx, bar_index)
                box.set_bgcolor(ob.bx, color.new(color.yellow, 94))
                box.set_border_style(ob.bx, line.style_dotted)
                ob.active := false
                bearObs.set(i, ob)

if not showOb
    if bullObs.size() > 0
        for i = bullObs.size() - 1 to 0
            oldOb = bullObs.pop()
            box.delete(oldOb.bx)
    if bearObs.size() > 0
        for i = bearObs.size() - 1 to 0
            oldOb = bearObs.pop()
            box.delete(oldOb.bx)

nearBullFvg = false
nearBearFvg = false
nearBullOb = false
nearBearOb = false

if bullFvgs.size() > 0
    for i = 0 to bullFvgs.size() - 1
        fvg = bullFvgs.get(i)
        if fvg.active and low <= fvg.top + atr * poiNearAtr and high >= fvg.bot - atr * 0.10
            nearBullFvg := true

if bearFvgs.size() > 0
    for i = 0 to bearFvgs.size() - 1
        fvg = bearFvgs.get(i)
        if fvg.active and high >= fvg.bot - atr * poiNearAtr and low <= fvg.top + atr * 0.10
            nearBearFvg := true

if bullObs.size() > 0
    for i = 0 to bullObs.size() - 1
        ob = bullObs.get(i)
        if ob.active and low <= ob.top + atr * poiNearAtr and high >= ob.bot - atr * 0.10
            nearBullOb := true

if bearObs.size() > 0
    for i = 0 to bearObs.size() - 1
        ob = bearObs.get(i)
        if ob.active and high >= ob.bot - atr * poiNearAtr and low <= ob.top + atr * 0.10
            nearBearOb := true

nearBullPoi = nearBullFvg or nearBullOb
nearBearPoi = nearBearFvg or nearBearOb
bullPoiActive = false
bearPoiActive = false

if bullFvgs.size() > 0
    for i = 0 to bullFvgs.size() - 1
        if bullFvgs.get(i).active
            bullPoiActive := true
if bullObs.size() > 0
    for i = 0 to bullObs.size() - 1
        if bullObs.get(i).active
            bullPoiActive := true
if bearFvgs.size() > 0
    for i = 0 to bearFvgs.size() - 1
        if bearFvgs.get(i).active
            bearPoiActive := true
if bearObs.size() > 0
    for i = 0 to bearObs.size() - 1
        if bearObs.get(i).active
            bearPoiActive := true

poiText = nearBullPoi and nearBearPoi ? "BOTH POI NEAR" : nearBullPoi ? "NEAR BULL POI" : nearBearPoi ? "NEAR BEAR POI" : bullPoiActive and bearPoiActive ? "BULL + BEAR ACTIVE" : bullPoiActive ? "BULL POI ACTIVE" : bearPoiActive ? "BEAR POI ACTIVE" : "NONE"

// ============================================================================
// COMPACT ENTRY MAP
// ============================================================================
var string activeSetup = "WAITING"
var float activeEntry = na
var float activeSl = na
var float activeTp1 = na
var float activeTp2 = na
var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var label entryLabel = na
var label slLabel = na
var label tp1Label = na
var label tp2Label = na

newLongSetup = showEntryMap and (mssBull or bosBull) and not na(lastLow)
newShortSetup = showEntryMap and (mssBear or bosBear) and not na(lastHigh)

if newLongSetup or newShortSetup
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tp1Label)
        label.delete(tp1Label)
    if not na(tp2Label)
        label.delete(tp2Label)

    activeEntry := close
    if newLongSetup
        activeSetup := "LONG"
        activeSl := math.min(low, lastLow) - atr * slAtrPad
        setupRisk = math.max(activeEntry - activeSl, atr * 0.50)
        activeSl := activeEntry - setupRisk
        activeTp1 := activeEntry + setupRisk * tp1R
        activeTp2 := activeEntry + setupRisk * tp2R
    else
        activeSetup := "SHORT"
        activeSl := math.max(high, lastHigh) + atr * slAtrPad
        setupRisk = math.max(activeSl - activeEntry, atr * 0.50)
        activeSl := activeEntry + setupRisk
        activeTp1 := activeEntry - setupRisk * tp1R
        activeTp2 := activeEntry - setupRisk * tp2R

    rightBar = bar_index + entryExtendBars
    entryLine := line.new(bar_index, activeEntry, rightBar, activeEntry, color=color.new(color.yellow, 0), width=1)
    slLine := line.new(bar_index, activeSl, rightBar, activeSl, color=color.new(color.red, 0), width=1)
    tp1Line := line.new(bar_index, activeTp1, rightBar, activeTp1, color=color.new(color.lime, 20), width=1, style=line.style_dashed)
    tp2Line := line.new(bar_index, activeTp2, rightBar, activeTp2, color=color.new(color.lime, 0), width=1)
    entryLabel := label.new(rightBar, activeEntry, "ENTRY " + f_price(activeEntry), style=label.style_label_left, color=color.new(color.yellow, 75), textcolor=color.white, size=size.tiny)
    slLabel := label.new(rightBar, activeSl, "SL " + f_price(activeSl), style=label.style_label_left, color=color.new(color.red, 75), textcolor=color.white, size=size.tiny)
    tp1Label := label.new(rightBar, activeTp1, "TP1 " + f_price(activeTp1), style=label.style_label_left, color=color.new(color.green, 80), textcolor=color.white, size=size.tiny)
    tp2Label := label.new(rightBar, activeTp2, "TP2 " + f_price(activeTp2), style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)

if not showEntryMap
    activeSetup := "HIDDEN"
    activeEntry := na
    activeSl := na
    activeTp1 := na
    activeTp2 := na
    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na
    if not na(slLine)
        line.delete(slLine)
        slLine := na
    if not na(tp1Line)
        line.delete(tp1Line)
        tp1Line := na
    if not na(tp2Line)
        line.delete(tp2Line)
        tp2Line := na
    if not na(entryLabel)
        label.delete(entryLabel)
        entryLabel := na
    if not na(slLabel)
        label.delete(slLabel)
        slLabel := na
    if not na(tp1Label)
        label.delete(tp1Label)
        tp1Label := na
    if not na(tp2Label)
        label.delete(tp2Label)
        tp2Label := na

// ============================================================================
// MARKET MAPPING ENGINE
// ============================================================================
scoreBull = 0
if biasBull
    scoreBull += 1
if validSession
    scoreBull += 1
if inDiscount
    scoreBull += 1
if sslSwept or asiaLowSwept
    scoreBull += 1
if trend == "BULL"
    scoreBull += 1
if nearBullPoi
    scoreBull += 1
if displacementBull
    scoreBull += 1

scoreBear = 0
if biasBear
    scoreBear += 1
if validSession
    scoreBear += 1
if inPremium
    scoreBear += 1
if bslSwept or asiaHighSwept
    scoreBear += 1
if trend == "BEAR"
    scoreBear += 1
if nearBearPoi
    scoreBear += 1
if displacementBear
    scoreBear += 1

bullContextPercent = int(math.round(scoreBull * 100.0 / 7.0))
bearContextPercent = int(math.round(scoreBear * 100.0 / 7.0))

mappingStatus = scoreBull >= 5 and scoreBull > scoreBear ? "BULLISH CONTEXT" : scoreBear >= 5 and scoreBear > scoreBull ? "BEARISH CONTEXT" : "NEUTRAL"
mappingColor = mappingStatus == "BULLISH CONTEXT" ? color.lime : mappingStatus == "BEARISH CONTEXT" ? color.red : color.yellow

// ============================================================================
// EVENT HISTORY
// ============================================================================
var array<string> eventLog = array.new_string()
string eventName = ""
float eventPrice = na

if mssBull
    eventName := "MSS BULL"
    eventPrice := lastHigh
else if mssBear
    eventName := "MSS BEAR"
    eventPrice := lastLow
else if bosBull
    eventName := "BOS BULL"
    eventPrice := lastHigh
else if bosBear
    eventName := "BOS BEAR"
    eventPrice := lastLow
else if newBslSweep
    eventName := "BSL SWEEP"
    eventPrice := lastHigh
else if newSslSweep
    eventName := "SSL SWEEP"
    eventPrice := lastLow
else if newAsiaHighSweep
    eventName := "ASIA HIGH SWEEP"
    eventPrice := asiaHigh
else if newAsiaLowSweep
    eventName := "ASIA LOW SWEEP"
    eventPrice := asiaLow

if barstate.isconfirmed and str.length(eventName) > 0
    eventLine = str.format_time(time, "HH:mm", tz) + "  " + eventName + " @ " + f_price(eventPrice)
    bool isNewEvent = true
    if eventLog.size() > 0
        isNewEvent := eventLog.get(0) != eventLine
    if isNewEvent
        eventLog.unshift(eventLine)
        if eventLog.size() > 3
            eventLog.pop()

event0 = eventLog.size() > 0 ? eventLog.get(0) : "No confirmed event"
event1 = eventLog.size() > 1 ? eventLog.get(1) : "-"
event2 = eventLog.size() > 2 ? eventLog.get(2) : "-"

// ============================================================================
// UNIFIED DASHBOARD
// ============================================================================
dashHeader = color.rgb(58, 58, 58)
dashBg = color.rgb(86, 86, 86)
dashAlt = color.rgb(74, 74, 74)
dashBorder = color.rgb(120, 120, 120)

var table dashboard = table.new(position.bottom_right, 3, 16, bgcolor=dashBg, border_width=1, border_color=dashBorder)

if barstate.isfirst
    table.merge_cells(dashboard, 0, 0, 2, 0)
    table.merge_cells(dashboard, 0, 1, 2, 1)
    table.merge_cells(dashboard, 1, 2, 2, 2)
    table.merge_cells(dashboard, 1, 3, 2, 3)
    table.merge_cells(dashboard, 1, 4, 2, 4)
    table.merge_cells(dashboard, 1, 5, 2, 5)
    table.merge_cells(dashboard, 1, 6, 2, 6)
    table.merge_cells(dashboard, 1, 7, 2, 7)
    table.merge_cells(dashboard, 1, 8, 2, 8)
    table.merge_cells(dashboard, 0, 12, 2, 12)
    table.merge_cells(dashboard, 0, 13, 2, 13)
    table.merge_cells(dashboard, 0, 14, 2, 14)
    table.merge_cells(dashboard, 0, 15, 2, 15)

if showDashboard and barstate.islast
    table.cell(dashboard, 0, 0, "AMY ICT NEXTGEN — " + timeframe.period + " MARKET MAPPING", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashHeader)
    table.cell(dashboard, 0, 1, "STATUS: " + mappingStatus, text_color=mappingColor, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    table.cell(dashboard, 0, 2, "HTF Bias", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 2, biasText, text_color=biasBull ? color.lime : biasBear ? color.red : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 3, "Session", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 3, sessionText, text_color=validSession ? color.lime : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    table.cell(dashboard, 0, 4, "Structure", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 4, trend, text_color=trend == "BULL" ? color.lime : trend == "BEAR" ? color.red : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 5, "Liquidity", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 5, liqText, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    table.cell(dashboard, 0, 6, "Range", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 6, rangeText, text_color=inDiscount ? color.lime : inPremium ? color.orange : color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 7, "OB / FVG", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 7, poiText, text_color=nearBullPoi ? color.lime : nearBearPoi ? color.red : color.silver, text_size=size.small, text_halign=text.align_left, bgcolor=dashAlt)

    entrySummary = activeSetup + " | E " + f_price(activeEntry) + " | SL " + f_price(activeSl) + " | T1 " + f_price(activeTp1) + " | T2 " + f_price(activeTp2)
    table.cell(dashboard, 0, 8, "Entry Map", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 8, entrySummary, text_color=activeSetup == "LONG" ? color.lime : activeSetup == "SHORT" ? color.red : color.silver, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashBg)

    table.cell(dashboard, 0, 9, "Bull", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 9, f_meter(bullContextPercent), text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 2, 9, str.tostring(bullContextPercent) + "%", text_color=color.white, text_size=size.small, bgcolor=dashAlt)

    table.cell(dashboard, 0, 10, "Bear", text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 1, 10, f_meter(bearContextPercent), text_color=color.white, text_size=size.small, bgcolor=dashBg)
    table.cell(dashboard, 2, 10, str.tostring(bearContextPercent) + "%", text_color=color.white, text_size=size.small, bgcolor=dashBg)

    table.cell(dashboard, 0, 11, "EMA", text_color=color.white, text_size=size.small, bgcolor=dashAlt)
    table.cell(dashboard, 1, 11, str.tostring(ema1Len) + " / " + str.tostring(ema2Len), text_color=color.white, text_size=size.tiny, bgcolor=dashAlt)
    table.cell(dashboard, 2, 11, str.tostring(ema3Len), text_color=color.white, text_size=size.tiny, bgcolor=dashAlt)

    table.cell(dashboard, 0, 12, "EVENT HISTORY", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=dashHeader)
    table.cell(dashboard, 0, 13, event0, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashBg)
    table.cell(dashboard, 0, 14, event1, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashAlt)
    table.cell(dashboard, 0, 15, event2, text_color=color.white, text_size=size.tiny, text_halign=text.align_left, bgcolor=dashBg)
else if barstate.islast
    table.clear(dashboard, 0, 0, 2, 15)
