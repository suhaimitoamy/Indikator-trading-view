//@version=5
indicator("AMY ICT NextGen Core", overlay=true, max_boxes_count=200, max_lines_count=120, max_labels_count=120)

// ============================================================================
// TYPES
// ============================================================================
type amyOrderBlock
    float top
    float bot
    int leftTime
    int bias
    box bx

type amyFairValueGap
    float top
    float bot
    int leftTime
    int bias
    box topBx
    box botBx

// ============================================================================
// INPUTS
// ============================================================================
grpCore = "1. Core"
tz = input.string("Asia/Makassar", "Timezone", group=grpCore)
asiaSess = input.session("0600-1400", "Asia Session", group=grpCore)
londonSess = input.session("1400-1800", "London Session", group=grpCore)
nySess = input.session("1930-0400", "New York Session", group=grpCore)
mode = input.string("Balanced", "Signal Mode", options=["Aggressive", "Balanced", "Conservative"], group=grpCore)
showAsia = input.bool(true, "Show Asia Range", group=grpCore)
showLiquidity = input.bool(true, "Show Liquidity", group=grpCore)
showStructure = input.bool(true, "Show BOS / MSS", group=grpCore)
showPoi = input.bool(true, "Show Active POI", group=grpCore)
showPanel = input.bool(true, "Show Mini Panel", group=grpCore)

grpCtx = "2. Context"
htf = input.timeframe("240", "HTF Bias", group=grpCtx)
emaLen = input.int(20, "HTF EMA Length", minval=1, group=grpCtx)

grpStruct = "3. Structure"
swingLen = input.int(4, "Swing Length", minval=1, maxval=20, group=grpStruct)
pdLookback = input.int(80, "Premium / Discount Lookback", minval=20, maxval=300, group=grpStruct)

grpRisk = "4. Risk"
atrLen = input.int(14, "ATR Length", minval=1, group=grpRisk)
slAtrPad = input.float(0.35, "SL ATR Buffer", minval=0.0, step=0.05, group=grpRisk)
maxRiskAtr = input.float(3.0, "Max Risk ATR", minval=0.5, step=0.1, group=grpRisk)

grpSR = "5. Support Resistance Boxes"
showSRBoxes = input.bool(true, "Show Support / Resistance Boxes", group=grpSR)
srBoxAtrPad = input.float(0.20, "Box Thickness ATR", minval=0.05, maxval=2.0, step=0.05, group=grpSR)
srBoxExtend = input.int(55, "Box Extend Bars", minval=10, maxval=200, group=grpSR)
showSRLabels = input.bool(true, "Show Support / Resistance Labels", group=grpSR)

grpPoi = "6. SMC POI Boxes"
poiMaxBoxes = input.int(3, "Visible OB / FVG Count", minval=1, maxval=10, group=grpPoi)
poiExtendBars = input.int(80, "POI Extend Bars", minval=10, maxval=300, group=grpPoi)
poiNearAtr = input.float(0.80, "POI Near ATR", minval=0.10, maxval=3.0, step=0.05, group=grpPoi)
showObText = input.bool(true, "Show OB Text", group=grpPoi)
showFvgText = input.bool(true, "Show FVG Text", group=grpPoi)

// ============================================================================
// HELPERS
// ============================================================================
f_inSession(sess) =>
    not na(time(timeframe.period, sess, tz))

f_price(x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

f_rightTime(bars) =>
    time + (time - time[1]) * bars

f_lastBearish(lookback) =>
    float zTop = na
    float zBot = na
    int zTime = na
    for i = 1 to lookback
        if na(zTop) and close[i] < open[i]
            zTop := open[i]
            zBot := low[i]
            zTime := time[i]
    [zTop, zBot, zTime]

f_lastBullish(lookback) =>
    float zTop = na
    float zBot = na
    int zTime = na
    for i = 1 to lookback
        if na(zTop) and close[i] > open[i]
            zTop := high[i]
            zBot := open[i]
            zTime := time[i]
    [zTop, zBot, zTime]

// ============================================================================
// CORE ENGINE
// ============================================================================
inAsia = f_inSession(asiaSess)
inLondon = f_inSession(londonSess)
inNY = f_inSession(nySess)
validSession = inLondon or inNY
sessionText = inAsia ? "ASIA" : inLondon ? "LONDON" : inNY ? "NY" : "OFF"

prevAsia = bar_index > 0 ? inAsia[1] : false
asiaStart = inAsia and not prevAsia

var float asiaHigh = na
var float asiaLow = na

if asiaStart
    asiaHigh := high
    asiaLow := low
else if inAsia
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)

plot(showAsia and validSession ? asiaHigh : na, "Asia High", color=color.new(color.purple, 15), style=plot.style_linebr, linewidth=1)
plot(showAsia and validSession ? asiaLow : na, "Asia Low", color=color.new(color.purple, 15), style=plot.style_linebr, linewidth=1)

// ============================================================================
// CONTEXT ENGINE
// ============================================================================
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead=barmerge.lookahead_off)
htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, emaLen)[1], lookahead=barmerge.lookahead_off)

biasBull = not na(htfClose) and not na(htfEma) and htfClose > htfEma
biasBear = not na(htfClose) and not na(htfEma) and htfClose < htfEma
biasText = biasBull ? "BULL" : biasBear ? "BEAR" : "NEUTRAL"

// ============================================================================
// STRUCTURE ENGINE
// ============================================================================
atr = ta.atr(atrLen)
body = math.abs(close - open)
barRange = math.max(high - low, syminfo.mintick)
bodyRatio = body / barRange
displacementBull = close > open and body >= atr * 0.25 and bodyRatio >= 0.45
displacementBear = close < open and body >= atr * 0.25 and bodyRatio >= 0.45

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na
var line bslLine = na
var line sslLine = na

if not na(ph)
    lastHigh := ph
    lastHighBar := bar_index - swingLen
    if showLiquidity
        if not na(bslLine)
            line.delete(bslLine)
        bslLine := line.new(lastHighBar, lastHigh, bar_index + 80, lastHigh, color=color.new(color.red, 25), style=line.style_dashed, width=1)
        label.new(lastHighBar, lastHigh, "BSL", style=label.style_label_down, color=color.new(color.red, 75), textcolor=color.white, size=size.tiny)

if not na(pl)
    lastLow := pl
    lastLowBar := bar_index - swingLen
    if showLiquidity
        if not na(sslLine)
            line.delete(sslLine)
        sslLine := line.new(lastLowBar, lastLow, bar_index + 80, lastLow, color=color.new(color.green, 25), style=line.style_dashed, width=1)
        label.new(lastLowBar, lastLow, "SSL", style=label.style_label_up, color=color.new(color.green, 75), textcolor=color.white, size=size.tiny)

if not na(bslLine)
    line.set_x2(bslLine, bar_index + 80)
if not na(sslLine)
    line.set_x2(sslLine, bar_index + 80)

var string trend = "NEUTRAL"
rawBreakBull = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
rawBreakBear = not na(lastLow) and close < lastLow and close[1] >= lastLow
mssBull = rawBreakBull and trend != "BULL" and displacementBull and barstate.isconfirmed
mssBear = rawBreakBear and trend != "BEAR" and displacementBear and barstate.isconfirmed
bosBull = rawBreakBull and trend == "BULL" and displacementBull and barstate.isconfirmed
bosBear = rawBreakBear and trend == "BEAR" and displacementBear and barstate.isconfirmed

if mssBull or bosBull
    trend := "BULL"
if mssBear or bosBear
    trend := "BEAR"

if showStructure and mssBull
    label.new(bar_index, low, "MSS\nBULL", style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)
if showStructure and mssBear
    label.new(bar_index, high, "MSS\nBEAR", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
if showStructure and bosBull
    label.new(bar_index, low, "BOS", style=label.style_label_up, color=color.new(color.green, 35), textcolor=color.white, size=size.tiny)
if showStructure and bosBear
    label.new(bar_index, high, "BOS", style=label.style_label_down, color=color.new(color.maroon, 35), textcolor=color.white, size=size.tiny)

pdHigh = ta.highest(high, pdLookback)
pdLow = ta.lowest(low, pdLookback)
pdEq = (pdHigh + pdLow) / 2.0
inDiscount = close < pdEq
inPremium = close > pdEq
plot(pdEq, "PD EQ", color=color.new(color.gray, 85), linewidth=1)

// ============================================================================
// LIQUIDITY ENGINE
// ============================================================================
prevLondon = bar_index > 0 ? inLondon[1] : false
prevNY = bar_index > 0 ? inNY[1] : false
sessionStart = (inLondon and not prevLondon) or (inNY and not prevNY)

var bool bslSwept = false
var bool sslSwept = false
var bool asiaHighSwept = false
var bool asiaLowSwept = false

if sessionStart
    bslSwept := false
    sslSwept := false
    asiaHighSwept := false
    asiaLowSwept := false

newBslSweep = not na(lastHigh) and high > lastHigh and close < lastHigh and barstate.isconfirmed
newSslSweep = not na(lastLow) and low < lastLow and close > lastLow and barstate.isconfirmed
newAsiaHighSweep = not na(asiaHigh) and high > asiaHigh and close < asiaHigh and barstate.isconfirmed
newAsiaLowSweep = not na(asiaLow) and low < asiaLow and close > asiaLow and barstate.isconfirmed

if newBslSweep
    bslSwept := true
if newSslSweep
    sslSwept := true
if newAsiaHighSweep
    asiaHighSwept := true
if newAsiaLowSweep
    asiaLowSwept := true

plotshape(showLiquidity and newBslSweep, "BSL Swept", style=shape.xcross, location=location.abovebar, color=color.red, text="BSL\nSWEEP", textcolor=color.red, size=size.tiny)
plotshape(showLiquidity and newSslSweep, "SSL Swept", style=shape.xcross, location=location.belowbar, color=color.lime, text="SSL\nSWEEP", textcolor=color.green, size=size.tiny)
plotshape(showLiquidity and newAsiaHighSweep, "Asia High Swept", style=shape.diamond, location=location.abovebar, color=color.purple, text="Asia H", textcolor=color.purple, size=size.tiny)
plotshape(showLiquidity and newAsiaLowSweep, "Asia Low Swept", style=shape.diamond, location=location.belowbar, color=color.purple, text="Asia L", textcolor=color.purple, size=size.tiny)

// ============================================================================
// SUPPORT RESISTANCE BOX ENGINE
// ============================================================================
var box resistanceBox = na
var box supportBox = na
var label resistanceLabel = na
var label supportLabel = na
resTop = not na(lastHigh) ? lastHigh + atr * srBoxAtrPad : na
resBot = not na(lastHigh) ? lastHigh - atr * srBoxAtrPad : na
supTop = not na(lastLow) ? lastLow + atr * srBoxAtrPad : na
supBot = not na(lastLow) ? lastLow - atr * srBoxAtrPad : na

if showSRBoxes and not na(lastHigh) and not na(lastHighBar)
    if na(resistanceBox)
        resistanceBox := box.new(lastHighBar, resTop, bar_index + srBoxExtend, resBot, bgcolor=color.new(color.purple, 82), border_color=color.new(color.purple, 55), text="resistance", text_color=color.purple, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
    else
        box.set_lefttop(resistanceBox, lastHighBar, resTop)
        box.set_rightbottom(resistanceBox, bar_index + srBoxExtend, resBot)
        box.set_text(resistanceBox, "resistance")
    if showSRLabels
        if na(resistanceLabel)
            resistanceLabel := label.new(bar_index + srBoxExtend, lastHigh, "resistance\n" + f_price(lastHigh), style=label.style_label_left, color=color.new(color.purple, 15), textcolor=color.white, size=size.tiny)
        else
            label.set_xy(resistanceLabel, bar_index + srBoxExtend, lastHigh)
            label.set_text(resistanceLabel, "resistance\n" + f_price(lastHigh))
else
    if not na(resistanceBox)
        box.delete(resistanceBox)
        resistanceBox := na
    if not na(resistanceLabel)
        label.delete(resistanceLabel)
        resistanceLabel := na

if showSRBoxes and not na(lastLow) and not na(lastLowBar)
    if na(supportBox)
        supportBox := box.new(lastLowBar, supTop, bar_index + srBoxExtend, supBot, bgcolor=color.new(color.blue, 84), border_color=color.new(color.blue, 58), text="Support", text_color=color.purple, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
    else
        box.set_lefttop(supportBox, lastLowBar, supTop)
        box.set_rightbottom(supportBox, bar_index + srBoxExtend, supBot)
        box.set_text(supportBox, "Support")
    if showSRLabels
        if na(supportLabel)
            supportLabel := label.new(bar_index + srBoxExtend, lastLow, "Support\n" + f_price(lastLow), style=label.style_label_left, color=color.new(color.purple, 15), textcolor=color.white, size=size.tiny)
        else
            label.set_xy(supportLabel, bar_index + srBoxExtend, lastLow)
            label.set_text(supportLabel, "Support\n" + f_price(lastLow))
else
    if not na(supportBox)
        box.delete(supportBox)
        supportBox := na
    if not na(supportLabel)
        label.delete(supportLabel)
        supportLabel := na

// ============================================================================
// SMC POI ENGINE: ARRAY ORDER BLOCK + SPLIT FVG
// ============================================================================
var array<amyOrderBlock> bullObs = array.new<amyOrderBlock>()
var array<amyOrderBlock> bearObs = array.new<amyOrderBlock>()
var array<amyFairValueGap> bullFvgs = array.new<amyFairValueGap>()
var array<amyFairValueGap> bearFvgs = array.new<amyFairValueGap>()

rightTime = f_rightTime(poiExtendBars)

[bullObTopTmp, bullObBotTmp, bullObTimeTmp] = f_lastBearish(10)
[bearObTopTmp, bearObBotTmp, bearObTimeTmp] = f_lastBullish(10)

if showPoi and (mssBull or bosBull) and not na(bullObTopTmp) and inDiscount
    newBox = box.new(chart.point.new(bullObTimeTmp, na, bullObTopTmp), chart.point.new(rightTime, na, bullObBotTmp), xloc=xloc.bar_time, extend=extend.none, bgcolor=color.new(color.teal, 82), border_color=color.new(color.teal, 35), text=showObText ? "+OB" : "", text_color=color.teal, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
    bullObs.unshift(amyOrderBlock.new(bullObTopTmp, bullObBotTmp, bullObTimeTmp, 1, newBox))
    if bullObs.size() > poiMaxBoxes
        oldOb = bullObs.pop()
        box.delete(oldOb.bx)

if showPoi and (mssBear or bosBear) and not na(bearObTopTmp) and inPremium
    newBox = box.new(chart.point.new(bearObTimeTmp, na, bearObTopTmp), chart.point.new(rightTime, na, bearObBotTmp), xloc=xloc.bar_time, extend=extend.none, bgcolor=color.new(color.orange, 82), border_color=color.new(color.orange, 35), text=showObText ? "-OB" : "", text_color=color.orange, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
    bearObs.unshift(amyOrderBlock.new(bearObTopTmp, bearObBotTmp, bearObTimeTmp, -1, newBox))
    if bearObs.size() > poiMaxBoxes
        oldOb = bearObs.pop()
        box.delete(oldOb.bx)

if bullObs.size() > 0
    for i = bullObs.size() - 1 to 0
        ob = bullObs.get(i)
        if close < ob.bot
            box.delete(ob.bx)
            bullObs.remove(i)
        else
            box.set_bottom_right_point(ob.bx, chart.point.new(rightTime, na, ob.bot))
            box.set_bgcolor(ob.bx, color.new(color.teal, low <= ob.top and high >= ob.bot ? 72 : 88))

if bearObs.size() > 0
    for i = bearObs.size() - 1 to 0
        ob = bearObs.get(i)
        if close > ob.top
            box.delete(ob.bx)
            bearObs.remove(i)
        else
            box.set_bottom_right_point(ob.bx, chart.point.new(rightTime, na, ob.bot))
            box.set_bgcolor(ob.bx, color.new(color.orange, high >= ob.bot and low <= ob.top ? 72 : 88))

fvgBull = low > high[2] and (low - high[2]) >= atr * 0.10 and displacementBull[1]
fvgBear = high < low[2] and (low[2] - high) >= atr * 0.10 and displacementBear[1]

if showPoi and fvgBull and biasBull and inDiscount
    fvgTop = low
    fvgBot = high[2]
    fvgMid = math.avg(fvgTop, fvgBot)
    topBox = box.new(chart.point.new(time[1], na, fvgTop), chart.point.new(rightTime, na, fvgMid), xloc=xloc.bar_time, bgcolor=color.new(color.green, 78), border_color=color.new(color.green, 60), text=showFvgText ? "FVG" : "", text_color=color.green, text_size=size.tiny, text_halign=text.align_right)
    botBox = box.new(chart.point.new(time[1], na, fvgMid), chart.point.new(rightTime, na, fvgBot), xloc=xloc.bar_time, bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 75))
    bullFvgs.unshift(amyFairValueGap.new(fvgTop, fvgBot, time[1], 1, topBox, botBox))
    if bullFvgs.size() > poiMaxBoxes
        oldFvg = bullFvgs.pop()
        box.delete(oldFvg.topBx)
        box.delete(oldFvg.botBx)

if showPoi and fvgBear and biasBear and inPremium
    fvgTop = low[2]
    fvgBot = high
    fvgMid = math.avg(fvgTop, fvgBot)
    topBox = box.new(chart.point.new(time[1], na, fvgTop), chart.point.new(rightTime, na, fvgMid), xloc=xloc.bar_time, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 75), text=showFvgText ? "FVG" : "", text_color=color.red, text_size=size.tiny, text_halign=text.align_right)
    botBox = box.new(chart.point.new(time[1], na, fvgMid), chart.point.new(rightTime, na, fvgBot), xloc=xloc.bar_time, bgcolor=color.new(color.red, 78), border_color=color.new(color.red, 60))
    bearFvgs.unshift(amyFairValueGap.new(fvgTop, fvgBot, time[1], -1, topBox, botBox))
    if bearFvgs.size() > poiMaxBoxes
        oldFvg = bearFvgs.pop()
        box.delete(oldFvg.topBx)
        box.delete(oldFvg.botBx)

if bullFvgs.size() > 0
    for i = bullFvgs.size() - 1 to 0
        fvg = bullFvgs.get(i)
        if low < fvg.bot
            box.delete(fvg.topBx)
            box.delete(fvg.botBx)
            bullFvgs.remove(i)
        else
            mid = math.avg(fvg.top, fvg.bot)
            box.set_bottom_right_point(fvg.topBx, chart.point.new(rightTime, na, mid))
            box.set_bottom_right_point(fvg.botBx, chart.point.new(rightTime, na, fvg.bot))
            box.set_bgcolor(fvg.topBx, color.new(color.green, low <= fvg.top and high >= fvg.bot ? 72 : 88))

if bearFvgs.size() > 0
    for i = bearFvgs.size() - 1 to 0
        fvg = bearFvgs.get(i)
        if high > fvg.top
            box.delete(fvg.topBx)
            box.delete(fvg.botBx)
            bearFvgs.remove(i)
        else
            mid = math.avg(fvg.top, fvg.bot)
            box.set_bottom_right_point(fvg.topBx, chart.point.new(rightTime, na, mid))
            box.set_bottom_right_point(fvg.botBx, chart.point.new(rightTime, na, fvg.bot))
            box.set_bgcolor(fvg.botBx, color.new(color.red, high >= fvg.bot and low <= fvg.top ? 72 : 88))

float bullFvgTop = na
float bullFvgBot = na
float bearFvgTop = na
float bearFvgBot = na
float bullObTop = na
float bullObBot = na
float bearObTop = na
float bearObBot = na

if bullFvgs.size() > 0
    latestBullFvg = bullFvgs.get(0)
    bullFvgTop := latestBullFvg.top
    bullFvgBot := latestBullFvg.bot
if bearFvgs.size() > 0
    latestBearFvg = bearFvgs.get(0)
    bearFvgTop := latestBearFvg.top
    bearFvgBot := latestBearFvg.bot
if bullObs.size() > 0
    latestBullOb = bullObs.get(0)
    bullObTop := latestBullOb.top
    bullObBot := latestBullOb.bot
if bearObs.size() > 0
    latestBearOb = bearObs.get(0)
    bearObTop := latestBearOb.top
    bearObBot := latestBearOb.bot

nearBullFvg = not na(bullFvgTop) and low <= bullFvgTop + atr * poiNearAtr and high >= bullFvgBot - atr * 0.2
nearBearFvg = not na(bearFvgBot) and high >= bearFvgBot - atr * poiNearAtr and low <= bearFvgTop + atr * 0.2
nearBullOb = not na(bullObTop) and low <= bullObTop + atr * poiNearAtr and high >= bullObBot - atr * 0.2
nearBearOb = not na(bearObBot) and high >= bearObBot - atr * poiNearAtr and low <= bearObTop + atr * 0.2
nearBullPoi = nearBullFvg or nearBullOb
nearBearPoi = nearBearFvg or nearBearOb

// ============================================================================
// SCORING + SIGNAL
// ============================================================================
minScore = mode == "Aggressive" ? 4 : mode == "Balanced" ? 5 : 6
scoreBull = 0
if biasBull
    scoreBull += 1
if validSession
    scoreBull += 1
if inDiscount
    scoreBull += 1
if sslSwept or asiaLowSwept
    scoreBull += 1
if mssBull or bosBull
    scoreBull += 1
if nearBullPoi
    scoreBull += 1
if displacementBull
    scoreBull += 1

scoreBear = 0
if biasBear
    scoreBear += 1
if validSession
    scoreBear += 1
if inPremium
    scoreBear += 1
if bslSwept or asiaHighSwept
    scoreBear += 1
if mssBear or bosBear
    scoreBear += 1
if nearBearPoi
    scoreBear += 1
if displacementBear
    scoreBear += 1

entry = close
slBuy = not na(lastLow) ? math.min(low, lastLow) - atr * slAtrPad : na
slSell = not na(lastHigh) ? math.max(high, lastHigh) + atr * slAtrPad : na
riskBuy = not na(slBuy) ? entry - slBuy : na
riskSell = not na(slSell) ? slSell - entry : na
validRiskBuy = not na(riskBuy) and riskBuy > syminfo.mintick and riskBuy <= atr * maxRiskAtr
validRiskSell = not na(riskSell) and riskSell > syminfo.mintick and riskSell <= atr * maxRiskAtr

tp1Buy = validRiskBuy ? entry + riskBuy : na
tp2Buy = validRiskBuy ? entry + riskBuy * 2.0 : na
tp1Sell = validRiskSell ? entry - riskSell : na
tp2Sell = validRiskSell ? entry - riskSell * 2.0 : na

finalBuy = barstate.isconfirmed and scoreBull >= minScore and validRiskBuy and scoreBull > scoreBear
finalSell = barstate.isconfirmed and scoreBear >= minScore and validRiskSell and scoreBear > scoreBull

plotshape(finalBuy, "BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), text="BUY", textcolor=color.black, size=size.small)
plotshape(finalSell, "SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.small)

var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na

if finalBuy or finalSell
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)

    sl = finalBuy ? slBuy : slSell
    tp1 = finalBuy ? tp1Buy : tp1Sell
    tp2 = finalBuy ? tp2Buy : tp2Sell
    entryLine := line.new(bar_index, entry, bar_index + 25, entry, color=color.new(color.yellow, 0), width=2)
    slLine := line.new(bar_index, sl, bar_index + 25, sl, color=color.new(color.red, 0), width=2)
    tp1Line := line.new(bar_index, tp1, bar_index + 25, tp1, color=color.new(color.green, 10), width=1)
    tp2Line := line.new(bar_index, tp2, bar_index + 25, tp2, color=color.new(color.green, 0), width=2)
    label.new(bar_index, finalBuy ? low : high, (finalBuy ? "BUY" : "SELL") + "\nScore: " + str.tostring(finalBuy ? scoreBull : scoreBear) + "/7\nEntry: " + f_price(entry) + "\nSL: " + f_price(sl) + "\nTP1: " + f_price(tp1) + "\nTP2: " + f_price(tp2), style=finalBuy ? label.style_label_up : label.style_label_down, color=finalBuy ? color.new(color.lime, 10) : color.new(color.red, 10), textcolor=finalBuy ? color.black : color.white, size=size.small)

// ============================================================================
// MINI PANEL
// ============================================================================
liqText = sslSwept or asiaLowSwept ? "SSL SWEPT" : bslSwept or asiaHighSwept ? "BSL SWEPT" : "WAIT"
poiText = nearBullPoi ? "BULL POI" : nearBearPoi ? "BEAR POI" : bullFvgs.size() > 0 or bullObs.size() > 0 ? "BULL READY" : bearFvgs.size() > 0 or bearObs.size() > 0 ? "BEAR READY" : "NONE"
statusText = finalBuy ? "BUY" : finalSell ? "SELL" : "WAIT"
maxScore = math.max(scoreBull, scoreBear)

var table panel = table.new(position.bottom_right, 2, 7, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 70))
if showPanel and barstate.islast
    table.cell(panel, 0, 0, "AMY ICT", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 0, "NEXTGEN", text_color=color.yellow, text_size=size.small)
    table.cell(panel, 0, 1, "Bias", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 1, biasText, text_color=biasBull ? color.lime : biasBear ? color.red : color.white, text_size=size.small)
    table.cell(panel, 0, 2, "Session", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 2, sessionText, text_color=validSession ? color.lime : color.gray, text_size=size.small)
    table.cell(panel, 0, 3, "Structure", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 3, trend, text_color=trend == "BULL" ? color.lime : trend == "BEAR" ? color.red : color.white, text_size=size.small)
    table.cell(panel, 0, 4, "Liquidity", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 4, liqText, text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 5, "POI / Score", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 5, poiText + " " + str.tostring(maxScore) + "/7", text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 6, "Status", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 6, statusText, text_color=finalBuy ? color.lime : finalSell ? color.red : color.white, text_size=size.small)

alertcondition(finalBuy, title="AMY ICT BUY", message="AMY ICT NextGen BUY")
alertcondition(finalSell, title="AMY ICT SELL", message="AMY ICT NextGen SELL")