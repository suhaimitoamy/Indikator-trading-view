//@version=6
indicator("AMY Simple ATR Bot", shorttitle="AMY ATR Bot", overlay=true, max_labels_count=500)

//==============================================================================
// AMY SIMPLE ATR BOT
// Konsep utama tetap sederhana:
// ATR trailing stop + crossover harga + satu filter tren EMA.
// Tidak memakai ICT, FVG, OB, scoring, dashboard, atau filter berlapis.
//==============================================================================

//------------------------------------------------------------------------------
// INPUT
//------------------------------------------------------------------------------
groupCore = "Pengaturan Utama"
keyValue = input.float(1.0, "Key Value", minval=0.1, step=0.1, group=groupCore)
atrPeriod = input.int(10, "ATR Period", minval=1, group=groupCore)
useHeikinAshi = input.bool(false, "Signals from Heikin Ashi", group=groupCore)
confirmOnClose = input.bool(true, "Konfirmasi Saat Candle Close", group=groupCore)

groupFilter = "Filter Tren Sederhana"
useTrendFilter = input.bool(true, "Gunakan Filter EMA", group=groupFilter,
     tooltip="BUY hanya di atas EMA dan SELL hanya di bawah EMA untuk mengurangi sinyal bolak-balik saat sideways.")
emaLength = input.int(50, "EMA Length", minval=1, group=groupFilter)

groupVisual = "Visual"
showTrail = input.bool(true, "Tampilkan ATR Trailing Stop", group=groupVisual)
showTrendEma = input.bool(false, "Tampilkan EMA Filter", group=groupVisual)
showLabels = input.bool(true, "Tampilkan Label BUY / SELL", group=groupVisual)
colorBars = input.bool(false, "Warnai Candle Sesuai Arah", group=groupVisual)

//------------------------------------------------------------------------------
// SOURCE
//------------------------------------------------------------------------------
haTicker = ticker.heikinashi(syminfo.tickerid)
haClose = request.security(haTicker, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
src = useHeikinAshi ? haClose : close

//------------------------------------------------------------------------------
// CLASSIC ATR TRAILING STOP
//------------------------------------------------------------------------------
xAtr = ta.atr(atrPeriod)
nLoss = keyValue * xAtr

var float atrTrailingStop = na
prevStop = nz(atrTrailingStop[1], 0.0)
prevSrc = nz(src[1], src)

atrTrailingStop :=
     src > prevStop and prevSrc > prevStop ? math.max(prevStop, src - nLoss) :
     src < prevStop and prevSrc < prevStop ? math.min(prevStop, src + nLoss) :
     src > prevStop ? src - nLoss : src + nLoss

//------------------------------------------------------------------------------
// TREND STATE DAN SINYAL
//------------------------------------------------------------------------------
var int position = 0
position :=
     prevSrc < prevStop and src > prevStop ? 1 :
     prevSrc > prevStop and src < prevStop ? -1 :
     nz(position[1], 0)

// EMA 1 sama dengan source. Mekanisme crossover tetap mengikuti pola
// classic UT Bot Alerts.
emaOne = ta.ema(src, 1)
above = ta.crossover(emaOne, atrTrailingStop)
below = ta.crossover(atrTrailingStop, emaOne)

// Hanya satu filter tambahan agar indikator tetap sederhana.
trendEma = ta.ema(src, emaLength)
buyTrendOk = not useTrendFilter or src > trendEma
sellTrendOk = not useTrendFilter or src < trendEma

confirmed = confirmOnClose ? barstate.isconfirmed : true
buySignal = confirmed and src > atrTrailingStop and above and buyTrendOk
sellSignal = confirmed and src < atrTrailingStop and below and sellTrendOk

//------------------------------------------------------------------------------
// VISUALS
//------------------------------------------------------------------------------
trailColor = position == 1 ? color.lime : position == -1 ? color.red : color.gray
plot(showTrail ? atrTrailingStop : na, "ATR Trailing Stop", color=trailColor, linewidth=2, style=plot.style_linebr)
plot(showTrendEma ? trendEma : na, "EMA Trend Filter", color=color.orange, linewidth=1)

plotshape(showLabels and buySignal, title="BUY", text="BUY", style=shape.labelup,
     location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny)

plotshape(showLabels and sellSignal, title="SELL", text="SELL", style=shape.labeldown,
     location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

barColorValue = colorBars ? (position == 1 ? color.lime : position == -1 ? color.red : na) : na
barcolor(barColorValue)

//------------------------------------------------------------------------------
// ALERTS
//------------------------------------------------------------------------------
alertcondition(buySignal, title="AMY ATR Bot BUY", message="AMY Simple ATR Bot: BUY pada {{ticker}} {{interval}} di {{close}}")
alertcondition(sellSignal, title="AMY ATR Bot SELL", message="AMY Simple ATR Bot: SELL pada {{ticker}} {{interval}} di {{close}}")
alertcondition(buySignal or sellSignal, title="AMY ATR Bot Any Signal", message="AMY Simple ATR Bot: sinyal baru pada {{ticker}} {{interval}} di {{close}}")
