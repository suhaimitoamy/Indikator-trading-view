//@version=6
indicator("AMY Simple ATR Bot v5", shorttitle="AMY ATR Bot v5", overlay=true, max_labels_count=500)

//==============================================================================
// AMY SIMPLE ATR BOT V5
// Tetap sederhana:
// 1) ATR trailing stop.
// 2) Harga memotong trailing stop.
// 3) EMA menentukan arah tren dan harus memiliki kemiringan searah.
// 4) Satu filter anti-exhaustion menolak close yang terlalu dekat ujung candle.
// Tidak memakai filter sesi, ICT, FVG, OB, scoring, atau dashboard.
//==============================================================================

//------------------------------------------------------------------------------
// INPUT
//------------------------------------------------------------------------------
groupCore = "Pengaturan Utama"
keyValue = input.float(3.75, "Key Value", minval=0.1, step=0.05, group=groupCore)
atrPeriod = input.int(20, "ATR Period", minval=1, group=groupCore)
useHeikinAshi = input.bool(false, "Signals from Heikin Ashi", group=groupCore)
confirmOnClose = input.bool(true, "Konfirmasi Saat Candle Close", group=groupCore)

groupTrend = "Filter Tren Sederhana"
useTrendFilter = input.bool(true, "Gunakan Filter EMA", group=groupTrend)
emaLength = input.int(150, "EMA Length", minval=1, group=groupTrend)
emaSlopeBars = input.int(4, "Kemiringan EMA (bar)", minval=1, maxval=20, group=groupTrend,
     tooltip="BUY hanya ketika harga di atas EMA dan EMA naik. SELL hanya ketika harga di bawah EMA dan EMA turun.")

groupExhaustion = "Filter Anti-Exhaustion"
useExhaustionFilter = input.bool(true, "Gunakan Filter Anti-Exhaustion", group=groupExhaustion,
     tooltip="Melewati candle sinyal yang menutup pada 5% ujung ekstrem agar tidak mengejar spike.")
maxClosePosition = input.float(0.95, "Maks. Posisi Close", minval=0.50, maxval=1.00, step=0.01, group=groupExhaustion)

groupVisual = "Visual"
showTrail = input.bool(true, "Tampilkan ATR Trailing Stop", group=groupVisual)
showTrendEma = input.bool(false, "Tampilkan EMA Filter", group=groupVisual)
showLabels = input.bool(true, "Tampilkan Label BUY / SELL", group=groupVisual)
colorBars = input.bool(false, "Warnai Candle Sesuai Arah", group=groupVisual)

//------------------------------------------------------------------------------
// SOURCE
//------------------------------------------------------------------------------
haTicker = ticker.heikinashi(syminfo.tickerid)
haClose = request.security(haTicker, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
src = useHeikinAshi ? haClose : close

//------------------------------------------------------------------------------
// CLASSIC ATR TRAILING STOP
//------------------------------------------------------------------------------
xAtr = ta.atr(atrPeriod)
nLoss = keyValue * xAtr

var float atrTrailingStop = na
prevStop = nz(atrTrailingStop[1], 0.0)
prevSrc = nz(src[1], src)

atrTrailingStop :=
     src > prevStop and prevSrc > prevStop ? math.max(prevStop, src - nLoss) :
     src < prevStop and prevSrc < prevStop ? math.min(prevStop, src + nLoss) :
     src > prevStop ? src - nLoss : src + nLoss

//------------------------------------------------------------------------------
// TREND STATE DAN SINYAL
//------------------------------------------------------------------------------
var int position = 0
position :=
     prevSrc < prevStop and src > prevStop ? 1 :
     prevSrc > prevStop and src < prevStop ? -1 :
     nz(position[1], 0)

emaOne = ta.ema(src, 1)
above = ta.crossover(emaOne, atrTrailingStop)
below = ta.crossover(atrTrailingStop, emaOne)

trendEma = ta.ema(src, emaLength)
trendRising = not na(trendEma[emaSlopeBars]) and trendEma > trendEma[emaSlopeBars]
trendFalling = not na(trendEma[emaSlopeBars]) and trendEma < trendEma[emaSlopeBars]

buyTrendOk = not useTrendFilter or (src > trendEma and trendRising)
sellTrendOk = not useTrendFilter or (src < trendEma and trendFalling)

// Backtest lintas 2025–2026 menunjukkan close tepat di ujung candle lebih sering
// menjadi entry terlambat. Tidak ada pembatasan sesi atau jam trading.
signalRange = math.max(high - low, syminfo.mintick)
buyClosePosition = (src - low) / signalRange
sellClosePosition = (high - src) / signalRange

buyExhaustionOk = not useExhaustionFilter or buyClosePosition <= maxClosePosition
sellExhaustionOk = not useExhaustionFilter or sellClosePosition <= maxClosePosition

confirmed = confirmOnClose ? barstate.isconfirmed : true
buySignal = confirmed and src > atrTrailingStop and above and buyTrendOk and buyExhaustionOk
sellSignal = confirmed and src < atrTrailingStop and below and sellTrendOk and sellExhaustionOk

//------------------------------------------------------------------------------
// VISUALS
//------------------------------------------------------------------------------
trailColor = position == 1 ? color.lime : position == -1 ? color.red : color.gray
plot(showTrail ? atrTrailingStop : na, "ATR Trailing Stop", color=trailColor, linewidth=2, style=plot.style_linebr)
plot(showTrendEma ? trendEma : na, "EMA Trend Filter", color=color.orange, linewidth=1)

plotshape(showLabels and buySignal, title="BUY", text="BUY", style=shape.labelup,
     location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny)

plotshape(showLabels and sellSignal, title="SELL", text="SELL", style=shape.labeldown,
     location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

barColorValue = colorBars ? (position == 1 ? color.lime : position == -1 ? color.red : na) : na
barcolor(barColorValue)

// Data Window untuk audit tanpa menambah objek ke chart.
plot(buyClosePosition, "Posisi Close BUY", display=display.data_window)
plot(sellClosePosition, "Posisi Close SELL", display=display.data_window)

//------------------------------------------------------------------------------
// ALERTS
//------------------------------------------------------------------------------
alertcondition(buySignal, title="AMY ATR Bot BUY", message="AMY Simple ATR Bot v5: BUY pada {{ticker}} {{interval}} di {{close}}")
alertcondition(sellSignal, title="AMY ATR Bot SELL", message="AMY Simple ATR Bot v5: SELL pada {{ticker}} {{interval}} di {{close}}")
alertcondition(buySignal or sellSignal, title="AMY ATR Bot Any Signal", message="AMY Simple ATR Bot v5: sinyal baru pada {{ticker}} {{interval}} di {{close}}")
