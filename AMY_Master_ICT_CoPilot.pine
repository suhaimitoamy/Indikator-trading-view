//@version=5
indicator("AMY Master ICT Co-Pilot [All-in-One]", shorttitle="AMY ICT Co-Pilot", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=3000)

// =============================================================================
// AMY MASTER ICT CO-PILOT [ALL-IN-ONE] - v1.1 (AUDITED & BULLETPROOF)
// -----------------------------------------------------------------------------
// Hasil Audit Logika:
// 1. Anti-Salah Arah (HTF Conflict Guard):
//    - Jika H4 Bearish tapi M15 break naik, Co-Pilot memperingatkan: "Counter-Trend Pullback! Dilarang Buy!"
//    - Hanya mengizinkan sinyal Buy jika H4 Netral/Bullish dan harga di zona Discount (bawah 50%).
// 2. Order Block Murni ICT:
//    - Mengambil candle berlawanan terakhir (Origin Candle) sebelum terjadi impulse break.
// 3. Manajemen Memori Anti-Bocor (Zero Drawing Leak):
//    - Garis PDH/PDL, Asia H/L, dan Equilibrium menggunakan pointer tunggal (line.set_xy) 
//      sehingga tidak pernah melebihi limit 500 line TradingView.
// 4. Anti-Tumpuk Layar HP:
//    - Co-Pilot terintegrasi penuh ke baris atas Dashboard HUD dengan font adaptif.
// =============================================================================

// =============================================================================
// 1. INPUT PENGATURAN
// =============================================================================

// --- Grup 1: Tampilan & Mode Mobile (Anti-Tumpuk) ---
grpVisual       = "1. Tampilan & Mode Mobile (HP)"
mobileMode      = input.bool(true, "Mode Layar HP (Kompak & Anti-Tumpuk)", group=grpVisual, tooltip="Menyatukan teks Co-Pilot ke dalam Dashboard agar tidak menutupi candle di layar vertikal HP.")
copilotStyle    = input.string("Dashboard + Pill", "Format Co-Pilot", options=["Dashboard Saja", "Pill Melayang Saja", "Dashboard + Pill"], group=grpVisual)
showDash        = input.bool(true, "Tampilkan Dashboard Status", group=grpVisual)
dashPos         = input.string("Bottom Right", "Posisi Dashboard", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpVisual)
dashSize        = input.string("Tiny", "Ukuran Font Dashboard", options=["Tiny", "Small", "Normal"], group=grpVisual)

// --- Grup 2: Struktur Pasar & Filter HTF ---
grpStructure    = "2. Struktur Pasar & Filter HTF (Anti-Salah Arah)"
useHtfFilter    = input.bool(true, "Aktifkan Filter Trend HTF", group=grpStructure, tooltip="Wajib aktif untuk mencegah salah arah: menolak buy saat H4 bearish.")
htfTimeframe    = input.timeframe("240", "Timeframe HTF (Trend Induk)", group=grpStructure)
htfEmaLen       = input.int(20, "Periode HTF EMA", minval=5, maxval=200, group=grpStructure)
m15SwingLen     = input.int(5, "Swing Lookback M15", minval=3, maxval=15, group=grpStructure, tooltip="Default 5 bar untuk menyaring noise micro-candle di Gold.")
dispThreshold   = input.float(1.1, "Minimal Rasio Displacement", minval=0.5, step=0.1, group=grpStructure, tooltip="Valid break harus memiliki candle impulsif (body >= threshold * ATR).")
showStructure   = input.bool(true, "Garis BOS & MSS di Chart", group=grpStructure)

// --- Grup 3: Level Kunci & Sesi ICT ---
grpLevels       = "3. Level Kunci & Sesi ICT"
showPdhPdl      = input.bool(true, "Tampilkan PDH / PDL", group=grpLevels)
showAsiaRange   = input.bool(true, "Tampilkan Asia High / Low", group=grpLevels)
asiaSession     = input.session("0600-1400", "Jam Sesi Asia (WITA / UTC+8)", group=grpLevels)
tzString        = input.string("Asia/Makassar", "Zona Waktu", group=grpLevels)
showDealingRange= input.bool(true, "Dealing Range & 50% Equilibrium", group=grpLevels)

// --- Grup 4: Order Flow (OB, FVG & Liquidity Sweep) ---
grpOrderFlow    = "4. Order Flow (OB, FVG & Sweep)"
showOB          = input.bool(true, "Tampilkan Order Block (OB)", group=grpOrderFlow)
obSearchBars    = input.int(8, "Lookback Cari Origin Candle OB", minval=3, maxval=20, group=grpOrderFlow)
maxObBoxes      = input.int(4, "Maksimal Box OB Aktif", minval=1, maxval=10, group=grpOrderFlow)
showFvg         = input.bool(true, "Tampilkan FVG (+ 50% CE Midline)", group=grpOrderFlow)
maxFvgBoxes     = input.int(4, "Maksimal Box FVG Aktif", minval=1, maxval=10, group=grpOrderFlow)
showSweeps      = input.bool(true, "Tampilkan Marker Liquidity Sweep", group=grpOrderFlow)
nearPoiAtrDist  = input.float(0.40, "Jarak Deteksi 'Mendekati POI' (ATR)", minval=0.1, maxval=2.0, step=0.05, group=grpOrderFlow)

// --- Grup 5: Entry Engine & Alert ---
grpEntry        = "5. Sniper Entry Engine & Alert"
showEntrySignal = input.bool(true, "Tampilkan Sinyal Entry Konfirmasi", group=grpEntry)
minScoreToTrade = input.int(60, "Ambang Skor Confluence Minimal (%)", minval=40, maxval=90, group=grpEntry)
slAtrMult       = input.float(0.35, "Buffer SL dari Titik Struktur (ATR)", minval=0.1, maxval=2.0, step=0.05, group=grpEntry)
tp1RrRatio      = input.float(1.0, "Target TP1 (RR)", minval=0.5, step=0.5, group=grpEntry)
tp2RrRatio      = input.float(2.0, "Target TP2 (RR)", minval=1.0, step=0.5, group=grpEntry)
showTradeLines  = input.bool(true, "Tampilkan Garis SL & TP Live", group=grpEntry)

// =============================================================================
// 2. FUNGSI UTILITAS & PENDUKUNG
// =============================================================================

f_pos(pos) =>
    pos == "Top Left" ? position.top_left :
     pos == "Bottom Right" ? position.bottom_right :
     pos == "Bottom Left" ? position.bottom_left : position.top_right

f_size(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal

f_price(p) =>
    na(p) ? "-" : str.tostring(p, format.mintick)

// ATR & Momentum Dasar
atrVal = ta.atr(14)
candleBody = math.abs(close - open)
meanBody = ta.sma(candleBody, 20)
isDisplacement = candleBody >= (atrVal * dispThreshold)

// =============================================================================
// 3. LOGIKA HTF BIAS (ANTI-SALAH ARAH)
// =============================================================================

[htfClose, htfEma] = request.security(syminfo.tickerid, htfTimeframe, [close[1], ta.ema(close, htfEmaLen)[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfBias = useHtfFilter ? (htfClose > htfEma ? 1 : htfClose < htfEma ? -1 : 0) : 0
htfBiasText = htfBias == 1 ? "BULLISH ↑" : htfBias == -1 ? "BEARISH ↓" : "NETRAL"
htfBiasColor = htfBias == 1 ? color.teal : htfBias == -1 ? color.maroon : color.gray

// =============================================================================
// 4. STRUKTUR PASAR M15 (BOS, MSS, INVALIDATION)
// =============================================================================

ph = ta.pivothigh(high, m15SwingLen, m15SwingLen)
pl = ta.pivotlow(low, m15SwingLen, m15SwingLen)

var float lastPH = na
var float lastPL = na
var float invalidLevel = na
var int marketBias = 0 // 1: Bullish, -1: Bearish
var int mssEvent = 0   // 1: Bull MSS, -1: Bear MSS, 0: None

if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// Valid Break: Close melewati swing point + dikonfirmasi candle displacement
bullValidBreak = not na(lastPH) and close > lastPH and close[1] <= lastPH and isDisplacement
bearValidBreak = not na(lastPL) and close < lastPL and close[1] >= lastPL and isDisplacement

// Update Struktur Pasar
if bullValidBreak and marketBias != 1
    marketBias := 1
    mssEvent := 1
    invalidLevel := lastPL
else if bearValidBreak and marketBias != -1
    marketBias := -1
    mssEvent := -1
    invalidLevel := lastPH
else
    mssEvent := 0

// Deteksi Pembatalan Setup (Invalidation)
var bool setupInvalid = false
if marketBias == 1 and not na(invalidLevel) and close < invalidLevel
    marketBias := 0
    setupInvalid := true
else if marketBias == -1 and not na(invalidLevel) and close > invalidLevel
    marketBias := 0
    setupInvalid := true
else
    setupInvalid := false

// =============================================================================
// 5. LEVEL KUNCI ICT (PDH, PDL, ASIA RANGE, DEALING RANGE)
// =============================================================================

// Daily High & Low (Closed bar sebelumnya agar non-repaint)
[pdhVal, pdlVal] = request.security(syminfo.tickerid, "D", [high[1], low[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Sesi Asia (WITA / UTC+8)
inAsia = not na(time(timeframe.period, asiaSession, tzString))
var float asiaHigh = na
var float asiaLow = na

if inAsia
    if not inAsia[1]
        asiaHigh := high
        asiaLow := low
    else
        asiaHigh := math.max(asiaHigh, high)
        asiaLow := math.min(asiaLow, low)

// Dealing Range & 50% Equilibrium
rangeHigh = ta.highest(high, 80)
rangeLow = ta.lowest(low, 80)
equilibrium = (rangeHigh + rangeLow) / 2.0
isDiscount = close < equilibrium
isPremium = close > equilibrium

// Pointer Tunggal Garis Level (Anti Memory Leak / Anti Batas 500 Garis)
var line pdhLine = na
var line pdlLine = na
var line eqLine = na
var line asiaHLine = na
var line asiaLLine = na

if barstate.islast
    if showPdhPdl and not na(pdhVal)
        if na(pdhLine)
            pdhLine := line.new(bar_index - 50, pdhVal, bar_index + 10, pdhVal, color=color.new(color.red, 30), width=1)
            pdlLine := line.new(bar_index - 50, pdlVal, bar_index + 10, pdlVal, color=color.new(color.green, 30), width=1)
        else
            line.set_xy1(pdhLine, bar_index - 50, pdhVal)
            line.set_xy2(pdhLine, bar_index + 10, pdhVal)
            line.set_xy1(pdlLine, bar_index - 50, pdlVal)
            line.set_xy2(pdlLine, bar_index + 10, pdlVal)

    if showDealingRange and not na(equilibrium)
        if na(eqLine)
            eqLine := line.new(bar_index - 80, equilibrium, bar_index + 10, equilibrium, color=color.new(color.yellow, 50), style=line.style_dashed, width=1)
        else
            line.set_xy1(eqLine, bar_index - 80, equilibrium)
            line.set_xy2(eqLine, bar_index + 10, equilibrium)

    if showAsiaRange and not na(asiaHigh)
        if na(asiaHLine)
            asiaHLine := line.new(bar_index - 40, asiaHigh, bar_index + 10, asiaHigh, color=color.new(color.purple, 40), width=1)
            asiaLLine := line.new(bar_index - 40, asiaLow, bar_index + 10, asiaLow, color=color.new(color.purple, 40), width=1)
        else
            line.set_xy1(asiaHLine, bar_index - 40, asiaHigh)
            line.set_xy2(asiaHLine, bar_index + 10, asiaHigh)
            line.set_xy1(asiaLLine, bar_index - 40, asiaLow)
            line.set_xy2(asiaLLine, bar_index + 10, asiaLow)

// =============================================================================
// 6. ORDER FLOW: TEXTBOOK OB, FVG (+50% CE), & LIQUIDITY SWEEP
// =============================================================================

// --- Liquidity Sweeps ---
bslSweep = not na(lastPH) and high > lastPH and close < lastPH
sslSweep = not na(lastPL) and low < lastPL and close > lastPL

var int lastSweepDir = 0
var int lastSweepBar = na
if sslSweep
    lastSweepDir := 1 // Sweep SSL -> Indikasi Reversal Naik
    lastSweepBar := bar_index
if bslSweep
    lastSweepDir := -1 // Sweep BSL -> Indikasi Reversal Turun
    lastSweepBar := bar_index

// Kadaluarsa status sweep setelah 15 bar
if not na(lastSweepBar) and (bar_index - lastSweepBar > 15)
    lastSweepDir := 0

// --- Order Block (Textbook Origin Candle) ---
var box[] bullObBoxes = array.new_box()
var box[] bearObBoxes = array.new_box()
var float activeBullObTop = na
var float activeBullObBtm = na
var float activeBearObTop = na
var float activeBearObBtm = na

// Bullish OB: Cari candle bearish terakhir sebelum terjadi break naik
if bullValidBreak
    int obOffset = na
    for i = 1 to obSearchBars
        if na(obOffset) and close[i] < open[i]
            obOffset := i
    if not na(obOffset)
        activeBullObTop := math.max(open[obOffset], close[obOffset])
        activeBullObBtm := low[obOffset]
        if showOB and barstate.isconfirmed
            bBox = box.new(bar_index - obOffset, activeBullObTop, bar_index + 15, activeBullObBtm, border_color=color.green, bgcolor=color.new(color.green, 85))
            array.push(bullObBoxes, bBox)
            if array.size(bullObBoxes) > maxObBoxes
                box.delete(array.shift(bullObBoxes))

// Bearish OB: Cari candle bullish terakhir sebelum terjadi break turun
if bearValidBreak
    int obOffsetB = na
    for i = 1 to obSearchBars
        if na(obOffsetB) and close[i] > open[i]
            obOffsetB := i
    if not na(obOffsetB)
        activeBearObTop := high[obOffsetB]
        activeBearObBtm := math.min(open[obOffsetB], close[obOffsetB])
        if showOB and barstate.isconfirmed
            brBox = box.new(bar_index - obOffsetB, activeBearObTop, bar_index + 15, activeBearObBtm, border_color=color.red, bgcolor=color.new(color.red, 85))
            array.push(bearObBoxes, brBox)
            if array.size(bearObBoxes) > maxObBoxes
                box.delete(array.shift(bearObBoxes))

// --- Fair Value Gaps (FVG) + 50% Consequent Encroachment (CE) ---
bullFvg = low > high[2] and close[1] > high[2]
bearFvg = high < low[2] and close[1] < low[2]
var float activeBullFvgTop = na
var float activeBullFvgBtm = na
var float activeBearFvgTop = na
var float activeBearFvgBtm = na

var box[] fvgBoxes = array.new_box()

if bullFvg
    activeBullFvgTop := low
    activeBullFvgBtm := high[2]
    if showFvg and barstate.isconfirmed
        bxFvg = box.new(bar_index - 1, activeBullFvgTop, bar_index + 15, activeBullFvgBtm, border_color=color.teal, bgcolor=color.new(color.teal, 90))
        array.push(fvgBoxes, bxFvg)
        if array.size(fvgBoxes) > maxFvgBoxes
            box.delete(array.shift(fvgBoxes))

if bearFvg
    activeBearFvgTop := low[2]
    activeBearFvgBtm := high
    if showFvg and barstate.isconfirmed
        bxFvgB = box.new(bar_index - 1, activeBearFvgTop, bar_index + 15, activeBearFvgBtm, border_color=color.orange, bgcolor=color.new(color.orange, 90))
        array.push(fvgBoxes, bxFvgB)
        if array.size(fvgBoxes) > maxFvgBoxes
            box.delete(array.shift(fvgBoxes))

// Proximity & Zona Sentuhan POI
nearBullOb  = not na(activeBullObTop) and close > activeBullObTop and (close - activeBullObTop) <= (atrVal * nearPoiAtrDist)
inBullOb    = not na(activeBullObTop) and close <= activeBullObTop and close >= activeBullObBtm
nearBearOb  = not na(activeBearObBtm) and close < activeBearObBtm and (activeBearObBtm - close) <= (atrVal * nearPoiAtrDist)
inBearOb    = not na(activeBearObBtm) and close >= activeBearObBtm and close <= activeBearObTop

nearBullFvg = not na(activeBullFvgTop) and close > activeBullFvgTop and (close - activeBullFvgTop) <= (atrVal * nearPoiAtrDist)
inBullFvg   = not na(activeBullFvgTop) and close <= activeBullFvgTop and close >= activeBullFvgBtm
nearBearFvg = not na(activeBearFvgBtm) and close < activeBearFvgBtm and (activeBearFvgBtm - close) <= (atrVal * nearPoiAtrDist)
inBearFvg   = not na(activeBearFvgBtm) and close >= activeBearFvgBtm and close <= activeBearFvgTop

// Rejection Wick
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
bullRejection = (inBullOb or inBullFvg) and lowerWick >= (candleBody * 1.2) and close > open
bearRejection = (inBearOb or inBearFvg) and upperWick >= (candleBody * 1.2) and close < open

// =============================================================================
// 7. MULTI-LAYER CONFLUENCE SCORING ENGINE (0 - 100%)
// =============================================================================

int bullScore = 0
int bearScore = 0

// Layer 1: HTF Trend Alignment (25 Poin)
if htfBias == 1
    bullScore += 25
else if htfBias == -1
    bearScore += 25

// Layer 2: M15 Structural Bias / Valid Break (20 Poin)
if marketBias == 1 or bullValidBreak
    bullScore += 20
if marketBias == -1 or bearValidBreak
    bearScore += 20

// Layer 3: Liquidity Swept (20 Poin)
if lastSweepDir == 1 or sslSweep
    bullScore += 20
if lastSweepDir == -1 or bslSweep
    bearScore += 20

// Layer 4: POI Alignment & Touch (15 Poin)
if inBullOb or inBullFvg
    bullScore += 15
else if nearBullOb or nearBullFvg
    bullScore += 8

if inBearOb or inBearFvg
    bearScore += 15
else if nearBearOb or nearBearFvg
    bearScore += 8

// Layer 5: Price Location (Discount vs Premium) (10 Poin)
if isDiscount
    bullScore += 10
if isPremium
    bearScore += 10

// Layer 6: Rejection Wick Confirm (10 Poin)
if bullRejection
    bullScore += 10
if bearRejection
    bearScore += 10

// Evaluasi Sinyal Final dengan Penjaga HTF (HTF Guard)
validLongSetup  = bullScore >= minScoreToTrade and (htfBias >= 0) and not setupInvalid and isDiscount
validShortSetup = bearScore >= minScoreToTrade and (htfBias <= 0) and not setupInvalid and isPremium

longTrigger  = validLongSetup and not validLongSetup[1] and barstate.isconfirmed
shortTrigger = validShortSetup and not validShortSetup[1] and barstate.isconfirmed

// =============================================================================
// 8. LIVE CO-PILOT NARRATIVE ENGINE (CERDAS & ANTI-SALAH ARAH)
// =============================================================================

var string coPilotText = "Menunggu formasi struktur pasar..."
var color coPilotColor = color.gray
var color coPilotBg    = color.new(color.black, 20)

// Kasus 1: Setup Batal
if setupInvalid
    coPilotText  := "⚠ Setup Batal: Harga close menembus invalidasi!"
    coPilotColor := color.red
    coPilotBg    := color.new(color.maroon, 15)

// Kasus 2: Sinyal Sniper Terkonfirmasi
else if longTrigger
    coPilotText  := "🚀 Sniper BUY Confirmed (" + str.tostring(bullScore) + "%)\nRejection di Discount + HTF Selaras"
    coPilotColor := color.lime
    coPilotBg    := color.new(color.green, 20)

else if shortTrigger
    coPilotText  := "🔻 Sniper SELL Confirmed (" + str.tostring(bearScore) + "%)\nRejection di Premium + HTF Selaras"
    coPilotColor := color.orange
    coPilotBg    := color.new(color.red, 20)

// Kasus 3: Rejection di POI
else if bullRejection and htfBias >= 0
    coPilotText  := "📍 Rejection Bullish di POI!\nPantau konfirmasi candle close untuk Buy"
    coPilotColor := color.teal
    coPilotBg    := color.new(color.teal, 30)

else if bearRejection and htfBias <= 0
    coPilotText  := "📍 Rejection Bearish di POI!\nPantau konfirmasi candle close untuk Sell"
    coPilotColor := color.orange
    coPilotBg    := color.new(color.maroon, 30)

// Kasus 4: Harga Masuk Zona POI
else if inBullOb
    if htfBias == -1
        coPilotText  := "📍 Di Bull OB tapi H4 Bearish!\nHati-hati jebakan, jangan buru-buru buy"
        coPilotColor := color.yellow
        coPilotBg    := color.new(color.darkgray, 20)
    else
        coPilotText  := "📍 Harga masuk Bull OB\nTunggu reaksi rejection candle"
        coPilotColor := color.lime
        coPilotBg    := color.new(color.darkgray, 20)

else if inBearOb
    if htfBias == 1
        coPilotText  := "📍 Di Bear OB tapi H4 Bullish!\nHati-hati jebakan, jangan buru-buru sell"
        coPilotColor := color.yellow
        coPilotBg    := color.new(color.darkgray, 20)
    else
        coPilotText  := "📍 Harga masuk Bear OB\nTunggu reaksi rejection candle"
        coPilotColor := color.red
        coPilotBg    := color.new(color.darkgray, 20)

// Kasus 5: Harga Mendekati POI
else if nearBullOb and htfBias >= 0
    coPilotText  := "👀 Harga mendekati Bull OB\nBersiap pantau reaksi di zona pantul"
    coPilotColor := color.yellow
    coPilotBg    := color.new(color.darkgray, 30)

else if nearBearOb and htfBias <= 0
    coPilotText  := "👀 Harga mendekati Bear OB\nBersiap pantau reaksi di zona pantul"
    coPilotColor := color.yellow
    coPilotBg    := color.new(color.darkgray, 30)

// Kasus 6: Valid Break (Dengan Proteksi Konflik HTF)
else if bullValidBreak
    if htfBias == -1
        coPilotText  := "⚠ Valid Break Bullish TAPI H4 Bearish!\nPotensi koreksi sementara — Dilarang Buy!"
        coPilotColor := color.yellow
        coPilotBg    := color.new(color.maroon, 25)
    else
        coPilotText  := "✓ Valid Break Bullish + Displacement\nStruktur M15 selaras H4, siap cari Buy"
        coPilotColor := color.lime
        coPilotBg    := color.new(color.green, 30)

else if bearValidBreak
    if htfBias == 1
        coPilotText  := "⚠ Valid Break Bearish TAPI H4 Bullish!\nPotensi koreksi sementara — Dilarang Sell!"
        coPilotColor := color.yellow
        coPilotBg    := color.new(color.maroon, 25)
    else
        coPilotText  := "✓ Valid Break Bearish + Displacement\nStruktur M15 selaras H4, siap cari Sell"
        coPilotColor := color.red
        coPilotBg    := color.new(color.red, 30)

// Kasus 7: Liquidity Sweeps
else if sslSweep
    coPilotText  := "💧 SSL Swept (Likuiditas Bawah Terambil)\nCari konfirmasi buy jika di Discount"
    coPilotColor := color.aqua
    coPilotBg    := color.new(color.blue, 30)

else if bslSweep
    coPilotText  := "💧 BSL Swept (Likuiditas Atas Terambil)\nCari konfirmasi sell jika di Premium"
    coPilotColor := color.aqua
    coPilotBg    := color.new(color.blue, 30)

// Kasus 8: Peringatan Posisi Zona
else if isPremium and marketBias == 1
    coPilotText  := "📊 Posisi di Premium (Atas 50%)\nBukan zona ideal Buy, tunggu pullback"
    coPilotColor := color.orange
    coPilotBg    := color.new(color.darkgray, 40)

else if isDiscount and marketBias == -1
    coPilotText  := "📊 Posisi di Discount (Bawah 50%)\nBukan zona ideal Sell, tunggu retracement"
    coPilotColor := color.orange
    coPilotBg    := color.new(color.darkgray, 40)

// =============================================================================
// 9. VISUALISASI CHART & HUD (MOBILE-CLEAN LAYOUT)
// =============================================================================

// Sinyal Panah Entry di Chart
plotshape(showEntrySignal and longTrigger, title="Sinyal Sniper Buy", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(showEntrySignal and shortTrigger, title="Sinyal Sniper Sell", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// Trade Management Lines (SL & TP Live)
var line longSlLine = na
var line longTp1Line = na
var line longTp2Line = na
var line shortSlLine = na
var line shortTp1Line = na
var line shortTp2Line = na

if longTrigger and showTradeLines
    longSl = not na(invalidLevel) ? invalidLevel - (atrVal * slAtrMult) : low - (atrVal * 1.5)
    riskDist = close - longSl
    longTp1 = close + (riskDist * tp1RrRatio)
    longTp2 = close + (riskDist * tp2RrRatio)
    line.delete(longSlLine)
    line.delete(longTp1Line)
    line.delete(longTp2Line)
    longSlLine  := line.new(bar_index, longSl, bar_index + 20, longSl, color=color.red, style=line.style_solid, width=2)
    longTp1Line := line.new(bar_index, longTp1, bar_index + 20, longTp1, color=color.green, style=line.style_dashed, width=1)
    longTp2Line := line.new(bar_index, longTp2, bar_index + 20, longTp2, color=color.teal, style=line.style_solid, width=2)

if shortTrigger and showTradeLines
    shortSl = not na(invalidLevel) ? invalidLevel + (atrVal * slAtrMult) : high + (atrVal * 1.5)
    riskDist = shortSl - close
    shortTp1 = close - (riskDist * tp1RrRatio)
    shortTp2 = close - (riskDist * tp2RrRatio)
    line.delete(shortSlLine)
    line.delete(shortTp1Line)
    line.delete(shortTp2Line)
    shortSlLine  := line.new(bar_index, shortSl, bar_index + 20, shortSl, color=color.red, style=line.style_solid, width=2)
    shortTp1Line := line.new(bar_index, shortTp1, bar_index + 20, shortTp1, color=color.green, style=line.style_dashed, width=1)
    shortTp2Line := line.new(bar_index, shortTp2, bar_index + 20, shortTp2, color=color.teal, style=line.style_solid, width=2)

// Floating Pill (Jika diaktifkan dan bukan mode Dashboard Saja)
var label copilotPill = na
if (copilotStyle == "Pill Melayang Saja" or copilotStyle == "Dashboard + Pill")
    if not mobileMode or copilotStyle == "Pill Melayang Saja"
        label.delete(copilotPill)
        copilotPill := label.new(bar_index + 3, close, coPilotText, xloc=xloc.bar_index, style=label.style_label_left, color=coPilotBg, textcolor=coPilotColor, size=f_size(dashSize))

// =============================================================================
// 10. UNIFIED COCKPIT DASHBOARD (ANTI-TUMPUK DI HP)
// =============================================================================

var table hud = table.new(f_pos(dashPos), 2, 6, bgcolor=color.new(#131722, 10), border_color=color.new(#363c4e, 30), border_width=1)

if showDash and barstate.islast
    // Header Co-Pilot (Menyatu dalam Dashboard agar rapi di HP)
    table.cell(hud, 0, 0, "AMY CO-PILOT", bgcolor=color.new(#1e222d, 0), text_color=color.white, text_size=f_size(dashSize))
    table.cell(hud, 1, 0, coPilotText, bgcolor=coPilotBg, text_color=coPilotColor, text_size=f_size(dashSize))

    // Baris 1: HTF Trend Filter
    table.cell(hud, 0, 1, "HTF Trend (" + htfTimeframe + ")", text_color=color.silver, text_size=f_size(dashSize))
    table.cell(hud, 1, 1, htfBiasText, bgcolor=color.new(htfBiasColor, 80), text_color=htfBiasColor, text_size=f_size(dashSize))

    // Baris 2: M15 Structure
    m15Text = marketBias == 1 ? "BULLISH (MSS/BOS)" : marketBias == -1 ? "BEARISH (MSS/BOS)" : "KONSOLIDASI"
    m15Color = marketBias == 1 ? color.lime : marketBias == -1 ? color.red : color.gray
    table.cell(hud, 0, 2, "Struktur M15", text_color=color.silver, text_size=f_size(dashSize))
    table.cell(hud, 1, 2, m15Text, bgcolor=color.new(m15Color, 80), text_color=m15Color, text_size=f_size(dashSize))

    // Baris 3: Zona Dealing Range
    zoneText = isDiscount ? "DISCOUNT (Bawah 50%)" : "PREMIUM (Atas 50%)"
    zoneColor = isDiscount ? color.green : color.red
    table.cell(hud, 0, 3, "Dealing Range", text_color=color.silver, text_size=f_size(dashSize))
    table.cell(hud, 1, 3, zoneText, bgcolor=color.new(zoneColor, 85), text_color=zoneColor, text_size=f_size(dashSize))

    // Baris 4: Status Likuiditas
    sweepText = lastSweepDir == 1 ? "SSL Terambil (Siap Buy)" : lastSweepDir == -1 ? "BSL Terambil (Siap Sell)" : "Belum Ada Sweep"
    sweepCol = lastSweepDir == 1 ? color.teal : lastSweepDir == -1 ? color.orange : color.silver
    table.cell(hud, 0, 4, "Liquidity Sweep", text_color=color.silver, text_size=f_size(dashSize))
    table.cell(hud, 1, 4, sweepText, bgcolor=color.new(sweepCol, 85), text_color=sweepCol, text_size=f_size(dashSize))

    // Baris 5: Confluence Score
    activeScore = marketBias == 1 ? bullScore : marketBias == -1 ? bearScore : math.max(bullScore, bearScore)
    scoreCol = activeScore >= 75 ? color.lime : activeScore >= 60 ? color.yellow : color.orange
    table.cell(hud, 0, 5, "Confluence Score", text_color=color.silver, text_size=f_size(dashSize))
    table.cell(hud, 1, 5, str.tostring(activeScore) + "%", bgcolor=color.new(scoreCol, 80), text_color=scoreCol, text_size=f_size(dashSize))

// =============================================================================
// 11. SISTEM ALERT UNIVERSAL
// =============================================================================

// Hidden plot untuk mapping data ke alert TradingView
plot(bullScore, "Bull Confluence Score", display=display.none)
plot(bearScore, "Bear Confluence Score", display=display.none)

alertcondition(longTrigger, title="[AMY] Sniper BUY Confirmed", message="[AMY CO-PILOT] Sniper BUY Confirmed! Skor: {{plot_0}}% | SL: {{plot_1}} | TP: {{plot_2}}")
alertcondition(shortTrigger, title="[AMY] Sniper SELL Confirmed", message="[AMY CO-PILOT] Sniper SELL Confirmed! Skor: {{plot_0}}% | SL: {{plot_1}} | TP: {{plot_2}}")
alertcondition(bullValidBreak, title="[AMY] Valid Break Bullish", message="[AMY CO-PILOT] Valid Break Bullish dengan Displacement terkonfirmasi!")
alertcondition(bearValidBreak, title="[AMY] Valid Break Bearish", message="[AMY CO-PILOT] Valid Break Bearish dengan Displacement terkonfirmasi!")
alertcondition(sslSweep, title="[AMY] SSL Swept", message="[AMY CO-PILOT] Sell-Side Liquidity (SSL) swept! Pantau konfirmasi buy.")
alertcondition(bslSweep, title="[AMY] BSL Swept", message="[AMY CO-PILOT] Buy-Side Liquidity (BSL) swept! Pantau konfirmasi sell.")
alertcondition(setupInvalid, title="[AMY] Setup Batal (Invalidated)", message="[AMY CO-PILOT] Setup batal! Harga telah menembus level proteksi/invalidasi.")
