//@version=6
indicator("XAUUSD SnR Breakout Base", overlay = true, max_labels_count = 500)

//==================== 1. INPUTS ====================//
grpSnR = "SnR Settings"
levelTf = input.timeframe("5", "Structure Timeframe", group = grpSnR)
swingLen = input.int(5, "Swing Length", minval = 1, group = grpSnR)

grpBreak = "Breakout Filters"
atrLen = input.int(14, "ATR Period", group = grpBreak)
minBreakAtr = input.float(0.5, "Min Breakout Body (ATR)", minval = 0.1, step = 0.1, group = grpBreak)

//==================== 2. CORE SNR LOGIC (Extracted from v7) ====================//
levelTfIsHigher = timeframe.in_seconds(levelTf) > timeframe.in_seconds()

// Pivot Detection (100% Anti-Repaint)
levelPh = levelTfIsHigher ? request.security(syminfo.tickerid, levelTf, ta.pivothigh(high, swingLen, swingLen), lookahead = barmerge.lookahead_off) : ta.pivothigh(high, swingLen, swingLen)
levelPl = levelTfIsHigher ? request.security(syminfo.tickerid, levelTf, ta.pivotlow(low, swingLen, swingLen), lookahead = barmerge.lookahead_off) : ta.pivotlow(low, swingLen, swingLen)

var float activeRes = na
var float activeSup = na

// Update level hanya jika pivot baru terbentuk
if not na(levelPh)
    activeRes := levelPh
if not na(levelPl)
    activeSup := levelPl

//==================== 3. DATA & VOLATILITY ====================//
atr = ta.atr(atrLen)
body = math.abs(close - open)
isBull = close > open
isBear = close < open

//==================== 4. BREAKOUT DETECTION ====================//
// Breakout SAH jika: 
// 1. Close menembus level.
// 2. Body candle lebih besar dari standar ATR (Bukan fakeout wick).
// 3. Candle sudah benar-benar tertutup rapat (isconfirmed).

bool isBreakUp = not na(activeRes) and close > activeRes and isBull and body > (atr * minBreakAtr) and barstate.isconfirmed
bool isBreakDown = not na(activeSup) and close < activeSup and isBear and body > (atr * minBreakAtr) and barstate.isconfirmed

//==================== 5. VISUALS ====================//
// Gambar Garis SnR
plot(activeRes, "Resistance", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
plot(activeSup, "Support", color = color.new(color.blue, 0), style = plot.style_linebr, linewidth = 2)

// Cetak Label Breakout
if isBreakUp
    label.new(bar_index, high, "BREAK\nUP", color = color.green, textcolor = color.white, style = label.style_label_down, size = size.tiny)
if isBreakDown
    label.new(bar_index, low, "BREAK\nDOWN", color = color.red, textcolor = color.white, style = label.style_label_up, size = size.tiny)
