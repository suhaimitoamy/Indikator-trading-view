//@version=5
indicator("AMY Adaptive Regime Compass 2019-2026", shorttitle="AMY Regime Compass", overlay=true, max_labels_count=300, max_lines_count=20)

// ============================================================================
// AMY ADAPTIVE REGIME COMPASS — STATE MACHINE
// Built from XAUUSD candle behavior observed across 2019-July 2026.
// This is a market-direction indicator, not a strategy and not an entry system.
// Best used on M5 and M15.
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// Visual settings
// ─────────────────────────────────────────────────────────────────────────────
grpVisual = "Tampilan"
showDashboard = input.bool(true, "Tampilkan dashboard", group=grpVisual)
showEma = input.bool(true, "Tampilkan EMA 21 / 55 / 200", group=grpVisual)
showBackground = input.bool(true, "Warnai latar sesuai arah resmi", group=grpVisual)
showMarkers = input.bool(true, "Tampilkan riwayat Buy / Sell", group=grpVisual)

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
f_clamp(_x, _lo, _hi) =>
    math.max(_lo, math.min(_hi, _x))

f_sign(_x) =>
    _x > 0 ? 1 : _x < 0 ? -1 : 0

f_direction_text(_score) =>
    na(_score) ? "?" : _score > 0.12 ? "BULLISH" : _score < -0.12 ? "BEARISH" : "NETRAL"

f_price_text(_price) =>
    na(_price) ? "-" : str.tostring(_price, format.mintick)

f_bias_color(_bias) =>
    _bias == 1 ? color.new(color.lime, 0) : _bias == -1 ? color.new(color.red, 0) : color.new(color.orange, 0)

// ─────────────────────────────────────────────────────────────────────────────
// Context engine
// Values are normalized by ATR so the rules survive large price-level changes.
// ─────────────────────────────────────────────────────────────────────────────
f_context() =>
    _tick = math.max(syminfo.mintick, 0.0000001)
    _atr = ta.atr(14)
    _atrSafe = math.max(_atr, _tick)
    _ema21 = ta.ema(close, 21)
    _ema55 = ta.ema(close, 55)
    _ema200 = ta.ema(close, 200)
    [_plusDi, _minusDi, _adx] = ta.dmi(14, 14)

    _directionalChange = math.abs(close - close[20])
    _pathTravel = math.sum(math.abs(close - close[1]), 20)
    _efficiency = _pathTravel > 0 ? _directionalChange / _pathTravel : 0.0

    _priorHigh = ta.highest(high[1], 20)
    _priorLow = ta.lowest(low[1], 20)
    _channelMid = (_priorHigh + _priorLow) * 0.5
    _channelHalf = math.max((_priorHigh - _priorLow) * 0.5, _tick)
    _channelPosition = f_clamp((close - _channelMid) / _channelHalf, -1.5, 1.5) / 1.5

    _fastTrend = (_ema21 - _ema55) / (_atrSafe * 1.20)
    _slowTrend = (_ema55 - _ema200) / (_atrSafe * 2.00)
    _slope = (_ema55 - _ema55[8]) / (_atrSafe * 1.40)
    _momentum = (close - close[12]) / (_atrSafe * 2.00)

    _score =
         0.32 * (_fastTrend / (1.0 + math.abs(_fastTrend))) +
         0.28 * (_slowTrend / (1.0 + math.abs(_slowTrend))) +
         0.16 * (_slope / (1.0 + math.abs(_slope))) +
         0.14 * _channelPosition +
         0.10 * (_momentum / (1.0 + math.abs(_momentum)))
    _score := f_clamp(_score, -1.0, 1.0)

    _bosUp = not na(_priorHigh) and close > _priorHigh and close[1] <= _priorHigh[1]
    _bosDown = not na(_priorLow) and close < _priorLow and close[1] >= _priorLow[1]
    _sweepLow = not na(_priorLow) and low < _priorLow and close > _priorLow
    _sweepHigh = not na(_priorHigh) and high > _priorHigh and close < _priorHigh
    _barsSinceSweepLow = ta.barssince(_sweepLow)
    _barsSinceSweepHigh = ta.barssince(_sweepHigh)
    _recentSweepLow = not na(_barsSinceSweepLow) and _barsSinceSweepLow <= 12
    _recentSweepHigh = not na(_barsSinceSweepHigh) and _barsSinceSweepHigh <= 12
    _bullMss = _bosUp and _recentSweepLow
    _bearMss = _bosDown and _recentSweepHigh

    _trueRange = ta.tr(true)
    _atrBase = ta.sma(_atr, 100)
    _atrRatio = not na(_atrBase) and _atrBase > 0 ? _atr / _atrBase : 1.0
    _candleRange = math.max(high - low, _tick)
    _bodyRatio = math.abs(close - open) / _candleRange
    _expansionUp = _atrRatio >= 1.20 and _trueRange / _atrSafe >= 1.25 and _bodyRatio >= 0.55 and close > open
    _expansionDown = _atrRatio >= 1.20 and _trueRange / _atrSafe >= 1.25 and _bodyRatio >= 0.55 and close < open

    // 1 = trend, 2 = range, 0 = transition.
    _regime = _adx >= 19.0 and _efficiency >= 0.16 and math.abs(_score) >= 0.18 ? 1 :
         _adx <= 16.0 or _efficiency <= 0.10 ? 2 : 0

    [_score, _regime, _ema21, _ema55, _ema200, _atr, _priorHigh, _priorLow, _bosUp, _bosDown, _bullMss, _bearMss, _expansionUp, _expansionDown]

// Confirmed higher-timeframe context only. The offset prevents a live HTF candle
// from changing an already displayed historical decision.
f_context_confirmed() =>
    [_score, _regime, _ema21, _ema55, _ema200, _atr, _priorHigh, _priorLow, _bosUp, _bosDown, _bullMss, _bearMss, _expansionUp, _expansionDown] = f_context()
    [_score[1], _regime[1], _ema21[1], _ema55[1], _ema200[1], _atr[1], _priorHigh[1], _priorLow[1], _bosUp[1], _bosDown[1], _bullMss[1], _bearMss[1], _expansionUp[1], _expansionDown[1]]

// ─────────────────────────────────────────────────────────────────────────────
// Local and multi-timeframe data
// ─────────────────────────────────────────────────────────────────────────────
[localScoreRaw, localRegimeRaw, localEma21Raw, localEma55Raw, localEma200Raw, localAtrRaw, localPriorHighRaw, localPriorLowRaw, localBosUpRaw, localBosDownRaw, localBullMssRaw, localBearMssRaw, localExpansionUpRaw, localExpansionDownRaw] = f_context()

localScore = barstate.isconfirmed ? localScoreRaw : localScoreRaw[1]
localRegime = barstate.isconfirmed ? localRegimeRaw : localRegimeRaw[1]
localEma21 = barstate.isconfirmed ? localEma21Raw : localEma21Raw[1]
localEma55 = barstate.isconfirmed ? localEma55Raw : localEma55Raw[1]
localEma200 = barstate.isconfirmed ? localEma200Raw : localEma200Raw[1]
localAtr = barstate.isconfirmed ? localAtrRaw : localAtrRaw[1]
localPriorHigh = barstate.isconfirmed ? localPriorHighRaw : localPriorHighRaw[1]
localPriorLow = barstate.isconfirmed ? localPriorLowRaw : localPriorLowRaw[1]
localBosUp = barstate.isconfirmed ? localBosUpRaw : localBosUpRaw[1]
localBosDown = barstate.isconfirmed ? localBosDownRaw : localBosDownRaw[1]
localBullMss = barstate.isconfirmed ? localBullMssRaw : localBullMssRaw[1]
localBearMss = barstate.isconfirmed ? localBearMssRaw : localBearMssRaw[1]
localExpansionUp = barstate.isconfirmed ? localExpansionUpRaw : localExpansionUpRaw[1]
localExpansionDown = barstate.isconfirmed ? localExpansionDownRaw : localExpansionDownRaw[1]
decisionClose = barstate.isconfirmed ? close : close[1]

[m15Score, m15Regime, m15Ema21, m15Ema55, m15Ema200, m15Atr, m15PriorHigh, m15PriorLow, m15BosUp, m15BosDown, m15BullMss, m15BearMss, m15ExpansionUp, m15ExpansionDown] = request.security(syminfo.tickerid, "15", f_context_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[h1Score, h1Regime, h1Ema21, h1Ema55, h1Ema200, h1Atr, h1PriorHigh, h1PriorLow, h1BosUp, h1BosDown, h1BullMss, h1BearMss, h1ExpansionUp, h1ExpansionDown] = request.security(syminfo.tickerid, "60", f_context_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[h4Score, h4Regime, h4Ema21, h4Ema55, h4Ema200, h4Atr, h4PriorHigh, h4PriorLow, h4BosUp, h4BosDown, h4BullMss, h4BearMss, h4ExpansionUp, h4ExpansionDown] = request.security(syminfo.tickerid, "240", f_context_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[d1Score, d1Regime, d1Ema21, d1Ema55, d1Ema200, d1Atr, d1PriorHigh, d1PriorLow, d1BosUp, d1BosDown, d1BullMss, d1BearMss, d1ExpansionUp, d1ExpansionDown] = request.security(syminfo.tickerid, "D", f_context_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

isM5Mode = timeframe.isminutes and timeframe.multiplier <= 5
isM15Mode = timeframe.isminutes and timeframe.multiplier > 5 and timeframe.multiplier <= 15
supportedTimeframe = isM5Mode or isM15Mode

// M5 needs M15 as a bridge. M15 uses H1-H4-D1 directly.
anchorScore = isM5Mode ?
     0.15 * nz(m15Score, 0.0) + 0.35 * nz(h1Score, 0.0) + 0.35 * nz(h4Score, 0.0) + 0.15 * nz(d1Score, 0.0) :
     0.45 * nz(h1Score, 0.0) + 0.40 * nz(h4Score, 0.0) + 0.15 * nz(d1Score, 0.0)

fastContextRegime = isM5Mode ? m15Regime : h1Regime
entryThreshold = isM5Mode ? 0.30 : 0.28
confirmationBars = isM5Mode ? 2 : 1
minimumHoldBars = isM5Mode ? 12 : 4
flipThreshold = 0.20
exitThreshold = 0.16

strongHtfConflict = not na(h1Score) and not na(h4Score) and h1Score * h4Score < 0 and math.abs(h1Score) >= 0.25 and math.abs(h4Score) >= 0.25
rangeNow = localRegime == 2 and fastContextRegime == 2 and math.abs(anchorScore) < 0.30

bullLocalConfirmation = localScore > 0.18 and decisionClose > localEma55 and
     (localBosUp or localExpansionUp or (decisionClose > localEma21 and localScore > 0.25))
bearLocalConfirmation = localScore < -0.18 and decisionClose < localEma55 and
     (localBosDown or localExpansionDown or (decisionClose < localEma21 and localScore < -0.25))

bullInitialSetup = anchorScore > entryThreshold and h1Score > 0.05 and h4Score > -0.10 and bullLocalConfirmation and not strongHtfConflict and not rangeNow
bearInitialSetup = anchorScore < -entryThreshold and h1Score < -0.05 and h4Score < 0.10 and bearLocalConfirmation and not strongHtfConflict and not rangeNow

// A direction flip is harder than continuation: it needs a sweep+MSS or a
// strong structure break, plus improving H1/H4 context.
bullFlipSetup = anchorScore > flipThreshold and h1Score > 0.10 and h4Score > -0.15 and
     (localBullMss or (localBosUp and localScore > 0.35)) and decisionClose > localEma55 and not strongHtfConflict
bearFlipSetup = anchorScore < -flipThreshold and h1Score < -0.10 and h4Score < 0.15 and
     (localBearMss or (localBosDown and localScore < -0.35)) and decisionClose < localEma55 and not strongHtfConflict

// ─────────────────────────────────────────────────────────────────────────────
// Persistent market-direction state machine
// Pullbacks do not automatically reverse the official direction.
// ─────────────────────────────────────────────────────────────────────────────
var int marketBias = 0
var int bullConfirmCount = 0
var int bearConfirmCount = 0
var int barsInBias = 0
var float lockedInvalidation = na

if barstate.isconfirmed
    if not supportedTimeframe
        marketBias := 0
        bullConfirmCount := 0
        bearConfirmCount := 0
        barsInBias := 0
        lockedInvalidation := na
    else if marketBias == 0
        bullConfirmCount := bullInitialSetup ? bullConfirmCount + 1 : 0
        bearConfirmCount := bearInitialSetup ? bearConfirmCount + 1 : 0

        if bullConfirmCount >= confirmationBars
            marketBias := 1
            barsInBias := 0
            lockedInvalidation := localPriorLow
            bullConfirmCount := 0
            bearConfirmCount := 0
        else if bearConfirmCount >= confirmationBars
            marketBias := -1
            barsInBias := 0
            lockedInvalidation := localPriorHigh
            bullConfirmCount := 0
            bearConfirmCount := 0
    else if marketBias == 1
        barsInBias += 1
        bearConfirmCount := bearFlipSetup ? bearConfirmCount + 1 : 0
        bullConfirmCount := 0

        if localBosUp and not na(localPriorLow)
            lockedInvalidation := na(lockedInvalidation) ? localPriorLow : math.max(lockedInvalidation, localPriorLow)

        bullHardInvalid =
             (not na(localPriorLow) and decisionClose < localPriorLow and localScore < -0.10 and h1Score < 0) or
             (anchorScore < -exitThreshold and h1Score < -0.10 and h4Score < 0)

        if barsInBias >= minimumHoldBars and bearConfirmCount >= confirmationBars
            marketBias := -1
            barsInBias := 0
            lockedInvalidation := localPriorHigh
            bearConfirmCount := 0
        else if barsInBias >= minimumHoldBars and bullHardInvalid
            marketBias := 0
            barsInBias := 0
            lockedInvalidation := na
            bearConfirmCount := 0
    else
        barsInBias += 1
        bullConfirmCount := bullFlipSetup ? bullConfirmCount + 1 : 0
        bearConfirmCount := 0

        if localBosDown and not na(localPriorHigh)
            lockedInvalidation := na(lockedInvalidation) ? localPriorHigh : math.min(lockedInvalidation, localPriorHigh)

        bearHardInvalid =
             (not na(localPriorHigh) and decisionClose > localPriorHigh and localScore > 0.10 and h1Score > 0) or
             (anchorScore > exitThreshold and h1Score > 0.10 and h4Score > 0)

        if barsInBias >= minimumHoldBars and bullConfirmCount >= confirmationBars
            marketBias := 1
            barsInBias := 0
            lockedInvalidation := localPriorLow
            bullConfirmCount := 0
        else if barsInBias >= minimumHoldBars and bearHardInvalid
            marketBias := 0
            barsInBias := 0
            lockedInvalidation := na
            bullConfirmCount := 0

// ─────────────────────────────────────────────────────────────────────────────
// Human-readable market state
// ─────────────────────────────────────────────────────────────────────────────
currentDirectionText = not supportedTimeframe ? "GUNAKAN M5 / M15" : marketBias == 1 ? "BULLISH" : marketBias == -1 ? "BEARISH" : "TUNGGU"

bullPullback = marketBias == 1 and (localScore < 0 or decisionClose < localEma21)
bearPullback = marketBias == -1 and (localScore > 0 or decisionClose > localEma21)

conditionText = not supportedTimeframe ? "TIMEFRAME TIDAK DIDUKUNG" :
     marketBias == 1 ? (localExpansionUp ? "BULLISH EXPANSION" : bullPullback ? "BULLISH PULLBACK" : "BULLISH CONTINUATION") :
     marketBias == -1 ? (localExpansionDown ? "BEARISH EXPANSION" : bearPullback ? "BEARISH PULLBACK" : "BEARISH CONTINUATION") :
     rangeNow ? "RANGE / SIDEWAYS" :
     anchorScore > 0.20 ? "KANDIDAT BULLISH" :
     anchorScore < -0.20 ? "KANDIDAT BEARISH" : "TRANSISI"

macroScore = 0.55 * nz(h4Score, 0.0) + 0.45 * nz(d1Score, 0.0)
macroText = f_direction_text(macroScore)
activeText = f_direction_text(h1Score)
localText = f_direction_text(localScore)

waitingText = not supportedTimeframe ? "PINDAHKAN CHART KE M5 ATAU M15" :
     strongHtfConflict ? "TUNGGU H1 DAN H4 SEARAH" :
     marketBias == 1 ? (bullPullback ? "TUNGGU PULLBACK BULLISH SELESAI" : "BIAS BULLISH MASIH AKTIF") :
     marketBias == -1 ? (bearPullback ? "TUNGGU PULLBACK BEARISH SELESAI" : "BIAS BEARISH MASIH AKTIF") :
     rangeNow ? "TUNGGU BREAKOUT DAN CANDLE CLOSE" :
     anchorScore > 0.20 ? "TUNGGU BREAK STRUKTUR BULLISH" :
     anchorScore < -0.20 ? "TUNGGU BREAK STRUKTUR BEARISH" : "TUNGGU H1 DAN H4 MEMBERI ARAH"

alignmentText = strongHtfConflict ? "BERLAWANAN" :
     f_sign(h1Score) == f_sign(h4Score) and f_sign(h4Score) == f_sign(d1Score) and f_sign(h1Score) != 0 ? "KOMPAK" :
     f_sign(h1Score) == f_sign(h4Score) and f_sign(h1Score) != 0 ? "H1-H4 SEARAH" : "BELUM KOMPAK"

// ─────────────────────────────────────────────────────────────────────────────
// Visuals
// ─────────────────────────────────────────────────────────────────────────────
plot(showEma ? localEma21 : na, "EMA 21", color=color.new(color.aqua, 10), linewidth=1)
plot(showEma ? localEma55 : na, "EMA 55", color=color.new(color.yellow, 0), linewidth=2)
plot(showEma ? localEma200 : na, "EMA 200", color=color.new(color.fuchsia, 15), linewidth=2)

backgroundColor = marketBias == 1 ? color.new(color.lime, 92) : marketBias == -1 ? color.new(color.red, 92) : rangeNow ? color.new(color.gray, 95) : na
bgcolor(showBackground ? backgroundColor : na, title="Arah market resmi")

buyMarker = supportedTimeframe and barstate.isconfirmed and marketBias == 1 and nz(marketBias[1], 0) != 1
sellMarker = supportedTimeframe and barstate.isconfirmed and marketBias == -1 and nz(marketBias[1], 0) != -1

plotshape(showMarkers and buyMarker, title="Arah berubah bullish", style=shape.labelup, text="Buy", location=location.belowbar, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
plotshape(showMarkers and sellMarker, title="Arah berubah bearish", style=shape.labeldown, text="Sell", location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// Compact dashboard — bottom right
// ─────────────────────────────────────────────────────────────────────────────
var table dash = table.new(position.bottom_right, 2, 8, border_width=1, frame_color=color.new(color.silver, 45), border_color=color.new(color.silver, 72))

if barstate.islast and showDashboard
    _biasColor = f_bias_color(marketBias)

    table.cell(dash, 0, 0, "AMY", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.tiny)
    table.cell(dash, 1, 0, "MARKET DIRECTION", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.tiny)

    table.cell(dash, 0, 1, "ARAH SAAT INI", text_color=color.silver, bgcolor=color.new(color.black, 18), text_size=size.tiny)
    table.cell(dash, 1, 1, currentDirectionText, text_color=marketBias == 1 ? color.black : color.white, bgcolor=_biasColor, text_size=size.small)

    table.cell(dash, 0, 2, "KONDISI", text_color=color.silver, bgcolor=color.new(color.black, 28), text_size=size.tiny)
    table.cell(dash, 1, 2, conditionText, text_color=color.white, bgcolor=color.new(color.black, 28), text_size=size.tiny)

    table.cell(dash, 0, 3, "ARAH BESAR", text_color=color.silver, bgcolor=color.new(color.black, 28), text_size=size.tiny)
    table.cell(dash, 1, 3, "H4/D1 " + macroText, text_color=macroScore > 0.12 ? color.lime : macroScore < -0.12 ? color.red : color.orange, bgcolor=color.new(color.black, 28), text_size=size.tiny)

    table.cell(dash, 0, 4, "ARAH AKTIF", text_color=color.silver, bgcolor=color.new(color.black, 28), text_size=size.tiny)
    table.cell(dash, 1, 4, "H1 " + activeText, text_color=h1Score > 0.12 ? color.lime : h1Score < -0.12 ? color.red : color.orange, bgcolor=color.new(color.black, 28), text_size=size.tiny)

    table.cell(dash, 0, 5, "STRUKTUR LOKAL", text_color=color.silver, bgcolor=color.new(color.black, 28), text_size=size.tiny)
    table.cell(dash, 1, 5, timeframe.period + " " + localText, text_color=localScore > 0.12 ? color.lime : localScore < -0.12 ? color.red : color.orange, bgcolor=color.new(color.black, 28), text_size=size.tiny)

    table.cell(dash, 0, 6, "KONTEKS TF", text_color=color.silver, bgcolor=color.new(color.black, 28), text_size=size.tiny)
    table.cell(dash, 1, 6, alignmentText, text_color=strongHtfConflict ? color.red : alignmentText == "KOMPAK" ? color.lime : color.orange, bgcolor=color.new(color.black, 28), text_size=size.tiny)

    table.cell(dash, 0, 7, "MENUNGGU", text_color=color.silver, bgcolor=color.new(color.black, 18), text_size=size.tiny)
    table.cell(dash, 1, 7, waitingText + (marketBias != 0 ? " | BATAL " + f_price_text(lockedInvalidation) : ""), text_color=marketBias == 0 ? color.orange : color.white, bgcolor=color.new(color.black, 18), text_size=size.tiny)

if barstate.islast and not showDashboard
    table.clear(dash, 0, 0, 1, 7)

// Direction-change alerts only. No order, SL, TP, or strategy simulation.
alertcondition(buyMarker, "AMY arah bullish", "AMY Regime Compass mengonfirmasi perubahan arah market menjadi bullish.")
alertcondition(sellMarker, "AMY arah bearish", "AMY Regime Compass mengonfirmasi perubahan arah market menjadi bearish.")
alertcondition(barstate.isconfirmed and strongHtfConflict and not strongHtfConflict[1], "AMY konflik H1-H4", "AMY Regime Compass mendeteksi H1 dan H4 bergerak berlawanan.")
