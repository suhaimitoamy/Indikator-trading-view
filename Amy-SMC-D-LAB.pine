//@version=5
indicator('Amy SMC D LAB', 'Amy SMC D LAB', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_LEG                     = 1
BEARISH_LEG                     = 0

BULLISH                         = +1
BEARISH                         = -1

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical'
PRESENT                         = 'Present'

COLORED                         = 'Colored'
MONOCHROME                      = 'Monochrome'

ALL                             = 'All'
BOS                             = 'BOS'
CHOCH                           = 'CHoCH'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal

ATR                             = 'Atr'
RANGE                           = 'Cumulative Mean Range'

CLOSE                           = 'Close'
HIGHLOW                         = 'High/Low'

SOLID                           = '⎯⎯⎯'
DASHED                          = '----'
DOTTED                          = '····'

SMART_GROUP                     = 'Smart Money Concepts'
INTERNAL_GROUP                  = 'Real Time Internal Structure'
SWING_GROUP                     = 'Real Time Swing Structure'
BLOCKS_GROUP                    = 'Order Blocks'
EQUAL_GROUP                     = 'EQH/EQL'
GAPS_GROUP                      = 'Fair Value Gaps'
LEVELS_GROUP                    = 'Highs & Lows MTF'
ZONES_GROUP                     = 'Premium & Discount Zones'

modeTooltip                     = 'Allows to display historical Structure or only the recent ones'
styleTooltip                    = 'Indicator color theme'
showTrendTooltip                = 'Display additional candles with a color reflecting the current trend detected by structure'
showInternalsTooltip            = 'Display internal market structure'
internalFilterConfluenceTooltip = 'Filter non significant internal structure breakouts'
showStructureTooltip            = 'Display swing market Structure'
showSwingsTooltip               = 'Display swing point as labels on the chart'
showHighLowSwingsTooltip        = 'Highlight most recent strong and weak high/low points on the chart'
showInternalOrderBlocksTooltip  = 'Display internal order blocks on the chart\n\nNumber of internal order blocks to display on the chart'
showSwingOrderBlocksTooltip     = 'Display swing order blocks on the chart\n\nNumber of internal swing blocks to display on the chart'
orderBlockFilterTooltip         = 'Method used to filter out volatile order blocks \n\nIt is recommended to use the cumulative mean range method when a low amount of data is available'
orderBlockMitigationTooltip     = 'Select what values to use for order block mitigation'
showEqualHighsLowsTooltip       = 'Display equal highs and equal lows on the chart'
equalHighsLowsLengthTooltip     = 'Number of bars used to confirm equal highs and equal lows'
equalHighsLowsThresholdTooltip  = 'Sensitivity threshold in a range (0, 1) used for the detection of equal highs & lows\n\nLower values will return fewer but more pertinent results'
showFairValueGapsTooltip        = 'Display fair values gaps on the chart'
fairValueGapsThresholdTooltip   = 'Filter out non significant fair value gaps'
fairValueGapsTimeframeTooltip   = 'Fair value gaps timeframe'
fairValueGapsExtendTooltip      = 'Determine how many bars to extend the Fair Value Gap boxes on chart'
showPremiumDiscountZonesTooltip = 'Display premium, discount, and equilibrium zones on chart'

modeInput                       = input.string( HISTORICAL, 'Mode',                     group = SMART_GROUP,    tooltip = modeTooltip, options = [HISTORICAL, PRESENT])
styleInput                      = input.string( COLORED,    'Style',                    group = SMART_GROUP,    tooltip = styleTooltip,options = [COLORED, MONOCHROME])
showTrendInput                  = input(        false,      'Color Candles',            group = SMART_GROUP,    tooltip = showTrendTooltip)

showInternalsInput              = input(        true,       'Show Internal Structure',  group = INTERNAL_GROUP, tooltip = showInternalsTooltip)
showInternalBullInput           = input.string( ALL,        'Bullish Structure',        group = INTERNAL_GROUP, inline = 'ibull', options = [ALL,BOS,CHOCH])
internalBullColorInput          = input(        GREEN,      '',                         group = INTERNAL_GROUP, inline = 'ibull')
showInternalBearInput           = input.string( ALL,        'Bearish Structure' ,       group = INTERNAL_GROUP, inline = 'ibear', options = [ALL,BOS,CHOCH])
internalBearColorInput          = input(        RED,        '',                         group = INTERNAL_GROUP, inline = 'ibear')
internalFilterConfluenceInput   = input(        false,      'Confluence Filter',        group = INTERNAL_GROUP, tooltip = internalFilterConfluenceTooltip)
internalStructureSize           = input.string( TINY,       'Internal Label Size',      group = INTERNAL_GROUP, options = [TINY,SMALL,NORMAL])

showStructureInput              = input(        true,       'Show Swing Structure',     group = SWING_GROUP,    tooltip = showStructureTooltip)
showSwingBullInput              = input.string( ALL,        'Bullish Structure',        group = SWING_GROUP,    inline = 'bull',    options = [ALL,BOS,CHOCH])
swingBullColorInput             = input(        GREEN,      '',                         group = SWING_GROUP,    inline = 'bull')
showSwingBearInput              = input.string( ALL,        'Bearish Structure',        group = SWING_GROUP,    inline = 'bear',    options = [ALL,BOS,CHOCH])
swingBearColorInput             = input(        RED,        '',                         group = SWING_GROUP,    inline = 'bear')
swingStructureSize              = input.string( SMALL,      'Swing Label Size',         group = SWING_GROUP,    options = [TINY,SMALL,NORMAL])
showSwingsInput                 = input(        false,      'Show Swings Points',       group = SWING_GROUP,    tooltip = showSwingsTooltip,inline = 'swings')
swingsLengthInput               = input.int(    50,         '',                         group = SWING_GROUP,    minval = 10,                inline = 'swings')
showHighLowSwingsInput          = input(        true,       'Show Strong/Weak High/Low',group = SWING_GROUP,    tooltip = showHighLowSwingsTooltip)

showInternalOrderBlocksInput    = input(        true,       'Internal Order Blocks' ,   group = BLOCKS_GROUP,   tooltip = showInternalOrderBlocksTooltip,   inline = 'iob')
internalOrderBlocksSizeInput    = input.int(    5,          '',                         group = BLOCKS_GROUP,   minval = 1, maxval = 20,                    inline = 'iob')
showSwingOrderBlocksInput       = input(        false,      'Swing Order Blocks',       group = BLOCKS_GROUP,   tooltip = showSwingOrderBlocksTooltip,      inline = 'ob')
swingOrderBlocksSizeInput       = input.int(    5,          '',                         group = BLOCKS_GROUP,   minval = 1, maxval = 20,                    inline = 'ob') 
orderBlockFilterInput           = input.string( 'Atr',      'Order Block Filter',       group = BLOCKS_GROUP,   tooltip = orderBlockFilterTooltip,          options = [ATR, RANGE])
orderBlockMitigationInput       = input.string( HIGHLOW,    'Order Block Mitigation',   group = BLOCKS_GROUP,   tooltip = orderBlockMitigationTooltip,      options = [CLOSE,HIGHLOW])
internalBullishOrderBlockColor  = input.color(color.new(#3179f5, 80), 'Internal Bullish OB',    group = BLOCKS_GROUP)
internalBearishOrderBlockColor  = input.color(color.new(#f77c80, 80), 'Internal Bearish OB',    group = BLOCKS_GROUP)
swingBullishOrderBlockColor     = input.color(color.new(#1848cc, 80), 'Bullish OB',             group = BLOCKS_GROUP)
swingBearishOrderBlockColor     = input.color(color.new(#b22833, 80), 'Bearish OB',             group = BLOCKS_GROUP)

showEqualHighsLowsInput         = input(        true,       'Equal High/Low',           group = EQUAL_GROUP,    tooltip = showEqualHighsLowsTooltip)
equalHighsLowsLengthInput       = input.int(    3,          'Bars Confirmation',        group = EQUAL_GROUP,    tooltip = equalHighsLowsLengthTooltip,      minval = 1)
equalHighsLowsThresholdInput    = input.float(  0.1,        'Threshold',                group = EQUAL_GROUP,    tooltip = equalHighsLowsThresholdTooltip,   minval = 0, maxval = 0.5, step = 0.1)
equalHighsLowsSizeInput         = input.string( TINY,       'Label Size',               group = EQUAL_GROUP,    options = [TINY,SMALL,NORMAL])

showFairValueGapsInput          = input(        false,      'Fair Value Gaps',          group = GAPS_GROUP,     tooltip = showFairValueGapsTooltip)
fairValueGapsThresholdInput     = input(        true,       'Auto Threshold',           group = GAPS_GROUP,     tooltip = fairValueGapsThresholdTooltip)
fairValueGapsTimeframeInput     = input.timeframe('',       'Timeframe',                group = GAPS_GROUP,     tooltip = fairValueGapsTimeframeTooltip)
fairValueGapsBullColorInput     = input.color(color.new(#00ff68, 70), 'Bullish FVG' , group = GAPS_GROUP)
fairValueGapsBearColorInput     = input.color(color.new(#ff0008, 70), 'Bearish FVG' , group = GAPS_GROUP)
fairValueGapsExtendInput        = input.int(    1,          'Extend FVG',               group = GAPS_GROUP,     tooltip = fairValueGapsExtendTooltip,       minval = 0)
showDailyLevelsInput            = input(        false,      'Daily',    group = LEVELS_GROUP,   inline = 'daily')
dailyLevelsStyleInput           = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'daily',   options = [SOLID,DASHED,DOTTED])
dailyLevelsColorInput           = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'daily')
showWeeklyLevelsInput           = input(        false,      'Weekly',   group = LEVELS_GROUP,   inline = 'weekly')
weeklyLevelsStyleInput          = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'weekly',  options = [SOLID,DASHED,DOTTED])
weeklyLevelsColorInput          = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'weekly')
showMonthlyLevelsInput          = input(        false,      'Monthly',   group = LEVELS_GROUP,   inline = 'monthly')
monthlyLevelsStyleInput         = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'monthly', options = [SOLID,DASHED,DOTTED])
monthlyLevelsColorInput         = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'monthly')

showPremiumDiscountZonesInput   = input(        false,      'Premium/Discount Zones',   group = ZONES_GROUP , tooltip = showPremiumDiscountZonesTooltip)
premiumZoneColorInput           = input.color(  RED,        'Premium Zone',             group = ZONES_GROUP)
equilibriumZoneColorInput       = input.color(  GRAY,       'Equilibrium Zone',         group = ZONES_GROUP)
discountZoneColorInput          = input.color(  GREEN,      'Discount Zone',            group = ZONES_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox

type trend
    int bias    

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime    
    int bias

var pivot swingHigh                 = pivot.new(na,na,false)
var pivot swingLow                  = pivot.new(na,na,false)
var pivot internalHigh              = pivot.new(na,na,false)
var pivot internalLow               = pivot.new(na,na,false)
var pivot equalHigh                 = pivot.new(na,na,false)
var pivot equalLow                  = pivot.new(na,na,false)
var trend swingTrend                = trend.new(0)
var trend internalTrend             = trend.new(0)
var equalDisplay equalHighDisplay   = equalDisplay.new()
var equalDisplay equalLowDisplay    = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<float> parsedHighs        = array.new<float>()
var array<float> parsedLows         = array.new<float>()
var array<float> highs              = array.new<float>()
var array<float> lows               = array.new<float>()
var array<int> times                = array.new<int>()
var trailingExtremes trailing       = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks      = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks   = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes        = array.new<box>()
var array<box> internalOrderBlocksBoxes     = array.new<box>()
var swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor        = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor        = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor                = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor               = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput 
varip int currentBarIndex           = bar_index
varip int lastBarIndex              = bar_index
alerts currentAlerts                = alerts.new()
var initialTime                     = time

if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))

bearishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure                          = ta.atr(200)
volatilityMeasure                   = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr)/bar_index
highVolatilityBar                   = (high - low) >= (2 * volatilityMeasure)
parsedHigh                          = highVolatilityBar ? low : high
parsedLow                           = highVolatilityBar ? high : low

parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
leg(int size) =>
    var leg     = 0    
    newLegHigh  = high[size] > ta.highest( size)
    newLegLow   = low[size]  < ta.lowest(  size)
    
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)      => ta.change(leg) != 0
startOfBearishLeg(int leg)  => ta.change(leg) == -1
startOfBullishLeg(int leg)  => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>    
    var label l_abel = na

    if modeInput == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    
    string tag          = 'EQL'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'EQH'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    if modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)
        
    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition           = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

getCurrentStructure(int size,bool equalHighLow = false, bool internal = false) =>        
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow    

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure                
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)            
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot,high[size],size,true)
                currentAlerts.equalHighs := true               

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)
                
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>    
    var line l_ine      = line.new(na,na,na,na,xloc = xloc.bar_time)
    var label l_abel    = label.new(na,na)

    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()

    l_ine   := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel  := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size = labelSize)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

    for [index,eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false
        
        if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true
        if crossedOderBlock                    
            orderBlocks.remove(index)            

storeOrdeBlock(pivot p_ivot,bool internal = false,int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)

        array<float> a_rray = na
        int parsedIndex = na

        if bias == BEARISH
            a_rray      := parsedHighs.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())  
        else
            a_rray      := parsedLows.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())                        

        orderBlock o_rderBlock          = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex),bias)
        array<orderBlock> orderBlocks   = internal ? internalOrderBlocks : swingOrderBlocks
        
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal = false) =>        
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()

    if orderBlocksSize > 0        
        maxOrderBlocks                      = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks  = orderBlocks.slice(0, math.min(maxOrderBlocks,orderBlocksSize))
        array<box> b_oxes                   = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes        

        for [index,eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)

            box b_ox        = b_oxes.get(index)
            b_ox.set_top_left_point(    chart.point.new(eachOrderBlock.barTime,na,eachOrderBlock.barHigh))
            b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,eachOrderBlock.barLow))        
            b_ox.set_border_color(      internal ? na : orderBlockColor)
            b_ox.set_bgcolor(           orderBlockColor)

displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    
    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize

    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    if ta.crossover(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBullishCHoCH  := tag == CHOCH
            currentAlerts.internalBullishBOS    := tag == BOS
        else
            currentAlerts.swingBullishCHoCH     := tag == CHOCH
            currentAlerts.swingBullishBOS       := tag == BOS

        p_ivot.crossed  := true
        t_rend.bias     := BULLISH

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition                        
            drawStructure(p_ivot,tag,bullishColor,lineStyle,label.style_label_down,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BULLISH)

    p_ivot          := internal ? internalLow : swingLow    
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if ta.crossunder(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBearishCHoCH  := tag == CHOCH
            currentAlerts.internalBearishBOS    := tag == BOS
        else
            currentAlerts.swingBearishCHoCH     := tag == CHOCH
            currentAlerts.swingBearishBOS       := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BEARISH

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        
        if displayCondition                        
            drawStructure(p_ivot,tag,bearishColor,lineStyle,label.style_label_up,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BEARISH)

fairValueGapBox(leftTime,rightTime,topPrice,bottomPrice,boxColor) => box.new(chart.point.new(leftTime,na,topPrice),chart.point.new(rightTime + fairValueGapsExtendInput * (time-time[1]),na,bottomPrice), xloc=xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

deleteFairValueGaps() =>
    for [index,eachFairValueGap] in fairValueGaps
        if (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)
    
drawFairValueGaps() => 
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]],lookahead = barmerge.lookahead_on)

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow,last2High,BULLISH,fairValueGapBox(lastTime,currentTime,currentLow,math.avg(currentLow,last2High),fairValueGapBullishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentLow,last2High),last2High,fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh,last2Low,BEARISH,fairValueGapBox(lastTime,currentTime,currentHigh,math.avg(currentHigh,last2Low),fairValueGapBearishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentHigh,last2Low),last2Low,fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time],lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel    

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray        = times.slice(leftIndex,rightIndex)
        array<float> topArray       = highs.slice(leftIndex,rightIndex)
        array<float> bottomArray    = lows.slice(leftIndex,rightIndex)

        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(    chart.point.new(parsedTopTime,na,parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))   
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))

    bottomLine.set_first_point( chart.point.new(parsedBottomTime,na,parsedBottom))    
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high,trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na,na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color=color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color=color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar            = last_bar_time + 20 * (time - time[1])

    topLine.set_first_point(    chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(          swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

    bottomLine.set_first_point( chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(       swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(    chart.point.new(trailing.barTime,na,top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))

    l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)

    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen,high,low,close,color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()

    if showHighLowSwingsInput
        drawHighLowSwings()

    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()

if showFairValueGapsInput
    deleteFairValueGaps()

getCurrentStructure(swingsLengthInput,false)
getCurrentStructure(5,false,true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput,true)

if showInternalsInput or showInternalOrderBlocksInput or showTrendInput
    displayStructure(true)

if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
    displayStructure()

if showInternalOrderBlocksInput
    deleteOrderBlocks(true)

if showSwingOrderBlocksInput
    deleteOrderBlocks()

if showFairValueGapsInput
    drawFairValueGaps()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput        
        drawOrderBlocks(true)
        
    if showSwingOrderBlocksInput        
        drawOrderBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D',timeframe.isdaily,dailyLevelsStyleInput,dailyLevelsColorInput)

    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W',timeframe.isweekly,weeklyLevelsStyleInput,weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M',timeframe.ismonthly,monthlyLevelsStyleInput,monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
//ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(currentAlerts.swingBullishBOS,           'Bullish BOS',                  'Internal Bullish BOS formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Bullish CHoCH',                'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.swingBearishBOS,            'Bearish BOS',                 'Bearish BOS formed')
alertcondition(currentAlerts.swingBearishCHoCH,          'Bearish CHoCH',               'Bearish CHoCH formed')

alertcondition(currentAlerts.internalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Bearish Swing OB Breakout')

alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')

alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')

//---------------------------------------------------------------------------------------------------------------------}
// AMY SMC Y DEVELOPMENT COPY
// Baseline: finalized Amy SMC X after the 2010–2026 full-history validation.
// NON-PREDICTIVE LOCK: structure/context modules that already perform their descriptive/functional jobs are inherited unchanged.
// Development scope for Amy SMC Y is the predictive layer unless the user explicitly changes that rule.

// AMY SMC ADD-ON
// Dashboard + Chart Context
//---------------------------------------------------------------------------------------------------------------------{

AMY_DASH_GROUP  = 'Amy Dashboard'
AMY_CHART_GROUP = 'Amy Chart'

amyShowDashboard     = input.bool(true, 'Show Dashboard', group = AMY_DASH_GROUP)
amyShowEvents        = input.bool(true, 'Sweep / Valid Break', group = AMY_CHART_GROUP)
amyShowPatterns      = input.bool(true, 'Candlestick Patterns', group = AMY_CHART_GROUP)
amyShowBoxPrices     = input.bool(false, 'FVG / OB Prices', group = AMY_CHART_GROUP)
amyShowLevelPrices   = input.bool(false, 'EQH/EQL + Strong/Weak Prices', group = AMY_CHART_GROUP)

amyPrice(float value) =>
    na(value) ? '-' : str.tostring(value, format.mintick)

amyTfName(string tf) =>
    string result = tf
    if tf == '1'
        result := 'M1'
    else if tf == '3'
        result := 'M3'
    else if tf == '5'
        result := 'M5'
    else if tf == '15'
        result := 'M15'
    else if tf == '30'
        result := 'M30'
    else if tf == '45'
        result := 'M45'
    else if tf == '60'
        result := 'H1'
    else if tf == '120'
        result := 'H2'
    else if tf == '180'
        result := 'H3'
    else if tf == '240'
        result := 'H4'
    else if tf == 'D' or tf == '1D'
        result := 'D1'
    else if tf == 'W' or tf == '1W'
        result := 'W1'
    else if tf == 'M' or tf == '1M'
        result := 'MN1'
    else if tf == '3M'
        result := 'MN3'
    result

amyAutoHTF() =>
    float sec = timeframe.in_seconds()
    string result = 'D'
    if timeframe.isseconds
        result := '1'
    else if sec <= 60
        result := '5'
    else if sec <= 180
        result := '15'
    else if sec <= 300
        result := '15'
    else if sec <= 900
        result := '60'
    else if sec <= 1800
        result := '120'
    else if sec <= 3600
        result := '240'
    else if sec <= 7200
        result := 'D'
    else if sec <= 14400
        result := 'D'
    else if sec <= 86400
        result := 'W'
    else if sec <= 604800
        result := 'M'
    else
        result := '3M'
    result

amyStructureBias(int length) =>
    float ph = ta.pivothigh(high, length, length)
    float pl = ta.pivotlow(low, length, length)
    float lastPH = ta.valuewhen(not na(ph), ph, 0)
    float prevPH = ta.valuewhen(not na(ph), ph, 1)
    float lastPL = ta.valuewhen(not na(pl), pl, 0)
    float prevPL = ta.valuewhen(not na(pl), pl, 1)
    float baselineSum = 0.0
    int baselineLength = length * 2
    for offset = 0 to baselineLength - 1
        baselineSum += close[offset]
    float baseline = baselineSum / baselineLength
    bool bullishStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
    bool bearishStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL
    int result = 0
    if bullishStructure
        result := BULLISH
    else if bearishStructure
        result := BEARISH
    else
        result := na(baseline) ? 0 : close >= baseline ? BULLISH : BEARISH
    result

amyDetectPattern() =>
    float candleRange = high - low
    float candleBody = math.abs(close - open)
    float bodySafe = math.max(candleBody, syminfo.mintick)
    float upperWick = high - math.max(open, close)
    float lowerWick = math.min(open, close) - low
    float prevRange = high[1] - low[1]
    float prev2Range = high[2] - low[2]
    float body1 = math.abs(close[1] - open[1])
    float body2 = math.abs(close[2] - open[2])
    float atrLocal = ta.atr(14)
    bool rangeValid = candleRange > 0 and not na(atrLocal) and candleRange >= atrLocal * 0.50
    bool strongBody = rangeValid and candleBody >= candleRange * 0.52
    bool prevBodyValid = prevRange > 0 and body1 >= prevRange * 0.32
    bool shortDown = not na(close[3]) and close[1] < close[3]
    bool shortUp = not na(close[3]) and close[1] > close[3]

    bool bullishEngulfing = strongBody and prevBodyValid and close > open and close[1] < open[1] and open <= close[1] and close >= open[1] and candleBody >= body1 * 1.15
    bool bearishEngulfing = strongBody and prevBodyValid and close < open and close[1] > open[1] and open >= close[1] and close <= open[1] and candleBody >= body1 * 1.15

    bool hammer = rangeValid and shortDown and candleBody <= candleRange * 0.38 and lowerWick >= candleRange * 0.58 and upperWick <= candleRange * 0.14 and close >= low + candleRange * 0.72
    bool shootingStar = rangeValid and shortUp and candleBody <= candleRange * 0.38 and upperWick >= candleRange * 0.58 and lowerWick <= candleRange * 0.14 and close <= low + candleRange * 0.28

    bool bullishPinBar = rangeValid and close > open and candleBody <= candleRange * 0.30 and lowerWick >= candleRange * 0.62 and upperWick <= candleRange * 0.12 and close >= low + candleRange * 0.76
    bool bearishPinBar = rangeValid and close < open and candleBody <= candleRange * 0.30 and upperWick >= candleRange * 0.62 and lowerWick <= candleRange * 0.12 and close <= low + candleRange * 0.24

    bool doji = rangeValid and candleBody <= candleRange * 0.07 and upperWick >= candleRange * 0.25 and lowerWick >= candleRange * 0.25

    bool firstBearStrong = prev2Range > 0 and close[2] < open[2] and body2 >= prev2Range * 0.55
    bool firstBullStrong = prev2Range > 0 and close[2] > open[2] and body2 >= prev2Range * 0.55
    bool middleSmall = body2 > 0 and body1 <= body2 * 0.35
    bool morningStar = rangeValid and firstBearStrong and middleSmall and close > open and candleBody >= candleRange * 0.48 and close >= math.avg(open[2], close[2])
    bool eveningStar = rangeValid and firstBullStrong and middleSmall and close < open and candleBody >= candleRange * 0.48 and close <= math.avg(open[2], close[2])

    string patternName = 'NONE'
    int patternBias = 0
    if morningStar
        patternName := 'Morning Star'
        patternBias := BULLISH
    else if eveningStar
        patternName := 'Evening Star'
        patternBias := BEARISH
    else if bullishEngulfing
        patternName := 'Bullish Engulfing'
        patternBias := BULLISH
    else if bearishEngulfing
        patternName := 'Bearish Engulfing'
        patternBias := BEARISH
    else if hammer
        patternName := 'Hammer'
        patternBias := BULLISH
    else if shootingStar
        patternName := 'Shooting Star'
        patternBias := BEARISH
    else if bullishPinBar
        patternName := 'Bullish Pin Bar'
        patternBias := BULLISH
    else if bearishPinBar
        patternName := 'Bearish Pin Bar'
        patternBias := BEARISH
    else if doji
        patternName := 'Doji'
        patternBias := 0
    [patternName, patternBias]

var array<string> amyEventNames  = array.new_string()
var array<float>  amyEventLevels = array.new_float()
var array<int>    amyEventTimes  = array.new_int()
var array<int>    amyEventDirs   = array.new_int()
var array<float>  amyEventPower  = array.new_float()

amyAddEvent(string eventName, float eventLevel, int direction, float power) =>
    array.unshift(amyEventNames, eventName)
    array.unshift(amyEventLevels, eventLevel)
    array.unshift(amyEventTimes, time)
    array.unshift(amyEventDirs, direction)
    array.unshift(amyEventPower, power)
    if array.size(amyEventNames) > 4
        array.pop(amyEventNames)
        array.pop(amyEventLevels)
        array.pop(amyEventTimes)
        array.pop(amyEventDirs)
        array.pop(amyEventPower)

var array<label> amyChartLabels = array.new<label>()

amyAddChartLabel(int labelIndex, float labelPrice, string labelText, bool above, color labelColor) =>
    label newLabel = label.new(labelIndex, labelPrice, labelText, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(labelColor, 83), style = above ? label.style_label_down : label.style_label_up, textcolor = labelColor, size = size.tiny)
    array.push(amyChartLabels, newLabel)
    if array.size(amyChartLabels) > 3
        label.delete(array.shift(amyChartLabels))

[amyPatternNow, amyPatternDirNow] = amyDetectPattern()
var string amyLastPattern = 'NONE'
var int amyLastPatternDir = 0
var int amyLastPatternBar = na
var float amyLastPatternY = na
var bool amyLastPatternAbove = false
var color amyLastPatternColor = GRAY
var label amyLatestPatternLabel = na
float amyAtr14 = ta.atr(14)
float amyOffset = math.max(nz(amyAtr14, high - low) * 0.30, syminfo.mintick * 10)
int amyPatternMaxAge = 3

if barstate.isconfirmed and amyPatternNow != 'NONE'
    amyLastPattern := amyPatternNow
    amyLastPatternDir := amyPatternDirNow
    amyLastPatternBar := bar_index
    amyLastPatternAbove := amyPatternDirNow <= 0
    amyLastPatternY := amyLastPatternAbove ? high + amyOffset * 2.0 : low - amyOffset * 2.0
    amyLastPatternColor := amyPatternDirNow == BULLISH ? GREEN : amyPatternDirNow == BEARISH ? RED : GRAY

int amyPatternAge = na(amyLastPatternBar) ? 1000000 : bar_index - amyLastPatternBar
bool amyPatternActive = amyLastPattern != 'NONE' and amyPatternAge <= amyPatternMaxAge
bool amyPatternSwingAligned = amyLastPatternDir != 0 and amyLastPatternDir == swingTrend.bias
bool amyPatternInternalAligned = amyLastPatternDir != 0 and amyLastPatternDir == internalTrend.bias
bool amyPatternStructureAligned = amyPatternSwingAligned or amyPatternInternalAligned
int amyPatternBiasActive = amyPatternActive and amyPatternStructureAligned ? amyLastPatternDir : 0
string amyPatternDisplay = amyPatternActive ? amyLastPattern : 'NONE'

if barstate.islast
    if amyShowPatterns and amyPatternActive and not na(amyLastPatternBar)
        if na(amyLatestPatternLabel)
            amyLatestPatternLabel := label.new(amyLastPatternBar, amyLastPatternY, amyLastPattern, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(amyLastPatternColor, 83), style = amyLastPatternAbove ? label.style_label_down : label.style_label_up, textcolor = amyLastPatternColor, size = size.tiny)
        else
            label.set_xy(amyLatestPatternLabel, amyLastPatternBar, amyLastPatternY)
            label.set_text(amyLatestPatternLabel, amyLastPattern)
            label.set_color(amyLatestPatternLabel, color.new(amyLastPatternColor, 83))
            label.set_textcolor(amyLatestPatternLabel, amyLastPatternColor)
            label.set_style(amyLatestPatternLabel, amyLastPatternAbove ? label.style_label_down : label.style_label_up)
    else if not na(amyLatestPatternLabel)
        label.delete(amyLatestPatternLabel)
        amyLatestPatternLabel := na

var float amyLastSweptHigh = na
var float amyLastSweptLow  = na
var float amyLastBrokenHigh = na
var float amyLastBrokenLow  = na
var string amyLastLiquiditySide = ''
var float amyLastLiquidityLevel = na
var int amyLastLiquidityBias = 0
var int amyLastLiquidityBar = na

float amyBSL = swingHigh.currentLevel
float amySSL = swingLow.currentLevel
bool amyHighAvailable = not na(amyBSL)
bool amyLowAvailable = not na(amySSL)

bool amyBSLSweep = barstate.isconfirmed and amyHighAvailable and high > amyBSL and close <= amyBSL and (na(amyLastSweptHigh) or amyLastSweptHigh != amyBSL) and (na(amyLastBrokenHigh) or amyLastBrokenHigh != amyBSL)
bool amySSLSweep = barstate.isconfirmed and amyLowAvailable and low < amySSL and close >= amySSL and (na(amyLastSweptLow) or amyLastSweptLow != amySSL) and (na(amyLastBrokenLow) or amyLastBrokenLow != amySSL)
bool amyBSLValidBreak = barstate.isconfirmed and amyHighAvailable and close > amyBSL and close[1] <= amyBSL and (na(amyLastBrokenHigh) or amyLastBrokenHigh != amyBSL)
bool amySSLValidBreak = barstate.isconfirmed and amyLowAvailable and close < amySSL and close[1] >= amySSL and (na(amyLastBrokenLow) or amyLastBrokenLow != amySSL)

float amyEventAtr = ta.atr(14)
float amyEventRange = high - low
float amyEventBody = math.abs(close - open)
float amyEventBodyRatio = amyEventRange > 0 ? amyEventBody / amyEventRange : 0.0
bool amyEventDisplacement = not na(amyEventAtr) and amyEventBody >= amyEventAtr * 0.35 and amyEventBodyRatio >= 0.55
float amyMinSweepExcursion = nz(amyEventAtr, 0.0) * 0.08
float amyMinBreakExcursion = nz(amyEventAtr, 0.0) * 0.05
string amyHTF = amyAutoHTF()
int amyHTFSwing = request.security(syminfo.tickerid, amyHTF, amyStructureBias(5)[1], lookahead = barmerge.lookahead_on)
bool amyEventHTFBullOK = na(amyHTFSwing) or amyHTFSwing == 0 or amyHTFSwing == BULLISH
bool amyEventHTFBearOK = na(amyHTFSwing) or amyHTFSwing == 0 or amyHTFSwing == BEARISH
bool amyRound5M5 = timeframe.period == '5'
bool amyRound5M15 = timeframe.period == '15'
bool amyRound5H1 = timeframe.period == '60'
bool amyRound5TestTF = amyRound5M5 or amyRound5M15 or amyRound5H1
bool amyQualifiedBSLSweepBase = amyBSLSweep and high >= amyBSL + amyMinSweepExcursion and close >= amyBSL - nz(amyEventAtr, 0.0) * 0.20
bool amyQualifiedSSLSweepBase = amySSLSweep and low <= amySSL - amyMinSweepExcursion and close <= amySSL + nz(amyEventAtr, 0.0) * 0.20
bool amyQualifiedBSLValidBreakBase = amyBSLValidBreak and amyEventDisplacement and close > open and close >= amyBSL + amyMinBreakExcursion
bool amyQualifiedSSLValidBreakBase = amySSLValidBreak and amyEventDisplacement and close < open and close <= amySSL - amyMinBreakExcursion
float amyBreakBodyAtr = not na(amyEventAtr) and amyEventAtr > 0 ? amyEventBody / amyEventAtr : 0.0
// AMY SMC Y ROUND 5 — 16-YEAR CONDITIONAL LIQUIDITY PROFILE.
// Raw Sweep / Valid Break semantics are untouched. The 2010–2026 replay showed that a raw sweep is usually
// followed by the next swing structure in the OPPOSITE direction of the raw sweep bias when Internal Structure
// already points that way. This is used only as a forward-predictive continuation cue; the descriptive liquidity
// event, Event History, labels, and non-predictive modules keep their original meaning.
bool amyQualifiedBSLSweep = amyRound5TestTF ? false : amyQualifiedBSLSweepBase
bool amyQualifiedSSLSweep = amyRound5TestTF ? false : amyQualifiedSSLSweepBase
int amySweepContinuationBias = amyRound5TestTF ? (amyBSLSweep and internalTrend.bias == BULLISH ? BULLISH : amySSLSweep and internalTrend.bias == BEARISH ? BEARISH : 0) : 0
bool amySweepContinuationQualified = amySweepContinuationBias != 0
// Valid Break keeps the best pre-Round-5 profiles. It remains an independent confirmation/label layer and is not
// allowed to replace the much stronger sweep-continuation evidence in the Round 5 Next Move override.
bool amyQualifiedBSLValidBreak = amyRound5M5 ? (amyQualifiedBSLValidBreakBase and internalTrend.bias == BULLISH and amyEventHTFBullOK and amyBreakBodyAtr >= 3.0 and amyEventBodyRatio >= 0.80) : amyRound5M15 ? (amyQualifiedBSLValidBreakBase and internalTrend.bias == BULLISH and amyEventHTFBullOK and amyBreakBodyAtr >= 1.0 and amyEventBodyRatio >= 0.65) : amyRound5H1 ? (amyQualifiedBSLValidBreakBase and amyBreakBodyAtr >= 0.50 and amyEventBodyRatio >= 0.70) : amyQualifiedBSLValidBreakBase
bool amyQualifiedSSLValidBreak = amyRound5M5 ? (amyQualifiedSSLValidBreakBase and internalTrend.bias == BEARISH and amyEventHTFBearOK and amyBreakBodyAtr >= 3.0 and amyEventBodyRatio >= 0.80) : amyRound5M15 ? (amyQualifiedSSLValidBreakBase and internalTrend.bias == BEARISH and amyEventHTFBearOK and amyBreakBodyAtr >= 1.0 and amyEventBodyRatio >= 0.65) : amyRound5H1 ? (amyQualifiedSSLValidBreakBase and amyBreakBodyAtr >= 0.50 and amyEventBodyRatio >= 0.70) : amyQualifiedSSLValidBreakBase

// Base structure qualification is frozen for OTE/Fibonacci because that layer already improved in the previous retest.
bool amyBaseQualifiedSwingBullBOS = barstate.isconfirmed and currentAlerts.swingBullishBOS and amyEventDisplacement and close > open and close >= swingHigh.currentLevel + amyMinBreakExcursion
bool amyBaseQualifiedSwingBearBOS = barstate.isconfirmed and currentAlerts.swingBearishBOS and amyEventDisplacement and close < open and close <= swingLow.currentLevel - amyMinBreakExcursion
bool amyBaseQualifiedSwingBullCHoCH = barstate.isconfirmed and currentAlerts.swingBullishCHoCH and amyEventDisplacement and close > open and close >= swingHigh.currentLevel + amyMinBreakExcursion
bool amyBaseQualifiedSwingBearCHoCH = barstate.isconfirmed and currentAlerts.swingBearishCHoCH and amyEventDisplacement and close < open and close <= swingLow.currentLevel - amyMinBreakExcursion

// Round 5 predictive structure layer. Raw BOS remains valid descriptive structure, but on tested profiles
// it is not promoted as a forward prediction because its follow-through was weaker than CHoCH.
float amyBullCHoCHExcursionAtr = not na(amyEventAtr) and amyEventAtr > 0 and not na(swingHigh.currentLevel) ? (close - swingHigh.currentLevel) / amyEventAtr : 0.0
float amyBearCHoCHExcursionAtr = not na(amyEventAtr) and amyEventAtr > 0 and not na(swingLow.currentLevel) ? (swingLow.currentLevel - close) / amyEventAtr : 0.0
// ROUND 5 BEST-OF ROLLBACK — BOS continuation candidate did not beat the retained CHoCH profiles over 2010–2026.
// Raw BOS remains descriptive structure and the base BOS/CHoCH qualifier used by OTE/Fibonacci stays untouched.
bool amyQualifiedSwingBullBOS = amyRound5TestTF ? false : amyBaseQualifiedSwingBullBOS and (na(amyHTFSwing) or amyHTFSwing == 0 or amyHTFSwing == BULLISH)
bool amyQualifiedSwingBearBOS = amyRound5TestTF ? false : amyBaseQualifiedSwingBearBOS and (na(amyHTFSwing) or amyHTFSwing == 0 or amyHTFSwing == BEARISH)
// AMY SMC Y ROUND 3 — M15 CHoCH predictive promotion.
// Raw BOS/CHoCH and the base qualifier used by OTE/Fibonacci remain unchanged.
// The M15 forward-prediction layer now requires HTF + Internal alignment and stronger displacement,
// selected only because it improved train, validation, holdout, and full-history 2010–2026 scoring.
// AMY SMC Y ROUND 4 — M5/H1 CHoCH predictive refinement.
// M15 keeps the Round 3 profile. The base qualifier used by OTE/Fibonacci stays untouched.
// AMY SMC Y ROUND 6 — H1 CHoCH keeps only controlled displacement (<1.50 ATR). The 2010–2026 replay
// improved train, validation and holdout with this cap. Base CHoCH remains untouched for OTE/Fibonacci.
bool amyQualifiedSwingBullCHoCH = amyRound5M5 ? (amyBaseQualifiedSwingBullCHoCH and amyHTFSwing == BEARISH and internalTrend.bias == BULLISH and amyEventBodyRatio >= 0.65 and amyBullCHoCHExcursionAtr >= 0.30) : amyRound5M15 ? (amyBaseQualifiedSwingBullCHoCH and amyHTFSwing == BULLISH and internalTrend.bias == BULLISH and amyEventBody >= amyEventAtr * 1.00 and amyEventBodyRatio >= 0.70 and amyBullCHoCHExcursionAtr >= 0.30) : amyRound5H1 ? (amyBaseQualifiedSwingBullCHoCH and amyEventBodyRatio >= 0.65 and amyBreakBodyAtr < 1.50) : amyBaseQualifiedSwingBullCHoCH
bool amyQualifiedSwingBearCHoCH = amyRound5M5 ? (amyBaseQualifiedSwingBearCHoCH and amyHTFSwing == BULLISH and internalTrend.bias == BEARISH and amyEventBodyRatio >= 0.65 and amyBearCHoCHExcursionAtr >= 0.30) : amyRound5M15 ? (amyBaseQualifiedSwingBearCHoCH and amyHTFSwing == BEARISH and internalTrend.bias == BEARISH and amyEventBody >= amyEventAtr * 1.00 and amyEventBodyRatio >= 0.70 and amyBearCHoCHExcursionAtr >= 0.30) : amyRound5H1 ? (amyBaseQualifiedSwingBearCHoCH and amyEventBodyRatio >= 0.65 and amyBreakBodyAtr < 1.50) : amyBaseQualifiedSwingBearCHoCH

// Protected Strong layer retained from Round 4. It does not feed Final Bias, Target, or Invalidation.
var float amyProtectedStrongHigh = na
var float amyProtectedStrongLow = na
var int amyProtectedStrongHighBar = na
var int amyProtectedStrongLowBar = na
if barstate.isconfirmed
    if (amyBaseQualifiedSwingBullBOS or amyBaseQualifiedSwingBullCHoCH) and not na(swingLow.currentLevel)
        amyProtectedStrongLow := swingLow.currentLevel
        amyProtectedStrongLowBar := swingLow.barIndex
    if (amyBaseQualifiedSwingBearBOS or amyBaseQualifiedSwingBearCHoCH) and not na(swingHigh.currentLevel)
        amyProtectedStrongHigh := swingHigh.currentLevel
        amyProtectedStrongHighBar := swingHigh.barIndex

if amyBSLSweep
    amyLastSweptHigh := amyBSL
    amyLastLiquiditySide := 'BSL'
    amyLastLiquidityLevel := amyBSL
    amyLastLiquidityBias := BEARISH
    amyLastLiquidityBar := bar_index
    amyAddEvent('BSL SWEEP', amyBSL, BEARISH, 30)
    if amyShowEvents and amyQualifiedBSLSweep
        amyAddChartLabel(bar_index, high + amyOffset, 'SWEEP', true, RED)

if amySSLSweep
    amyLastSweptLow := amySSL
    amyLastLiquiditySide := 'SSL'
    amyLastLiquidityLevel := amySSL
    amyLastLiquidityBias := BULLISH
    amyLastLiquidityBar := bar_index
    amyAddEvent('SSL SWEEP', amySSL, BULLISH, 30)
    if amyShowEvents and amyQualifiedSSLSweep
        amyAddChartLabel(bar_index, low - amyOffset, 'SWEEP', false, GREEN)

if amyBSLValidBreak
    amyLastBrokenHigh := amyBSL
    amyLastLiquiditySide := 'BSL'
    amyLastLiquidityLevel := amyBSL
    amyLastLiquidityBias := BULLISH
    amyLastLiquidityBar := bar_index
    amyAddEvent('BSL VALID BREAK', amyBSL, BULLISH, 35)
    if amyShowEvents and amyQualifiedBSLValidBreak
        amyAddChartLabel(bar_index, high + amyOffset, 'VALID BREAK', true, GREEN)

if amySSLValidBreak
    amyLastBrokenLow := amySSL
    amyLastLiquiditySide := 'SSL'
    amyLastLiquidityLevel := amySSL
    amyLastLiquidityBias := BEARISH
    amyLastLiquidityBar := bar_index
    amyAddEvent('SSL VALID BREAK', amySSL, BEARISH, 35)
    if amyShowEvents and amyQualifiedSSLValidBreak
        amyAddChartLabel(bar_index, low - amyOffset, 'VALID BREAK', false, RED)

if barstate.isconfirmed
    if currentAlerts.swingBullishBOS
        amyAddEvent('BOS BULL', swingHigh.currentLevel, BULLISH, 25)
    if currentAlerts.swingBearishBOS
        amyAddEvent('BOS BEAR', swingLow.currentLevel, BEARISH, 25)
    if currentAlerts.swingBullishCHoCH
        amyAddEvent('CHoCH BULL', swingHigh.currentLevel, BULLISH, 20)
    if currentAlerts.swingBearishCHoCH
        amyAddEvent('CHoCH BEAR', swingLow.currentLevel, BEARISH, 20)
    if currentAlerts.equalHighs
        amyAddEvent('EQH', equalHigh.currentLevel, 0, 0)
    if currentAlerts.equalLows
        amyAddEvent('EQL', equalLow.currentLevel, 0, 0)

if amyShowLevelPrices
    if currentAlerts.equalHighs and not na(equalHighDisplay.l_abel)
        label.set_text(equalHighDisplay.l_abel, 'EQH ' + amyPrice(equalHigh.currentLevel))
    if currentAlerts.equalLows and not na(equalLowDisplay.l_abel)
        label.set_text(equalLowDisplay.l_abel, 'EQL ' + amyPrice(equalLow.currentLevel))

if amyShowBoxPrices and showFairValueGapsInput and (barstate.islastconfirmedhistory or barstate.islast)
    if array.size(fairValueGaps) > 0
        for [index, gap] in fairValueGaps
            string gapName = gap.bias == BULLISH ? 'Bullish FVG' : 'Bearish FVG'
            string gapText = gapName + '\n' + amyPrice(gap.top) + ' — ' + amyPrice(gap.bottom)
            color gapTextColor = gap.bias == BULLISH ? GREEN : RED
            box.set_text(gap.topBox, gapText)
            box.set_text_color(gap.topBox, gapTextColor)
            box.set_text_size(gap.topBox, size.tiny)
            box.set_text_halign(gap.topBox, text.align_center)
            box.set_text_valign(gap.topBox, text.align_center)
            box.set_text(gap.bottomBox, '')

if amyShowBoxPrices and showInternalOrderBlocksInput and (barstate.islastconfirmedhistory or barstate.islast)
    int amyInternalCount = math.min(internalOrderBlocksSizeInput, array.size(internalOrderBlocks))
    if amyInternalCount > 0
        for index = 0 to amyInternalCount - 1
            orderBlock currentOB = array.get(internalOrderBlocks, index)
            box currentBox = array.get(internalOrderBlocksBoxes, index)
            string obName = currentOB.bias == BULLISH ? 'Bullish Internal OB' : 'Bearish Internal OB'
            string obText = obName + '\n' + amyPrice(currentOB.barHigh) + ' — ' + amyPrice(currentOB.barLow)
            color obTextColor = currentOB.bias == BULLISH ? GREEN : RED
            box.set_text(currentBox, obText)
            box.set_text_color(currentBox, obTextColor)
            box.set_text_size(currentBox, size.tiny)
            box.set_text_halign(currentBox, text.align_center)
            box.set_text_valign(currentBox, text.align_center)

if amyShowBoxPrices and showSwingOrderBlocksInput and (barstate.islastconfirmedhistory or barstate.islast)
    int amySwingOBCount = math.min(swingOrderBlocksSizeInput, array.size(swingOrderBlocks))
    if amySwingOBCount > 0
        for index = 0 to amySwingOBCount - 1
            orderBlock currentOB = array.get(swingOrderBlocks, index)
            box currentBox = array.get(swingOrderBlocksBoxes, index)
            string obName = currentOB.bias == BULLISH ? 'Bullish Swing OB' : 'Bearish Swing OB'
            string obText = obName + '\n' + amyPrice(currentOB.barHigh) + ' — ' + amyPrice(currentOB.barLow)
            color obTextColor = currentOB.bias == BULLISH ? GREEN : RED
            box.set_text(currentBox, obText)
            box.set_text_color(currentBox, obTextColor)
            box.set_text_size(currentBox, size.tiny)
            box.set_text_halign(currentBox, text.align_center)
            box.set_text_valign(currentBox, text.align_center)

if amyShowLevelPrices and showHighLowSwingsInput and barstate.islast
    if array.size(label.all) > 0
        for currentLabel in label.all
            string currentText = label.get_text(currentLabel)
            if str.contains(currentText, 'Strong High')
                if not na(amyProtectedStrongHigh) and not na(amyProtectedStrongHighBar)
                    label.set_xy(currentLabel, amyProtectedStrongHighBar, amyProtectedStrongHigh)
                    label.set_text(currentLabel, 'Strong High ' + amyPrice(amyProtectedStrongHigh))
                else
                    label.set_text(currentLabel, 'Strong High ' + amyPrice(trailing.top))
            else if currentText == 'Weak High'
                label.set_text(currentLabel, 'Weak High ' + amyPrice(trailing.top))
            else if str.contains(currentText, 'Strong Low')
                if not na(amyProtectedStrongLow) and not na(amyProtectedStrongLowBar)
                    label.set_xy(currentLabel, amyProtectedStrongLowBar, amyProtectedStrongLow)
                    label.set_text(currentLabel, 'Strong Low ' + amyPrice(amyProtectedStrongLow))
                else
                    label.set_text(currentLabel, 'Strong Low ' + amyPrice(trailing.bottom))
            else if currentText == 'Weak Low'
                label.set_text(currentLabel, 'Weak Low ' + amyPrice(trailing.bottom))

amyNearestAbove(float a, float b, float c, float d, float reference) =>
    float result = na
    if not na(a) and a > reference
        result := a
    if not na(b) and b > reference and (na(result) or b < result)
        result := b
    if not na(c) and c > reference and (na(result) or c < result)
        result := c
    if not na(d) and d > reference and (na(result) or d < result)
        result := d
    result

amyNearestBelow(float a, float b, float c, float d, float reference) =>
    float result = na
    if not na(a) and a < reference
        result := a
    if not na(b) and b < reference and (na(result) or b > result)
        result := b
    if not na(c) and c < reference and (na(result) or c > result)
        result := c
    if not na(d) and d < reference and (na(result) or d > result)
        result := d
    result

amyNearestAbove6(float a, float b, float c, float d, float e, float f, float reference) =>
    float result = na
    if not na(a) and a > reference
        result := a
    if not na(b) and b > reference and (na(result) or b < result)
        result := b
    if not na(c) and c > reference and (na(result) or c < result)
        result := c
    if not na(d) and d > reference and (na(result) or d < result)
        result := d
    if not na(e) and e > reference and (na(result) or e < result)
        result := e
    if not na(f) and f > reference and (na(result) or f < result)
        result := f
    result

amyNearestBelow6(float a, float b, float c, float d, float e, float f, float reference) =>
    float result = na
    if not na(a) and a < reference
        result := a
    if not na(b) and b < reference and (na(result) or b > result)
        result := b
    if not na(c) and c < reference and (na(result) or c > result)
        result := c
    if not na(d) and d < reference and (na(result) or d > result)
        result := d
    if not na(e) and e < reference and (na(result) or e > result)
        result := e
    if not na(f) and f < reference and (na(result) or f > result)
        result := f
    result

var float amyDRTop = na
var float amyDRBottom = na
var int amyDRBias = 0

bool amyDRBullEvent = barstate.isconfirmed and (currentAlerts.swingBullishBOS or currentAlerts.swingBullishCHoCH)
bool amyDRBearEvent = barstate.isconfirmed and (currentAlerts.swingBearishBOS or currentAlerts.swingBearishCHoCH)

if amyDRBullEvent and not na(swingLow.currentLevel)
    amyDRBottom := swingLow.currentLevel
    amyDRTop := math.max(high, nz(swingHigh.currentLevel, high))
    amyDRBias := BULLISH
else if amyDRBearEvent and not na(swingHigh.currentLevel)
    amyDRTop := swingHigh.currentLevel
    amyDRBottom := math.min(low, nz(swingLow.currentLevel, low))
    amyDRBias := BEARISH
else if na(amyDRTop) and not na(swingHigh.currentLevel) and not na(swingLow.currentLevel) and swingHigh.currentLevel > swingLow.currentLevel
    amyDRTop := swingHigh.currentLevel
    amyDRBottom := swingLow.currentLevel
    amyDRBias := swingTrend.bias

bool amyDRValid = not na(amyDRTop) and not na(amyDRBottom) and amyDRTop > amyDRBottom
float amyRangeTop = amyDRValid ? amyDRTop : na
float amyRangeBottom = amyDRValid ? amyDRBottom : na
float amyRangeSpan = amyDRValid ? amyRangeTop - amyRangeBottom : na
float amyRangeEQ = amyDRValid ? math.avg(amyRangeTop, amyRangeBottom) : na
float amyEQUpper = amyDRValid ? amyRangeBottom + amyRangeSpan * 0.525 : na
float amyEQLower = amyDRValid ? amyRangeBottom + amyRangeSpan * 0.475 : na
// AMY SMC D — DEALING RANGE PURE-LOCATION PROFILES.
// Fresh raw XAUUSD 2004-2026, rolling 8y->1y OOS 2012-2026:
// M5 keeps 70/30 pure location; M15 keeps 60/40 pure location — both are frozen and unchanged.
// H1 uses the high/low of the previous 240 CLOSED H1 bars (current candle excluded) with 55/45 pure location.
// Dealing Range remains descriptive only; H1 has no Swing/Internal/HTF context gate and does not feed predictors.
float amyPassedDRPremiumRatio = 0.65
float amyPassedDRDiscountRatio = 0.35
float amyPremiumGate = amyDRValid ? amyRangeBottom + amyRangeSpan * amyPassedDRPremiumRatio : na
float amyDiscountGate = amyDRValid ? amyRangeBottom + amyRangeSpan * amyPassedDRDiscountRatio : na
bool amyDRM5Strict = timeframe.period == '5'
bool amyDRBullHTFConfirm = na(amyHTFSwing) or amyHTFSwing == 0 or amyHTFSwing == BULLISH
bool amyDRBearHTFConfirm = na(amyHTFSwing) or amyHTFSwing == 0 or amyHTFSwing == BEARISH
bool amyDRBullContextBase = amyDRBias == BULLISH and swingTrend.bias == BULLISH and internalTrend.bias != BEARISH
bool amyDRBearContextBase = amyDRBias == BEARISH and swingTrend.bias == BEARISH and internalTrend.bias != BULLISH
bool amyDRBullContext = amyDRBullContextBase and (not amyDRM5Strict or (internalTrend.bias == BULLISH and amyDRBullHTFConfirm))
bool amyDRBearContext = amyDRBearContextBase and (not amyDRM5Strict or (internalTrend.bias == BEARISH and amyDRBearHTFConfirm))

// D H1 — dedicated rolling range from previous 240 closed H1 bars only.
// high[1]/low[1] exclude the current H1 candle; ta.highest/lowest look only backward.
float amyCH1RangeTop = amyRound5H1 ? ta.highest(high[1], 240) : na
float amyCH1RangeBottom = amyRound5H1 ? ta.lowest(low[1], 240) : na
bool amyCH1DRValid = amyRound5H1 and not na(amyCH1RangeTop) and not na(amyCH1RangeBottom) and amyCH1RangeTop > amyCH1RangeBottom
float amyCH1RangeSpan = amyCH1DRValid ? amyCH1RangeTop - amyCH1RangeBottom : na
float amyCH1PremiumGate = amyCH1DRValid ? amyCH1RangeBottom + amyCH1RangeSpan * 0.55 : na
float amyCH1DiscountGate = amyCH1DRValid ? amyCH1RangeBottom + amyCH1RangeSpan * 0.45 : na

bool amyCDealingPureTF = amyRound5M5 or amyRound5M15
float amyCDealingPremiumRatio = amyRound5M5 ? 0.70 : amyRound5M15 ? 0.60 : amyPassedDRPremiumRatio
float amyCDealingDiscountRatio = amyRound5M5 ? 0.30 : amyRound5M15 ? 0.40 : amyPassedDRDiscountRatio
float amyCDealingPremiumGate = amyDRValid ? amyRangeBottom + amyRangeSpan * amyCDealingPremiumRatio : na
float amyCDealingDiscountGate = amyDRValid ? amyRangeBottom + amyRangeSpan * amyCDealingDiscountRatio : na

string amyDealingRange = 'EQUILIBRIUM'
int amyDealingBias = 0
if amyRound5H1
    // D H1: pure-location descriptive state from previous 240 closed H1 bars.
    // PREMIUM = bearish, DISCOUNT = bullish; 45%-55% remains equilibrium/neutral.
    if amyCH1DRValid
        if close >= amyCH1PremiumGate
            amyDealingRange := 'PREMIUM'
            amyDealingBias := BEARISH
        else if close <= amyCH1DiscountGate
            amyDealingRange := 'DISCOUNT'
            amyDealingBias := BULLISH
else if amyDRValid
    if amyCDealingPureTF
        // D M5/M15: the field itself is the validated pure-location signal.
        // PREMIUM = bearish, DISCOUNT = bullish; middle band remains equilibrium/neutral.
        if close >= amyCDealingPremiumGate
            amyDealingRange := 'PREMIUM'
            amyDealingBias := BEARISH
        else if close <= amyCDealingDiscountGate
            amyDealingRange := 'DISCOUNT'
            amyDealingBias := BULLISH
    else
        // Other timeframes retain the frozen Z behavior exactly.
        if close > amyEQUpper
            amyDealingRange := 'PREMIUM'
            amyDealingBias := close >= amyPremiumGate and amyDRBearContext ? BEARISH : 0
        else if close < amyEQLower
            amyDealingRange := 'DISCOUNT'
            amyDealingBias := close <= amyDiscountGate and amyDRBullContext ? BULLISH : 0
int amyLiquidityAge = na(amyLastLiquidityBar) ? 1000000 : bar_index - amyLastLiquidityBar
bool amyLiquidityActive = amyLiquidityAge <= 12
int amyLiquidityBiasActive = amyLiquidityActive ? amyLastLiquidityBias : 0

float amyRecentHigh = ta.highest(high[1], 50)
float amyRecentLow = ta.lowest(low[1], 50)
[amyPDH, amyPDL] = request.security(syminfo.tickerid, 'D', [high[1], low[1]], lookahead = barmerge.lookahead_on)
[amyPWH, amyPWL] = request.security(syminfo.tickerid, 'W', [high[1], low[1]], lookahead = barmerge.lookahead_on)
float amyWeakHigh = swingTrend.bias == BULLISH and trailing.lastTopTime < time ? trailing.top : na
float amyWeakLow = swingTrend.bias == BEARISH and trailing.lastBottomTime < time ? trailing.bottom : na
float amyLiquidityMinDistance = nz(amyAtr14, ta.atr(14)) * 0.35
float amyForwardBSL = amyNearestAbove6(equalHigh.currentLevel, amyWeakHigh, amyPDH, amyPWH, swingHigh.currentLevel, amyRecentHigh, close + amyLiquidityMinDistance)
float amyForwardSSL = amyNearestBelow6(equalLow.currentLevel, amyWeakLow, amyPDL, amyPWL, swingLow.currentLevel, amyRecentLow, close - amyLiquidityMinDistance)

string amyLiquidityDisplay = ''
if amyLiquidityActive and amyLastLiquiditySide != '' and not na(amyLastLiquidityLevel)
    amyLiquidityDisplay := amyLastLiquiditySide + ' ' + amyPrice(amyLastLiquidityLevel)
else if swingTrend.bias == BULLISH and not na(amyForwardBSL)
    amyLiquidityDisplay := 'BSL ' + amyPrice(amyForwardBSL)
else if swingTrend.bias == BEARISH and not na(amyForwardSSL)
    amyLiquidityDisplay := 'SSL ' + amyPrice(amyForwardSSL)
else if not na(amyForwardBSL)
    amyLiquidityDisplay := 'BSL ' + amyPrice(amyForwardBSL)
else if not na(amyForwardSSL)
    amyLiquidityDisplay := 'SSL ' + amyPrice(amyForwardSSL)
else
    amyLiquidityDisplay := '-'

int amyCurrentSwingBias = swingTrend.bias
int amyCurrentInternalBias = internalTrend.bias
int amySafeHTFBias = na(amyHTFSwing) ? 0 : amyHTFSwing
int amyPatternCandidate = amyPatternBiasActive
int amyPatternVotes = amyPatternCandidate == 0 ? 0 : (amySafeHTFBias == amyPatternCandidate ? 1 : 0) + (amyCurrentSwingBias == amyPatternCandidate ? 1 : 0) + (amyCurrentInternalBias == amyPatternCandidate ? 1 : 0) + (amyLiquidityBiasActive == amyPatternCandidate ? 1 : 0)
int amyPatternOpposes = amyPatternCandidate == 0 ? 0 : (amySafeHTFBias != 0 and amySafeHTFBias == -amyPatternCandidate ? 1 : 0) + (amyCurrentSwingBias != 0 and amyCurrentSwingBias == -amyPatternCandidate ? 1 : 0) + (amyCurrentInternalBias != 0 and amyCurrentInternalBias == -amyPatternCandidate ? 1 : 0) + (amyLiquidityBiasActive != 0 and amyLiquidityBiasActive == -amyPatternCandidate ? 1 : 0)
bool amyPatternReversal = amyLastPattern == 'Morning Star' or amyLastPattern == 'Evening Star' or amyLastPattern == 'Hammer' or amyLastPattern == 'Shooting Star' or amyLastPattern == 'Bullish Pin Bar' or amyLastPattern == 'Bearish Pin Bar'
bool amyPatternLocalBoth = amyPatternCandidate != 0 and amyCurrentSwingBias == amyPatternCandidate and amyCurrentInternalBias == amyPatternCandidate
bool amyPatternLiquidityConfirm = amyPatternCandidate != 0 and amyLiquidityBiasActive == amyPatternCandidate
bool amyPatternRound4TF = timeframe.period == '15' or timeframe.period == '60'
bool amyPatternContextQualified = false
if amyPatternCandidate != 0
    if not amyPatternRound4TF
        amyPatternContextQualified := amyPatternVotes >= 2 and amyPatternOpposes <= 1 and (not amyPatternReversal or amyPatternLiquidityConfirm or amyPatternLocalBoth)
    else
        bool amyPatternBearPriority = amyLastPattern == 'Bearish Engulfing' or amyLastPattern == 'Evening Star' or amyLastPattern == 'Bearish Pin Bar'
        bool amyPatternBullish = amyPatternCandidate == BULLISH
        int amyPatternRequiredVotes = amyPatternBearPriority ? 2 : 3
        bool amyPatternConflictOK = amyPatternBearPriority ? amyPatternOpposes <= 1 : amyPatternOpposes == 0
        bool amyPatternBullExtra = not amyPatternBullish or amyPatternLiquidityConfirm or amyPatternLocalBoth
        bool amyPatternReversalExtra = not amyPatternReversal or amyPatternLiquidityConfirm or amyPatternLocalBoth
        amyPatternContextQualified := amyPatternVotes >= amyPatternRequiredVotes and amyPatternConflictOK and amyPatternBullExtra and amyPatternReversalExtra
bool amyPatternNameAllowed = amyRound5M5 ? (amyLastPattern == 'Morning Star' or amyLastPattern == 'Bullish Pin Bar') : amyRound5M15 ? amyLastPattern != 'Bearish Engulfing' : amyRound5H1 ? (amyLastPattern != 'Bearish Engulfing' and amyLastPattern != 'Evening Star') : true
bool amyPatternV1Qualified = amyPatternContextQualified and amyPatternNameAllowed
// AMY SMC Y ROUND 3 — timeframe-specific pattern predictive promotion.
// Raw candlestick detection is unchanged. These rules only decide when a detected pattern is promoted as a forward predictor.
bool amyPatternRound3Qualified = amyPatternV1Qualified
if amyPatternCandidate != 0
    if amyRound5M5
        bool amyPatternM5Primary = (amyLastPattern == 'Bullish Engulfing' or amyLastPattern == 'Bullish Pin Bar' or amyLastPattern == 'Morning Star') and amySafeHTFBias == amyPatternCandidate and amyCurrentSwingBias != amyPatternCandidate
        bool amyPatternM5ConflictRecovery = (amyLastPattern == 'Bullish Engulfing' or amyLastPattern == 'Bearish Engulfing') and amyCurrentInternalBias == amyPatternCandidate and ((amyPatternVotes == 1 and amyPatternOpposes == 3) or (amyPatternVotes == 2 and amyPatternOpposes == 2))
        amyPatternRound3Qualified := amyPatternM5Primary or amyPatternM5ConflictRecovery
    else if amyRound5M15
        bool amyPatternM15Primary = (amyLastPattern == 'Bullish Engulfing' or amyLastPattern == 'Morning Star' or amyLastPattern == 'Bullish Pin Bar') and amyPatternVotes == 3 and amyPatternOpposes == 0
        bool amyPatternM15RetraceConfirm = amyLastPattern == 'Morning Star' and amyPatternVotes == 2 and amyPatternOpposes == 1 and amyCurrentInternalBias == amyPatternCandidate
        amyPatternRound3Qualified := amyPatternM15Primary or amyPatternM15RetraceConfirm
    else if amyRound5H1
        amyPatternRound3Qualified := (amyLastPattern == 'Bullish Engulfing' and amyPatternVotes == 3 and amyPatternOpposes == 0) or (amyLastPattern == 'Morning Star' and amyPatternVotes == 3 and amyPatternOpposes == 0) or (amyLastPattern == 'Bearish Pin Bar' and amyPatternVotes == 2 and amyPatternOpposes == 1) or (amyLastPattern == 'Hammer' and amyPatternVotes == 2 and amyPatternOpposes == 1 and amyCurrentInternalBias == amyPatternCandidate)
// AMY SMC Y ROUND 4 — precision refinement on top of the retained Round 3 pattern profile.
// No new pattern detector is added; only forward-predictive promotion is filtered.
bool amyPatternRound4Qualified = amyPatternRound3Qualified
if amyPatternCandidate != 0 and amyPatternRound3Qualified
    if amyRound5M5
        amyPatternRound4Qualified := amyLastPattern == 'Bullish Engulfing' or amyLastPattern == 'Bearish Engulfing'
    else if amyRound5M15
        amyPatternRound4Qualified := (amyLastPattern == 'Bullish Engulfing' or amyLastPattern == 'Morning Star') and amySafeHTFBias == amyPatternCandidate
    else if amyRound5H1
        amyPatternRound4Qualified := amySafeHTFBias == amyPatternCandidate and amyCurrentInternalBias == amyPatternCandidate
// AMY SMC Y ROUND 5 — 16-YEAR CONDITIONAL PATTERN PROFILE.
// No detector is added. M5 keeps only the Round-4-qualified Bearish Engulfing forward call because that family
// remained above 70% in train (2010–2018), validation (2019–2023), and holdout (2024–2026).
bool amyPatternRound5Qualified = amyPatternRound4Qualified
if amyRound5M5
    amyPatternRound5Qualified := amyPatternRound4Qualified and amyLastPattern == 'Bearish Engulfing'
// AMY SMC Y ROUND 6 — liquidity-conflict pattern regime.
// Across 2010–2026, a freshly detected M15/H1 pattern that points against the still-active liquidity bias was a
// repeatable reversal regime and improved train, validation and holdout versus the retained Round-5 pattern layer.
// This is detection-candle only so a later liquidity-state change cannot retroactively promote an old pattern.
bool amyPatternLiquidityConflictRegime = amyPatternAge == 0 and amyPatternCandidate != 0 and amyLiquidityBiasActive == -amyPatternCandidate
bool amyPatternRound6Qualified = amyPatternRound5Qualified or ((amyRound5M15 or amyRound5H1) and amyPatternLiquidityConflictRegime)
amyPatternBiasActive := amyPatternRound6Qualified ? amyPatternCandidate : 0

// FINAL ALL-PASSED CHECKPOINT — all accepted Amy SMC X modules are consolidated in this file.
// Final Bias keeps the already-passed core weights (HTF Swing, Swing Structure, Internal Structure, Liquidity Context).
// Pattern / qualified CHoCH / qualified Valid Break stay as independent confirmation layers instead of being double-counted
// into Final Bias, because their evidence is derived from the same underlying structure/liquidity state. Their best passed
// filters remain active for chart labels, alerts and downstream Target qualification.
float amyFinalScore = amySafeHTFBias * 35 + amyCurrentSwingBias * 30 + amyCurrentInternalBias * 20 + amyLiquidityBiasActive * 15
int amyFinalBias = BULLISH
if amyFinalScore > 0
    amyFinalBias := BULLISH
else if amyFinalScore < 0
    amyFinalBias := BEARISH
else if amyCurrentSwingBias != 0
    amyFinalBias := amyCurrentSwingBias
else if amySafeHTFBias != 0
    amyFinalBias := amySafeHTFBias
else
    amyFinalBias := close >= open ? BULLISH : BEARISH

string amyFinalBiasText = amyFinalBias == BULLISH ? 'BULLISH' : 'BEARISH'
float amyProtectedLow = not na(swingLow.currentLevel) and swingLow.currentLevel < close ? swingLow.currentLevel : na
float amyProtectedHigh = not na(swingHigh.currentLevel) and swingHigh.currentLevel > close ? swingHigh.currentLevel : na
float amyBullInvalidation = not na(amyProtectedLow) ? amyProtectedLow : amyNearestBelow(trailing.bottom, amyRecentLow, internalLow.currentLevel, na, close)
float amyBearInvalidation = not na(amyProtectedHigh) ? amyProtectedHigh : amyNearestAbove(trailing.top, amyRecentHigh, internalHigh.currentLevel, na, close)
float amyInvalidation = amyFinalBias == BULLISH ? amyBullInvalidation : amyBearInvalidation

float amyHistoryScore = 0.0
int amyEventCount = array.size(amyEventDirs)
float amyBarMillis = math.max(1.0, timeframe.in_seconds() * 1000.0)
if amyEventCount > 0
    for index = 0 to amyEventCount - 1
        int eventDirection = array.get(amyEventDirs, index)
        float eventStrength = array.get(amyEventPower, index)
        int eventTimeValue = array.get(amyEventTimes, index)
        float eventAgeBars = math.max(0.0, (time - eventTimeValue) / amyBarMillis)
        float ageWeight = eventAgeBars <= 4 ? 1.00 : eventAgeBars <= 12 ? 0.65 : eventAgeBars <= 24 ? 0.35 : 0.0
        float orderWeight = index == 0 ? 1.00 : index == 1 ? 0.80 : index == 2 ? 0.60 : 0.40
        amyHistoryScore += eventDirection * eventStrength * ageWeight * orderWeight

int amyHistoryBias = amyHistoryScore > 5 ? BULLISH : amyHistoryScore < -5 ? BEARISH : 0
// AMY SMC Z ROUND 8 — LONG-HISTORY CONTEXT.
// Final Bias remains a continuous descriptive bias, while M5 Next Move is now selective and may WAIT outside
// the validated execution regime. M15/H1 retain the accepted Round-7 directional behavior.
// Event History stays context/confidence evidence and is not an independent direction-flip engine.
float amyContextScore = amySafeHTFBias * 25 + amyCurrentSwingBias * 25 + amyCurrentInternalBias * 15 + amyLiquidityBiasActive * 15
float amyNextRaw = amyHistoryScore * 0.55 + amyContextScore
// AMY SMC Z ROUND 8 — REGIME-ADAPTIVE NEXT MOVE.
// The 2010–2026 replay found that M5 Internal Transition is the only selective execution regime that improved
// train, validation, holdout and full-history Target V1 lifecycle together. M5 therefore predicts only when that
// regime is active; outside it the dashboard explicitly waits instead of forcing a low-quality UP/DOWN call.
// Sweep continuation remains a high-precision directional WATCH context, but it is not promoted to a target-backed
// M5 execution call because adding it produced only a marginal lifecycle gain. M15/H1 regime-gating candidates were
// rolled back, so those timeframes retain the accepted Round-7 behavior.
bool amyM5InternalTransitionRegime = amyRound5M5 and amySafeHTFBias != 0 and amySafeHTFBias == amyCurrentSwingBias and amyLiquidityBiasActive == amyCurrentSwingBias and amyCurrentInternalBias == -amyCurrentSwingBias
bool amyRound8M5TradeRegime = amyM5InternalTransitionRegime

// AMY SMC Z ROUND 9 — CONFIRMED TRANSITION EXECUTION GATE.
// Round 8 proved the Internal Transition regime robustly, but not every transition entry had equal execution quality.
// Round 9 keeps the regime only when the ENTRY candle closes in the new Internal direction and the protected
// structural invalidation is at least 3 ATR away. This 3 ATR structural-room gate improved directional precision
// and Target V1 lifecycle in train, validation and holdout; it does not shorten the target or use future candles.
bool amyRound9M5RegimeEntry = amyRound8M5TradeRegime and not amyRound8M5TradeRegime[1]
float amyRound9EntryInvalidation = amyCurrentInternalBias == BULLISH ? amyBullInvalidation : amyCurrentInternalBias == BEARISH ? amyBearInvalidation : na
float amyRound9EntryRiskAtr = not na(amyRound9EntryInvalidation) and not na(amyEventAtr) and amyEventAtr > 0 ? math.abs(close - amyRound9EntryInvalidation) / amyEventAtr : na
bool amyRound9CandleConfirm = amyCurrentInternalBias == BULLISH ? close > open : amyCurrentInternalBias == BEARISH ? close < open : false
bool amyRound9EntryConfirmed = amyRound9CandleConfirm and not na(amyRound9EntryRiskAtr) and amyRound9EntryRiskAtr >= 3.0
var int amyRound9M5TradeDirection = 0
if barstate.isconfirmed
    if not amyRound8M5TradeRegime
        amyRound9M5TradeDirection := 0
    else if amyRound9M5RegimeEntry
        amyRound9M5TradeDirection := amyRound9EntryConfirmed ? amyCurrentInternalBias : 0

bool amyRound9M5TradeRegime = amyRound8M5TradeRegime and amyRound9M5TradeDirection != 0

// AMY SMC Z ROUND 10 — QUALITY GRADE, NOT A CORE FILTER.
// Train + validation selected a cleaner confirmed-transition subset: entry body 0.50–2.50 ATR,
// body/range >= 0.30 and structural room < 8 ATR (Round 9 already enforces >= 3 ATR).
// Its Target V1 lifecycle improved strongly, but holdout directional precision was lower by one historical hit.
// Therefore Round 10 does NOT discard the retained Round-9 trades. It grades the cleaner subset A+ and keeps
// the remaining already-valid Round-9 trades as A. Next Move, Target V1 and invalidation logic stay unchanged.
float amyRound10EntryBodyAtr = not na(amyEventAtr) and amyEventAtr > 0 ? amyEventBody / amyEventAtr : na
bool amyRound10EntryAPlusQualified = amyRound9EntryConfirmed and not na(amyRound10EntryBodyAtr) and amyRound10EntryBodyAtr >= 0.50 and amyRound10EntryBodyAtr < 2.50 and amyEventBodyRatio >= 0.30 and amyRound9EntryRiskAtr < 8.0
var bool amyRound10M5APlus = false
if barstate.isconfirmed
    if not amyRound9M5TradeRegime
        amyRound10M5APlus := false
    else if amyRound9M5RegimeEntry
        amyRound10M5APlus := amyRound10EntryAPlusQualified

bool amyRound9M5SweepWatch = amyRound5M5 and not amyRound9M5TradeRegime and amySweepContinuationQualified
bool amyRound9M5TransitionWatch = amyRound5M5 and amyRound8M5TradeRegime and not amyRound9M5TradeRegime
string amyRound10Regime = amyRound5M5 ? (amyRound9M5TradeRegime ? (amyRound10M5APlus ? 'TRADE • A+' : 'TRADE • A') : amyRound9M5SweepWatch ? 'WATCH • SWEEP' : amyRound9M5TransitionWatch ? 'WATCH • TRANSITION' : 'WAIT') : 'R9 BASELINE'
int amyNextDirection = amyRound5M5 ? (amyRound9M5TradeRegime ? amyRound9M5TradeDirection : 0) : amyFinalBias
// H1 keeps the previously accepted confirmed-sweep-candle override. M15 remains the retained baseline.
if amyRound5H1 and amySweepContinuationQualified
    amyNextDirection := amySweepContinuationBias

bool amyHasExecutionSignal = amyNextDirection != 0
string amyNextMove = amyNextDirection == BULLISH ? 'UP' : amyNextDirection == BEARISH ? 'DOWN' : 'WAIT'
// Pullback mirrors the already-gated Next Move state; it adds no independent predictor or classifier.
int amyPullbackDirection = amyNextDirection == BULLISH ? BEARISH : amyNextDirection == BEARISH ? BULLISH : 0
string amyPullback = amyPullbackDirection == BULLISH ? 'UP' : amyPullbackDirection == BEARISH ? 'DOWN' : 'WAIT'
// Select invalidation from the actual execution direction. WAIT has no synthetic invalidation/target.
float amyExecutionInvalidation = amyNextDirection == BULLISH ? amyBullInvalidation : amyNextDirection == BEARISH ? amyBearInvalidation : na
// AMY SMC Z ROUND 8 TARGET V1 — target is available whenever Next Move is actionable.
// M5 WAIT/WATCH intentionally has no synthetic target. For actionable calls, prefer nearby untouched structural liquidity;
// if that liquidity is too distant or unavailable, use the retained conservative projected fallback. The projected target
// is forced outside the signal candle, preserving the same-candle anti-leak rule.
float amyTargetAtr = nz(amyAtr14, math.max(high - low, syminfo.mintick))
float amyTargetRiskDistance = not na(amyExecutionInvalidation) ? math.abs(close - amyExecutionInvalidation) : amyTargetAtr
float amyProjectedTargetDistance = math.max(amyTargetRiskDistance * 0.40, amyTargetAtr * 0.22)
float amyTargetOutsidePad = math.max(amyTargetAtr * 0.02, syminfo.mintick)
float amyBullProjectedTarget = math.max(close + amyProjectedTargetDistance, high + amyTargetOutsidePad)
float amyBearProjectedTarget = math.min(close - amyProjectedTargetDistance, low - amyTargetOutsidePad)
float amyTargetMinDistance = math.max(amyTargetAtr * 0.10, amyTargetRiskDistance * 0.30)
float amyBullTargetRef = math.max(close + amyTargetMinDistance, high + syminfo.mintick)
float amyBearTargetRef = math.min(close - amyTargetMinDistance, low - syminfo.mintick)
float amyBullTargetBase = amyNearestAbove6(equalHigh.currentLevel, amyWeakHigh, amyPDH, amyPWH, swingHigh.currentLevel, amyRecentHigh, amyBullTargetRef)
float amyBearTargetBase = amyNearestBelow6(equalLow.currentLevel, amyWeakLow, amyPDL, amyPWL, swingLow.currentLevel, amyRecentLow, amyBearTargetRef)
float amyInternalBullTarget = not na(internalHigh.currentLevel) and internalHigh.currentLevel > amyBullTargetRef ? internalHigh.currentLevel : na
float amyInternalBearTarget = not na(internalLow.currentLevel) and internalLow.currentLevel < amyBearTargetRef ? internalLow.currentLevel : na
float amyTargetCandidate = not amyHasExecutionSignal ? na : amyNextDirection == BULLISH ? amyNearestAbove(amyBullTargetBase, amyInternalBullTarget, na, na, amyBullTargetRef) : amyNearestBelow(amyBearTargetBase, amyInternalBearTarget, na, na, amyBearTargetRef)
float amyTargetDistanceRatio = not na(amyTargetCandidate) and amyTargetRiskDistance > 0 ? math.abs(amyTargetCandidate - close) / amyTargetRiskDistance : na
bool amyTargetQualityOK = amyHasExecutionSignal and not na(amyTargetCandidate) and amyTargetRiskDistance > 0 and amyTargetDistanceRatio <= 0.40
float amyTarget = not amyHasExecutionSignal ? na : amyTargetQualityOK ? amyTargetCandidate : amyNextDirection == BULLISH ? amyBullProjectedTarget : amyBearProjectedTarget
string amyTargetSide = not amyHasExecutionSignal ? 'WAIT' : amyTargetQualityOK ? (amyNextDirection == BULLISH ? 'BSL' : 'SSL') : (amyNextDirection == BULLISH ? 'PROJ UP' : 'PROJ DOWN')

// Confidence measures agreement only when an actionable prediction exists.
float amyConfidenceRaw = amyHasExecutionSignal ? 50.0 : 0.0
if amyHasExecutionSignal and amySafeHTFBias != 0
    amyConfidenceRaw += amySafeHTFBias == amyNextDirection ? 8 : -8
if amyHasExecutionSignal and amyCurrentSwingBias != 0
    amyConfidenceRaw += amyCurrentSwingBias == amyNextDirection ? 10 : -10
if amyHasExecutionSignal and amyCurrentInternalBias != 0
    amyConfidenceRaw += amyCurrentInternalBias == amyNextDirection ? 6 : -6
if amyHasExecutionSignal and amyLiquidityBiasActive != 0
    amyConfidenceRaw += amyLiquidityBiasActive == amyNextDirection ? 6 : -6
if amyHasExecutionSignal and amyHistoryBias != 0
    amyConfidenceRaw += amyHistoryBias == amyNextDirection ? 5 : -5
if amyHasExecutionSignal and math.abs(amyNextRaw) < 18
    amyConfidenceRaw -= 5
int amyConfidence = amyHasExecutionSignal ? int(math.round(math.max(35.0, math.min(85.0, amyConfidenceRaw)))) : 0

var table amyDashboard = table.new(position.bottom_right, 2, 17, bgcolor = color.new(color.black, 12), border_color = color.new(GRAY, 65), border_width = 1)

if barstate.isfirst
    table.merge_cells(amyDashboard, 0, 0, 1, 0)
    table.merge_cells(amyDashboard, 0, 13, 1, 13)

if barstate.islast
    if amyShowDashboard
        color amyBullColor = GREEN
        color amyBearColor = RED
        color amyFinalColor = amyFinalBias == BULLISH ? amyBullColor : amyBearColor
        color amyNextColor = amyNextDirection == BULLISH ? amyBullColor : amyNextDirection == BEARISH ? amyBearColor : GRAY
        color amyPullbackColor = amyPullbackDirection == BULLISH ? amyBullColor : amyPullbackDirection == BEARISH ? amyBearColor : GRAY
        string amyHeader = 'MARKET BIAS — ' + amyTfName(timeframe.period)
        table.cell(amyDashboard, 0, 0, amyHeader, bgcolor = color.new(BLUE, 72), text_color = color.white, text_size = size.small)
        table.cell(amyDashboard, 0, 1, 'HTF Swing', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 1, (amySafeHTFBias == BULLISH ? 'BULLISH' : 'BEARISH') + ' • ' + amyTfName(amyHTF), text_color = amySafeHTFBias == BULLISH ? amyBullColor : amyBearColor, text_size = size.tiny)
        table.cell(amyDashboard, 0, 2, 'Swing Structure', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 2, amyCurrentSwingBias == BULLISH ? 'BULLISH' : 'BEARISH', text_color = amyCurrentSwingBias == BULLISH ? amyBullColor : amyBearColor, text_size = size.tiny)
        table.cell(amyDashboard, 0, 3, 'Liquidity', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 3, amyLiquidityDisplay, text_color = color.white, text_size = size.tiny)
        table.cell(amyDashboard, 0, 4, 'Dealing Range', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 4, amyDealingRange, text_color = amyDealingBias == BULLISH ? amyBullColor : amyDealingBias == BEARISH ? amyBearColor : GRAY, text_size = size.tiny)
        table.cell(amyDashboard, 0, 5, 'Pattern', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 5, amyPatternDisplay, text_color = amyPatternBiasActive == BULLISH ? amyBullColor : amyPatternBiasActive == BEARISH ? amyBearColor : GRAY, text_size = size.tiny)
        table.cell(amyDashboard, 0, 6, 'Final Bias', text_color = color.white, bgcolor = color.new(amyFinalColor, 82), text_size = size.tiny)
        table.cell(amyDashboard, 1, 6, amyFinalBiasText, text_color = amyFinalColor, bgcolor = color.new(amyFinalColor, 82), text_size = size.tiny)
        table.cell(amyDashboard, 0, 7, 'Invalidasi', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 7, amyPrice(amyExecutionInvalidation), text_color = color.white, text_size = size.tiny)
        table.cell(amyDashboard, 0, 8, 'Next Move', text_color = color.white, bgcolor = color.new(amyNextColor, 82), text_size = size.tiny)
        table.cell(amyDashboard, 1, 8, amyNextMove, text_color = amyNextColor, bgcolor = color.new(amyNextColor, 82), text_size = size.tiny)
        table.cell(amyDashboard, 0, 9, 'Pullback', text_color = color.white, bgcolor = color.new(amyPullbackColor, 82), text_size = size.tiny)
        table.cell(amyDashboard, 1, 9, amyPullback, text_color = amyPullbackColor, bgcolor = color.new(amyPullbackColor, 82), text_size = size.tiny)
        table.cell(amyDashboard, 0, 10, 'Target', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 10, amyHasExecutionSignal ? amyTargetSide + ' ' + amyPrice(amyTarget) : '-', text_color = color.white, text_size = size.tiny)
        table.cell(amyDashboard, 0, 11, 'Regime', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 11, amyRound10Regime, text_color = amyRound9M5TradeRegime ? amyNextColor : (amyRound9M5SweepWatch or amyRound9M5TransitionWatch) ? color.orange : color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 0, 12, 'Confidence', text_color = color.silver, text_size = size.tiny)
        table.cell(amyDashboard, 1, 12, amyHasExecutionSignal ? str.tostring(amyConfidence) + '%' : '-', text_color = amyNextColor, text_size = size.tiny)
        table.cell(amyDashboard, 0, 13, 'EVENT HISTORY', bgcolor = color.new(GRAY, 82), text_color = color.white, text_size = size.tiny)
        for historyIndex = 0 to 2
            int historyRow = 14 + historyIndex
            if historyIndex < array.size(amyEventNames)
                string eventName = array.get(amyEventNames, historyIndex)
                float eventLevel = array.get(amyEventLevels, historyIndex)
                int eventTime = array.get(amyEventTimes, historyIndex)
                int eventDirection = array.get(amyEventDirs, historyIndex)
                string eventClock = str.format_time(eventTime, 'HH:mm', syminfo.timezone)
                color eventColor = eventDirection == BULLISH ? amyBullColor : eventDirection == BEARISH ? amyBearColor : color.silver
                table.cell(amyDashboard, 0, historyRow, eventClock, text_color = color.silver, text_size = size.tiny)
                table.cell(amyDashboard, 1, historyRow, eventName + ' @ ' + amyPrice(eventLevel), text_color = eventColor, text_size = size.tiny)
            else
                table.cell(amyDashboard, 0, historyRow, '-', text_color = color.new(GRAY, 50), text_size = size.tiny)
                table.cell(amyDashboard, 1, historyRow, '-', text_color = color.new(GRAY, 50), text_size = size.tiny)
    else
        for dashboardRow = 0 to 16
            table.cell(amyDashboard, 0, dashboardRow, '', bgcolor = color.new(color.black, 100))
            table.cell(amyDashboard, 1, dashboardRow, '', bgcolor = color.new(color.black, 100))

// AMY SMC Z ROUND 10 RESULT LOCK
// Round 9 remains the execution baseline: confirmed Internal Transition + >=3 ATR structural room.
// Round 10 adds only evidence-backed quality grading: A+ is the cleaner body/risk subset; A keeps every other
// already-valid Round-9 trade. The A+ subset was NOT allowed to replace A because holdout directional precision
// was lower by one historical hit despite materially better Target V1 lifecycle. This preserves the best-of rule.
// M15/H1 and all previously strong descriptive modules remain unchanged.

// FINAL LONG-HISTORY BASELINE — XAUUSD 2010–2026 validation checkpoint.
// The current Amy SMC X configuration beat the previous settings on the same long-history replay, so its logic is frozen as the reference baseline.
// Further predictive development continues in Amy SMC Y; Amy SMC X should not be changed unless explicitly requested.

// FINAL CONSOLIDATION LOCK
// Passed modules present in Amy SMC X: Internal/Swing/HTF structure, Liquidity Context, Event History, Next Move,
// Final Bias, EQH/EQL, Weak/Strong H-L, Daily/Weekly/Monthly H-L, Dealing Range, FVG, Order Block, Invalidation,
// Confidence, OTE, Fibonacci Extension, Pattern, qualified BOS/CHoCH, qualified Sweep/Valid Break, and Target.
// Future tuning must not overwrite a better passed profile with a worse result.

alertcondition(amyQualifiedBSLSweep or amyQualifiedSSLSweep, 'Liquidity Sweep', 'Qualified liquidity sweep detected')
alertcondition(amyQualifiedBSLValidBreak or amyQualifiedSSLValidBreak, 'Valid Break', 'Qualified structure/liquidity break detected')
alertcondition(barstate.isconfirmed and amyPatternBiasActive != 0, 'Candlestick Pattern', 'Context-qualified candlestick pattern detected')
alertcondition(barstate.isconfirmed and amyRound5M5 and amyRound8M5TradeRegime, 'Round 8 Regime Signal', 'Amy SMC Z Round 8 M5 Internal Transition regime is actionable')

//---------------------------------------------------------------------------------------------------------------------}
// AMY SMC Y — INDEPENDENT CHART MODULES
// OTE / Fibonacci Extension
//---------------------------------------------------------------------------------------------------------------------{

AMYX_OTE_GROUP = 'Amy OTE'
AMYX_FIB_GROUP = 'Amy Fibonacci Extension'

amyxShowOTE       = input.bool(true, 'Show OTE', group = AMYX_OTE_GROUP)
amyxOTEExtendBars = input.int(12, 'Extend Bars', minval = 5, maxval = 100, group = AMYX_OTE_GROUP)

amyxShowFib       = input.bool(true, 'Show Fibonacci Extension', group = AMYX_FIB_GROUP)
amyxFibExtendBars = input.int(12, 'Extend Bars', minval = 5, maxval = 100, group = AMYX_FIB_GROUP)
amyxFibMaxInput   = input.string('2.000', 'Max Extension', options = ['2.000', '2.618'], group = AMYX_FIB_GROUP)

float amyxRawSwingTop = swingHigh.currentLevel
float amyxRawSwingBottom = swingLow.currentLevel
bool amyxRawRangeValid = not na(amyxRawSwingTop) and not na(amyxRawSwingBottom) and amyxRawSwingTop > amyxRawSwingBottom

var float amyxLockedTop = na
var float amyxLockedBottom = na
var int amyxLockedBias = 0
var int amyxLockedStartBar = na
var int amyxLockedEndBar = na

float amyxImpulseAtr = ta.atr(14)
float amyxImpulseRange = high - low
float amyxImpulseBody = math.abs(close - open)
float amyxImpulseBodyRatio = amyxImpulseRange > 0 ? amyxImpulseBody / amyxImpulseRange : 0.0
bool amyxImpulseDisplacement = not na(amyxImpulseAtr) and amyxImpulseBody >= amyxImpulseAtr * 0.45 and amyxImpulseBodyRatio >= 0.55
bool amyxBullStructureEvent = (amyBaseQualifiedSwingBullBOS or amyBaseQualifiedSwingBullCHoCH) and (amySafeHTFBias == 0 or amySafeHTFBias == BULLISH) and amyCurrentInternalBias != BEARISH and close >= high - amyxImpulseRange * 0.25
bool amyxBearStructureEvent = (amyBaseQualifiedSwingBearBOS or amyBaseQualifiedSwingBearCHoCH) and (amySafeHTFBias == 0 or amySafeHTFBias == BEARISH) and amyCurrentInternalBias != BULLISH and close <= low + amyxImpulseRange * 0.25

if amyxBullStructureEvent and not na(swingLow.currentLevel)
    amyxLockedBottom := swingLow.currentLevel
    amyxLockedTop := math.max(high, nz(swingHigh.currentLevel, high))
    amyxLockedBias := BULLISH
    amyxLockedStartBar := swingLow.barIndex
    amyxLockedEndBar := bar_index
else if amyxBearStructureEvent and not na(swingHigh.currentLevel)
    amyxLockedTop := swingHigh.currentLevel
    amyxLockedBottom := math.min(low, nz(swingLow.currentLevel, low))
    amyxLockedBias := BEARISH
    amyxLockedStartBar := swingHigh.barIndex
    amyxLockedEndBar := bar_index

bool amyxLockedInvalid = amyxLockedBias == BULLISH ? (not na(amyxLockedBottom) and close < amyxLockedBottom) : amyxLockedBias == BEARISH ? (not na(amyxLockedTop) and close > amyxLockedTop) : false
if barstate.isconfirmed and amyxLockedInvalid
    amyxLockedTop := na
    amyxLockedBottom := na
    amyxLockedBias := 0
    amyxLockedStartBar := na
    amyxLockedEndBar := na

float amyxSwingTop = amyxLockedTop
float amyxSwingBottom = amyxLockedBottom
bool amyxRangeValid = not na(amyxSwingTop) and not na(amyxSwingBottom) and amyxSwingTop > amyxSwingBottom and amyxLockedBias != 0
float amyxSwingRange = amyxRangeValid ? amyxSwingTop - amyxSwingBottom : na
int amyxLegBias = amyxLockedBias == BEARISH ? BEARISH : BULLISH
color amyxLegColor = amyxLegBias == BULLISH ? GREEN : RED

//---------------------------------------------------------------------------------------------------------------------}
// PASSED CHECKPOINT — OTE→1.272 M15: 85.71% (6/7). Preserve the current locked-leg/OTE profile.
// OTE — 0.62 / 0.705 / 0.79
//---------------------------------------------------------------------------------------------------------------------{

float amyxOTE62 = na
float amyxOTE705 = na
float amyxOTE79 = na

if amyxRangeValid
    if amyxLegBias == BULLISH
        amyxOTE62 := amyxSwingTop - amyxSwingRange * 0.62
        amyxOTE705 := amyxSwingTop - amyxSwingRange * 0.705
        amyxOTE79 := amyxSwingTop - amyxSwingRange * 0.79
    else
        amyxOTE62 := amyxSwingBottom + amyxSwingRange * 0.62
        amyxOTE705 := amyxSwingBottom + amyxSwingRange * 0.705
        amyxOTE79 := amyxSwingBottom + amyxSwingRange * 0.79

float amyxOTETop = amyxRangeValid ? math.max(amyxOTE62, amyxOTE79) : na
float amyxOTEBottom = amyxRangeValid ? math.min(amyxOTE62, amyxOTE79) : na
int amyxOTELeft = nz(amyxLockedStartBar, bar_index)
int amyxOTERight = bar_index + amyxOTEExtendBars

var box amyxOTEBox = na
var line amyxOTE705Line = na

if barstate.islast
    if amyxShowOTE and amyxRangeValid
        if na(amyxOTEBox)
            amyxOTEBox := box.new(amyxOTELeft, amyxOTETop, amyxOTERight, amyxOTEBottom, xloc = xloc.bar_index, bgcolor = color.new(amyxLegColor, 88), border_color = color.new(amyxLegColor, 35))
        else
            box.set_left(amyxOTEBox, amyxOTELeft)
            box.set_right(amyxOTEBox, amyxOTERight)
            box.set_top(amyxOTEBox, amyxOTETop)
            box.set_bottom(amyxOTEBox, amyxOTEBottom)
            box.set_bgcolor(amyxOTEBox, color.new(amyxLegColor, 88))
            box.set_border_color(amyxOTEBox, color.new(amyxLegColor, 35))
        box.set_text(amyxOTEBox, 'OTE\n' + amyPrice(amyxOTETop) + ' — ' + amyPrice(amyxOTEBottom))
        box.set_text_color(amyxOTEBox, amyxLegColor)
        box.set_text_size(amyxOTEBox, size.tiny)
        box.set_text_halign(amyxOTEBox, text.align_center)
        box.set_text_valign(amyxOTEBox, text.align_center)

        if na(amyxOTE705Line)
            amyxOTE705Line := line.new(amyxOTELeft, amyxOTE705, amyxOTERight, amyxOTE705, xloc = xloc.bar_index, color = color.new(amyxLegColor, 20), style = line.style_dotted, width = 1)
        else
            line.set_xy1(amyxOTE705Line, amyxOTELeft, amyxOTE705)
            line.set_xy2(amyxOTE705Line, amyxOTERight, amyxOTE705)
            line.set_color(amyxOTE705Line, color.new(amyxLegColor, 20))
    else
        if not na(amyxOTEBox)
            box.delete(amyxOTEBox)
            amyxOTEBox := na
        if not na(amyxOTE705Line)
            line.delete(amyxOTE705Line)
            amyxOTE705Line := na

var int amyxLastOTETouchLeg = na
bool amyxOTERawTouch = barstate.isconfirmed and amyxShowOTE and amyxRangeValid and high >= amyxOTEBottom and low <= amyxOTETop
bool amyxOTETouch = amyxOTERawTouch and (na(amyxLastOTETouchLeg) or amyxLastOTETouchLeg != amyxLockedEndBar)
if amyxOTETouch
    amyxLastOTETouchLeg := amyxLockedEndBar

//---------------------------------------------------------------------------------------------------------------------}
// PASSED CHECKPOINT — Fib 1.272: M5 70.27% (26/37), M15 81.82% (9/11). Preserve TP1 ratio/profile.
// FIBONACCI EXTENSION — TP1 / TP2 / MAX
//---------------------------------------------------------------------------------------------------------------------{

float amyxFibMaxRatio = amyxFibMaxInput == '2.618' ? 2.618 : 2.0
float amyxPassedFibTP1Ratio = 1.272
float amyxFib1272 = na
float amyxFib1618 = na
float amyxFibMax = na

if amyxRangeValid
    if amyxLegBias == BULLISH
        amyxFib1272 := amyxSwingBottom + amyxSwingRange * amyxPassedFibTP1Ratio
        amyxFib1618 := amyxSwingBottom + amyxSwingRange * 1.618
        amyxFibMax := amyxSwingBottom + amyxSwingRange * amyxFibMaxRatio
    else
        amyxFib1272 := amyxSwingTop - amyxSwingRange * amyxPassedFibTP1Ratio
        amyxFib1618 := amyxSwingTop - amyxSwingRange * 1.618
        amyxFibMax := amyxSwingTop - amyxSwingRange * amyxFibMaxRatio

int amyxFibLeft = nz(amyxLockedEndBar, bar_index)
int amyxFibRight = bar_index + amyxFibExtendBars

var line amyxFibLine1 = na
var line amyxFibLine2 = na
var line amyxFibLine3 = na
var label amyxFibLabel1 = na
var label amyxFibLabel2 = na
var label amyxFibLabel3 = na

if barstate.islast
    if amyxShowFib and amyxRangeValid
        if na(amyxFibLine1)
            amyxFibLine1 := line.new(amyxFibLeft, amyxFib1272, amyxFibRight, amyxFib1272, xloc = xloc.bar_index, color = color.new(amyxLegColor, 30), style = line.style_dashed)
            amyxFibLine2 := line.new(amyxFibLeft, amyxFib1618, amyxFibRight, amyxFib1618, xloc = xloc.bar_index, color = color.new(amyxLegColor, 15), style = line.style_dashed)
            amyxFibLine3 := line.new(amyxFibLeft, amyxFibMax, amyxFibRight, amyxFibMax, xloc = xloc.bar_index, color = amyxLegColor, style = line.style_solid)
            amyxFibLabel1 := label.new(amyxFibRight, amyxFib1272, '', xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(amyxLegColor, 90), textcolor = amyxLegColor, size = size.tiny)
            amyxFibLabel2 := label.new(amyxFibRight, amyxFib1618, '', xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(amyxLegColor, 90), textcolor = amyxLegColor, size = size.tiny)
            amyxFibLabel3 := label.new(amyxFibRight, amyxFibMax, '', xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(amyxLegColor, 86), textcolor = amyxLegColor, size = size.tiny)
        else
            line.set_xy1(amyxFibLine1, amyxFibLeft, amyxFib1272)
            line.set_xy2(amyxFibLine1, amyxFibRight, amyxFib1272)
            line.set_xy1(amyxFibLine2, amyxFibLeft, amyxFib1618)
            line.set_xy2(amyxFibLine2, amyxFibRight, amyxFib1618)
            line.set_xy1(amyxFibLine3, amyxFibLeft, amyxFibMax)
            line.set_xy2(amyxFibLine3, amyxFibRight, amyxFibMax)
            line.set_color(amyxFibLine1, color.new(amyxLegColor, 30))
            line.set_color(amyxFibLine2, color.new(amyxLegColor, 15))
            line.set_color(amyxFibLine3, amyxLegColor)
            label.set_xy(amyxFibLabel1, amyxFibRight, amyxFib1272)
            label.set_xy(amyxFibLabel2, amyxFibRight, amyxFib1618)
            label.set_xy(amyxFibLabel3, amyxFibRight, amyxFibMax)
            label.set_textcolor(amyxFibLabel1, amyxLegColor)
            label.set_textcolor(amyxFibLabel2, amyxLegColor)
            label.set_textcolor(amyxFibLabel3, amyxLegColor)

        label.set_text(amyxFibLabel1, 'TP1 1.272  ' + amyPrice(amyxFib1272))
        label.set_text(amyxFibLabel2, 'TP2 1.618  ' + amyPrice(amyxFib1618))
        label.set_text(amyxFibLabel3, 'MAX ' + amyxFibMaxInput + '  ' + amyPrice(amyxFibMax))
    else
        if not na(amyxFibLine1)
            line.delete(amyxFibLine1)
            line.delete(amyxFibLine2)
            line.delete(amyxFibLine3)
            amyxFibLine1 := na
            amyxFibLine2 := na
            amyxFibLine3 := na
        if not na(amyxFibLabel1)
            label.delete(amyxFibLabel1)
            label.delete(amyxFibLabel2)
            label.delete(amyxFibLabel3)
            amyxFibLabel1 := na
            amyxFibLabel2 := na
            amyxFibLabel3 := na

alertcondition(amyxOTETouch, 'OTE Touch', 'Price entered the OTE zone')

//---------------------------------------------------------------------------------------------------------------------}
// AMY SMC D-LAB — DISCRETE MANUAL ENTRY RESEARCH (2026-08-11)
// Frozen production baseline: Amy-SMC-D.pine @ d6e6d7c979dd5a852bddd9661bef0480caa2eb35 — DO NOT MODIFY.
// Dataset: raw/audited XAUUSD 2004 warm-up, score 2005–2026 (2026 Jan–Jul), no synthetic candles.
// Walk-forward: rolling 8y train -> 1y OOS, OOS test years 2012–2026. Rules below are fixed, not re-fit per test year.
// Directional horizon: M5 48 / M15 32 / H1 24 closed bars; locked opposite Swing boundary is structural cancellation.
// Execution study: signal is known only after its candle closes. NEXT = next-bar market/open; RETEST = broken level <=3 bars.
// Main lifecycle reference TP = 0.40R (same scale as the retained projected-target layer); 1.00R was checked as robustness.
// Conservative ambiguity rule in research: if SL and TP occur in the same base-TF candle, count SL first.
// IMPORTANT RESULT: same-candle Dealing Range alignment with QVB/QCH collapsed M5/M15 coverage to ~zero. It is archived,
// not silently forced here. DR D-fix remains context/filter only where it is mechanically compatible (Sweep/Pattern).
// Final Bias is intentionally NOT used by this module.
//---------------------------------------------------------------------------------------------------------------------{

AMY_DLAB_ENTRY_GROUP = 'Amy D-LAB Entry Research'
amyDlabShowNextEntries = input.bool(false, 'Show NEXT entry candidates', group = AMY_DLAB_ENTRY_GROUP)
amyDlabShowRetestEntries = input.bool(false, 'Show RETEST candidates', group = AMY_DLAB_ENTRY_GROUP)
amyDlabReferenceTpR = input.float(0.40, 'Reference TP (R)', minval = 0.10, step = 0.05, group = AMY_DLAB_ENTRY_GROUP)
amyDlabRetestBars = input.int(3, 'Retest validity (bars)', minval = 1, maxval = 10, group = AMY_DLAB_ENTRY_GROUP)

var array<label> amyDlabEntryLabels = array.new<label>()

amyDlabReferenceTarget(int direction, float entryPrice, float stopPrice) =>
    float result = na
    bool riskValid = direction == BULLISH ? not na(stopPrice) and stopPrice < entryPrice : direction == BEARISH ? not na(stopPrice) and stopPrice > entryPrice : false
    if riskValid
        float risk = math.abs(entryPrice - stopPrice)
        result := direction == BULLISH ? entryPrice + risk * amyDlabReferenceTpR : entryPrice - risk * amyDlabReferenceTpR
    result

amyDlabAddEntryLabel(bool enabled, string method, int direction, float triggerLevel, float stopLevel, float referenceTarget, string executionText) =>
    if enabled and direction != 0 and not na(triggerLevel)
        color entryColor = direction == BULLISH ? GREEN : RED
        bool labelAbove = direction == BEARISH
        float markerY = labelAbove ? high + amyOffset * 2.2 : low - amyOffset * 2.2
        string side = direction == BULLISH ? 'BUY' : 'SELL'
        string entryText = method + ' • ' + side + '\nTRG ' + amyPrice(triggerLevel) + '\n' + executionText + '\nSL ' + amyPrice(stopLevel) + '\nTP REF ' + amyPrice(referenceTarget)
        label newEntryLabel = label.new(bar_index, markerY, entryText, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(entryColor, 84), style = labelAbove ? label.style_label_down : label.style_label_up, textcolor = entryColor, size = size.tiny)
        array.push(amyDlabEntryLabels, newEntryLabel)
        if array.size(amyDlabEntryLabels) > 24
            label.delete(array.shift(amyDlabEntryLabels))

// K1 — Qualified Valid Break + Internal Structure. DR is not required on the break candle.
int amyDlabK1Dir = amyQualifiedBSLValidBreak ? BULLISH : amyQualifiedSSLValidBreak ? BEARISH : 0
bool amyDlabK1Event = barstate.isconfirmed and amyDlabK1Dir != 0 and amyCurrentInternalBias == amyDlabK1Dir
float amyDlabK1Trigger = amyDlabK1Dir == BULLISH ? amyBSL : amyDlabK1Dir == BEARISH ? amySSL : na
float amyDlabK1Stop = amyDlabK1Dir == BULLISH ? amyBullInvalidation : amyDlabK1Dir == BEARISH ? amyBearInvalidation : na
float amyDlabK1TpRef = amyDlabReferenceTarget(amyDlabK1Dir, close, amyDlabK1Stop)
if amyDlabK1Event
    amyDlabAddEntryLabel(amyDlabShowNextEntries, 'K1 QVB', amyDlabK1Dir, amyDlabK1Trigger, amyDlabK1Stop, amyDlabK1TpRef, 'ENTRY NEXT OPEN • +1 BAR')

// K2 — Qualified CHoCH + same-direction Internal Structure. QCH is already a fresh Swing transition event.
int amyDlabK2Dir = amyQualifiedSwingBullCHoCH ? BULLISH : amyQualifiedSwingBearCHoCH ? BEARISH : 0
bool amyDlabK2Event = barstate.isconfirmed and amyDlabK2Dir != 0 and amyCurrentInternalBias == amyDlabK2Dir
float amyDlabK2Trigger = amyDlabK2Dir == BULLISH ? swingHigh.currentLevel : amyDlabK2Dir == BEARISH ? swingLow.currentLevel : na
float amyDlabK2Stop = amyDlabK2Dir == BULLISH ? amyBullInvalidation : amyDlabK2Dir == BEARISH ? amyBearInvalidation : na
float amyDlabK2TpRef = amyDlabReferenceTarget(amyDlabK2Dir, close, amyDlabK2Stop)
if amyDlabK2Event
    amyDlabAddEntryLabel(amyDlabShowNextEntries, 'K2 QCH', amyDlabK2Dir, amyDlabK2Trigger, amyDlabK2Stop, amyDlabK2TpRef, 'ENTRY NEXT OPEN • +1 BAR')

// K3 — Sweep Continuation + D-fix Dealing Range alignment. Internal alignment is inherent in Sweep Continuation.
int amyDlabK3Dir = amySweepContinuationQualified ? amySweepContinuationBias : 0
bool amyDlabK3Event = barstate.isconfirmed and amyDlabK3Dir != 0 and amyDealingBias == amyDlabK3Dir
float amyDlabK3Trigger = amyDlabK3Dir == BULLISH ? amyBSL : amyDlabK3Dir == BEARISH ? amySSL : na
float amyDlabK3Stop = amyDlabK3Dir == BULLISH ? amyBullInvalidation : amyDlabK3Dir == BEARISH ? amyBearInvalidation : na
float amyDlabK3TpRef = amyDlabReferenceTarget(amyDlabK3Dir, close, amyDlabK3Stop)
if amyDlabK3Event
    amyDlabAddEntryLabel(amyDlabShowNextEntries, 'K3 SWC+DR', amyDlabK3Dir, amyDlabK3Trigger, amyDlabK3Stop, amyDlabK3TpRef, 'ENTRY NEXT OPEN • +1 BAR')

// K4 — Qualified Pattern must be FRESH on this exact candle, plus D-fix location + Internal Structure alignment.
int amyDlabK4Dir = amyPatternAge == 0 ? amyPatternBiasActive : 0
bool amyDlabK4Event = barstate.isconfirmed and amyDlabK4Dir != 0 and amyDealingBias == amyDlabK4Dir and amyCurrentInternalBias == amyDlabK4Dir
float amyDlabK4Trigger = amyDlabK4Event ? close : na
float amyDlabK4Stop = amyDlabK4Dir == BULLISH ? amyBullInvalidation : amyDlabK4Dir == BEARISH ? amyBearInvalidation : na
float amyDlabK4TpRef = amyDlabReferenceTarget(amyDlabK4Dir, close, amyDlabK4Stop)
if amyDlabK4Event
    amyDlabAddEntryLabel(amyDlabShowNextEntries, 'K4 PAT+DR+INT', amyDlabK4Dir, amyDlabK4Trigger, amyDlabK4Stop, amyDlabK4TpRef, 'ENTRY NEXT OPEN • +1 BAR')

// K5/K6 — delayed limit alternatives. The level is exact and remains valid for the configured number of bars.
// Research lifecycle cancels if the locked opposite Swing boundary invalidates before fill; these labels ARM the limit.
float amyDlabK5TpRef = amyDlabReferenceTarget(amyDlabK1Dir, amyDlabK1Trigger, amyDlabK1Stop)
if amyDlabK1Event
    amyDlabAddEntryLabel(amyDlabShowRetestEntries, 'K5 QVB RETEST', amyDlabK1Dir, amyDlabK1Trigger, amyDlabK1Stop, amyDlabK5TpRef, 'LIMIT @ TRG • <= ' + str.tostring(amyDlabRetestBars) + ' BARS')

float amyDlabK6TpRef = amyDlabReferenceTarget(amyDlabK2Dir, amyDlabK2Trigger, amyDlabK2Stop)
if amyDlabK2Event
    amyDlabAddEntryLabel(amyDlabShowRetestEntries, 'K6 QCH RETEST', amyDlabK2Dir, amyDlabK2Trigger, amyDlabK2Stop, amyDlabK6TpRef, 'LIMIT @ TRG • <= ' + str.tostring(amyDlabRetestBars) + ' BARS')

alertcondition(amyDlabK1Event, 'D-LAB K1 QVB NEXT', 'Qualified Valid Break + Internal Structure: execute at next bar open')
alertcondition(amyDlabK2Event, 'D-LAB K2 QCH NEXT', 'Qualified CHoCH + Internal Structure: execute at next bar open')
alertcondition(amyDlabK3Event, 'D-LAB K3 SWC DR NEXT', 'Sweep Continuation + Dealing Range: execute at next bar open')
alertcondition(amyDlabK4Event, 'D-LAB K4 PAT DR INT NEXT', 'Fresh Qualified Pattern + Dealing Range + Internal Structure: execute at next bar open')
alertcondition(amyDlabK1Event, 'D-LAB K5 QVB RETEST ARM', 'Qualified Valid Break retest armed at the broken level for the configured bars')
alertcondition(amyDlabK2Event, 'D-LAB K6 QCH RETEST ARM', 'Qualified CHoCH retest armed at the broken level for the configured bars')

// OOS RESULT LOCK — 2012–2026, main TP = 0.40R.
// Columns: signals/executions | directional accuracy | TP win rate | expectancy | HC execution windows (>=30 / 15).
// M5 : K1 237/237 | 89.03% | 48.10% | +0.0291R | 0/15
//      K2 684/684 | 78.95% | 52.78% | -0.0162R | 15/15
//      K3 561/555 | 79.82% | 53.51% | -0.0026R | 13/15
//      K4 69/63   | 63.49% | 66.67% | +0.0461R | 0/15
//      K5 237/51  | 72.55% | 54.90% | -0.0285R | 0/15 | fill 21.52%
//      K6 684/358 | 74.02% | 60.89% | +0.0569R | 2/15 | fill 52.34%
// M15: K1 878/878 | 90.66% | 39.98% | +0.0146R | 15/15
//      K2 319/319 | 91.85% | 42.01% | +0.0253R | 0/15
//      K3 226/222 | 80.18% | 49.10% | -0.0576R | 0/15
//      K4 350/294 | 72.45% | 44.90% | -0.0673R | 0/15
//      K5 878/434 | 87.33% | 43.09% | +0.0021R | 7/15 | fill 49.43%
//      K6 319/132 | 87.12% | 42.42% | -0.0076R | 0/15 | fill 41.38%
// H1 : K1 264/264 | 97.35% | 26.89% | +0.0179R | 0/15
//      K2 54/54   | 98.15% | 29.63% | +0.0369R | 0/15
//      K3 22/21   | 80.95% | 47.62% | -0.0325R | 0/15
//      K4 112/88  | 87.50% | 53.41% | +0.0577R | 0/15
//      K5 264/106 | 96.23% | 31.13% | +0.0326R | 0/15 | fill 40.15%
//      K6 54/33   | 96.97% | 18.18% | -0.0109R | 0/15 | fill 61.11%
// 1.00R robustness: K1 remained positive on M5/M15/H1 (+0.0361/+0.0114/+0.0433R).
// K2 remained positive on M15/H1 (+0.0312/+0.0722R) but negative on M5. K3 remained non-preferred as an entry trigger.
// Manual timing check: favorable signal-close -> next-open gap was rarely >0.10R and never >0.25R in K1/K2 OOS,
// so NEXT-open is materially more practical than waiting for retest, which missed roughly 38–78% depending on method/TF.
// RESEARCH RECOMMENDATION LOCK: primary = K1, strongest deployable profile M15; K2 = secondary M15/H1.
// K3 stays WATCH/context, not primary entry. K4 stays exploratory only. K5/K6 are optional delayed limit variants,
// with K5 M5 archived; strict same-candle DR+QVB/QCH is archived due near-zero coverage.

//---------------------------------------------------------------------------------------------------------------------}
// AMY SMC D-LAB — EXECUTABLE COMBINATORIAL SIGNAL (LAB ONLY)
// BSL Continue BUY — Strong Bull + ATR Expansion
// Research lineage: cd2a28e11dbbe6f9b6bb9c262c6bcbf8f9728c09.
// This block is additive. It does not feed Final Bias, Next Move, Pullback, dashboard fields, K1-K21, or production logic.
// Trigger uses the native Amy BSL sweep event and interprets it as a BUY continuation candidate only inside the locked H1 regime.
// H1 regime data is prior-closed only: request.security(..., [1], lookahead_on) to avoid HTF future leakage.
// IMPORTANT RESEARCH NOTE:
// The old 716-trade research checkpoint was produced by a research-port rolling-sweep proxy + fold-selected ATR exits.
// It was not byte-for-byte equivalent to native amyBSLSweep and did not have one fixed structural SL rule.
// This executable version follows the native Pine BSL event plus the explicit regime/structural-exit mandate below.
//----------------------------------------------------------------------------------------------------------------------{

amyDlabShowBslStrongBullAtr = input.bool(false, 'Show BSL Continue BUY (Strong Bull+ATR)', group = AMY_DLAB_ENTRY_GROUP)

[amyDlabBslH1Close, amyDlabBslH1Ema50, amyDlabBslH1Ema200, amyDlabBslH1Ema200Back120, amyDlabBslH1Atr14, amyDlabBslH1AtrMedian240] = request.security(
    syminfo.tickerid,
    '60',
    [close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1], ta.ema(close, 200)[121], ta.atr(14)[1], ta.median(ta.atr(14), 240)[1]],
    lookahead = barmerge.lookahead_on)

bool amyDlabBslMacroBull = not na(amyDlabBslH1Close) and not na(amyDlabBslH1Ema50) and not na(amyDlabBslH1Ema200) and not na(amyDlabBslH1Ema200Back120) and amyDlabBslH1Close > amyDlabBslH1Ema200 and amyDlabBslH1Ema50 > amyDlabBslH1Ema200 and amyDlabBslH1Ema200 > amyDlabBslH1Ema200Back120
bool amyDlabBslAtrExpansion = not na(amyDlabBslH1Atr14) and not na(amyDlabBslH1AtrMedian240) and amyDlabBslH1Atr14 > 1.15 * amyDlabBslH1AtrMedian240
bool amyDlabBslValidatedTF = timeframe.period == '15' or timeframe.period == '60'

// Native BSL continuation is the trigger source: BSL sweep + bullish Internal Structure. No standalone BSL/SSL semantics are overwritten.
// M15/H1 only: these are the signal timeframes actually carried by the combinatorial OOS research.
bool amyDlabBslStrongBullAtrSignal = barstate.isconfirmed and amyDlabBslValidatedTF and amySweepContinuationBias == BULLISH and amyDlabBslMacroBull and amyDlabBslAtrExpansion and not na(amyBullInvalidation) and amyBullInvalidation < close

// Executable plan is locked at the NEXT bar open, matching the D-LAB next-open execution convention.
// SL = opposite structural invalidation captured on the signal candle, floored to >= 1.00 XAUUSD.
// TP = existing D-LAB projected-target geometry from structural risk (0.40 * structural distance or 0.22 * ATR),
//      but with the manual-trading realism floor >= 2.00 XAUUSD and forced outside the signal candle.
// The old research-port used train-selected ATR exits by fold, so no single historical ATR stop pair can be embedded
// without hard-coding OOS-year choices. We intentionally do not hard-code those historical fold selections.
bool amyDlabBslStrongBullAtrEntryBar = barstate.isnew and amyDlabBslStrongBullAtrSignal[1]
float amyDlabBslStrongBullAtrRawStop = amyBullInvalidation[1]
float amyDlabBslStrongBullAtrEntryNow = amyDlabBslStrongBullAtrEntryBar ? open : na
bool amyDlabBslStrongBullAtrPlanValid = amyDlabBslStrongBullAtrEntryBar and not na(amyDlabBslStrongBullAtrRawStop) and amyDlabBslStrongBullAtrRawStop < amyDlabBslStrongBullAtrEntryNow
float amyDlabBslStrongBullAtrRiskDistance = amyDlabBslStrongBullAtrPlanValid ? math.max(1.00, amyDlabBslStrongBullAtrEntryNow - amyDlabBslStrongBullAtrRawStop) : na
float amyDlabBslStrongBullAtrStopNow = amyDlabBslStrongBullAtrPlanValid ? amyDlabBslStrongBullAtrEntryNow - amyDlabBslStrongBullAtrRiskDistance : na
float amyDlabBslStrongBullAtrSignalAtr = nz(amyEventAtr[1], math.max(high[1] - low[1], syminfo.mintick))
float amyDlabBslStrongBullAtrTargetDistance = amyDlabBslStrongBullAtrPlanValid ? math.max(2.00, math.max(amyDlabBslStrongBullAtrRiskDistance * 0.40, amyDlabBslStrongBullAtrSignalAtr * 0.22)) : na
float amyDlabBslStrongBullAtrOutsidePad = math.max(amyDlabBslStrongBullAtrSignalAtr * 0.02, syminfo.mintick)
float amyDlabBslStrongBullAtrTargetNow = amyDlabBslStrongBullAtrPlanValid ? math.max(amyDlabBslStrongBullAtrEntryNow + amyDlabBslStrongBullAtrTargetDistance, high[1] + amyDlabBslStrongBullAtrOutsidePad) : na

var float amyDlabBslStrongBullAtrEntry = na
var float amyDlabBslStrongBullAtrSL = na
var float amyDlabBslStrongBullAtrTP = na
var label amyDlabBslStrongBullAtrLabel = na

if amyDlabBslStrongBullAtrPlanValid
    amyDlabBslStrongBullAtrEntry := amyDlabBslStrongBullAtrEntryNow
    amyDlabBslStrongBullAtrSL := amyDlabBslStrongBullAtrStopNow
    amyDlabBslStrongBullAtrTP := amyDlabBslStrongBullAtrTargetNow

    if amyDlabShowBslStrongBullAtr
        if not na(amyDlabBslStrongBullAtrLabel)
            label.delete(amyDlabBslStrongBullAtrLabel)
        string amyDlabBslPlanText = 'BSL CONT BUY • STRONG BULL+ATR' +
          '\nENTRY ' + amyPrice(amyDlabBslStrongBullAtrEntry) +
          '\nSL ' + amyPrice(amyDlabBslStrongBullAtrSL) +
          '\nTP ' + amyPrice(amyDlabBslStrongBullAtrTP)
        amyDlabBslStrongBullAtrLabel := label.new(
          bar_index,
          low - amyOffset * 2.4,
          amyDlabBslPlanText,
          xloc = xloc.bar_index,
          yloc = yloc.price,
          style = label.style_label_up,
          color = color.new(GREEN, 84),
          textcolor = GREEN,
          size = size.tiny)

plot(amyDlabShowBslStrongBullAtr ? amyDlabBslStrongBullAtrEntry : na, 'BSL Continue BUY Entry', color = color.new(GREEN, 15), linewidth = 1, style = plot.style_linebr)
plot(amyDlabShowBslStrongBullAtr ? amyDlabBslStrongBullAtrSL : na, 'BSL Continue BUY SL', color = color.new(RED, 10), linewidth = 1, style = plot.style_linebr)
plot(amyDlabShowBslStrongBullAtr ? amyDlabBslStrongBullAtrTP : na, 'BSL Continue BUY TP', color = color.new(BLUE, 10), linewidth = 1, style = plot.style_linebr)

alertcondition(amyDlabBslStrongBullAtrSignal, 'BSL Continue BUY - Strong Bull ATR Expansion', 'BSL Continue BUY - Strong Bull ATR Expansion')

// PRE-COMMIT SANITY LOCK — native executable semantics, repaired/audited XAUUSD, OOS 2012-2026.
// This is NOT expected to reproduce the old 716 research-port checkpoint because that checkpoint used
// rolling-50 sweep proxy semantics, ATR-SMA research features, train-selected TF/ATR exits, and no explicit Macro-Bull gate.
// Exact native-trigger replay with the executable filters produced:
// M15: 30 raw signals / 28 non-overlapping executions | WR 85.71% | End $10,572.32 | MaxDD 1.00% | MedSL 24.45 | MedTP 9.78.
// H1 : 9 raw signals / 2 non-overlapping executions | sample too small for HC; do not infer robustness.
// Research-fold TF proxy (H1 through 2022, M15 2023-2026): 16 executions | WR 75.00% | End $10,069.60 | MaxDD 2.00%.
// Therefore this code is LAB/FORWARD-TEST ONLY. The old $14,934.91 / 716-trade result is not claimed as executable validation.

//---------------------------------------------------------------------------------------------------------------------}
// AMY SMC D-LAB — K1 M15 AUTOPSY DIAGNOSTIC PAYLOAD (2026-08-12)
// DIAGNOSTIC ONLY. No K1-K21/Pullback rule, filter, trigger, target, or production logic is changed by this block.
// Universe parity: 878 executable K1 M15 events reconstructed from the frozen D-LAB source semantics + repaired/audited XAUUSD.
// Replayed headline parity: directional = 796/878 = 90.6606%; TP hits = 351/878 = 39.9772%; gap = 445/878 = 50.6834 pp.
//
// STEP 0 — METRIC-DEFINITION AUDIT
// Directional accuracy:
// - Signal/reference: confirmed K1/QVB signal candle; no trade-entry price is used by this metric.
// - Horizon: next 32 CLOSED M15 bars.
// - Correct: the predicted direction survives all 32 bars without the locked opposite Swing structural-cancellation boundary
//   being touched/crossed by M15 high/low. TP is ignored; end-of-horizon net displacement is NOT the correctness test.
// TP win rate:
// - Signal is known only after the K1/QVB M15 candle closes; execution reference = OPEN of the next M15 candle.
// - The opposite Swing/invalidation boundary is locked from the signal candle; R = abs(NEXT OPEN - locked stop).
// - TP = NEXT OPEN +/- 0.40R; evaluation horizon = the same next 32 M15 bars.
// - M15 OHLC is the execution ordering source. If TP and SL are both reachable in the same M15 bar, legacy rule = SL first.
// - Replay parity proves the historical 39.98% uses NEXT OPEN as the TP/R reference: it yields exactly 351 TP hits;
//   signal-close target reference would yield 352 and is therefore not the historical scoring definition.
// - The chart helper amyDlabK1TpRef is a signal-close display reference; do not confuse it with the historical NEXT-OPEN score.
// Measurement mismatch: horizons are both 32 bars, but the metrics do NOT share an outcome definition/reference.
// Directional = structural survival and is TP-blind. TP WR = explicit NEXT-OPEN 0.40R barrier hit.
// Historical bookkeeping note: the older directional workbook has 877 OOS QVB rows, while executable D-LAB K1 has 878.
// This autopsy uses the executable 878-event universe and recomputes directional survival on those same 878 events.
//
// STEP 1 — PATH CLASSIFICATION
// Requested 5-bucket taxonomy is not exhaustive: 468/878 events touch NEITHER TP nor SL inside 32 bars.
// Forcing those 468 into Winner/SL-loss/Directional-Failure/Collision would falsify the path data, so a mandatory
// diagnostic bucket #6 (Unresolved/Timeout) is added. This is a taxonomy correction, NOT a new strategy/filter.
// Winner split uses a predeclared non-optimized diagnostic threshold: Clean = pre-TP MAE < 0.50R; Dirty = MAE >= 0.50R.
// #1 Clean Winner                         : 324 / 878 = 36.90%
// #2 Dirty Winner                         :  27 / 878 =  3.08%
// #3 Directionally Correct, Execution Loss:   0 / 878 =  0.00%
// #4 True Directional Failure (SL-first)  :  59 / 878 =  6.72%
// #5 Ambiguous/Intrabar Collision         :   0 / 878 =  0.00%
// #6 Unresolved/Timeout (no TP, no SL)     : 468 / 878 = 53.30%
// Execution x directional cross-tag (needed because TP-first and later structural failure can overlap):
// - TP first + directional survives 32 bars : 328
// - TP first + later structural failure      :  23
// - SL first + directional failure           :  59
// - Timeout + directional survives 32 bars   : 468
// - SL first + directional survives          :   0
// - Same-bar TP/SL collision                 :   0
// Therefore the hypothesized #3 path (SL first, then still directionally correct under the OLD 90.66% metric) is impossible
// in this replay: the trade SL is the same locked structural boundary whose touch makes directional-survival false.
//
// STEP 2 — MAE/MFE BEFORE EXECUTION RESOLUTION
// Units below: first R-normalized percentiles P25/P50/P75/P90; then XAUUSD distance P25/P50/P75/P90.
// #1 Clean Winner (n=324)
// MAE R   : 0.0371 / 0.1010 / 0.1998 / 0.2765 | XAU: 0.5183 / 1.4715 / 2.9090 / 5.1459
// MFE R   : 0.4325 / 0.4784 / 0.5712 / 0.6865 | XAU: 5.2500 / 7.2885 / 11.3775 / 19.3280
// #2 Dirty Winner (n=27)
// MAE R   : 0.5708 / 0.6260 / 0.7131 / 0.8258 | XAU: 5.1000 / 6.5000 / 13.3215 / 16.8712
// MFE R   : 0.4639 / 0.5622 / 0.6098 / 0.8943 | XAU: 4.1750 / 8.0700 / 10.4585 / 13.4646
// #3 Directionally Correct, Execution Loss (n=0)
// MAE/MFE: N/A — no event exists under the actual structural-survival definition.
// #4 True Directional Failure / SL-first (n=59)
// MAE R   : 1.0514 / 1.0980 / 1.2454 / 1.4174 | XAU: 11.7250 / 15.9000 / 21.4000 / 24.2066
// MFE R   : 0.0529 / 0.1135 / 0.1835 / 0.2963 | XAU: 0.7215 / 1.2000 / 2.7850 / 4.7710
// #5 Ambiguous/Intrabar Collision (n=0)
// MAE/MFE: N/A — no same-M15-bar TP+SL first-resolution collision exists in the 878-event replay.
// #6 Unresolved/Timeout (n=468)
// MAE R   : 0.1587 / 0.3082 / 0.5350 / 0.7309 | XAU: 3.7175 / 6.7000 / 10.9473 / 19.1652
// MFE R   : 0.0765 / 0.1675 / 0.2770 / 0.3504 | XAU: 1.6300 / 3.2300 / 6.6300 / 12.0451
// Additional full-32-bar directional-path diagnostic:
// - Directional survivors n=796: MAE R P25/P50/P75/P90 = 0.1110/0.2473/0.4733/0.7020;
//   MFE R = 0.1353/0.3294/0.6144/1.0762.
// - Structural failures n=82: MAE R = 1.1324/1.3364/1.5719/2.0089;
//   MFE R = 0.0796/0.1835/0.5027/0.9190.
// #3-vs-#4 requested comparison cannot be computed because #3 n=0; this zero is itself the diagnostic result.
//
// STEP 3 — DIAGNOSTIC DECOMPOSITION (NO FILTER/SOLUTION RECOMMENDATION)
// Directional-correct count 796 minus TP-hit count 351 = 445 events = 50.6834 pp headline gap.
// Exact decomposition of that 445-event difference:
// +468 directionally-correct TIMEOUT/no-barrier events = +53.3030 pp
//  -23 TP-first winners that later hit structural cancellation inside the 32-bar directional horizon = -2.6196 pp
//  =445 net events = 50.6834 pp.
// Diagnosis: the 90.66% -> 39.98% gap is dominated by METRIC/LIFECYCLE MISMATCH + unresolved 32-bar paths,
// NOT by a large population of "SL first, then direction becomes correct" executions. That hypothesized population is 0.
// Directional-quality failure exists but is small by the locked metric: 82/878 = 9.34%; 59 are SL-first and 23 had TP first
// before later structural cancellation. The largest state is 468/878 = 53.30%: structural direction survives but 0.40R TP
// is never touched within the same 32-bar horizon. This payload intentionally stops at diagnosis; no filter is proposed/tested.
//---------------------------------------------------------------------------------------------------------------------}

//---------------------------------------------------------------------------------------------------------------------}
// AMY SMC D-LAB — K1 M15 TIMEOUT AUTOPSY PHASE 2 (2026-08-12)
// DIAGNOSTIC ONLY. Continuation of Phase-1 autopsy @ f06ff44d014c5cf42766ba760b64f68be5443d5b.
// No K1-K21/Pullback rule, entry, SL, TP, filter, production field, or executable Pine logic is changed here.
// Phase-1 parity gate reproduced EXACTLY before this analysis: K1 M15 = 878 events; original 32-bar Timeout = 468.
// Locked lifecycle remains NEXT OPEN + signal-locked structural SL + TP 0.40R + M15 same-bar SL-first ordering.
//
// STEP 1 — EXTENDED OBSERVATION OF THE 468 ORIGINAL TIMEOUTS
// This is observation only: entry, SL and TP are frozen at their original values. Tracking resumes after original bar 32.
// First resolution through TOTAL bar 64:
// - Late TP :  88 / 468 = 18.80%
// - Late SL :  34 / 468 =  7.26%
// - Still unresolved: 346 / 468 = 73.93%
// First resolution through TOTAL bar 96 (3x original horizon):
// - Late TP : 146 / 468 = 31.20%
// - Late SL :  70 / 468 = 14.96%
// - Still unresolved: 252 / 468 = 53.85%
// - Same-M15-bar TP/SL collision in the extension: 0.
// Among the 216 events that DID resolve by bar 96, 67.59% resolved TP-first and 32.41% SL-first.
// Extra time beyond original bar 32, resolved-by-96 population:
// - All resolved n=216: median +27 M15 bars; median wall-clock +7.25h.
// - Late TP n=146: median +23.5 M15 bars (P25/P75 +8.25/+41.0); wall-clock median +6.75h.
// - Late SL n=70: median +33 M15 bars (P25/P75 +14.0/+50.75); wall-clock median +9.00h.
// Tail-persistence sensitivity, still with the SAME frozen TP/SL: bar128 unresolved 193/468=41.24%;
// bar192 unresolved 133/468=28.42%; bar256 unresolved 95/468=20.30%. These are observation tails, not new horizons for K1.
//
// STEP 2 — ORIGINAL-32-BAR MFE INSIDE TIMEOUT POPULATION
// Phase-1 parity MFE R P25/P50/P75/P90 = 0.0765 / 0.1675 / 0.2770 / 0.3504.
// Threshold counts are descriptive probes only; none was optimized or promoted as a rule:
// - MFE >= 0.10R: 313 / 468 = 66.88%
// - MFE >= 0.20R: 201 / 468 = 42.95%
// - MFE >= 0.25R: 143 / 468 = 30.56%
// - MFE >= 0.30R:  92 / 468 = 19.66%
// - MFE >= 0.35R:  48 / 468 = 10.26%
// - MFE >= 0.375R: 23 / 468 =  4.91%
// - MFE >= 0.39R:   8 / 468 =  1.71%
// Therefore 376/468=80.34% never even reached 0.30R, and 267/468=57.05% never reached 0.20R in the original horizon.
// Extended outcome association (post-entry diagnostic only):
// - Original MFE >=0.30R (n=92): by bar96 TP 57.61%, SL 17.39%, unresolved 25.00%.
// - Original MFE < 0.30R (n=376): by bar96 TP 24.73%, SL 14.36%, unresolved 60.90%.
// Thus a real "almost reached 0.40R" subset exists, but it is a minority rather than the dominant Timeout mechanism.
//
// STEP 3 — PRE-ENTRY DESCRIPTIVE CHARACTERISTICS: CLEAN WINNER vs TIMEOUT
// Groups are frozen from Phase 1: Clean Winner n=324; Timeout n=468.
// Quantiles below are P25 / P50 / P75 / P90 and are measured on/at the CONFIRMED signal candle unless stated.
// QVB body / ATR14:
// - Clean  : 1.5151 / 1.8883 / 2.5938 / 3.2842
// - Timeout: 1.4882 / 1.9342 / 2.5568 / 3.3676
// QVB body / candle range:
// - Clean  : 0.7360 / 0.8101 / 0.8888 / 0.9450
// - Timeout: 0.7636 / 0.8288 / 0.9013 / 0.9494
// QVB full range / ATR14:
// - Clean  : 1.8740 / 2.3902 / 3.1207 / 3.9650
// - Timeout: 1.8094 / 2.3869 / 3.1567 / 3.9300
// ATR14 raw XAUUSD:
// - Clean  : 1.2983 / 1.8320 / 2.8089 / 4.8230
// - Timeout: 1.3933 / 2.1643 / 3.0934 / 4.7094
// ATR14 as % of signal close:
// - Clean  : 0.0850 / 0.1143 / 0.1532 / 0.2122%
// - Timeout: 0.0959 / 0.1302 / 0.1731 / 0.2156%
// Signal-close structural room to the locked opposite Swing boundary / ATR14 (strictly known before NEXT OPEN):
// - Clean  : 6.5070 / 7.8809 / 9.9356 / 12.3498 ATR
// - Timeout: 7.8999 / 10.5776 / 13.9837 / 19.8462 ATR
// Actual NEXT-OPEN 0.40R TP distance expressed in ATR14 (execution geometry, not a pre-entry feature):
// - Clean  : 2.5998 / 3.1660 / 3.9753 / 4.9451 ATR
// - Timeout: 3.1748 / 4.2345 / 5.5934 / 7.9355 ATR
// Median comparison: body/ATR differs only +2.43% Timeout-vs-Clean; full-range/ATR is effectively identical (-0.14%).
// In contrast, median signal structural room is +34.22% larger and the actual 0.40R TP is +33.75% farther in ATR units.
// Descriptive Cliff's delta (Timeout minus Clean): body/ATR -0.004, body/range +0.088, range/ATR -0.026,
// ATR raw +0.119, ATR% +0.140, signal-room/ATR +0.410, direction-normalized DR location +0.183.
// The strongest separation is therefore structural-room geometry, not weak QVB candle displacement.
//
// SESSION DESCRIPTIVE PROFILE
// Clock normalization for comparability: 2012-2025 HistData fixed UTC-05 source wall-time -> UTC (+5h); 2026 Dukascopy is UTC.
// Fixed non-optimized bins (no DST adjustment): Asia 00-08 UTC; London 08-13; London-NY overlap 13-17;
// NY-only 17-22; rollover/off 22-24.
// - Clean n=324  : Asia 21.91% | London 34.57% | Overlap 36.11% | NY 6.17% | Rollover 1.23%
// - Timeout n=468: Asia 25.85% | London 19.02% | Overlap 41.45% | NY 10.90% | Rollover 2.78%
// Largest descriptive shift is London-only: Timeout -15.55 percentage points vs Clean; overlap/NY/Asia are higher in Timeout.
// This pattern remains visible when BUY/SELL are inspected separately; it is NOT tested as a filter or causal rule here.
//
// DEALING-RANGE DESCRIPTIVE PROFILE
// Native M15 D-fix is retained exactly (60/40). K1 QVB events mechanically sit on the predicted-side extreme:
// Clean = 156 PREMIUM BUY-side / 168 DISCOUNT SELL-side by direction mapping; Timeout = 255 / 213; no EQUILIBRIUM cases.
// Direction-normalized DR location (1.0 = farther toward predicted-side edge), P25/P50/P75/P90:
// - Clean  : 0.9373 / 0.9672 / 0.9855 / 0.9949
// - Timeout: 0.9553 / 0.9776 / 0.9905 / 0.9967
// Both groups are already highly extreme; DR location is a much weaker separator than structural-room geometry.
//
// INTERNAL COMPOSITION OF THE 468 TIMEOUTS AT BAR 96 (DESCRIPTIVE, NOT A FILTER TEST)
// Late TP n=146: median body/ATR 1.992; ATR 2.225; signal-room 9.282 ATR; original MFE 0.246R; MAE 0.265R.
// Late SL n=70 : median body/ATR 2.064; ATR 1.655; signal-room 7.704 ATR; original MFE 0.150R; MAE 0.628R.
// Still unresolved n=252: median body/ATR 1.903; ATR 2.299; signal-room 11.912 ATR; original MFE 0.115R; MAE 0.271R.
// Persistent unresolved events therefore have the largest structural room and the lowest original favorable excursion,
// while their QVB candle strength remains close to the other Timeout subgroups.
//
// PHASE-2 DIAGNOSIS — NO FILTER/SOLUTION RECOMMENDATION
// Classification is (c) MIXTURE, with explicit 3x-horizon proportions from the original 468 Timeout events:
// (a-like) delayed winners: 146/468 = 31.20% reached the SAME 0.40R TP after bar32 but by bar96.
// delayed failures:          70/468 = 14.96% hit the SAME locked SL after bar32 but by bar96.
// persistent stall:         252/468 = 53.85% still hit neither boundary even by bar96.
// Therefore Timeout is NOT simply "wait longer and it wins": more than half remain unresolved at 3x horizon.
// It is also NOT well described as a weak QVB-trigger population: pre-entry body/ATR, body/range and range/ATR are nearly the same
// as Clean Winner, and Timeout ATR is actually somewhat higher. The dominant pre-entry difference is larger locked structural room,
// which makes the unchanged 0.40R TP materially farther away in ATR units; separately, most Timeouts show weak realized follow-through
// inside 32 bars (80.34% never reached 0.30R). Thus the population is best described as a mixture of delayed follow-through and
// persistent pace/geometry stall, not a single "bad direction" or "weak breakout candle" class.
// This payload deliberately stops at diagnosis. No K1 filter, session gate, DR gate, TP/SL change, or production promotion was tested.
//---------------------------------------------------------------------------------------------------------------------}

//---------------------------------------------------------------------------------------------------------------------}
// AMY SMC D-LAB — K1 HUMAN ENTRY CONSTRUCTION — CAUSAL ACCEPTANCE/REJECTION + LOCAL SL (2026-08-12)
// CORRECTED EXPERIMENT / RESEARCH ONLY. Documentation payload only; no executable Pine logic is changed by this block.
// Frozen production baseline Amy-SMC-D.pine remains d6e6d7c979dd5a852bddd9661bef0480caa2eb35.
// Existing K1-K21, Pullback, Phase-1/Phase-2 autopsy payloads and all production fields above remain untouched.
// This block supersedes the earlier experiment payload commit 4b3e71cf24a3abbf8b2742df03216485b9fbbb40 because that
// draft allowed the +1 M15 candle to influence rejection routing by its CLOSE while also allowing an earlier +1-bar fill.
// The corrected replay below removes that intra-bar close-conditioned lookahead by reserving +1 strictly for classification.
// Dataset: repaired/audited raw XAUUSD; 2004 warm-up; rolling 8y train -> 1y OOS; OOS 2012-2026; no synthetic candles.
// PARITY GATE before experiment: K1 M15 source = 878; old TP=351; SL=59; Timeout=468; directional survival=796/878=90.6606%.
//
// =====================================================================================================================
// CAUSAL CONSTRUCTION LOCK
// =====================================================================================================================
// SOURCE SIGNAL
// - Exact same K1 M15 signal population: confirmed Qualified Valid Break + same-direction Internal Structure.
// - No new predictor/filter creates or removes any of the 878 source signals before execution construction.
// - Broken level = source BSL for bullish QVB / source SSL for bearish QVB.
//
// BUFFER / WALK-FORWARD SELECTION
// - Candidate buffer = absolute $1.00 or $2.00 XAUUSD; not broker ticks.
// - Bull continuation entry level = BSL + buffer; bear continuation = SSL - buffer.
// - Rolling selection uses only preceding 8 calendar years. Objective = mean 0.40R terminal lifecycle R per SOURCE signal;
//   NO FILL / invalid geometry / TP-floor-ineligible = 0R for parameter selection. Tie: more valid fills, then smaller buffer.
// - OOS-selected buffer is $1.00 in ALL 15 folds (2012-2026). $2.00 never beats $1.00 on its own preceding train slice.
// - The same train-selected buffer is reused unchanged for 0.40R, 1.00R, 1.50R and fixed-nominal TP reports.
//
// CAUSAL +1 CLASSIFICATION / ENTRY WINDOW
// - Exactly the next M15 candle (+1) is classification-only because its CLOSE is required to know Acceptance vs Rejection.
// - Bullish QVB rejection = +1 close <= broken BSL; bearish QVB rejection = +1 close >= broken SSL.
// - If no rejection, branch=CONTINUATION. If rejection, branch=SWEEP and direction reverses.
// - No fill is permitted inside +1; doing so would let the still-unknown +1 close retroactively choose the branch.
// - Entry can fill from +2 through +32 relative to QVB, preserving the original 32-bar post-signal information boundary.
// - Unfilled by +32 = NO FILL, never Timeout.
//
// LOCAL SL
// - Continuation BUY = latest CONFIRMED internalLow size-5 strictly before QVB; SELL = latest internalHigh strictly before QVB.
// - Sweep reverse SL is immediate confirmed internalHigh/internalLow known at rejection (+1) close.
// - No fallback/walk-back to farther local pivots. Wrong-side pivot = INVALID_LOCAL_STOP.
// - Raw local R < $1.00 = INVALID_SL_FLOOR; stop is not moved artificially.
//
