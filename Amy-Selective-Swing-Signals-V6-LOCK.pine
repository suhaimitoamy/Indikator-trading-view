//@version=6
indicator("Amy Selective Swing Signals V6 LOCK", "Amy Swing V6 LOCK", overlay = true, max_labels_count = 300, max_bars_back = 5000)

// Standalone diagnostic/fix variant. V1-V6 are untouched.
// Hard invariant after initialization: BUY -> SELL -> BUY -> SELL.
// Labels include V6 so screenshots can prove which script emitted them.

string grpTurn = "1. Major Turning Logic"
int pivotLen = input.int(2, "Pivot Confirmation Bars", minval = 1, maxval = 8, group = grpTurn)
int prominenceLookback = input.int(12, "Major Swing Lookback", minval = 5, maxval = 60, group = grpTurn)
float minLegAtr = input.float(1.50, "Minimum Opposite Leg (ATR)", minval = 0.25, maxval = 10.0, step = 0.25, group = grpTurn)
int minPivotBars = input.int(6, "Minimum Bars Between Major Turns", minval = 1, maxval = 100, group = grpTurn)

string grpQuality = "2. Balanced Quality Gate"
int emaLen = input.int(20, "Quality EMA", minval = 2, maxval = 200, group = grpQuality)
int rsiLen = input.int(14, "Quality RSI", minval = 2, maxval = 100, group = grpQuality)
float buyRsiMax = input.float(48.0, "BUY Pivot RSI Max", minval = 10, maxval = 60, step = 1, group = grpQuality)
float sellRsiMin = input.float(52.0, "SELL Pivot RSI Min", minval = 40, maxval = 90, step = 1, group = grpQuality)
float minWickRatio = input.float(0.20, "Minimum Rejection Wick", minval = 0.0, maxval = 0.9, step = 0.05, group = grpQuality)
float stretchAtr = input.float(0.25, "EMA Stretch (ATR)", minval = 0.0, maxval = 4.0, step = 0.05, group = grpQuality)
int qualityNeeded = input.int(1, "Extra Quality Evidence Needed", minval = 1, maxval = 3, group = grpQuality)
float hugeLegOverrideAtr = input.float(2.75, "Huge-Leg Quality Override (ATR)", minval = 1.0, maxval = 12.0, step = 0.25, group = grpQuality)

string grpConfirm = "3. Reversal Confirmation"
int confirmWindow = input.int(6, "Confirmation Window (bars)", minval = 1, maxval = 20, group = grpConfirm)
float retraceAtr = input.float(0.30, "Minimum Reversal From Pivot (ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = grpConfirm)
int microBreakBars = input.int(2, "Micro Structure Break Bars", minval = 1, maxval = 10, group = grpConfirm)
float confirmBodyAtr = input.float(0.10, "Minimum Confirmation Body (ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = grpConfirm)
float maxConfirmDistanceAtr = input.float(2.00, "Maximum Chase Distance From Pivot (ATR)", minval = 0.50, maxval = 5.0, step = 0.10, group = grpConfirm)

string grpVisual = "4. Visual"
float labelDistanceAtr = input.float(0.25, "Label Distance (ATR)", minval = 0.05, maxval = 2.0, step = 0.05, group = grpVisual)
bool diagnosticLabel = input.bool(true, "Show V6 In Label", group = grpVisual)

float atr = ta.atr(14)
float ema = ta.ema(close, emaLen)
float rsi = ta.rsi(close, rsiLen)
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)

// nextExpected: 0 = initialization (either side), +1 = BUY only, -1 = SELL only.
var int nextExpected = 0
var float lastTurnPrice = na
var int lastTurnPivotBar = na

var bool buyArmed = false
var float buyPivot = na
var float buyPivotAtr = na
var int buyPivotBar = na
var int buyExpiry = na

var bool sellArmed = false
var float sellPivot = na
var float sellPivotAtr = na
var int sellPivotBar = na
var int sellExpiry = na

bool buyAllowed = nextExpected == 0 or nextExpected == 1
bool sellAllowed = nextExpected == 0 or nextExpected == -1

if barstate.isconfirmed and not na(ph) and sellAllowed
    int pBar = bar_index - pivotLen
    float pAtr = nz(atr[pivotLen], atr)
    float pRange = high[pivotLen] - low[pivotLen]
    float upperWick = high[pivotLen] - math.max(open[pivotLen], close[pivotLen])
    float pivotRsi = rsi[pivotLen]
    float pivotEma = ema[pivotLen]
    float priorWindowHigh = ta.highest(high, prominenceLookback)[pivotLen]
    bool prominent = not na(priorWindowHigh) and ph >= priorWindowHigh
    bool wickOk = pRange > 0 and upperWick / pRange >= minWickRatio
    bool rsiOk = not na(pivotRsi) and pivotRsi >= sellRsiMin
    bool stretchOk = not na(pivotEma) and ph >= pivotEma + pAtr * stretchAtr
    int q = (wickOk ? 1 : 0) + (rsiOk ? 1 : 0) + (stretchOk ? 1 : 0)
    bool spacingOk = na(lastTurnPivotBar) or pBar - lastTurnPivotBar >= minPivotBars
    float legAtr = nextExpected == -1 and not na(lastTurnPrice) ? (ph - lastTurnPrice) / math.max(pAtr, syminfo.mintick) : na
    bool amplitudeOk = nextExpected == 0 or (nextExpected == -1 and ph - lastTurnPrice >= pAtr * minLegAtr)
    bool hugeLeg = not na(legAtr) and legAtr >= hugeLegOverrideAtr
    if prominent and spacingOk and amplitudeOk and (q >= qualityNeeded or hugeLeg)
        if not sellArmed or na(sellPivot) or ph >= sellPivot
            sellArmed := true
            sellPivot := ph
            sellPivotAtr := pAtr
            sellPivotBar := pBar
            sellExpiry := bar_index + confirmWindow

if barstate.isconfirmed and not na(pl) and buyAllowed
    int pBar = bar_index - pivotLen
    float pAtr = nz(atr[pivotLen], atr)
    float pRange = high[pivotLen] - low[pivotLen]
    float lowerWick = math.min(open[pivotLen], close[pivotLen]) - low[pivotLen]
    float pivotRsi = rsi[pivotLen]
    float pivotEma = ema[pivotLen]
    float priorWindowLow = ta.lowest(low, prominenceLookback)[pivotLen]
    bool prominent = not na(priorWindowLow) and pl <= priorWindowLow
    bool wickOk = pRange > 0 and lowerWick / pRange >= minWickRatio
    bool rsiOk = not na(pivotRsi) and pivotRsi <= buyRsiMax
    bool stretchOk = not na(pivotEma) and pl <= pivotEma - pAtr * stretchAtr
    int q = (wickOk ? 1 : 0) + (rsiOk ? 1 : 0) + (stretchOk ? 1 : 0)
    bool spacingOk = na(lastTurnPivotBar) or pBar - lastTurnPivotBar >= minPivotBars
    float legAtr = nextExpected == 1 and not na(lastTurnPrice) ? (lastTurnPrice - pl) / math.max(pAtr, syminfo.mintick) : na
    bool amplitudeOk = nextExpected == 0 or (nextExpected == 1 and lastTurnPrice - pl >= pAtr * minLegAtr)
    bool hugeLeg = not na(legAtr) and legAtr >= hugeLegOverrideAtr
    if prominent and spacingOk and amplitudeOk and (q >= qualityNeeded or hugeLeg)
        if not buyArmed or na(buyPivot) or pl <= buyPivot
            buyArmed := true
            buyPivot := pl
            buyPivotAtr := pAtr
            buyPivotBar := pBar
            buyExpiry := bar_index + confirmWindow

if sellArmed and bar_index > sellExpiry
    sellArmed := false
if buyArmed and bar_index > buyExpiry
    buyArmed := false

float body = math.abs(close - open)
float priorMicroHigh = ta.highest(high, microBreakBars)[1]
float priorMicroLow = ta.lowest(low, microBreakBars)[1]
bool bullBreak = barstate.isconfirmed and close > open and body >= atr * confirmBodyAtr and not na(priorMicroHigh) and close > priorMicroHigh
bool bearBreak = barstate.isconfirmed and close < open and body >= atr * confirmBodyAtr and not na(priorMicroLow) and close < priorMicroLow
float buyDistanceAtr = buyArmed and not na(buyPivotAtr) ? (close - buyPivot) / math.max(buyPivotAtr, syminfo.mintick) : na
float sellDistanceAtr = sellArmed and not na(sellPivotAtr) ? (sellPivot - close) / math.max(sellPivotAtr, syminfo.mintick) : na
bool buyRetraceOk = buyArmed and not na(buyDistanceAtr) and buyDistanceAtr >= retraceAtr and buyDistanceAtr <= maxConfirmDistanceAtr
bool sellRetraceOk = sellArmed and not na(sellDistanceAtr) and sellDistanceAtr >= retraceAtr and sellDistanceAtr <= maxConfirmDistanceAtr

bool buySignal = buyAllowed and buyArmed and buyRetraceOk and bullBreak
bool sellSignal = sellAllowed and sellArmed and sellRetraceOk and bearBreak

if buySignal and sellSignal and nextExpected == 0
    if buyDistanceAtr >= sellDistanceAtr
        sellSignal := false
    else
        buySignal := false

if buySignal
    string txt = diagnosticLabel ? "V6 BUY" : "BUY"
    label.new(bar_index, low - atr * labelDistanceAtr, txt, yloc = yloc.price, style = label.style_label_up, color = color.rgb(38, 103, 230), textcolor = color.white, size = size.small)
    lastTurnPrice := buyPivot
    lastTurnPivotBar := buyPivotBar
    nextExpected := -1
    buyArmed := false
    sellArmed := false

if sellSignal
    string txt = diagnosticLabel ? "V6 SELL" : "SELL"
    label.new(bar_index, high + atr * labelDistanceAtr, txt, yloc = yloc.price, style = label.style_label_down, color = color.rgb(190, 65, 78), textcolor = color.white, size = size.small)
    lastTurnPrice := sellPivot
    lastTurnPivotBar := sellPivotBar
    nextExpected := 1
    sellArmed := false
    buyArmed := false

alertcondition(buySignal, "Amy Swing V6 LOCK — BUY", "Hard-locked V6 BUY.")
alertcondition(sellSignal, "Amy Swing V6 LOCK — SELL", "Hard-locked V6 SELL.")