//@version=5
indicator("AMY Predictive QRR Sweep-Reclaim [No Repaint]", overlay=true, max_boxes_count=200, max_lines_count=100, max_labels_count=300, max_bars_back=3000)

// =============================================================================
// PROFILE — parameters are the July 2026 code produced by monthly walk-forward
// =============================================================================
grpProfile = "1. Walk-Forward Profile"
profile = input.string("1:2", "Risk Reward Profile", options=["1:1", "1:2", "1:3"], group=grpProfile)
pipSize = input.float(0.10, "XAUUSD Pip Size", minval=0.01, step=0.01, group=grpProfile)
maxSlPips = input.float(150.0, "Maximum SL (pips)", minval=1.0, group=grpProfile)

rr = profile == "1:1" ? 1.0 : profile == "1:2" ? 2.0 : 3.0
atrLen = profile == "1:1" ? 21 : profile == "1:2" ? 7 : 14
pivotLen = profile == "1:1" ? 5 : 7
zoneWidthAtr = profile == "1:1" ? 0.30 : 0.40
sweepAtr = profile == "1:1" ? 0.00 : profile == "1:2" ? 0.20 : 0.05
reclaimAtr = profile == "1:3" ? 0.10 : 0.00
slBufferAtr = profile == "1:1" ? 0.20 : profile == "1:2" ? 0.25 : 0.10
minBodyAtr = profile == "1:3" ? 0.15 : 0.05
minCloseLocation = profile == "1:1" ? 0.60 : 0.55
zoneExpiryBars = profile == "1:3" ? 144 : 24
confirmationBars = 1
maxHoldBars = 288
maxZonesEachSide = 7
maxSlDistance = maxSlPips * pipSize

// July 2026 profiles use confirmed swing levels + previous-day high/low.
useSwingLevels = true
usePreviousDay = true

// =============================================================================
// DISPLAY
// =============================================================================
grpDisplay = "2. Display"
showPendingZones = input.bool(true, "Show Pending Zones", group=grpDisplay)
showPendingLabels = input.bool(true, "Show Pending Labels", group=grpDisplay)
showTargets = input.bool(true, "Show Entry / TP / SL", group=grpDisplay)
showStats = input.bool(true, "Show Statistics", group=grpDisplay)

// =============================================================================
// CORE VALUES — only completed candles and confirmed levels are used
// =============================================================================
atr = ta.atr(atrLen)
confirmedPivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
confirmedPivotLow = ta.pivotlow(low, pivotLen, pivotLen)
previousDayHigh = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
previousDayLow = request.security(syminfo.tickerid, "D", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
newDay = nz(ta.change(time("D"))) != 0

// =============================================================================
// ZONE STORAGE
// direction: 1 = BUY zone, -1 = SELL zone
// state: 0 = pending, 1 = setup already used, 2 = invalid, 3 = expired
// =============================================================================
var zoneDirections = array.new_int()
var zoneTops = array.new_float()
var zoneBottoms = array.new_float()
var zoneMids = array.new_float()
var zoneStates = array.new_int()
var zoneCreatedBars = array.new_int()
var zoneBoxes = array.new_box()
var zoneLabels = array.new_label()
var zoneSources = array.new_string()

f_zoneCount(int direction) =>
    int count = 0
    int n = array.size(zoneDirections)
    if n > 0
        for i = 0 to n - 1
            if array.get(zoneDirections, i) == direction
                count += 1
    count

f_removeOldestDirection(int direction) =>
    int removeIndex = -1
    int oldestBar = 1000000000
    int n = array.size(zoneDirections)
    if n > 0
        for i = 0 to n - 1
            if array.get(zoneDirections, i) == direction
                int created = array.get(zoneCreatedBars, i)
                if created < oldestBar
                    oldestBar := created
                    removeIndex := i
    if removeIndex >= 0
        box oldBox = array.remove(zoneBoxes, removeIndex)
        label oldLabel = array.remove(zoneLabels, removeIndex)
        if not na(oldBox)
            box.delete(oldBox)
        if not na(oldLabel)
            label.delete(oldLabel)
        array.remove(zoneDirections, removeIndex)
        array.remove(zoneTops, removeIndex)
        array.remove(zoneBottoms, removeIndex)
        array.remove(zoneMids, removeIndex)
        array.remove(zoneStates, removeIndex)
        array.remove(zoneCreatedBars, removeIndex)
        array.remove(zoneSources, removeIndex)
    removeIndex

f_hasNearbyZone(int direction, float level, float distance) =>
    bool nearby = false
    int n = array.size(zoneDirections)
    if n > 0
        for i = 0 to n - 1
            if array.get(zoneDirections, i) == direction and array.get(zoneStates, i) == 0
                if math.abs(array.get(zoneMids, i) - level) <= distance
                    nearby := true
    nearby

f_addZone(int direction, float level, float atrValue, string source) =>
    if not na(level) and not na(atrValue) and atrValue > 0
        float mergeDistance = atrValue * 0.45
        if not f_hasNearbyZone(direction, level, mergeDistance)
            if f_zoneCount(direction) >= maxZonesEachSide
                f_removeOldestDirection(direction)

            float halfWidth = atrValue * zoneWidthAtr * 0.5
            float zoneTop = level + halfWidth
            float zoneBottom = level - halfWidth
            color baseColor = direction == 1 ? color.rgb(22, 139, 90) : color.rgb(181, 47, 72)
            string sideText = direction == 1 ? "pending buy" : "pending sell"
            string finalText = sideText + " · " + source

            box newBox = na
            label newLabel = na
            if showPendingZones
                newBox := box.new(bar_index, zoneTop, bar_index + zoneExpiryBars, zoneBottom, xloc=xloc.bar_index, bgcolor=color.new(baseColor, 86), border_color=color.new(baseColor, 45))
            if showPendingLabels
                newLabel := label.new(bar_index + zoneExpiryBars, level, finalText, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(baseColor, 30), textcolor=color.white, size=size.tiny)

            array.push(zoneDirections, direction)
            array.push(zoneTops, zoneTop)
            array.push(zoneBottoms, zoneBottom)
            array.push(zoneMids, level)
            array.push(zoneStates, 0)
            array.push(zoneCreatedBars, bar_index)
            array.push(zoneBoxes, newBox)
            array.push(zoneLabels, newLabel)
            array.push(zoneSources, source)
    0

f_hideZone(int index, int newState) =>
    array.set(zoneStates, index, newState)
    box b = array.get(zoneBoxes, index)
    label l = array.get(zoneLabels, index)
    if not na(b)
        box.set_bgcolor(b, color.new(color.gray, 100))
        box.set_border_color(b, color.new(color.gray, 100))
    if not na(l)
        label.set_color(l, color.new(color.gray, 100))
        label.set_textcolor(l, color.new(color.white, 100))
    0

// =============================================================================
// SETUP AND TRADE STATE — only one direction can be active
// =============================================================================
var bool setupActive = false
var int setupDirection = 0
var int setupStartBar = na
var float setupTrigger = na
var float setupSL = na

var bool tradeActive = false
var int tradeDirection = 0
var int tradeStartBar = na
var float tradeEntry = na
var float tradeSL = na
var float tradeTP = na

var int winCount = 0
var int lossCount = 0
var int timeoutCount = 0
var int cancelledSetupCount = 0
var int skippedSlCount = 0

var line entryLine = na
var line slLine = na
var line tpLine = na
var label entryText = na
var label slText = na
var label tpText = na

f_clearTargets() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(entryText)
        label.delete(entryText)
    if not na(slText)
        label.delete(slText)
    if not na(tpText)
        label.delete(tpText)
    0

bool buySetupSignal = false
bool sellSetupSignal = false
bool buyEntrySignal = false
bool sellEntrySignal = false

// =============================================================================
// BAR-CLOSE ENGINE
// =============================================================================
if barstate.isconfirmed
    // 1. Manage an existing trade. SL is counted first on an ambiguous candle.
    if tradeActive and bar_index > tradeStartBar
        bool stopped = tradeDirection == 1 ? low <= tradeSL : high >= tradeSL
        bool targeted = tradeDirection == 1 ? high >= tradeTP : low <= tradeTP
        bool timedOut = bar_index - tradeStartBar >= maxHoldBars

        if stopped
            lossCount += 1
            tradeActive := false
            label.new(bar_index, tradeSL, "SL", style=tradeDirection == 1 ? label.style_label_down : label.style_label_up, color=color.rgb(188, 40, 61), textcolor=color.white, size=size.tiny)
        else if targeted
            winCount += 1
            tradeActive := false
            label.new(bar_index, tradeTP, "TP", style=tradeDirection == 1 ? label.style_label_down : label.style_label_up, color=color.rgb(26, 151, 180), textcolor=color.white, size=size.tiny)
        else if timedOut
            timeoutCount += 1
            tradeActive := false

    // 2. Confirm or cancel a sweep/reclaim setup.
    // Entry is at the confirmation candle CLOSE, eliminating intrabar trigger-order ambiguity.
    if setupActive and not tradeActive and bar_index > setupStartBar
        bool plannedSlTouched = setupDirection == 1 ? low <= setupSL : high >= setupSL
        bool closeConfirmed = setupDirection == 1 ? close > setupTrigger : close < setupTrigger
        bool setupExpired = bar_index - setupStartBar > confirmationBars

        if plannedSlTouched
            cancelledSetupCount += 1
            setupActive := false
        else if closeConfirmed
            float riskDistance = setupDirection == 1 ? close - setupSL : setupSL - close
            if riskDistance > maxSlDistance
                skippedSlCount += 1
                setupActive := false
            else if riskDistance > syminfo.mintick
                tradeActive := true
                tradeDirection := setupDirection
                tradeStartBar := bar_index
                tradeEntry := close
                tradeSL := setupSL
                tradeTP := setupDirection == 1 ? tradeEntry + riskDistance * rr : tradeEntry - riskDistance * rr
                buyEntrySignal := setupDirection == 1
                sellEntrySignal := setupDirection == -1
                setupActive := false

                f_clearTargets()
                entryLine := na
                slLine := na
                tpLine := na
                entryText := na
                slText := na
                tpText := na
                if showTargets
                    entryLine := line.new(bar_index, tradeEntry, bar_index + 35, tradeEntry, xloc=xloc.bar_index, color=color.new(color.white, 45), style=line.style_dotted)
                    slLine := line.new(bar_index, tradeSL, bar_index + 35, tradeSL, xloc=xloc.bar_index, color=color.red)
                    tpLine := line.new(bar_index, tradeTP, bar_index + 35, tradeTP, xloc=xloc.bar_index, color=color.aqua, style=line.style_dashed)
                    entryText := label.new(bar_index + 35, tradeEntry, "ENTRY", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny)
                    slText := label.new(bar_index + 35, tradeSL, "SL", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
                    tpText := label.new(bar_index + 35, tradeTP, "TP " + profile, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.aqua, 20), textcolor=color.white, size=size.tiny)
        else if setupExpired
            cancelledSetupCount += 1
            setupActive := false

    // 3. Add only confirmed swing levels and completed previous-day levels.
    if useSwingLevels
        if not na(confirmedPivotHigh)
            f_addZone(-1, confirmedPivotHigh, atr, "SWING")
        if not na(confirmedPivotLow)
            f_addZone(1, confirmedPivotLow, atr, "SWING")
    if usePreviousDay and newDay
        f_addZone(-1, previousDayHigh, atr, "PDH")
        f_addZone(1, previousDayLow, atr, "PDL")

    // 4. Search for a genuine sweep + reclaim. One zone may create one setup only.
    if not tradeActive and not setupActive and array.size(zoneDirections) > 0
        int buyIndex = -1
        int sellIndex = -1
        float buyScore = -1000000000.0
        float sellScore = -1000000000.0
        float candleRange = math.max(high - low, syminfo.mintick)
        float candleBody = math.abs(close - open)
        bool bullishCandle = close > open
        bool bearishCandle = close < open
        float buyCloseLocation = (close - low) / candleRange
        float sellCloseLocation = (high - close) / candleRange

        for i = 0 to array.size(zoneDirections) - 1
            if array.get(zoneStates, i) == 0
                int age = bar_index - array.get(zoneCreatedBars, i)
                int direction = array.get(zoneDirections, i)
                float zoneTop = array.get(zoneTops, i)
                float zoneBottom = array.get(zoneBottoms, i)

                if age > zoneExpiryBars
                    f_hideZone(i, 3)
                else if direction == 1
                    bool swept = low <= zoneBottom - atr * sweepAtr
                    bool reclaimed = close >= zoneTop + atr * reclaimAtr
                    bool validSetup = swept and reclaimed and bullishCandle and candleBody >= atr * minBodyAtr and buyCloseLocation >= minCloseLocation
                    if validSetup
                        float score = ((zoneBottom - low) + (close - zoneTop)) / math.max(atr, syminfo.mintick)
                        if score > buyScore
                            buyScore := score
                            buyIndex := i
                    else if close < zoneBottom - atr * 0.50
                        f_hideZone(i, 2)
                else
                    bool swept = high >= zoneTop + atr * sweepAtr
                    bool reclaimed = close <= zoneBottom - atr * reclaimAtr
                    bool validSetup = swept and reclaimed and bearishCandle and candleBody >= atr * minBodyAtr and sellCloseLocation >= minCloseLocation
                    if validSetup
                        float score = ((high - zoneTop) + (zoneBottom - close)) / math.max(atr, syminfo.mintick)
                        if score > sellScore
                            sellScore := score
                            sellIndex := i
                    else if close > zoneTop + atr * 0.50
                        f_hideZone(i, 2)

        int selectedIndex = -1
        int selectedDirection = 0
        if buyIndex >= 0 and sellIndex >= 0
            if buyScore > sellScore
                selectedIndex := buyIndex
                selectedDirection := 1
            else if sellScore > buyScore
                selectedIndex := sellIndex
                selectedDirection := -1
        else if buyIndex >= 0
            selectedIndex := buyIndex
            selectedDirection := 1
        else if sellIndex >= 0
            selectedIndex := sellIndex
            selectedDirection := -1

        if selectedIndex >= 0
            // Consume the zone immediately: it cannot generate repeated setups.
            f_hideZone(selectedIndex, 1)
            setupActive := true
            setupDirection := selectedDirection
            setupStartBar := bar_index
            setupTrigger := selectedDirection == 1 ? high : low
            setupSL := selectedDirection == 1 ? low - atr * slBufferAtr : high + atr * slBufferAtr
            buySetupSignal := selectedDirection == 1
            sellSetupSignal := selectedDirection == -1

// Keep current target lines visible while the trade remains active.
if showTargets and tradeActive
    if not na(entryLine)
        line.set_x2(entryLine, bar_index + 35)
    if not na(slLine)
        line.set_x2(slLine, bar_index + 35)
    if not na(tpLine)
        line.set_x2(tpLine, bar_index + 35)
    if not na(entryText)
        label.set_x(entryText, bar_index + 35)
    if not na(slText)
        label.set_x(slText, bar_index + 35)
    if not na(tpText)
        label.set_x(tpText, bar_index + 35)

plotshape(buySetupSignal, title="BUY Setup", text="BUY SETUP", style=shape.labelup, location=location.belowbar, color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
plotshape(sellSetupSignal, title="SELL Setup", text="SELL SETUP", style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)
plotshape(buyEntrySignal, title="BUY Entry", text="BUY", style=shape.labelup, location=location.belowbar, color=color.rgb(22, 152, 92), textcolor=color.white, size=size.small)
plotshape(sellEntrySignal, title="SELL Entry", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.rgb(190, 45, 70), textcolor=color.white, size=size.small)

// =============================================================================
// STATISTICS
// =============================================================================
var table stats = table.new(position.top_right, 2, 7, border_width=0)
if barstate.islast
    if showStats
        int closedTrades = winCount + lossCount
        float wr = closedTrades > 0 ? winCount * 100.0 / closedTrades : 0.0
        table.cell(stats, 0, 0, "PROFILE", text_color=color.white, bgcolor=color.new(color.gray, 55))
        table.cell(stats, 1, 0, profile, text_color=color.aqua, bgcolor=color.new(color.gray, 55))
        table.cell(stats, 0, 1, "TP", text_color=color.aqua)
        table.cell(stats, 1, 1, str.tostring(winCount), text_color=color.aqua)
        table.cell(stats, 0, 2, "SL", text_color=color.red)
        table.cell(stats, 1, 2, str.tostring(lossCount), text_color=color.red)
        table.cell(stats, 0, 3, "WR", text_color=color.white)
        table.cell(stats, 1, 3, str.tostring(wr, "#.##") + "%", text_color=color.white)
        table.cell(stats, 0, 4, "TIMEOUT", text_color=color.silver)
        table.cell(stats, 1, 4, str.tostring(timeoutCount), text_color=color.silver)
        table.cell(stats, 0, 5, "CANCEL", text_color=color.silver)
        table.cell(stats, 1, 5, str.tostring(cancelledSetupCount), text_color=color.silver)
        table.cell(stats, 0, 6, "SL > 150", text_color=color.orange)
        table.cell(stats, 1, 6, str.tostring(skippedSlCount), text_color=color.orange)
    else
        table.clear(stats, 0, 0, 1, 6)

alertcondition(buySetupSignal, "AMY BUY Setup", "AMY QRR: BUY sweep/reclaim setup formed")
alertcondition(sellSetupSignal, "AMY SELL Setup", "AMY QRR: SELL sweep/reclaim setup formed")
alertcondition(buyEntrySignal, "AMY BUY Entry", "AMY QRR: BUY confirmed at candle close")
alertcondition(sellEntrySignal, "AMY SELL Entry", "AMY QRR: SELL confirmed at candle close")
