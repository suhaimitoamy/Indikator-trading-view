//@version=6
indicator("Amy Selective Swing Signals V5", "Amy Swing Signals V5", overlay = true, max_labels_count = 300, max_bars_back = 5000)

// ============================================================================
// AMY SELECTIVE SWING SIGNALS V5 — MAJOR TURN + SPARSITY
// Standalone experiment. V1 / V2 / V3 / V4 are not modified.
//
// V5 combines:
// - V4 major-turn / alternating state machine
// - V1-style sparse quality gating
// - confirmed pivots only
// - no back-painting: BUY/SELL prints on the confirmation candle
// - no dashboard
// ============================================================================

string grpTurn = "1. Major Turning Logic"
int pivotLen = input.int(2, "Pivot Confirmation Bars", minval = 1, maxval = 8, group = grpTurn)
int prominenceLookback = input.int(14, "Major Swing Lookback", minval = 5, maxval = 60, group = grpTurn)
float minLegAtr = input.float(1.75, "Minimum Opposite Leg (ATR)", minval = 0.25, maxval = 10.0, step = 0.25, group = grpTurn)
int minPivotBars = input.int(8, "Minimum Bars Between Major Turns", minval = 1, maxval = 100, group = grpTurn)

string grpQuality = "2. Sparse Quality Gate"
int emaLen = input.int(20, "Quality EMA", minval = 2, maxval = 200, group = grpQuality)
int rsiLen = input.int(14, "Quality RSI", minval = 2, maxval = 100, group = grpQuality)
float buyRsiMax = input.float(45.0, "BUY Pivot RSI Max", minval = 10, maxval = 60, step = 1, group = grpQuality)
float sellRsiMin = input.float(55.0, "SELL Pivot RSI Min", minval = 40, maxval = 90, step = 1, group = grpQuality)
float minWickRatio = input.float(0.25, "Minimum Rejection Wick", minval = 0.0, maxval = 0.9, step = 0.05, group = grpQuality)
float stretchAtr = input.float(0.35, "EMA Stretch (ATR)", minval = 0.0, maxval = 4.0, step = 0.05, group = grpQuality)
int qualityNeeded = input.int(1, "Extra Quality Evidence Needed", minval = 1, maxval = 3, group = grpQuality)
float hugeLegOverrideAtr = input.float(3.25, "Huge-Leg Quality Override (ATR)", minval = 1.0, maxval = 12.0, step = 0.25, group = grpQuality)

string grpConfirm = "3. Reversal Confirmation"
int confirmWindow = input.int(5, "Confirmation Window (bars)", minval = 1, maxval = 20, group = grpConfirm)
float retraceAtr = input.float(0.40, "Minimum Reversal From Pivot (ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = grpConfirm)
int microBreakBars = input.int(2, "Micro Structure Break Bars", minval = 1, maxval = 10, group = grpConfirm)
float confirmBodyAtr = input.float(0.15, "Minimum Confirmation Body (ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = grpConfirm)
float maxConfirmDistanceAtr = input.float(1.60, "Maximum Chase Distance From Pivot (ATR)", minval = 0.50, maxval = 5.0, step = 0.10, group = grpConfirm)

string grpVisual = "4. Visual"
float labelDistanceAtr = input.float(0.25, "Label Distance (ATR)", minval = 0.05, maxval = 2.0, step = 0.05, group = grpVisual)

float atr = ta.atr(14)
float ema = ta.ema(close, emaLen)
float rsi = ta.rsi(close, rsiLen)
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)

// +1 = last accepted BUY, -1 = last accepted SELL, 0 = not initialized.
var int lastTurn = 0
var float lastTurnPrice = na
var int lastTurnPivotBar = na

// Pending BUY candidate.
var bool buyArmed = false
var float buyPivot = na
var float buyPivotAtr = na
var int buyPivotBar = na
var int buyExpiry = na

// Pending SELL candidate.
var bool sellArmed = false
var float sellPivot = na
var float sellPivotAtr = na
var int sellPivotBar = na
var int sellExpiry = na

// ============================================================================
// CONFIRMED MAJOR SWING HIGH CANDIDATE
// Only searched when SELL is allowed by the alternating state.
// ============================================================================
if barstate.isconfirmed and not na(ph) and lastTurn != -1
    int pBar = bar_index - pivotLen
    float pAtr = nz(atr[pivotLen], atr)
    float pRange = high[pivotLen] - low[pivotLen]
    float upperWick = high[pivotLen] - math.max(open[pivotLen], close[pivotLen])
    float pivotRsi = rsi[pivotLen]
    float pivotEma = ema[pivotLen]
    float priorWindowHigh = ta.highest(high, prominenceLookback)[pivotLen]

    bool prominent = not na(priorWindowHigh) and ph >= priorWindowHigh
    bool wickOk = pRange > 0 and upperWick / pRange >= minWickRatio
    bool rsiOk = not na(pivotRsi) and pivotRsi >= sellRsiMin
    bool stretchOk = not na(pivotEma) and ph >= pivotEma + pAtr * stretchAtr
    int extraQuality = (wickOk ? 1 : 0) + (rsiOk ? 1 : 0) + (stretchOk ? 1 : 0)

    float legAtr = lastTurn == 1 and not na(lastTurnPrice) ? (ph - lastTurnPrice) / math.max(pAtr, syminfo.mintick) : na
    bool hugeLeg = not na(legAtr) and legAtr >= hugeLegOverrideAtr
    bool qualityOk = prominent and (extraQuality >= qualityNeeded or hugeLeg)
    bool spacingOk = na(lastTurnPivotBar) or pBar - lastTurnPivotBar >= minPivotBars
    bool amplitudeOk = lastTurn == 0 or (lastTurn == 1 and not na(legAtr) and legAtr >= minLegAtr)

    if qualityOk and spacingOk and amplitudeOk
        if not sellArmed or na(sellPivot) or ph >= sellPivot
            sellArmed := true
            sellPivot := ph
            sellPivotAtr := pAtr
            sellPivotBar := pBar
            sellExpiry := bar_index + confirmWindow

// ============================================================================
// CONFIRMED MAJOR SWING LOW CANDIDATE
// Only searched when BUY is allowed by the alternating state.
// ============================================================================
if barstate.isconfirmed and not na(pl) and lastTurn != 1
    int pBar = bar_index - pivotLen
    float pAtr = nz(atr[pivotLen], atr)
    float pRange = high[pivotLen] - low[pivotLen]
    float lowerWick = math.min(open[pivotLen], close[pivotLen]) - low[pivotLen]
    float pivotRsi = rsi[pivotLen]
    float pivotEma = ema[pivotLen]
    float priorWindowLow = ta.lowest(low, prominenceLookback)[pivotLen]

    bool prominent = not na(priorWindowLow) and pl <= priorWindowLow
    bool wickOk = pRange > 0 and lowerWick / pRange >= minWickRatio
    bool rsiOk = not na(pivotRsi) and pivotRsi <= buyRsiMax
    bool stretchOk = not na(pivotEma) and pl <= pivotEma - pAtr * stretchAtr
    int extraQuality = (wickOk ? 1 : 0) + (rsiOk ? 1 : 0) + (stretchOk ? 1 : 0)

    float legAtr = lastTurn == -1 and not na(lastTurnPrice) ? (lastTurnPrice - pl) / math.max(pAtr, syminfo.mintick) : na
    bool hugeLeg = not na(legAtr) and legAtr >= hugeLegOverrideAtr
    bool qualityOk = prominent and (extraQuality >= qualityNeeded or hugeLeg)
    bool spacingOk = na(lastTurnPivotBar) or pBar - lastTurnPivotBar >= minPivotBars
    bool amplitudeOk = lastTurn == 0 or (lastTurn == -1 and not na(legAtr) and legAtr >= minLegAtr)

    if qualityOk and spacingOk and amplitudeOk
        if not buyArmed or na(buyPivot) or pl <= buyPivot
            buyArmed := true
            buyPivot := pl
            buyPivotAtr := pAtr
            buyPivotBar := pBar
            buyExpiry := bar_index + confirmWindow

// Expire stale candidates.
if sellArmed and bar_index > sellExpiry
    sellArmed := false
if buyArmed and bar_index > buyExpiry
    buyArmed := false

// ============================================================================
// NON-REPAINT REVERSAL CONFIRMATION
// ============================================================================
float body = math.abs(close - open)
float priorMicroHigh = ta.highest(high, microBreakBars)[1]
float priorMicroLow = ta.lowest(low, microBreakBars)[1]

bool bullBody = barstate.isconfirmed and close > open and body >= atr * confirmBodyAtr
bool bearBody = barstate.isconfirmed and close < open and body >= atr * confirmBodyAtr
bool bullBreak = bullBody and not na(priorMicroHigh) and close > priorMicroHigh
bool bearBreak = bearBody and not na(priorMicroLow) and close < priorMicroLow

float buyDistanceAtr = buyArmed and not na(buyPivotAtr) ? (close - buyPivot) / math.max(buyPivotAtr, syminfo.mintick) : na
float sellDistanceAtr = sellArmed and not na(sellPivotAtr) ? (sellPivot - close) / math.max(sellPivotAtr, syminfo.mintick) : na

bool buyRetraceOk = buyArmed and not na(buyDistanceAtr) and buyDistanceAtr >= retraceAtr and buyDistanceAtr <= maxConfirmDistanceAtr
bool sellRetraceOk = sellArmed and not na(sellDistanceAtr) and sellDistanceAtr >= retraceAtr and sellDistanceAtr <= maxConfirmDistanceAtr

bool buySignal = buyArmed and lastTurn != 1 and buyRetraceOk and bullBreak
bool sellSignal = sellArmed and lastTurn != -1 and sellRetraceOk and bearBreak

// During initialization only, if both sides are ready on one candle, keep the
// candidate with the larger normalized reversal distance.
if buySignal and sellSignal and lastTurn == 0
    if buyDistanceAtr >= sellDistanceAtr
        sellSignal := false
    else
        buySignal := false

if buySignal
    float y = low - atr * labelDistanceAtr
    label.new(bar_index, y, "BUY", yloc = yloc.price, style = label.style_label_up, color = color.rgb(38, 103, 230), textcolor = color.white, size = size.small)
    lastTurn := 1
    lastTurnPrice := buyPivot
    lastTurnPivotBar := buyPivotBar
    buyArmed := false
    sellArmed := false

if sellSignal
    float y = high + atr * labelDistanceAtr
    label.new(bar_index, y, "SELL", yloc = yloc.price, style = label.style_label_down, color = color.rgb(190, 65, 78), textcolor = color.white, size = size.small)
    lastTurn := -1
    lastTurnPrice := sellPivot
    lastTurnPivotBar := sellPivotBar
    sellArmed := false
    buyArmed := false

alertcondition(buySignal, "Amy Swing Signals V5 — BUY", "Major sparse confirmed BUY turning signal V5.")
alertcondition(sellSignal, "Amy Swing Signals V5 — SELL", "Major sparse confirmed SELL turning signal V5.")
