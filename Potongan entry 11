bool ent_bullBreakerActive = false

if bearish_ob.size() > 0
    for i = 0 to bearish_ob.size() - 1
        _ob = bearish_ob.get(i)
        if _ob.breaker and not ent_bullBreakerActive
            ent_bullBreakerTop := _ob.top
            ent_bullBreakerBtm := _ob.btm
