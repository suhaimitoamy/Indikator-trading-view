        piv_opBuyDist := piv_dist
        piv_opBuyLevel := piv_s4

piv_opBuyActive = not na(piv_opBuyLevel)
piv_opSellActive = not na(piv_opSellLevel)

var line[] piv_lines = array.new<line>(9, na)
var label[] piv_labels = array.new<label>(9, na)

piv_draw(_idx, _price, _name, _baseColor, _isOPBuy, _isOPSell) =>
    line _ln = array.get(piv_lines, _idx)
    label _lb = array.get(piv_labels, _idx)
    _show = piv_show and not na(_price)
    _col = _isOPBuy ? color.lime : _isOPSell ? color.red : _baseColor
    _width = _isOPBuy or _isOPSell ? piv_opWidth : piv_lineWidth
    _txt = _isOPBuy ? _name + "  OP BUY  " + str.tostring(_price, format.mintick) :
         _isOPSell ? _name + "  OP SELL  " + str.tostring(_price, format.mintick) :
         _name + "  " + str.tostring(_price, format.mintick)
    _left = math.max(0, bar_index - piv_backBars)
    _right = bar_index + piv_extendBars
    if _show
        if na(_ln)
            _ln := line.new(_left, _price, _right, _price, xloc=xloc.bar_index, extend=extend.none, color=_col, width=_width)
        else
            line.set_xy1(_ln, _left, _price)
            line.set_xy2(_ln, _right, _price)
            line.set_color(_ln, _col)
            line.set_width(_ln, _width)
            line.set_style(_ln, line.style_solid)
        if piv_showLabels
            if na(_lb)
                _lb := label.new(_right, _price, _txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(_col, 82), textcolor=_col, size=size.tiny)
            else
                label.set_xy(_lb, _right, _price)
                label.set_text(_lb, _txt)
                label.set_color(_lb, color.new(_col, 82))
                label.set_textcolor(_lb, _col)
                label.set_size(_lb, size.tiny)
        else
            if not na(_lb)
                label.delete(_lb)
                _lb := na
    else
        if not na(_ln)
            line.delete(_ln)
            _ln := na
        if not na(_lb)
            label.delete(_lb)
            _lb := na
    array.set(piv_lines, _idx, _ln)
    array.set(piv_labels, _idx, _lb)

piv_draw(0, piv_r4, "R4", color.new(color.red, 35), false, piv_opSellLevel == piv_r4)
piv_draw(1, piv_r3, "R3", color.new(color.red, 30), false, piv_opSellLevel == piv_r3)
piv_draw(2, piv_r2, "R2", color.new(color.red, 20), false, piv_opSellLevel == piv_r2)
piv_draw(3, piv_r1, "R1", color.new(color.red, 10), false, piv_opSellLevel == piv_r1)
piv_draw(4, piv_p, "PIVOT", color.new(color.blue, 0), false, false)
piv_draw(5, piv_s1, "S1", color.new(color.lime, 10), piv_opBuyLevel == piv_s1, false)
piv_draw(6, piv_s2, "S2", color.new(color.lime, 20), piv_opBuyLevel == piv_s2, false)
piv_draw(7, piv_s3, "S3", color.new(color.lime, 30), piv_opBuyLevel == piv_s3, false)
piv_draw(8, piv_s4, "S4", color.new(color.lime, 35), piv_opBuyLevel == piv_s4, false)

