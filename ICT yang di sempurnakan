//==================== CUSTOM PIVOT OP LEVELS ====================//
piv_group = "Custom Pivot OP Levels"
piv_show = input.bool(true, "Show Pivot OP Levels", group=piv_group)
piv_tf = input.string("D", "Pivot Source TF", options=["D", "W", "M"], group=piv_group)
piv_showLabels = input.bool(true, "Show Pivot Labels", group=piv_group)
piv_backBars = input.int(80, "Left Bars", minval=10, maxval=500, group=piv_group)
piv_extendBars = input.int(40, "Right Bars", minval=5, maxval=300, group=piv_group)
piv_lineWidth = input.int(1, "Line Width", minval=1, maxval=4, group=piv_group)
piv_showOP = input.bool(true, "Show OP Reaction", group=piv_group)
piv_opAtrMult = input.float(0.35, "OP Zone ATR", minval=0.05, step=0.05, group=piv_group)
piv_opWidth = input.int(3, "OP Line Width", minval=1, maxval=5, group=piv_group)

piv_prevHigh = request.security(syminfo.tickerid, piv_tf, high[1], barmerge.gaps_off, barmerge.lookahead_on)
piv_prevLow = request.security(syminfo.tickerid, piv_tf, low[1], barmerge.gaps_off, barmerge.lookahead_on)
piv_prevClose = request.security(syminfo.tickerid, piv_tf, close[1], barmerge.gaps_off, barmerge.lookahead_on)

piv_range = piv_prevHigh - piv_prevLow
piv_p = (piv_prevHigh + piv_prevLow + piv_prevClose) / 3.0

piv_r1 = 2.0 * piv_p - piv_prevLow
piv_s1 = 2.0 * piv_p - piv_prevHigh
piv_r2 = piv_p + piv_range
piv_s2 = piv_p - piv_range
piv_r3 = piv_prevHigh + 2.0 * (piv_p - piv_prevLow)
piv_s3 = piv_prevLow - 2.0 * (piv_prevHigh - piv_p)
piv_r4 = piv_r3 + piv_range
piv_s4 = piv_s3 - piv_range

piv_opZone = atr * piv_opAtrMult

piv_checkSell(_lvl) =>
    not na(_lvl) and high >= _lvl - piv_opZone and close < _lvl

piv_checkBuy(_lvl) =>
    not na(_lvl) and low <= _lvl + piv_opZone and close > _lvl

float piv_opSellLevel = na
float piv_opSellDist = na
float piv_opBuyLevel = na
float piv_opBuyDist = na

if piv_showOP and piv_checkSell(piv_r1)
    piv_dist = math.abs(close - piv_r1)
    if na(piv_opSellDist) or piv_dist < piv_opSellDist
        piv_opSellDist := piv_dist
        piv_opSellLevel := piv_r1

if piv_showOP and piv_checkSell(piv_r2)
    piv_dist = math.abs(close - piv_r2)
    if na(piv_opSellDist) or piv_dist < piv_opSellDist
        piv_opSellDist := piv_dist
        piv_opSellLevel := piv_r2

if piv_showOP and piv_checkSell(piv_r3)
    piv_dist = math.abs(close - piv_r3)
    if na(piv_opSellDist) or piv_dist < piv_opSellDist
        piv_opSellDist := piv_dist
        piv_opSellLevel := piv_r3

if piv_showOP and piv_checkSell(piv_r4)
    piv_dist = math.abs(close - piv_r4)
    if na(piv_opSellDist) or piv_dist < piv_opSellDist
        piv_opSellDist := piv_dist
        piv_opSellLevel := piv_r4

if piv_showOP and piv_checkBuy(piv_s1)
    piv_dist = math.abs(close - piv_s1)
    if na(piv_opBuyDist) or piv_dist < piv_opBuyDist
        piv_opBuyDist := piv_dist
        piv_opBuyLevel := piv_s1

if piv_showOP and piv_checkBuy(piv_s2)
    piv_dist = math.abs(close - piv_s2)
    if na(piv_opBuyDist) or piv_dist < piv_opBuyDist
        piv_opBuyDist := piv_dist
        piv_opBuyLevel := piv_s2

if piv_showOP and piv_checkBuy(piv_s3)
    piv_dist = math.abs(close - piv_s3)
    if na(piv_opBuyDist) or piv_dist < piv_opBuyDist
        piv_opBuyDist := piv_dist
        piv_opBuyLevel := piv_s3

if piv_showOP and piv_checkBuy(piv_s4)
    piv_dist = math.abs(close - piv_s4)
